        $('#immatriculation_maintien_secteur_activite').change(function(){

            var e = document.getElementById("immatriculation_maintien_secteur_activite");

            var valOption = e.options[e.selectedIndex].value;

            $.ajax({
                type: "GET",
                url: "/employer/immatriculations/1/load_activities?secteur="+valOption,
                data: null,
                success: function(data, textStatus, jqXHR){
                    // alert('ok');
                    console.log(data);

                    $('#immatriculation_maintien_activite_principale')
                        .empty()
                        .append(data)
                        .prepend("<option value='' selected='selected'></option>");

