<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="ibox-content">
        <%= bootstrap_form_for(@paiement, url: employer_paiements_path(@immatriculation), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
        <%= f.alert_message "Please fix the errors below." %>

        <%= f.collection_select :references, @factures , :reference_facture, :description, {}, {multiple: true} %>


        <%= f.select :mode_paiement,
                     Paiement::TYPE_ENCAISSEMENT.keys.collect { |mode_paiement| [Paiement.human_enum_name(:mode_paiement, mode_paiement), mode_paiement] }, label: 'Mode paiement' %>
        <%= f.number_field :montant, label: 'Montant à payer' %>

        <div class="hr-line-dashed"></div>

        <div class="form-group row">
          <div class="col-sm-4 col-sm-offset-4">
            <%= link_to 'Annuler', admin_users_path, class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>