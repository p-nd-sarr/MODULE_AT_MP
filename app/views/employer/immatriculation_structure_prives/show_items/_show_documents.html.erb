<div class="row">
  <div class="col-sm-4">
    <% unless @immatriculation.id == nil or @immatriculation.documents_valide? %>
    <%= link_to "Je valide tous les documents", employer_immatriculation__structure_prive_valider_documents_path(current_user), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
    <%end %>
  </div>
</div>
<div class="row">
  <div class="col-lg-8">
    <% current_user.document_immatriculations.each do |document_immatriculation| %>

      <table class="table table-bordered table-condensed table-hover">
        <thead>
        <tr>
          <th scope="col">Type document</th>
          <th scope="col">commentaire</th>
          <% if @immatriculation != nil && !@immatriculation.documents_valide %>
          <th scope="col">Actions</th>
            <%end  %>
        </tr>
        </thead>
        <tbody>
          <tr>
            <td><%= DocumentImmatriculation.human_enum_name(:type_document, document_immatriculation.type_document) %></td>
            <td><%= document_immatriculation.commentaire %></td>
            <% if @immatriculation != nil && !@immatriculation.documents_valide %>
            <td>
              <a href="<%= url_for(document_immatriculation.document) %>" target="_blank"> <button class="btn btn-outline btn-danger btn-xs"> Retirer</button></a>
              <a href="<%= url_for(document_immatriculation.document) %>" target="_blank"> <button class="btn btn-outline btn-primary btn-xs"> Prévisualiser</button></a>
            </td>
              <% end %>
          </tr>
        </tbody>
      </table>
    <% end %>
  </div>

</div>

  <button id="ajouter_document" class="btn btn-primary">ajouter un Document</button>

  <% if @immatriculation != nil %>

    <%= bootstrap_form_for([:employer, @document_immatriculation], layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
    <div class="row" id="new_document_immatriculation">
      <div class="col-sm-8 col-sm-offset-2">
        <h2>ajouter d'un document</h2>
        <%= f.select :type_document,
                     DocumentImmatriculation::TYPE_DOCUMENT.keys.collect { |type_document| [DocumentImmatriculation.human_enum_name(:type_document, type_document), type_document] }, label: 'Type document' %>
        <%= f.file_field :document, label: 'Document', required: true %>
        <%= f.text_area :commentaire, label: 'Commentaire' %>

        <div class="hr-line-dashed"></div>

        <div class="form-group row">
          <div class="col-sm-4 col-sm-offset-2">
            <%= f.button 'Ajouter', class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <script type="text/javascript">
      $(document).ready(function(){
          $('#new_document_immatriculation').hide();

          $("#ajouter_document").click(function () {
              $('#new_document_immatriculation').show();
              return false;
          });
      })
  </script>
<% end %>
<% if @immatriculation != nil  %>
  <div class="ibox ">
    <div class="ibox-title">
      <h5>Liste des documents</h5>
    </div>
    <div class="ibox-content">
      <table class="table table-striped table-bordered table-hover">
        <thead>
        <tr>
          <th scope="col"  style="width: 300px">Type</th>
          <th scope="col" style="width: 500px">Choisir document</th>
          <th scope="col" style="width: 100px">Action</th>
        </tr>
        </thead>
        <% DocumentImmatriculation::TYPE_DOCUMENT.each do |document_name| %>
          <tbody>
          <%= bootstrap_form_for([:employer, @document_immatriculation], layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <tr>
              <td >
                <%= f.hidden_field :type_document, value:document_name.first%>
                <%=DocumentImmatriculation.human_enum_name(:type_document, document_name.first)%>
              </td>
              <td>
                <%= f.file_field :document, label: '&nbsp;'.html_safe %>
              </td>

              <td>

                <%= f.button 'Valider', class: 'btn btn-outline btn-primary btn-xs' %>

              </td>
            </tr>
          <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>
<% end %>