<%= content_for :titre_page, @employeur.nil? ?  "Soumission de la demande d’immatriculation  #{@immatriculation.raison_sociale}" : "Mise à jour informations du compte employeur" %>

<%= content_for :actions_page do %>
  <% if @immatriculation.creation? %>

    <div class="progress">
      <div class="progress-bar progress-bar-striped progress-bar-animated progress-bar-primary" style="width: <%=@pourcentage%>%" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100">Progression : <%= @pourcentage %>%</div>
    </div>

    <% if @immatriculation.pret_pour_soumission? %>
      <%= link_to "Soumettre", employer_immatriculation_structure_prife_soumettre_demande_path(@immatriculation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
    <% end %>

  <% end %>

  <% if @immatriculation.soumis? or @immatriculation.valide? %>
    <h4>Etat Demande : <span class="btn btn-warning"> <%= Immatriculation.human_enum_name(:etat, @immatriculation.etat) %></span></h4>

  <% else %>

  <% end %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
            <h2>
              Ninea: <%= @immatriculation.ninea %>
            </h2>

            <% if @immatriculation.creation? %>
              <% if @immatriculation.pret_pour_soumission? %>
                <h2 class="text-info">
                  Votre dossier est prêt pour soumission
                </h2>
              <% else %>
                <p class="text-warning">
                  Merci de valider les informations sur les différents onglets pour pouvoir soumettre le dossier
                </p>
              <% end %>
            <% end %>

            <div>
              <ul class="nav nav-tabs">
                <!--                <span class="pull-right small text-muted">1406 Elements</span>-->
                <li class="<%=@active_societe%>"><a data-toggle="tab" href="#tab-1"><i class="fa fa-user"></i>Information société
                  <%= '<span class="label label-warning">à valider</span>'.html_safe unless @immatriculation.etat_civil_demandeur_valide? %>
                </a></li>
                <li class="<%=@active_representant %>"><a data-toggle="tab" href="#tab-2"><i class="fa fa-folder"></i>Représentant légal
                  <%= '<span class="label label-warning">à valider</span>'.html_safe unless @immatriculation.representant_valide?  %>
                </a></li>
                <li class="<%=@active_salaries %>"><a data-toggle="tab" href="#tab-3"><i class="fa fa-folder"></i>Informations Salariés
                  <%= '<span class="label label-warning">à valider</span>'.html_safe unless @immatriculation.salarie_valide? %>
                </a></li>
                <li class="<%=@active_document %>"><a data-toggle="tab" href="#tab-4"><i class="fa fa-folder"></i>Documents à joindre
                  <%= '<span class="label label-warning">à valider</span>'.html_safe unless @immatriculation.documents_valide? %>
                </a></li>
              </ul>
              <div class="tab-content">

                <div id="tab-1" class="tab-pane <%=@active_societe%>">
                  <div class="full-height-scroll">
                    <br>
                    <%= render 'employer/immatriculations/templates/show_etat_civil_groupe2' %>
                  </div>
                </div>

                <div id="tab-2" class="tab-pane <%=@active_representant%>">
                  <div class="full-height-scroll">
                    <br>
                    <%= render 'employer/immatriculation_structure_prives/show_items/show_representant' %>
                  </div>
                </div>

                <div id="tab-3" class="tab-pane <%=@active_salaries%>">
                  <div class="full-height-scroll">
                    <br>
                    <%= render 'employer/immatriculations/templates/show_salarie'  %>

                  </div>
                </div>

                <div id="tab-4" class="tab-pane <%=@active_document%>">
                  <div class="full-height-scroll">
                    <br>
                    <%= render 'employer/immatriculation_structure_prives/show_items/show_documents' %>

                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


<script type="text/javascript" charset="utf-8">

    $(document).ready(function(){

        $('#immatriculation_secteur_activite').change(function(){

            var e = document.getElementById("immatriculation_secteur_activite");

            var valOption = e.options[e.selectedIndex].value;

            $.ajax({
                type: "GET",
                url: "/employer/immatriculations/1/load_activities?secteur="+valOption,
                data: null,
                success: function(data, textStatus, jqXHR){
                    // alert('ok');
                    console.log(data);

                    $('#immatriculation_activite_principale')
                        .empty()
                        .append(data)
                        .prepend("<option value='' selected='selected'></option>");

                },
                error: function(jqXHR, textStatus, errorThrown){
                    // alert('error');
                    console.log('error');
                }
            });

        });


