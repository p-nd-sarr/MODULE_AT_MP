                        .prepend("<option value='' selected='selected'></option>");

                },
                error: function(jqXHR, textStatus, errorThrown){
                    // alert('error');
                    console.log('error');
                }
            });

        });

        $('#immatriculation_commune').change(function(){

            console.log('---> immatriculation_commune');

            var e = document.getElementById("immatriculation_commune");
            var valOption = e.options[e.selectedIndex].value;

            $.ajax({
                type: "GET",
                url: "/employer/immatriculations/1/load_adresse?commune="+valOption,
                data: null,
                success: function(data, textStatus, jqXHR){
                    // alert('ok');
                    console.log(data);

                    $('#immatriculation_quartier')
                        .empty()
