<%= content_for :titre_page do %>
  <h2>Bienvenue Dans Votre Espace Employeur :   <span> <%= " #{current_user.nom} - #{current_user.sigle}" %></span></h2>
  <h5> Raison Sociale:  <span style="color:#1ab394"><%= @employeur.nil? ? current_user.raison_sociale : @employeur.fhrsoc %> </span></h5>
<% end %>

<%= content_for :actions_page do %>

  <% if @pourcentage < 100 %>
    <div class="progress">
      <div class="progress-bar progress-bar-striped progress-bar-animated progress-bar-primary" style="width: <%=@pourcentage%>%" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"> <%= @pourcentage %>%</div>
    </div>
  <%end %>

  <% if @pourcentage >= 100 %>
  <a href="<%= @url %>" target="_blank" class="btn btn-primary"><i class="fa fa-print"></i> Imprimer </a>
  <% end %>
<% end %>

<div class="row">

  <%= link_to employer_immatriculations_path do %>
  <div class="col-lg-2">
    <div class="widget style1 navy-bg" style="text-align:center">
      <div class="row vertical-align">
        <div class="col-lg-12">
          <i class="fa fa-id-card fa-3x"></i>
        </div>
        <div class="col-lg-12" style="text-align: center">
          <% if @employeur.nil? %>
          <h5 class="font-bold"> Demander <br> immatriculation </h5>
            <% else %>
            <h5 class="font-bold"> Mettre à jour <br> son compte </h5>
        <% end %>
        </div>
      </div>
    </div>
  </div>
  <%end %>

  <%= link_to employer_declarations_path do %>
    <div class="col-lg-2">
      <div class="widget style1 navy-bg" style="text-align:center">
        <div class="row vertical-align">
          <div class="col-lg-12">
            <i class="fa fa-folder-open fa-3x"></i>
          </div>
          <div class="col-lg-12" style="text-align: center">
            <h5 class="font-bold"> Faire une <br> déclaration</h5>
          </div>
        </div>
      </div>
    </div>

  <%end %>

  <%= link_to employer_effectifs_path do %>
    <div class="col-lg-2">
      <div class="widget style1 navy-bg" style="text-align:center">
        <div class="row vertical-align">
          <div class="col-lg-12">
            <i class="fa fa-users fa-3x"></i>
          </div>
          <div class="col-lg-12" style="text-align: center">
            <h5 class="font-bold"> Gérer <br> les effectifs </h5>
          </div>
        </div>
      </div>
    </div>
  <%end %>

  <%= link_to employer_factures_path do %>
    <div class="col-lg-2">
      <div class="widget style1 navy-bg" style="text-align:center">
        <div class="row vertical-align">
          <div class="col-lg-12">
            <i class="fa fa-file fa-3x"></i>
          </div>
          <div class="col-lg-12" style="text-align: center">
            <h5 class="font-bold"> Payer une <br> facture</h5>
          </div>
        </div>
      </div>
    </div>
  <%end %>

  <%= link_to root_path do %>
  <div class="col-lg-2">
    <div class="widget style1 navy-bg" style="text-align:center">
      <div class="row vertical-align">
        <div class="col-lg-12">
          <i class="fa fa-file fa-3x"></i>
        </div>
        <div class="col-lg-12" style="text-align: center">
          <h5 class="font-bold"> Demander <br> attestation</h5>
        </div>
      </div>
    </div>
  </div>
  <%end %>

  <%= link_to employer_moratoires_path do %>
  <div class="col-lg-2">
    <div class="widget style1 navy-bg" style="text-align: center">
      <div class="row vertical-align">
        <div class="col-lg-12">
          <i class="fa fa-bank fa-3x"></i>
        </div>
        <div class="col-lg-12 text-right" style="text-align: center">
          <h5 class="font-bold"> Demander un <br> moratoire</h5>
        </div>
      </div>
    </div>
  </div>
  <%end %>
</div>

  <div class="row m-b-lg m-t-lg">

    <div class="col-md-7">
      <div class="ibox">
        <div class="ibox-content">
          <div class="row">
            <div class="col-lg-6">
              <h3 class="text-success"><strong>Identification</strong></h3>
                <d1 class="row mb-0">
                  <div class="col-sm-12" style="padding-left:0px;">
                    <h5>Nº unique IPRES/CSS : <span style="color:#1ab394;"><%= @employeur.try(:fhnum) %></span></h5>

                    <h5>Ancien Nº IPRES : <span style="color:#1ab394;"><%= @employeur.try(:ancien_num_ipres) %></span> </h5>

                    <h5>Ancien Nº CSS : <span style="color:#1ab394"><%= @employeur.try(:ancien_num_css) %> </span></h5>
                  </div>
                </d1>
            </div>
            <div class="col-lg-6">
              <h3 class="text-success"><strong>Détails statut employeur</strong></h3>
                <d1 class="row mb-0">
                  <div class="col-sm-12" style="padding-left:0px">
                    <h5>Statut unique : <span style="color:#1ab394"><%= @employeur.try(:statut) %>  </span></h5>

                    <h5>Statut IPRES : <span style="color:#1ab394"><%= @employeur.try(:ancien_statut_ipres) %>  </span> </h5>

                    <h5>Statut CSS : <span style="color:#1ab394"><%= @employeur.try(:ancien_statut_css) %>  </span></h5>
                  </div>
                </d1>
            </div>
            <div class="col-lg-12"></div>
            <div class="col-lg-6">
              <h3 class="text-success"><strong>Solde des branches</strong></h3>
                <d1 class="row mb-0">
                  <div class="col-sm-12" style="padding-left:0px">
                    <h5>Branche vieillesse : <span style="color:#1ab394"><%= @employeur.try(:solde_ve) %>  </span></h5>

                    <h5>Branche AT : <span style="color:#1ab394"><%= @employeur.try(:solde_at) %>  </span> </h5>

                    <h5>Branche PF : <span style="color:#1ab394"><%= @employeur.try(:solde_pf) %>  </span></h5>

                    <h5>Solde total : <span style="color:#1ab394"><%= @employeur.try(:solde_total) %>  </span></h5>
                  </div>
                </d1>
            </div>
            <div class="col-lg-6">
              <h3 class="text-success"><strong>Agences de gestion</strong></h3>
                <d1 class="row mb-0">
                  <div class="col-sm-12" style="padding-left:0px;">
                    <h5>IPRES : <span style="color:#1ab394"><%= @employeur.try(:ancien_num_ipres) %>  </span></h5>
                    <h5>CSS : <span style="color:#1ab394"><%= @employeur.try(:ancien_num_css) %>  </span></h5>
                  </div>
                </d1>
            </div>
          </div>
        </div>
      </div>    
    </div>

    <div class="col-md-5">
      <div class="ibox">
        <div class="ibox-content">
          <div class="row" style="padding:20px">
            <h2>Mes notifications</h2>
            <table class="table table-mail small m-b-xs" style="margin-top:40px">
                  <tbody>
                    <tr class="unread">
                      <td class="check-mail">
                        <div class="icheckbox_square-green" style="position: relative;"><input type="checkbox" class="i-checks" style="position: absolute; opacity: 0;"><ins class="iCheck-helper" style="position: absolute; top: 0%; left: 0%; display: block; width: 100%; height: 100%; margin: 0px; padding: 0px; background: rgb(255, 255, 255) none repeat scroll 0% 0%; border: 0px none; opacity: 0;"></ins></div>
                      </td>
                      <td class="mail-ontact"><a href="mail_detail.html">Immatriculation</a></td>
                      <td class="mail-subject"><span href="mail_detail.html"><%= " #{@message_content} - #{@pourcentage}%" %></span></td>
                      <td class=""></td>
                      <td class="text-right mail-date"></td>
                    </tr>
                    <tr class="unread">
                      <td class="check-mail">
                        <div class="icheckbox_square-green checked" style="position: relative;"><input type="checkbox" class="i-checks" checked="" style="position: absolute; opacity: 0;"><ins class="iCheck-helper" style="position: absolute; top: 0%; left: 0%; display: block; width: 100%; height: 100%; margin: 0px; padding: 0px; background: rgb(255, 255, 255) none repeat scroll 0% 0%; border: 0px none; opacity: 0;"></ins></div>
                      </td>
                      <td class="mail-ontact"><a href="mail_detail.html">Moratoire</a></td>
                      <td class="mail-subject"><a href="mail_detail.html"></a></td>
                      <td class=""></td>
                      <td class="text-right mail-date"></td>
                    </tr>
                    <tr class="unread">
                      <td class="check-mail">
                        <div class="icheckbox_square-green checked" style="position: relative;"><input type="checkbox" class="i-checks" checked="" style="position: absolute; opacity: 0;"><ins class="iCheck-helper" style="position: absolute; top: 0%; left: 0%; display: block; width: 100%; height: 100%; margin: 0px; padding: 0px; background: rgb(255, 255, 255) none repeat scroll 0% 0%; border: 0px none; opacity: 0;"></ins></div>
                      </td>
                      <td class="mail-ontact"><a href="mail_detail.html">Paiement</a></td>
                      <td class="mail-subject"><a href="mail_detail.html"></a></td>
                      <td class=""></td>
                      <td class="text-right mail-date"></td>
                    </tr>
                    <tr class="read">
                      <td class="check-mail">
                        <div class="icheckbox_square-green" style="position: relative;"><input type="checkbox" class="i-checks" style="position: absolute; opacity: 0;"><ins class="iCheck-helper" style="position: absolute; top: 0%; left: 0%; display: block; width: 100%; height: 100%; margin: 0px; padding: 0px; background: rgb(255, 255, 255) none repeat scroll 0% 0%; border: 0px none; opacity: 0;"></ins></div>
                      </td>
                      <td class="mail-ontact"><a href="mail_detail.html">Attestation</a> <span class="label label-warning float-right">Document</span> </td>
                      <td class="mail-subject"><a href="mail_detail.html"></a></td>
                      <td class=""></td>
                      <td class="text-right mail-date"></td>
                    </tr>

                  </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div> <!-- end row -->



