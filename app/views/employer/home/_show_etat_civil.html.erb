<div class="row">
  <div class="col-lg-4">

    <h2 style="color: #1ab394">Identification</h2>
    <p>
      <strong>Numéro unique de sécurité sociale:</strong>
      <%=  @employeur.fhnum %>
    </p>

    <p>
      <strong>Ancien numéro IPRES :</strong>
      <%= @employeur.ancien_num_ipres %>
    </p>

    <p>
      <strong>Ancien numéro CSS:</strong>
      <%= @employeur.ancien_num_css %>
    </p>

    <p>
      <strong>Ninéa :</strong>
      <%= @immatriculation.ninea %>
    </p>
    <p>
      <strong>Ninet:</strong>
      <%= @immatriculation.ninet %>
    </p>

    <p>
      <strong>COFI:</strong>
      <%= @immatriculation.ninea %>
    </p>

    <p>
      <strong>Registre de commerce:</strong>
      <%= @immatriculation.code_identification_fiscale %>
    </p>


  </div>

  <div class="col-lg-4">

    <h2 style="color: #1ab394">Catégorie d’entreprise</h2>
    <p>
      <strong>Type d’établissement:</strong>
      <%= ImmatriculationSocietePrive.human_enum_name(:type_etablissement, @immatriculation.type_etablissement) %>
    </p>

    <p>
      <strong>Statut juridique:</strong>
      <%= ImmatriculationSocietePrive.human_enum_name(:statut_juridique, @immatriculation.statut_juridique) %>
    </p>

    <p>
      <strong>Activité principale:</strong>
      <%= @immatriculation.activite_principale %>
    </p>

    <p>
      <strong>Secteur d’activité  :</strong>
      <%= @immatriculation.secteur_activite %>
    </p>

  </div>

  <div class="col-lg-4">

    <h2 style="color: #1ab394">Adresse - Siège social</h2>
    <p>
      <strong>Région:</strong>
      <%= @region.designation %>
    </p>

    <p>
      <strong>Ville:</strong>
      <%= @ville.designation %>
    </p>

    <p>
      <strong>Commune:</strong>
      <%= @commune.designation%>
    </p>

    <p>
      <strong>Quartier  :</strong>
      <%= @quartier.designation %>
    </p>

    <p>
      <strong>Adresse  :</strong>
      <%= @immatriculation.adresse %>
    </p>

    <p>
      <strong>Pays  :</strong>
      <%= @immatriculation.secteur_activite %>
    </p>

    <p>
      <strong>Boite postale  :</strong>
      <%= @immatriculation.secteur_activite %>
    </p>

    <p>
      <strong>Email  :</strong>
      <%= @immatriculation.email_employeur %>
    </p>

    <p>
      <strong>Telephone  :</strong>
      <%= @immatriculation.telephone_employeur %>
    </p>



  </div>

</div>
