<div class="row">
  <% @immatriculation.document_immatriculations.each do |document_immatriculation| %>
    <div class="col-lg-4">
      <div class="contact-box" style="min-height: 180px">
        <a href="<%= url_for(document_immatriculation.document) %>" target="_blank">
          <div class="col-sm-4">
            <div class="text-center">
              <%= %>
            </div>
          </div>
          <div class="col-sm-8">
            <h3><strong><%= DocumentImmatriculation.human_enum_name(:type_document, document_immatriculation.type_document) %></strong></h3>
            <p>
              <strong>Commentaires :</strong><br>
              <%= document_immatriculation.commentaire %>
            </p>
          </div>
          <div class="clearfix"></div>
        </a>
      </div>
    </div>
  <% end %>
</div>