<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">Nom</th>
    <th scope="col">Prénom</th>
    <th scope="col">Date de naissance</th>
    <th scope="col">type piece</th>
    <th scope="col">NIN</th>
  </tr>
  </thead>

  <tbody>
  <% @salaries.each do |salarie| %>
    <tr>
      <td><%= salarie.nom %></td>
      <td><%= salarie.prenom %></td>
      <td><%= salarie.date_naissance %></td>
      <td><%= SalarieImmatriculation.human_enum_name(:type_piece, salarie.type_piece) %></td>
      <td><%= salarie.numero_piece %></td>
    </tr>
  <% end %>
  </tbody>
</table>
<%= paginate @salaries %>