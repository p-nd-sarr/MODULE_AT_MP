<script type="text/javascript">

    $(document).ready(function(){

        $('#salarie_immatriculation_region').change(function(){

            console.log('change region');
            var e = document.getElementById("salarie_immatriculation_region");

            //var strOption = e.options[e.selectedIndex].text;
            var regionRepresentant = e.options[e.selectedIndex].value;

            $.ajax({
                type: "GET",
                url: "/employer/immatriculation_associations/1/load_adresse?region="+regionRepresentant,
                data: null,
                success: function(data, textStatus, jqXHR){
                    // alert('ok');
                    console.log(data);

                    $('#salarie_immatriculation_departement')
                        .empty()
                        .append(data)
                        .prepend("<option value='' selected='selected'></option>");

                },
                error: function(jqXHR, textStatus, errorThrown){
                    // alert('error');
                    console.log('error');
                }
            });

        });

        $('#salarie_immatriculation_departement').change(function(){


            console.log('change departement');

