<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="ibox-content">
        <%= bootstrap_form_for(@declaration, url: employer_declarations_path(@declaration), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
        <%= f.alert_message "Please fix the errors below." %>

        <%= f.number_field :effectif, label: 'Total des salariés' %>

        <%= f.number_field :montant_pf, label: 'Total de cotisation PF' %>
        <%= f.number_field :montant_at, label: 'Total de cotisation AT/MP' %>
        <%= f.number_field :montant_rg, label: 'Total de cotisation RG' %>
        <%= f.number_field :montant_rcc, label: 'Total de cotisation RCC' %>

        <hr>
        <%= f.number_field :montant_total, label: 'Total de cotisation' %>

        <div class="hr-line-dashed"></div>

        <div class="form-group row">
          <div class="col-sm-4 col-sm-offset-4">
            <%= link_to 'Annuler', admin_users_path, class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>