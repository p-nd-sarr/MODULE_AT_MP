<% unless @declaration.synthese_valide? %>
  <div class="row">
    <div class="col-lg-4">
      <div class="form-group row">
        <div class="col-sm-12">
          <%= link_to "Je valide les informations sur la synthèse", employer_declaration_valider_synthese_path(@declaration), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-w-m btn-primary', id: 'valider_synthese' %>
        </div>
      </div>
    </div>
  </div>

<% end %>
<div class="row">
  <div class="col-sm-12">

    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Période</th>
        <th scope="col">Effectif</th>
        <th scope="col">Montant AT</th>
        <th scope="col">Montant PF</th>
        <th scope="col">Montant RG</th>
        <th scope="col">Montant RCC</th>
        <th scope="col">Montant total</th>
        <th scope="col">Montant détail</th>
      </tr>
      </thead>

      <tbody>
        <tr>
          <td><%= I18n.l(@declaration.periode , format: :periode) %></td>
          <td><%= @declaration.effectif %></td>
          <td><%= @declaration.montant_at %></td>
          <td><%= @declaration.montant_pf %></td>
          <td><%= @declaration.montant_rg %></td>
          <td><%= @declaration.montant_rcc %></td>
          <td><%= @declaration.montant_total %></td>
          <td></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>