<div class="modal inmodal" id="soumettre" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <%= bootstrap_form_for(@declaration, url: employer_missing_declaration_soumettre_path(@declaration), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
      <div class="modal-content animated bounceInRight">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
          <i class="fa fa-laptop modal-icon"></i>
          <h4 class="modal-title">Soumission Demande déclaration </h4>
          <small class="font-bold">Saisir un commentaire</small>
        </div>
        <div class="modal-body">
          <%= f.text_area :commentaire, label: 'Commentaire' %>

          <%= f.file_field :document, label: '&nbsp;'.html_safe %>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
          <button type="submit" class="btn btn-primary">Soumettre</button>

        </div>
      </div>
    <% end %>
  </div>
</div>



<script type="text/javascript">
    $(document).ready(function () {
        showMotifSortie();
        var input = document.getElementById('label_file');
        var infoArea = document.getElementById('file_name');
        input.addEventListener('change', showFileName);

        $('#missing_ligne_declaration_date_sortie_3i , #missing_ligne_declaration_date_sortie_2i').change(
            function () {
                showMotifSortie();
            }
        )

        function showFileName(event) {
            var input = event.srcElement;
            var fileName = input.files[0].name;
            infoArea.textContent = fileName;
        }

        function showMotifSortie() {
            if ($('#missing_ligne_declaration_date_sortie_3i').val() != 31 || $('#missing_ligne_declaration_date_sortie_2i').val() != 12) {
                $('#motif_sortie').show();
            } else $('#motif_sortie').hide();
        }
    })
</script>


<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {

          <% @ligne_declarations.each do |ligne_declaration| %>

          $('#ligne_declaration_<%=ligne_declaration.id %>').hide();
          $('#details_ligne_<%=ligne_declaration.id %>').hide();

          <% end %>

          $("a").click(function () {
              $('#' + this.id.replace("button_", "")).show();
          });
      })
  </script>
<% end %>