<%= content_for :titre_page, "Mes Effectifs" %>

<%= content_for :actions_page do %>
  <%#= link_to 'Ajouter', new_employer_effectif_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">

    <div class="col-lg-4">
      <div class="ibox volet1">
        <div class="ibox-title text-success">
          <h3>Total effectif</h3>
        </div>
        <div class="ibox-content">
          <h1 class="no-margins"><%= @total_effectif.size %></h1>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="ibox volet2">
        <div class="ibox-title text-success">
          <h3>Total Départ <span class="label label-warning" style="float:right"><%= @effectifs.size==0 ? 0 : @effectifs_retrait.size * 100 / @effectifs.size %>%</span></h3>
        </div>
        <div class="ibox-content">
          <h1 class="no-margins"><%=  @effectifs_retrait.size %></h1>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="ibox volet3">
        <div class="ibox-title text-success">
          <h3>Total actif <span class="label label-primary" style="float:right"><%= @effectifs.size==0 ? 0 : @effectifs_actif.size * 100 / @effectifs.size %>%</span></h3>
        </div>
        <div class="ibox-content">
          <h1 class="no-margins"><%=  @effectifs_actif.size %></h1>
        </div>
      </div>
    </div>

  </div>
</div>

