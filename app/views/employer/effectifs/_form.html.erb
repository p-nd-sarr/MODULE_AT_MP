<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="ibox-content">
        <%= bootstrap_form_for(@salarie, url: employer_effectifs_path(@salarie), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
        <%= f.alert_message "Please fix the errors below." %>

        <%= f.text_field :nom, label: 'Nom', required: true %>
        <%= f.text_field :prenom, label: 'Prénom' %>
        <%= f.text_field :prenom, label: 'Matricule' %>
        <%= f.select :type_piece,
                     SalarieImmatriculation::TYPE_PIECE.keys.collect { |type_piece| [SalarieImmatriculation.human_enum_name(:type_piece, type_piece), type_piece] }, label: 'Type de pièce' %>
        <%= f.text_field :numero_piece, label: 'Numéro de pièce' %>

        <div class="hr-line-dashed"></div>

        <div class="form-group row">
          <div class="col-sm-8 col-sm-offset-4" style="text-align:right">
            <%= link_to 'Annuler', admin_users_path, class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>