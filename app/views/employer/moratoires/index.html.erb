      <div class="col-lg-3"></div>
      
    </div>


    <h2>Historique moratoires</h2>

    <table class="table table-striped">

      <tbody>

      <tr>
        <td>Montant total</td>
        <td>Nombre échéance</td>
        <td>Date debut</td>
        <td>Date fin</td>
        <td>Premier échéance</td>
        <td>Dernier échéance</td>
        <td>Statut</td>
      </tr>
      <% @moratoires.each do |moratoire| %>
      <tr>
        <td><strong><%= moratoire.montant == nil ? 0 : moratoire.montant.round(-1) %></strong></td>
        <td><%= moratoire.nombre_echeance %></td>
        <td><%= moratoire.date_debut %></td>
        <td><%= moratoire.date_fin %></td>
        <td><strong><%= moratoire.premier_montant == nil ? 0 :  moratoire.premier_montant.round(-1) %></strong></td>
        <td><strong><%#= moratoire.dernier_montant == nil ? 0 :  moratoire.dernier_montant.round(-1) %></strong></td>
        <td><a href="#"><i class="fa fa-check text-navy"></i></a></td>
      </tr>
        <% end %>
      </tbody>
    </table>
    <%= paginate @moratoires %>
</div>

<% end %>