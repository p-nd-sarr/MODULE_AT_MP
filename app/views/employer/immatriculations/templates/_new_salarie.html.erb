<script type="text/javascript">

    $(document).ready(function () {

        $('#salarie_immatriculation_region').change(function () {

            console.log('change region');
            var e = document.getElementById("salarie_immatriculation_region");

            //var strOption = e.options[e.selectedIndex].text;
            var regionRepresentant = e.options[e.selectedIndex].value;

            $.ajax({
                type: "GET",
                url: "/employer/immatriculations/1/load_adresse?region=" + regionRepresentant,
                data: null,
                success: function (data, textStatus, jqXHR) {
                    // alert('ok');
                    console.log(data);

                    $('#salarie_immatriculation_departement')
                        .empty()
                        .append(data)
                        .prepend("<option value='' selected='selected'></option>");

                },
                error: function (jqXHR, textStatus, errorThrown) {
                    // alert('error');
                    console.log('error');
                }
            });

        });

        $('#salarie_immatriculation_departement').change(function () {


            console.log('change departement');

            var e = document.getElementById("salarie_immatriculation_departement");
            var departementRepresentant = e.options[e.selectedIndex].value;

            $.ajax({
                type: "GET",
                url: "/employer/immatriculations/1/load_adresse?departement=" + departementRepresentant,
                data: null,
                success: function (data, textStatus, jqXHR) {
                    // alert('ok');
                    console.log(data);

                    $('#salarie_immatriculation_arondissement')
                        .empty()
                        .append(data)
                        .prepend("<option value='' selected='selected'></option>");

                },
                error: function (jqXHR, textStatus, errorThrown) {
                    // alert('error');
                    console.log('error');
                }
            });

        });

        $('#salarie_immatriculation_arondissement').change(function () {

            console.log('change ville');


            var e = document.getElementById("salarie_immatriculation_arondissement");
            var villeRepresentant = e.options[e.selectedIndex].value;

            $.ajax({
                type: "GET",
                url: "/employer/immatriculations/1/load_adresse?ville=" + villeRepresentant,
                data: null,
                success: function (data, textStatus, jqXHR) {
                    // alert('ok');
                    console.log(data);

                    $('#salarie_immatriculation_commune')
                        .empty()
                        .append(data)
                        .prepend("<option value='' selected='selected'></option>");

                },
                error: function (jqXHR, textStatus, errorThrown) {
                    // alert('error');
                    console.log('error');
                }
            });

        });

        $('#salarie_immatriculation_commune').change(function () {

            console.log('change commune');

            var e = document.getElementById("salarie_immatriculation_commune");
            var communeRepresentant = e.options[e.selectedIndex].value;

            $.ajax({
                type: "GET",
                url: "/employer/immatriculations/1/load_adresse?commune=" + communeRepresentant,
                data: null,
                success: function (data, textStatus, jqXHR) {
                    // alert('ok');
                    console.log(data);

                    $('#salarie_immatriculation_quartier')
                        .empty()
                        .append(data)
                        .prepend("<option value='' selected='selected'></option>");

                },
                error: function (jqXHR, textStatus, errorThrown) {
                    // alert('error');
                    console.log('error');
                }
            });

        });


    });

</script>

