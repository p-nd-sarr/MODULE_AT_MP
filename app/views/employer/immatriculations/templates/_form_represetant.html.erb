<div class="row" id="update_representant" style="margin-top:20px" >
  <%= bootstrap_form_for([:employer, @representant], label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
    <div class="col-lg-10 col-lg-offset-1">
      <div class="panel-group" id="accordion1">
        <div class="panel panel-primary" style="padding: 10px">
          <div class="panel-heading">
            <h5 class="panel-title">
              <a data-toggle="collapse" data-parent="#accordion1" href="#etatCivil">
                <span class="fa fa-user"></span> Etat civil
                <div class="ibox-tools">
                  <i class="fa fa-chevron-up"style="color: #fff"></i>
                </div>
              </a>
            </h5>
          </div>
          <div class="panel-collapse collapse in" id="etatCivil" style="padding-top: 20px">
            <div class="full-height-scroll row" style="padding:20px">

              <div class="col-lg-6">
                <%= f.text_field :last_name , label: 'Nom', required: true  %>
              </div>
              <div class="col-lg-6">
                <%= f.text_field :first_name, label: 'Prénom', required: true %>
              </div>
              <div class="col-lg-6">
                <%= f.date_select :birthdate, label: "Date de naissance",
                                  start_year: (Date.today - 100.year).year, end_year: Date.today.year , required: true %>
              </div>
              <div class="col-lg-6">
                <%= f.collection_select :place_of_birth, @pays ,:id,:description, include_blank: true, label: 'Lieu de naissance', tag: 'Naissance', required: true  %>
              </div>
              <div class="col-lg-6">
                <%= f.collection_select :nationality, @pays ,:id,:description, include_blank: true, label: 'Nationalité', tag: 'Nationalite', required: true  %>
              </div>

            </div>
          </div>
        </div> <!-- end panel primary -->

        <div class="panel panel-primary" style="padding: 10px">
          <div class="panel-heading">
            <h5 class="panel-title">
              <a data-toggle="collapse" data-parent="#accordion1" href="#piece">
                <span class="fa fa-id-badge"></span> Pièce d'identité
                <div class="ibox-tools">
                  <i class="fa fa-chevron-up"style="color: #fff"></i>
                </div>
              </a>
            </h5>
          </div>
          <div class="panel-collapse collapse" id="piece" style="padding-top: 20px">
            <div class="full-height-scroll row" style="padding:20px">

              <div class="col-lg-6">
                <%= f.select :type_of_identity,
                       RepresentantLegal::TYPE_PIECE.keys.collect { |type_of_identity| [RepresentantLegal.human_enum_name(:type_of_identity, type_of_identity), type_of_identity] }, label: 'Type de piece' %>
              </div>
              <div class="col-lg-6">
                <%= f.text_field :identity_number, label: 'Numéro de piece', required: true  %>
              </div>
              <div class="col-lg-6">
                <%= f.date_select :issued_date, label: "Date de délivrance",
                                start_year: (Date.today - 100.year).year, end_year: Date.today.year , required: true %>
              </div>
              <div class="col-lg-6">
                <%= f.date_select :expiry_date, label: "Date d'expiration",
                                start_year: Date.today.year, end_year: Time.now.year + 18 , required: true %>
              </div>

            </div>
          </div>
        </div> <!-- end panel primary -->
        <div class="panel panel-primary" style="padding: 10px">
          <div class="panel-heading">
            <h5 class="panel-title">
              <a data-toggle="collapse" data-parent="#accordion1" href="#adresse">
                <span class="fa fa-address-card"></span> Adresse personnelle du représentant
                <div class="ibox-tools">
                  <i class="fa fa-chevron-up"style="color: #fff"></i>
                </div>
              </a>
            </h5>
          </div>
          <div class="panel-collapse collapse" id="adresse" style="padding-top: 20px">
            <div class="full-height-scroll row" style="padding:20px">

              <div class="col-lg-6">
                <%= f.collection_select :region, @regions,:id,:designation, include_blank: true, label: 'Région', tag: 'region', required: true   %>
              </div>
              <div class="col-lg-6">
                <%= f.collection_select :departement, @departements,:id,:designation, label: 'Département' , required: true, id: 'immatriculation_departement' %>
              </div>
              <div class="col-lg-6">
                <%= f.collection_select :ville, @villes,:id,:designation, label: 'Arrondissement', required: true, id: 'immatriculation_ville'  %>
              </div>
              <div class="col-lg-6">
                <%= f.collection_select :commune, @communes,:id,:designation, label: 'Commune', required: true, id: 'immatriculation_commune'  %>
              </div>
              <div class="col-lg-6">
                <%= f.collection_select :quartier, @quartiers,:id,:designation, label: 'Quartier', required: true, id: 'immatriculation_quartier'  %>
              </div>
              <div class="col-lg-6">
                <%= f.text_field :address, label: 'Adresse', required: true  %>
              </div>
              <div class="col-lg-6">
                <%= f.text_field :mobile_number, label: 'Téléphone' %>
              </div>
              <div class="col-lg-6">
                <%= f.text_field :email, label: 'Email' %>
              </div>
            </div>
          </div>
        </div> <!-- end panel primary -->

      </div> <!-- end panel group -->
    </div> <!-- end col-lg-10 -->





