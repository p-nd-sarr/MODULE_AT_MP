<li class="<%= 'active' if is_active_controller('admin/salaries') %>">
  <a href="#"><i class="fa fa-users"></i> <span class="nav-label">Salariés</span><span class="fa arrow"></span></a>
  <ul class="nav nav-second-level <%= is_active_controller('admin/salaries') %>">
    <li class="<%= 'active' if is_active_controller('admin/salaries') %>">
      <%= link_to 'Liste', admin_salaries_path %>
    </li>
  </ul>
</li>

<li class="<%= 'active' if is_active_controller('admin/employeurs') %>">
  <a href="#"><i class="fa fa-users"></i> <span class="nav-label">Employeurs</span><span class="fa arrow"></span></a>
  <ul class="nav nav-second-level <%= is_active_controller('admin/employeurs') %>">
    <li class="<%= 'active' if is_active_controller('admin/employeurs') %>">
      <%= link_to 'Liste des employeurs', admin_employeurs_path %>
    </li>
  </ul>
</li>
<!-- Menu Arrêt de travail -->
<li class="<%= 'active' if is_active_controller('admin/arret_travails') && @est_mp == false %>">
  <a href="#"><i class="fa fa-users"></i>
    <span class="nav-label">Accident travail</span><span class="fa arrow"></span></a>
  <ul class="nav nav-second-level <%= is_active_controller('admin/arret_travails') %>">
    <li class="<%= 'active' if is_active_controller('admin/arret_travails') and is_active_action('index') %>">
      <%= link_to 'Toutes les demandes at', admin_arret_travails_path(est_mp: false ) %>
    </li>
    <li class="<%= 'active' if is_active_controller('admin/arret_travails') and is_active_action('new') %>">
      <%= link_to 'Ajouter dossier at', new_admin_arret_travail_path(est_mp: false ) %>
    </li>
  </ul>
</li>

<!-- Menu Maladies Professionnelles -->
<li class="<%= 'active' if is_active_controller('admin/arret_travails') && @est_mp == true %>">
  <a href="#"><i class="fa fa-users"></i>
    <span class="nav-label">Maladies professionnelles</span><span class="fa arrow"></span></a>
  <ul class="nav nav-second-level <%= is_active_controller('admin/arret_travails') %>">
    <li class="<%= 'active' if is_active_controller('admin/arret_travails') and is_active_action('index') %>">
      <%= link_to 'Toutes les demandes  MP', admin_arret_travails_path(est_mp: true ) %>
    </li>
    <li class="<%= 'active' if is_active_controller('admin/arret_travails') and is_active_action('new') %>">
      <%= link_to 'Ajouter dossier MP', new_admin_arret_travail_path(est_mp: true ) %>
    </li>
  </ul>
</li>

<li class="<%= 'active' if is_active_controller('admin/conjoints') or
    is_active_controller('admin/enfants') %>">
  <a href="#"><i class="fa fa-users"></i> <span class="nav-label">Grappe familiale</span><span class="fa arrow"></span></a>
  <ul class="nav nav-second-level <%= is_active_controller('admin/conjoints') %>">
    <li class="<%= 'active' if is_active_controller('admin/conjoints') %>"><%= link_to 'Conjoints', admin_conjoints_path %></li>
  </ul>
  <ul class="nav nav-second-level <%= is_active_controller('admin/enfants') %>">
    <li class="<%= 'active' if is_active_controller('admin/enfants') %>"><%= link_to 'Enfants', admin_enfants_path %></li>
  </ul>
</li>
