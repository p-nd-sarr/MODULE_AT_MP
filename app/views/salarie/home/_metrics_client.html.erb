<div class="wrapper wrapper-content">
  <div class="row">
    
      <div class="col-lg-3">
          <div class="ibox option_menu" style="box-shadow: 2px 2px 4px #1ab394;">
            <div class="ibox-title">
              <h5>PERIODE D'ACTIVITE</h5>
            </div>
            <div class="ibox-content">
               <br>
              <div class="stat-percent text-success font-bold">
                <i class="fa fa-bolt"></i>
              </div>
               <h1 class="no-margins"><%= @annee_debut %> - <%= @annee_fin %></h1>
              <div style="text-align:center">
                <%= link_to ' Voir carrieres', salarie_carrieres_path, class: 'btn btn-primary btn-xs fa fa-eye', style: 'margin-top:15px;' %>
              </div>
            </div>
          </div>
      </div>
      <div class="col-lg-3">
          <div class="ibox option_menu" style="box-shadow: 2px 2px 4px #1ab394;">
            <div class="ibox-title">
              <h5>TOTAL POINTS</h5>
            </div>
            <div class="ibox-content">
               <br>
              <div class="stat-percent text-success font-bold">
                <i class="fa fa-bolt"></i>
              </div>
              <h1 class="no-margins">
                <%= format_cfa @total_points, false %>
              </h1>
                <div style="text-align:center">
                <%= link_to ' Voir carrieres', salarie_carrieres_path, class: 'btn btn-primary btn-xs fa fa-eye', style: 'margin-top:15px;' %>
              </div>
            </div>
          </div>
      </div>

      <div class="col-lg-3">
       
          <div class="ibox option_menu" style="box-shadow: 2px 2px 4px #1ab394;">
            <div class="ibox-title">
              <h5>Enfants</h5>
            </div>
            <div class="ibox-content">
              <h1 class="no-margins"><%= @salarie.enfants.count %></h1>
              <div class="stat-percent text-success font-bold">
                <%#= @total_demande.zero? ? 0 : LiquidationRetraite.count * 100 / @total_demande %>%
                <i class="fa fa-bolt"></i>
              </div>
              <small>Nombre d'enfants</small>
              <div style="text-align:center">
                <%= link_to ' Voir les enfants', salarie_enfants_path, class: 'btn btn-primary btn-xs fa fa-eye', style: 'margin-top:15px;' %>
              </div>
            </div>
          </div>
      
      </div>

      <div class="col-lg-3">
       
          <div class="ibox option_menu" style="box-shadow: 2px 2px 4px #1ab394;">
            <div class="ibox-title">
              <h5>Conjoints</h5>
            </div>
            <div class="ibox-content">
               <h1 class="no-margins">
                <%= @salarie.conjoints.count %>
              </h1>
              <div class="stat-percent text-success font-bold">
                <%#= @total_demande.zero? ? 0 : LiquidationRetraite.count * 100 / @total_demande %>%
                <i class="fa fa-bolt"></i>
              </div>
              <small>Nombre de conjoints</small>
              <div style="text-align:center">
                <%= link_to ' Voir les enfants', salarie_conjoints_path, class: 'btn btn-primary btn-xs fa fa-eye', style: 'margin-top:15px;' %>
              </div>
            </div>
          </div>
      
      </div>
  </div>
</div>
