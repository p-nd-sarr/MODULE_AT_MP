<%= content_for :titre_page, "Détails Participant. Numéro Salarié : #{@salarie.numero_salarie}" %>

<%= content_for :titre_page_autres_details do %>
  Numéro Salarié : <%= @salarie.numero_salarie %> <br>
  Ancien Numéro IPRES : <%#= @salarie.ipres_ancien_matric %> <br>
  Ancien Numéro CSS : <%#= @salarie.css_ancien_matric %> <br>
<% end %>




<div class="row">
  <div class="col-lg-12">
    <div class="ibox float-e-margins">
      <div class="ibox-content">
        <div class="wrapper wrapper-content" >
          <div>
           
            <div class="tab-content">

                <div id="tab-1" class="tab-pane active">
                  <div class="full-height-scroll">
                    <br>
                      <div class="row">
  <%#= @salarie.inspect%>
<div class="col-lg-6">
    <d1 class="row mb-0">
    <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-user"></span> Prénom & nom:</dt>
    </div>
    <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
        <dd class="mb-1"><%= @salarie.full_name %></dd>
    </div>
    </d1>

    <d1 class="row mb-0">
        <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-calendar"></span> Date de naisance:</dt>
        </div>
        <div class="col-sm-6 text-sm-left" style="text-align: left;">
            <dd class="mb-1"><%= @salarie.date_naissance %></dd>
        </div>
    </d1>

      <d1 class="row mb-0">
        <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-calendar"></span> Type de piéce:</dt>
        </div>
        <div class="col-sm-6 text-sm-left" style="text-align: left;">
            <dd class="mb-1"><%#= @salarie.type_piece %></dd>
        </div>
    </d1>

    <d1 class="row mb-0">
        <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-calendar"></span> Numéro piéce:</dt>
        </div>
        <div class="col-sm-6 text-sm-left" style="text-align: left;">
            <dd class="mb-1"><%#= @salarie.numero_piece %></dd>
        </div>
    </d1>
    <d1 class="row mb-0">
        <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-calendar"></span> Adresse:</dt>
        </div>
        <div class="col-sm-6 text-sm-left" style="text-align: left;">
            <dd class="mb-1"><%= @salarie.adresse %></dd>
        </div>
    </d1>
</div>
<div class="col-lg-6">

    <d1 class="row mb-0">
    <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-calendar"></span> Téléphone:</dt>
    </div>
    <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%#= @salarie.phone %></dd>
    </div>
    </d1>

    <d1 class="row mb-0">
    <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-list"></span> Profession:</dt>
    </div>
    <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%#= @salarie.profession %></dd>
    </div>
    </d1>

    <d1 class="row mb-0">
    <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-list"></span> Genre:</dt>
    </div>
    <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%#= @salarie.genre %></dd>
    </div>
    </d1>

    <d1 class="row mb-0">
    <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-calendar"></span> Regime:</dt>
    </div>
    <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%#= @salarie.regime %></dd>
    </div>
    </d1>

    <d1 class="row mb-0">
    <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-calendar"></span> Emploi:</dt>
    </div>
    <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%#= @salarie.emploi %></dd>
    </div>
    </d1>
</div>
</div>
                  </div>
                </div>

                <div id="tab-2" class="tab-pane">
                  <div class="full-height-scroll">
                    <br>
                   <%#= render 'show_carrieres' %>
                  </div>
                </div>


                <div id="tab-3" class="tab-pane">
                  <div class="full-height-scroll">
                    <br>
                      <div class="row">
                        <div class="col-lg-12" style="margin-top: 30px">
                          <div class="panel-body">
                            <div class="panel-group" id="accordion">
                              <div class="panel panel-default" style="padding: 10px">
                                <div class="panel-heading">
                                  <h5 class="panel-title">
                                    <a data-toggle="collapse" data-parent="#accordion" href="#conjoint">
                                      <span class="fa fa-users"></span> Conjoint
                                    </a>
                                  </h5>
                                </div>
                                <div class="panel-collapse collapse" id="conjoint" style="padding-top: 20px">
                                  <div class="full-height-scroll">
                                    <br>
                                
                                    <%#= render 'show_conjoints' %>
              
                                  </div>
                                </div>
                              </div> <!-- End panel default conjoint -->

                              <div class="panel panel-default" style="padding: 10px">
                                <div class="panel-heading">
                                  <h5 class="panel-title">
                                    <a data-toggle="collapse" data-parent="#accordion" href="#enfant">
                                      <span class="fa fa-users"></span> Enfants
                                    </a>
                                  </h5>
                                </div>
                                <div class="panel-collapse collapse" id="enfant" style="padding-top: 20px">
                                  <div class="full-height-scroll">
                                    <br>
                                    <hr>
                                    <%#= render 'show_enfants' %>
                                  </div>
                                </div>
                              </div> <!-- End panel default enfant -->
                            </div>
                          </div>
                        </div> <!-- End col -->
                      </div> <!-- End row -->
                  </div>
                </div>


                <div id="tab-4" class="tab-pane">
                  <div class="full-height-scroll">
                    <br>
                   <%#= render 'show_dossiers_prestations' %>
                  </div>
                </div>

              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>




