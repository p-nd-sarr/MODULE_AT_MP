<div class="row animated fadeInRight">
  <div class="col-lg-12">
    <div class="ibox ">
      <div class="ibox-content" id="ibox-content">
        <div id="vertical-timeline" class="vertical-container dark-timeline">

          <div class="vertical-timeline-block">
            <div class="vertical-timeline-icon red-bg">
              <i class="fa fa-folder"></i>
            </div>
            <div class="vertical-timeline-content">
              <h2>Ouverture et Instruction</h2>
              <hr>
              <div class='row'>
                <div class="col-lg-12">
                  <div class="col-lg-4">
                    <h5><strong class="text-navy">OUVERT
                      PAR:</strong><br> <%= @demande_liquidation.ajoute_par.full_name %></h5>
                    <h5><strong class="text-navy">DATE
                      D'OUVERTURE:</strong><br> <%= @demande_liquidation.created_at.strftime("%d/%m/%Y à %H:%M") %></h5>
                  </div>
                  <div class="col-lg-4" style="border-left:1px solid rgb(210, 210, 210)">
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.ajoute_par.nil? %>">SOUMIS A
                      L'INSTRUCTION PAR LE gestionnaire de compte
                      PAR:</strong><br> <%= @demande_liquidation.ajoute_par.full_name unless @demande_liquidation.ajoute_par.nil? %>
                    </h5>
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.date_soumission.nil? %>">DATE DE
                      SOUMISSION:</strong><br> <%= (@demande_liquidation.date_soumission.strftime("%d/%m/%Y à %H:%M")) unless @demande_liquidation.date_soumission.nil? %>
                    </h5>
                  </div>
                  <div class="col-lg-4" style="border-left:1px solid rgb(210, 210, 210)">
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.instruit_par.nil? %>">INSTRUIT
                      PAR:</strong><br> <%= (@demande_liquidation.instruit_par.full_name) unless @demande_liquidation.instruit_par.nil? %>
                    </h5>
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.instruit_le.nil? %>">DATE
                      D'INSTRUCTION:</strong><br> <%= (@demande_liquidation.instruit_le.strftime("%d/%m/%Y à %H:%M")) unless @demande_liquidation.instruit_le.nil? %>
                    </h5>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="vertical-timeline-block">
            <div class="vertical-timeline-icon blue-bg">
              <i class="fa fa-file-text"></i>
            </div>
            <div class="vertical-timeline-content">
              <h2>Affectation et Traitement du dossier</h2>
              <hr>
              <div class='row'>
                <div class="col-lg-12">
                  <div class="col-lg-4">
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.affecter_salarie.nil? %>">AFFECTE A
                      GESTIONNAIRE
                      COTISATION:</strong><br> <%= @demande_liquidation.affecter_salarie.full_name unless @demande_liquidation.affecter_salarie.nil? %>
                    </h5>
                    <h5><strong>PAR LE CHEF DE SERVICE COTISATION:</strong><br></h5>
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.affectation_salarie_date.nil? %>">DATE
                      D'AFFECTATION:</strong><br> <%= (@demande_liquidation.affectation_salarie_date.strftime("%d/%m/%Y à %H:%M")) unless @demande_liquidation.affectation_salarie_date.nil? %>
                    </h5>
                  </div>
                  <div class="col-lg-4" style="border-left:1px solid rgb(210, 210, 210)">
                    <h5>
                      <strong class="<%= 'text-navy' unless @demande_liquidation.affecter_allocataire.nil? %>">AFFECTE A
                        GESTIONNAIRE
                        ALLOCATION:</strong><br> <%= @demande_liquidation.affecter_allocataire.full_name unless @demande_liquidation.affecter_allocataire.nil? %>
                    </h5>
                    <h5><strong>PAR LE CHEF DE SECTION LIQUIDATION:</strong><br></h5>
                    <h5>
                      <strong class="<%= 'text-navy' unless @demande_liquidation.affectation_allocataire_date.nil? %>">DATE
                        D'AFFECTATION:</strong><br> <%= (@demande_liquidation.affectation_allocataire_date.strftime("%d/%m/%Y à %H:%M")) unless @demande_liquidation.affectation_allocataire_date.nil? %>
                    </h5>
                  </div>
                  <div class="col-lg-4" style="border-left:1px solid rgb(210, 210, 210);">
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.soumission_carriere_par.nil? %>">SOUMISSION
                      VALIDATION CARRIERE
                      PAR:</strong><br><%= @demande_liquidation.soumission_carriere_par.full_name unless @demande_liquidation.soumission_carriere_par.nil? %>
                    </h5>
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.soumission_carriere_par.nil? %>">DATE
                      DE SOUMISSION VALIDATION
                      CARRIERE:</strong><br><%= (@demande_liquidation.date_soumission_carriere.strftime("%d/%m/%Y à %H:%M")) unless @demande_liquidation.date_soumission_carriere.nil? %>
                    </h5>
                  </div>
                </div>
                <div class="col-lg-12">
                  <hr>
                  <div class="col-lg-4">
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.validation_carriere_par.nil? %>">VALIDATION
                      CARRIERE PAR CHEF DE SERVICE
                      COTISATION:</strong><br><%= @demande_liquidation.validation_carriere_par.full_name unless @demande_liquidation.validation_carriere_par.nil? %>
                    </h5>
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.validation_carriere_par.nil? %>">DATE
                      DE VALIDATION
                      CARRIERE:</strong><br> <%= (@demande_liquidation.date_validation_carriere.strftime("%d/%m/%Y à %H:%M")) unless @demande_liquidation.date_validation_carriere.nil? %>
                    </h5>
                  </div>
                  <div class="col-lg-4" style="border-left:1px solid rgb(210, 210, 210)">
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.soumission_validation_par.nil? %>">SOUMISSION
                      VALIDATION FICHE DE LIQUIDATION
                      PAR:</strong><br> <%= @demande_liquidation.soumission_validation_par.full_name unless @demande_liquidation.soumission_validation_par.nil? %>
                    </h5>
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.soumission_validation_par.nil? %>">DATE
                      DE SOUMISSION VALIDATION FICHE DE
                      LIQUIDATION: </strong><br> <%= (@demande_liquidation.date_soumission_validation.strftime("%d/%m/%Y à %H:%M")) unless @demande_liquidation.date_soumission_validation.nil? %>
                    </h5>
                  </div>
                  <div class="col-lg-4" style="border-left:1px solid rgb(210, 210, 210)">
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.validation_liquidation_par.nil? %>">VALIDATION
                      FICHE DE LIQUIDATION PAR CHEF DE SECTION
                      LIQUIDATION:</strong><br><%= @demande_liquidation.validation_liquidation_par.full_name unless @demande_liquidation.validation_liquidation_par.nil? %>
                    </h5>
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.validation_liquidation_par.nil? %>">DATE
                      DE VALIDATION FICHE DE
                      LIQUIDATION: </strong><br> <%= (@demande_liquidation.date_validation_liquidation.strftime("%d/%m/%Y à %H:%M")) unless @demande_liquidation.date_validation_liquidation.nil? %>
                    </h5>
                  </div>
                </div>
                <div class="col-lg-12">
                  <hr>
                  <div class="col-lg-4">
                    <h5>
                      <strong class="<%= 'text-navy' unless @demande_liquidation.valider_par.nil? %>">VALIDATION DOSSIER
                        PAR CHEF DE SERVICE
                        ALLOCATION:</strong><br> <%= @demande_liquidation.valider_par.full_name unless @demande_liquidation.valider_par.nil? %>
                    </h5>
                    <h5><strong class="<%= 'text-navy' unless @demande_liquidation.valider_le.nil? %>">DATE DE
                      VALIDATION: </strong><br> <%= @demande_liquidation.valider_le.strftime("%d/%m/%Y à %H:%M") unless @demande_liquidation.valider_le.nil? %>
                    </h5>
                  </div>
                </div>

                <div class="col-lg-12">
                  <hr>
                  <div class="col-lg-4">
                    <h5>
                      <strong class="<%= 'text-navy' unless @demande_liquidation.valider_par.nil? %>">GENERATION LETTRE
                        DATE:</strong><br> <%= @demande_liquidation.date_generation.strftime("%d/%m/%Y à %H:%M") unless @demande_liquidation.date_generation.nil? %>
                    </h5>
                    
                  </div>
                </div>


                <div class="col-lg-12">
                  <hr>
                  <div class="col-lg-4">
                    <h5>
                      <strong class="<%= 'text-navy' unless @demande_liquidation.update_fullname_par.nil? %>">MODIFICATION NOM & PRENOM</strong>
                      <br> <%= @demande_liquidation.update_fullname_par.full_name unless @demande_liquidation.update_fullname_par.nil? %>
                      <br> LE: <%= @demande_liquidation.update_fullname_date.strftime("%d/%m/%Y à %H:%M") unless @demande_liquidation.update_fullname_date.nil? %>
                      <br> ANCIEN PRENOM et NOM: <%= @demande_liquidation.update_fullname_commentaire unless @demande_liquidation.update_fullname_commentaire.nil? %>
                    </h5>

                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="vertical-timeline-block">
            <div class="vertical-timeline-icon blue-bg">
              <i class="fa fa-file-text"></i>
            </div>
            <div class="vertical-timeline-content">
              <h2>Historique Traitement du dossier</h2>
              <hr>
              <div class='row'>
                
          <table class="table table-bordered table-condensed table-hover">
            <tr>
              <td>User</td>
              <td>Date</td>
              <td>Etat Origine</td>
              <td>Etat Aprés traitement</td>
            </tr>
            <% @demande_liquidation.workflow_histories.order(created_at: :desc).each do |workflow| %>
              <tr>
                <td><%= workflow.user.full_name %></td>
                <td><%= workflow.created_at.strftime("%d/%m/%Y à %H:%M") %></td>
                <td><%= workflow.from %></td>
                <td><%= workflow.to %></td>
              </tr>
            <% end %>
          </table>
              </div>
            </div>
          </div>

          <div class="vertical-timeline-block">
            <div class="vertical-timeline-icon blue-bg">
              <i class="fa fa-file-text"></i>
            </div>
            <div class="vertical-timeline-content">
              <h2>Commentaire sur le dossier</h2>
              <hr>
              <div class='row'>
              <ul>

                <li> <%= "Soumission: #{@demande_liquidation.commentaire_soumission}" unless @demande_liquidation.commentaire_soumission.nil?%></li>
                <li> <%= "Instruction: #{@demande_liquidation.commentaire_instruction}" unless @demande_liquidation.commentaire_instruction.nil?%></li>
                <li> <%= "Affectation fiche Carrière: #{@demande_liquidation.commentaire_affectation_salaire}" unless @demande_liquidation.commentaire_affectation_salaire.nil?%></li>
                <li> <%= "Affectation demande Allocations: #{@demande_liquidation.commentaire_affectation_allocataire}" unless @demande_liquidation.commentaire_affectation_allocataire.nil?%></li>
                <li> <%= "Soumission carrière: #{@demande_liquidation.commentaire_carriere}" unless @demande_liquidation.commentaire_carriere.nil?%></li>
                <li> <%= "Validation carrière: #{@demande_liquidation.commentaire_validation_carriere}" unless @demande_liquidation.commentaire_validation_carriere.nil?%></li>
                <li> <%= "Soumission Tableau Récap:  #{@demande_liquidation.commentaire_tableau}" unless @demande_liquidation.commentaire_tableau.nil?%></li>
                <li> <%= "Validation Tableau récap #{@demande_liquidation.commentaire_validation_tableau}" unless @demande_liquidation.commentaire_validation_tableau.nil?%></li>
                <li> <%= "Validation dossier: #{@demande_liquidation.commentaire_validation}" unless @demande_liquidation.commentaire_validation.nil?%></li>

              </ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
