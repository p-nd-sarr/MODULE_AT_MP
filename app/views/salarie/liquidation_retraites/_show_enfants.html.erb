<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">Nom</th>
    <th scope="col">Prénom</th>
    <th scope="col">Date de naissance</th>
    <th scope="col">Nom mère</th>
    <th scope="col">Prénom mère</th>
    <th scope="col">Nom père</th>
    <th scope="col">Prénom père</th>
  </tr>
  </thead>

  <tbody>
  <% current_user.enfants.valide.each do |enfant| %>
    <tr>
      <td><%= enfant.nom %></td>
      <td><%= enfant.prenom %></td>
      <td><%= l enfant.date_naissance %></td>
      <td><%= enfant.nom_mere %></td>
      <td><%= enfant.prenom_mere %></td>
      <td><%= enfant.nom_pere %></td>
      <td><%= enfant.prenom_pere %></td>
    </tr>
  <% end %>
  </tbody>
</table>