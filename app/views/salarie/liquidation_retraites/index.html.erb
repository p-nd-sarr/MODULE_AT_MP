<%= content_for :titre_page, "Dossier de liquidation retraite" %>
<% if @demande_liquidations.count.zero? %>
  <h2 style="text-align:center; margin-top:50px">
    <hr>
    La liste des dossiers ICM est vide !!!
  </h2>
<% else %>
  <div class="wrapper wrapper-content">
    <div class="ibox-content">
      <table class="table table-bordered table-condensed table-hover">
        <thead>
        <tr>
          <th scope="col">N° dossier</th>
          <th scope="col">Adresse domicile</th>
          <th scope="col">Agence</th>
          <th scope="col">Mode de paiement</th>
          <th scope="col">Etat</th>
          <th colspan="2"></th>
        </tr>
        </thead>

        <tbody>
          <% @demande_liquidations.each do |demande_liquidation| %>
            <tr>
              <td>
                <% if demande_liquidation.num_dossier.nil? %>
                  <%= demande_liquidation.numero_affiliation %>
                <% else %>
                  <%= demande_liquidation.num_dossier %>
                <% end %>
              </td>
              <td><%= demande_liquidation.adresse_reception_allocation %></td>
              <td><%= demande_liquidation.agence_creation.try(:description_prest) %></td>
              <td><%= demande_liquidation.mode_paiement_human %></td>
              <td><%= LiquidationRetraite.workflow_spec.states[demande_liquidation.workflow_state.to_sym].meta[:label] %></td>
              <td style="width: 75px">
                <%= (link_to 'Details', salarie_liquidation_retraite_path(demande_liquidation), class: 'btn btn-outline btn-primary btn-xs') %>
              </td>
              <td>
                <% if demande_liquidation.date_soumission? %>
                  <%= link_to 'Récépissé', admin_liquidation_retraite_show_facture_path(demande_liquidation.id, format: :pdf), class: "btn btn-outline btn-success btn-xs my-2 my-sm-0", target: '_blank' %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
