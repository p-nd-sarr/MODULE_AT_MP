<h4>Nom et Prénom: <%= @demande_liquidation.prenom %> <%= @demande_liquidation.nom %></h4>

<% if @demande_liquidation.current_state >= :cotisation_valide %>
  <h2>TOTAL POINTS RÉGIME GÉNÉRAL
    : <%= format_entier @demande_liquidation.carrieres_prestation.regime_general.sum(:points) %></h2>
  <h2>TOTAL POINTS RÉGIME CADRE
    : <%= format_entier @demande_liquidation.carrieres_prestation.regime_cadre.sum(:points) %></h2>
<% end %>

<h3>Régime Général</h3>
<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">Exercice</th>
    <th scope="col">Employeur</th>
    <th scope="col">Numero</th>
    <th scope="col">Période</th>
    <!--    <th scope="col">Régime</th>-->
    <th scope="col">Salaire 1</th>
    <th scope="col">Salaire 2</th>
    <th scope="col">Salaire Réel</th>
    <th scope="col">Points</th>
    <th scope="col">Motif</th>
    <th scope="col">Etat</th>
    <th scope="col">Est repris?</th>
    <% if @demande_liquidation.affecter_salarie == current_user %>
      <th colspan="3"></th>
    <% end %>
  </tr>
  </thead>

  <tbody>
  <% @demande_liquidation.carrieres_prestation.regime_general.order("date_sortie asc").each do |carriere| %>
    <tr class="<%= 'bg-danger' if carriere.points.zero? %>">
      <td><%= carriere.exercice %></td>
      <td><%= carriere.raison_sociale %></td>
      <td><%= carriere.ref_employeur %></td>
      <td> <%= l carriere.date_entree %> - <%= l carriere.date_sortie %> </td>
      <!--      <td><%#= carriere.type_regime.code %></td>-->
      <td align="right"><%= format_cfa(carriere.salaire1, false) %></td>
      <td align="right"><%= format_cfa(carriere.salaire2, false) %></td>
      <td align="right"><%= format_cfa(carriere.salaire, false) %></td>
      <!--      <td align="right"><%#= carriere.points %></td>-->
      <td align="right"><%= format_entier carriere.points %></td>
      <td align="right"><%=  carriere.try(:motif) %></td>
      <td align="right"><%= carriere.etat %></td>
      <td align="right"><%= state_yes_no carriere.est_repris? %></td>
    </tr>
  <% end %>
  </tbody>
</table>

<h3>Régime Cadre</h3>
<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">Exercice</th>
    <th scope="col">Employeur</th>
    <th scope="col">Numero</th>
    <th scope="col">Période</th>
    <!--    <th scope="col">Régime</th>-->
    <th scope="col">Salaire 1</th>
    <th scope="col">Salaire 2</th>
    <th scope="col">Salaire Réel</th>
    <th scope="col">Points</th>
    <th scope="col">Motif</th>
    <th scope="col">Etat</th>
    <th scope="col">Est repris?</th>
    <% if @demande_liquidation.affecter_salarie == current_user %>
      <th colspan="3"></th>
    <% end %>
  </tr>
  </thead>
  <tbody>
  <% @demande_liquidation.carrieres_prestation.regime_cadre.order("date_sortie asc").each do |carriere| %>
    <tr class="<%= 'bg-danger' if carriere.points.zero? %>">
      <td><%= carriere.exercice %></td>
      <td><%= carriere.raison_sociale %></td>
      <td><%= carriere.ref_employeur %></td>
      <td> <%= l carriere.date_entree %> - <%= l carriere.date_sortie %> </td>
      <!--      <td><%#= carriere.type_regime.code %></td>-->
      <td align="right"><%= format_cfa(carriere.salaire1, false) %></td>
      <td align="right"><%= format_cfa(carriere.salaire2, false) %></td>
      <td align="right"><%= format_cfa(carriere.salaire, false) %></td>
      <!--      <td align="right"><%#= carriere.points %></td>-->
      <td align="right">
        <%= format_entier carriere.points %></td>

      <td align="right">
        <%= carriere.try(:motif) %></td>
      <td align="right"><%= carriere.etat %></td>
      <td align="right"><%= state_yes_no carriere.est_repris? %></td>
    </tr>
  <% end %>
  </tbody>
</table>



<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          chargerInfosEmployeur();


          $('#soumettre_button_id').hide();

          var exercice = $('#carriere_exercice').val();
          var date_entree = $('#carriere_date_entree_1i').val();
          var date_sortie = $('#carriere_date_sortie_1i').val();
          if (exercice === date_entree && exercice === date_sortie) {
              console.log('true');
              $('#soumettre_button_id').show();
          } else {
              $('#soumettre_button_id').hide();
          }


          $('#carriere_ref_employeur').change(function () {
              chargerInfosEmployeur();
          })

          function chargerInfosEmployeur() {
              let ref_employeur = $('#carriere_ref_employeur').val();
              $.ajax({
                  url: "/admin/employeurs/" + ref_employeur + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      if (data) {
                          $("#carriere_raison_sociale").val(data.fhrsoc);
                      } else {
                          $("#carriere_raison_sociale").val('');
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      $("#carriere_raison_sociale").val('');
                      $("#carriere_raison_sociale").val('');
                  }
              });
          }


          $("#carriere_date_entree_1i").change(function () {
              var exercice = $('#carriere_exercice').val();
              var date_entree = $('#carriere_date_entree_1i').val();
              var date_sortie = $('#carriere_date_sortie_1i').val();

              var date_entree_mois = $('#carriere_date_entree_2i').val();
              var date_sortie_mois = $('#carriere_date_sortie_2i').val();

              if (exercice === date_entree && exercice === date_sortie) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

              if (date_sortie_mois > date_entree_mois) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

          });

          $("#carriere_date_sortie_1i").change(function () {
              var exercice = $('#carriere_exercice').val();
              var date_entree = $('#carriere_date_entree_1i').val();
              var date_sortie = $('#carriere_date_sortie_1i').val();

              var date_entree_mois = $('#carriere_date_entree_2i').val();
              var date_sortie_mois = $('#carriere_date_sortie_2i').val();

              if (exercice === date_entree && exercice === date_sortie) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

              if (date_sortie_mois > date_entree_mois) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

          });

          $("#carriere_date_entree_2i").change(function () {
              var date_entree_mois = $('#carriere_date_entree_2i').val();
              var date_sortie_mois = $('#carriere_date_sortie_2i').val();

              if (parseInt(date_sortie_mois) > parseInt(date_entree_mois)) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

          });

          $("#carriere_date_sortie_2i").change(function () {
              var date_entree_mois = $('#carriere_date_entree_2i').val();
              var date_sortie_mois = $('#carriere_date_sortie_2i').val();

              if (parseInt(date_sortie_mois) > parseInt(date_entree_mois)) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

          });


      })
  </script>
<% end %>

