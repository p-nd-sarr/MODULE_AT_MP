<%= content_for :titre_page, "Détails allocation_prenatale" %>

<%= content_for :actions_page do %>
    <%= link_to 'Retour', salarie_dossier_prestation_allocation_prenatales_path(@dossier_prestation), class: 'btn btn-white btn-sm' %>
  <% if @allocation_prenatale.creation? %>
    <%= link_to 'Modifier', edit_salarie_dossier_prestation_allocation_prenatale_path(@dossier_prestation, @allocation_prenatale), class: 'btn btn-white btn-sm' %>
    <%= link_to 'Soumettre', salarie_dossier_prestation_allocation_prenatale_soumission_form_path(@dossier_prestation, @allocation_prenatale), class: 'btn btn-primary btn-sm' %>
  <% end %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="contact-box" style="min-height: 180px">
          <div class="col-sm-4">
            <div class="text-center">
              <a href="<%= url_for(@allocation_prenatale.document) %>" target="_blank">
                <%= image_tag @allocation_prenatale.document.preview(resize: "500x500>"), class: "m-t-xs img-responsive" %>
              </a>
            </div>
          </div>
          <div class="col-sm-8">
            <h3><strong><%= AllocationPrenatale.human_enum_name(:volet, @allocation_prenatale.volet) %></strong></h3>
            <p>
              <strong>Dossier prestation:</strong>
              <%= @allocation_prenatale.dossier_prestation.num_dossier %>
            </p>
            <p>
              <strong>Debut grossesse:</strong>
              <%= l @allocation_prenatale.grossesse.date_grossesse %>
            </p>

            <p>
              <strong>Date soumission:</strong>
              <%= @allocation_prenatale.date_soumission %>
            </p>

            <p>
              <strong>Date liquidation:</strong>
              <%= @allocation_prenatale.date_validation %>
            </p>

            <p>
              <strong>Commentaire:</strong>
              <%= @allocation_prenatale.commentaire %>
            </p>
          </div>
          <div class="clearfix"></div>
      </div>
    </div>

  </div>
</div>
