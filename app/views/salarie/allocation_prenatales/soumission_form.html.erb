<%= content_for :titre_page, 'Conditions Soumission Demande' %>

<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="wrapper wrapper-content">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>Soumission de la demande  d'allocation prenatale</h5>
        </div>
        <div class="ibox-content">
          <%= bootstrap_form_for(@allocation_prenatale,
                                 url: salarie_dossier_prestation_allocation_prenatale_soumettre_path(@dossier_prestation, @allocation_prenatale),
                                 layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <%= f.alert_message "Une erreur est survenue lors de la soumission." %>
            <p>
              En soumettant le demande j'accepte les conditions suivantes :
            </p>

            <%= f.check_box :condition_1, label: "Condition 1 : Je déclare avoir été consulté par un médecin pour la validation
              de ma grossesse" %>
            <%= f.check_box :condition_2, label: "Condition 2 : Je déclare en outre n'avoir pas adressé pour le
              #{AllocationPrenatale.human_enum_name(:volet, @allocation_prenatale.volet)} de la grossesse débutant le
              #{l @allocation_prenatale.grossesse.date_grossesse} d'autre demande d'allocation prénatale à la CSS
              et n'avoir jamais perçu à ce titre quelque somme que ce soit." %>
            <%= f.check_box :condition_3, label: "Condition 3 : Je certifie que les renseignements portés sur la présente demande
              sont exacts." %>

            <div class="hr-line-dashed"></div>

            <div class="form-group row">
              <div class="col-sm-4 col-sm-offset-4">
                <%= link_to 'Annuler', salarie_dossier_prestation_allocation_prenatales_path(@dossier_prestation), class: 'btn btn-white' %>
                <%= f.button 'Soumettre', class: 'btn btn-primary' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>