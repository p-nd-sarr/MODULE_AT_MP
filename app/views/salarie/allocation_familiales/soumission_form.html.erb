<%= content_for :titre_page, 'Conditions Soumission Demande' %>

<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="wrapper wrapper-content">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>Soumission de la demande  d'allocation familiale</h5>
        </div>
        <div class="ibox-content">
          <%= bootstrap_form_for(@allocation_familiale,
                                 url: salarie_dossier_prestation_allocation_familiale_soumettre_path(@dossier_prestation, @allocation_familiale),
                                 layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <%= f.alert_message "Une erreur est survenue lors de la soumission." %>
            <p>
              En soumettant le demande j'accepte les conditions suivantes :
            </p>

            <%= f.check_box :condition_1, label: "Condition 1 : Je déclare en outre n'avoir pas adressé pour le
              #{AllocationFamiliale.human_enum_name(:trimestre, @allocation_familiale.trimestre)} / #{@allocation_familiale.annee} de mon enfant
              #{ @allocation_familiale.enfant.prenom + ' ' + @allocation_familiale.enfant.nom} d'autre demande d'allocation familiale à la CSS
              et n'avoir jamais perçu à ce titre quelque somme que ce soit." %>
            <%= f.check_box :condition_2, label: "Condition 2 : Je certifie que les renseignements portés sur la présente demande
              sont exacts." %>
            
            <div class="hr-line-dashed"></div>

            <div class="form-group row">
              <div class="col-sm-4 col-sm-offset-4">
                <%= link_to 'Annuler', salarie_dossier_prestation_allocation_familiales_path(@dossier_prestation), class: 'btn btn-white' %>
                <%= f.button 'Soumettre', class: 'btn btn-primary' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>