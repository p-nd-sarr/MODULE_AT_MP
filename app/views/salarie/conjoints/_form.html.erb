      function tableaux_conjoint() {
          const numero_affiliation = $('#conjoint_numero_affiliation').val();

          $.ajax({
              url: "/admin/conjoints/listconjoint/" + numero_affiliation + ".json",
              method: 'get',
              dataType: "json",

              success: function (data) {
                  if (data) {
                      nombre_conjoint = data.length
                      if (data.length >= 1) {
                          $('#list_conjoint').show();
                      } else {
                          $('#list_conjoint').hide();
                      }
                      html = ' ';
                      $.each(data, function (key, conjoint) {
                          html += '<tr></tr>';
                          html += '<td>' + conjoint.prenom + '</td>';
                          html += '<td>' + conjoint.nom + '</td>';
                          html += '<td>' + conjoint.date_naissance + '</td>';
                          html += '<td>' + conjoint.date_mariage + '</td>';
                          html += '<td>' + conjoint.numero_piece + '</td>';
                          html += '<td>' + conjoint.etat_conjoint + '</td>';
                          /*if (conjoint.regime_matrimoniale === 'monogame' && conjoint.etat_conjoint === 'union'){
                              html += '<td>' + "premiere" + '</td>';
                          }else if (conjoint.regime_matrimoniale === 'polygame'  && conjoint.etat_conjoint === 'union'){
                              html += '<td>' + conjoint.rang_conjoint + '</td>';
                              var x=document.getElementById('conjoint_rang_conjoint');
                              for(var i=0; i < x.options.length; i++){
                                  if(x.options[i].value == conjoint.rang_conjoint){
                                      x.options[i].disabled = true;
                                  }
                              }
                          }else {
                              html += '<td>' + "pas de rang" + '</td>';
                          }*/
                      });
                      $("#t_body_conjoint").html(html);

                      data.forEach(function (item) {

                          if (item.date_delivrance_piece_salarie == null){
                              $("#conjoint_date_delivrance_piece_salarie").val(new Date())
                              $("#conjoint_date_delivrance_piece_salarie").attr('readOnly', 'false' );
                          }else {
                              $("#conjoint_date_delivrance_piece_salarie").val(item.date_delivrance_piece_salarie)
                              $("#conjoint_date_delivrance_piece_salarie").attr('readOnly', 'true' );
                              return;
                          }

                          if (item.date_delivrance_piece != null || !item.date_delivrance_piece.empty()){
                              $("#conjoint_date_delivrance_piece").val(item.date_delivrance_piece)
                              return;
                          }else {
                              $("#conjoint_date_delivrance_piece").val(new Date())
                          }

                      });

                  } else {
                      $('#list_conjoint').hide();
                  }
              },
              error: function (XMLHttpRequest, textStatus, errorThrown) {
                  console.log('ERROR')
              }
          });
      }

