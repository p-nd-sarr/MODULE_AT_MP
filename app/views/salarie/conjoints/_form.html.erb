      function convertDate(inputFormat) {
          function pad(s) {
              return (s < 10) ? '0' + s : s;
          }

          var d = new Date(inputFormat)
          return [pad(d.getDate()), pad(d.getMonth() + 1), d.getFullYear()].join('/')
      }

      function load_salaries() {
          const numero_affiliation = $('#conjoint_numero_affiliation').val();
          $.ajax({
              url: "/admin/conjoints/listsalaries/" + numero_affiliation + ".json",
              method: 'get',
              dataType: "json",
              success: function (data) {
                  if (data) {
                      console.log("== salarie ==", data)
                      html = '<option value=""></option>';
                      if (data.regime_matrimoniale != null) {
                          html += '<option value="' + data.regime_matrimoniale + '">' + data.regime_matrimoniale + '</option>';
                          $("#conjoint_regime_matrimoniale").html(html);
                      } else {
                          html += '<option value="monogame">Monogamie</option>';
                          html += '<option value="polygame">Polygamie</option>';

                          $("#conjoint_regime_matrimoniale").html(html);
                      }

                      if (data.nombre_femme != null) {
                          $("#conjoint_nombre_femmes").val(data.nombre_femme);
                      }

                      if (data.date_naissance != null) {
                          $("#id_date_naissance_salarie").hide()
                          $("#date_naissance_exist").text(convertDate(data.date_naissance))
                          $("#id_date_naissance_salarie_exist").show()

                      } else {
                          $("#id_date_naissance_salarie").show()
                          $("#id_date_naissance_salarie_exist").hide()
                      }

                      if (data.nin !== null) {
                          $("#conjoint_nin").val(data.nin);
                      }
                  }
              }, error: function (XMLHttpRequest, textStatus, errorThrown) {
                  console.log(errorThrown)
              }
          });
      }

