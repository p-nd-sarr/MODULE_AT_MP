<div class="row">
  <% @dossier_prestation.document_dossier_prestations.each do |document_dossier_prestation| %>
    <div class="col-lg-4">
      <div class="contact-box" style="min-height: 180px">
        <a href="<%= url_for(document_dossier_prestation.document) %>" target="_blank">
          <div class="col-sm-4">
            <div class="text-center">
              <%= image_tag document_dossier_prestation.document.preview(resize: "500x500>"), class: "m-t-xs img-responsive" %>
              <!--              preview-->
            </div>
          </div>
          <div class="col-sm-8">
            <h3><strong><%= DocumentDossierPrestation.human_enum_name(:type_document, document_dossier_prestation.type_document) %></strong></h3>

          </div>
          <div class="clearfix">
            <%= link_to "Modifier", salarie_dossier_prestation_update_document_form_path(@dossier_prestation, document_dossier_prestation.id) ,  class: 'btn btn-outline btn-primary btn-xs' %>
            <%= link_to "supprimer", salarie_dossier_prestation_destroy_document_path(@dossier_prestation, document_dossier_prestation.id), data: { method: :delete }, class: 'btn btn-outline btn-danger btn-xs' %>
          </div>
        </a>
      </div>
    </div>
  <% end %>
</div>






<% if @dossier_prestation.creation?  %>
  <div class="ibox ">
    <div class="ibox-title">
      <h5>Liste des documents</h5>
    </div>
    <div class="ibox-content">
      <table class="table table-striped table-bordered table-hover">
        <thead>
        <tr>
          <th scope="col"  style="width: 300px">Type</th>
          <th scope="col" style="width: 500px">Choisir document</th>
          <th scope="col" style="width: 100px">Action</th>
        </tr>
        </thead>
        <% DocumentDossierPrestation::TYPE_DOCUMENT.each do |document_name| %>
          <tbody>
          <%= bootstrap_form_for(@document_dossier_prestations, url: salarie_dossier_prestation_create_document_path(@dossier_prestation ), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <tr>
              <td >
                <%= f.hidden_field :type_document, value:document_name.first%>
                <%=DocumentDossierPrestation.human_enum_name(:type_document, document_name.first) %>
              </td>
              <td>
                <%= f.file_field :document, label: '&nbsp;'.html_safe %>
              </td>

              <td>
                <% if !@dossier_prestation.document_dossier_prestations.where(type_document: document_name.first).exists? %>
                  <%= f.button 'Valider', class: 'btn btn-outline btn-primary btn-xs' %>
                <% else  !@dossier_prestation != nil && !@dossier_prestation.document_valid %>
                  <%= f.label 'soumis', class: 'label' %>
                <% end %>
              </td>
            </tr>
          <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>
<% end %>
