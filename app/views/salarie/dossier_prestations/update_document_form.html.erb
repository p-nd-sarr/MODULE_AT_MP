<% if @dossier_prestation.creation?  %>
  <div class="ibox ">
    <div class="ibox-title">
      <h5>Liste des documents</h5>
    </div>
    <div class="ibox-content">
      <table class="table table-striped table-bordered table-hover">
        <thead>
        <tr>
          <th scope="col"  style="width: 300px">Type</th>
          <th scope="col" style="width: 500px">Choisir document</th>
          <th scope="col" style="width: 100px">Action</th>
        </tr>
        </thead>
        <% DocumentDossierPrestation::TYPE_DOCUMENT.each do |document_name| %>
          <tbody>
          <%= bootstrap_form_for(@document_dossier_prestation, url: salarie_dossier_prestation_update_document_path(@dossier_prestation, @document_dossier_prestation), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <tr>
              <td >
                <%= f.hidden_field :type_document, value:document_name.first%>
                <%=DocumentDossierPrestation.human_enum_name(:type_document, document_name.first)%>
              </td>
              <td>
                <%= f.file_field :document, label: '&nbsp;'.html_safe%>
              </td>

              <td>
                <%= f.button 'Modifier', class: 'btn btn-outline btn-primary btn-xs' %>
              </td>
            </tr>
          <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>
<% end %>