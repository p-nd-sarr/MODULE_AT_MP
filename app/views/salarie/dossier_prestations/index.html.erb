        <!-- <td style="width: 75px"> -->
          <%# <%= link_to 'postnatales', salarie_dossier_prestation_allocation_postnatales_path(dossier_prestation),
                      class: 'btn btn-outline btn-info btn-xs' %>
        <!-- </td> -->
        <!-- <td style="width: 75px"> -->
          <%# <%= link_to 'familiales', salarie_dossier_prestation_allocation_familiales_path(dossier_prestation),
                      class: 'btn btn-outline btn-info btn-xs' %>
