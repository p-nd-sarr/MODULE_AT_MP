<div class="modal inmodal" id="document-modal-form-<%= document.documentable_type %><%= document.documentable.id %>" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Fermer</span>
        </button>
        <h5 class="modal-title">Ajout d'un document</h5>
      </div>
      <div class="modal-body" style="background-color: white">
        <%= bootstrap_form_for(document, url: documents_path(back_url: back_url), namespace: document.class.name, layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
          <%= f.select :type_document,
                       type_documents.keys.collect {
                           |type_document| [Document.human_enum_name(:type_document, type_document), type_document] },
                       label: 'Type' %>
          <%= f.file_field :document, label: 'Document', required: true %>
          <%= f.date_field :date_delivrance_piece %>
          <%= f.date_field :date_expiration %>
          <%= f.text_area :commentaire %>
          <%= f.hidden_field :documentable_id %>
          <%= f.hidden_field :documentable_type %>

          <div class="hr-line-dashed"></div>

          <div class="form-group row">
            <div class="col-sm-8 col-sm-offset-4">
              <%= f.button "#{document.persisted? ? 'Modifier' : 'Ajouter'}", class: 'btn btn-primary' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>