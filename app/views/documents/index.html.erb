<%= content_for :titre_page, 'Documents' %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_document_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Type document</th>
        <th scope="col">Commentaire</th>
        <th colspan="3"></th>
      </tr>
      </thead>

      <tbody>
      <% @documents.each do |document| %>
        <tr>
          <td><%= document.type_document %></td>
          <td><%= document.commentaire %></td>
          <td style="width: 75px">
            <%= link_to 'détails', document, class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'modifier', edit_document_path(document), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'supprimer', document, method: :delete, data: {confirm: 'En êtes vous sûr?'}, class: 'btn btn-outline btn-danger btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>