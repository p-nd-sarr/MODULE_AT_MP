<%= content_for :titre_page, "Modification du mot de passe" %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">

  <div class="row">
    <div class="col-sm-offset-2 col-sm-8">
      <div class='box'>
        <div class='box-content'>

          <%= bootstrap_form_for(@user, url: password_update_path, method: :post, layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
              <%= f.password_field :current_password, label: 'Mot de passe actuel', help: "vous devez mettre votre mot de passe actuel pour confirmer les modifications" %>
              <%= f.password_field :password, label: 'Nouveau mot de passe' %>
              <%= f.password_field :password_confirmation, label: 'Confirmation mot de passe' %>

              <div class="hr-line-dashed"></div>

              <div class="form-group">
                <div class="col-sm-4 col-sm-offset-4">
                  <%= link_to 'Annuler', root_path, class: 'btn btn-white' %>
                  <%= f.button 'Modifier', class: 'btn btn-primary' %>
                </div>
              </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
</div>

<style>
    label.required:after {
        content:"";
    }
</style>