<%= content_for :titre_page, "Details régularisation de pension [#{@regularisation_pension.workflow_state}]" %>

<%= content_for :actions_page do %>

     <!-- Création et soumission de la demande -->
  <%= link_to 'Liste demandes', allocataire_regularisation_pensions_path, class: 'btn btn-white btn-sm' %>
  <% if @regularisation_pension.creation? %>
    <%#= link_to 'Modifier', edit_admin_demande_remboursement_cotisation_path(@demande_remboursement_cotisation), class: 'btn btn-white btn-sm' %>
    <% if @regularisation_pension.pret_pour_soumission? and current_user.can_allocataire? and @regularisation_pension.ajoute_par == current_user %>
      <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#SoumissionModal" id="soumettre_id">Soumettre</button>
    <% end %>
  <% end %>

 



 







<% end %>

<div class="wrapper wrapper-content">
  <div class="progressbar-wrapper">
    <ul class="progressbar">
      <li class="<%= ("active") if @regularisation_pension.current_state >= :creation %>">Création</li>
      <li class="<%= ("active") if @regularisation_pension.current_state >= :soumis %>">Soumission</li>
      <li class="<%= ("active") if @regularisation_pension.current_state >= :instruit %>">Instruction</li>
      </li>
      <li class="<%= ("active") if @regularisation_pension.current_state >= :recap_soumis %>">Soumission Recap</li>
      <li class="<%= ("active") if @regularisation_pension.current_state >= :recap_valide %>">Validation Recap</li>
      <li class="<%= ("active") if @regularisation_pension.current_state >= :dossier_valide %>">Validation Dossier</li>
    </ul>
  </div>

  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <h4>
            N° affiliation: <%= @regularisation_pension.numero_allocataire %>
          </h4>
          <%unless @regularisation_pension.numero_dossier.nil?%>
          <h4>
            N° dossier: <%= @regularisation_pension.numero_dossier %>
          </h4>
          <% end %>
          <div class="wrapper wrapper-content">
         

            <div>
              <ul class="nav nav-tabs">
                <!--                <span class="pull-right small text-muted">1406 Elements</span>-->
                <li class="active"><a data-toggle="tab" href="#tab-1"><i class="fa fa-user"></i>Etat Civil Demandeur
                  <%#= '<span class="label label-warning">à valider</span>'.html_safe unless @demande_liquidation.etat_civil_demandeur_valide? %>
                </a></li>
            
            
                <li class=""><a data-toggle="tab" href="#tab-2"><i class="fa fa-folder"></i>Documents
                
                </a></li>

               
                <li class=""><a data-toggle="tab" href="#tab-4"><i class="fa fa-folder"></i>Recap
                  <%#= '<span class="label label-warning">à valider</span>'.html_safe unless @demande_liquidation.documents_valide? %>
                </a></li>

               

                  <li class=""><a data-toggle="tab" href="#tab-5"><i class="fa fa-folder"></i>Historiques
                  </a></li>

              </ul>
              <div class="tab-content">
                <div id="tab-1" class="tab-pane active">
                  <div class="full-height-scroll">
                    <br>
                    <%# if !@regularisation_pension.etat_civil_demandeur_valide? and current_user.can_allocataire? and @regularisation_pension.ajoute_par == current_user %>
                      <%#= link_to "Je valide les informations sur l'état civil", admin_allocataire_regularisation_pension_valider_etat_civil_demandeur_path(@allocataire,@regularisation_pension), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
                      <hr>
                    <% end %>
                    <%#= render 'show_etat_civil' %>
                  </div>
                </div>

                <div id="tab-2" class="tab-pane">
                  <div class="full-height-scroll">
                    <br>
                    <%# if !@regularisation_pension.documents_valide? and current_user.can_allocataire?  %>
                      <%#= link_to "Je valide tous les documents", admin_allocataire_regularisation_pension_valider_documents_path(@allocataire, @regularisation_pension), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
                      <hr>
                    <% end %>
                  <%#= render 'show_documents' %>
                    <br>
                  </div>
                </div>

                <div id="tab-3" class="tab-pane">
                  <div class="full-height-scroll">
                    <br>
                    <%#= render 'show_enfants' %>
                    <br>
                  </div>
                </div>

                <div id="tab-4" class="tab-pane">
                  <div class="full-height-scroll">
                    <br>
                    <%#= render 'show_tableau_recapitulatif' %>
                    <br>
                  </div>
                </div>

                <div id="tab-5" class="tab-pane">
                  <div class="full-height-scroll">
                    <br>
                    <%#= render 'show_historiques' %>
                    <br>
                  </div>
                </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>



  <% unless @gestionnaires.nil? %>
    <div class="modal inmodal" id="affecter-one-modal" tabindex="-1" role="dialog" aria-hidden="true">
      <div class="modal-dialog">
        <%= bootstrap_form_for(@regularisation_pension, url: admin_allocataire_regularisation_pension_affecter_allocataire_path(@allocataire, @regularisation_pension), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
          <div class="modal-content animated bounceInRight">
            <div class="modal-header">
              <button type="button" class="close" data-dismiss="modal">
                <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
              <i class="fa fa-laptop modal-icon"></i>
              <h4 class="modal-title">Affectation la demande : <%= @regularisation_pension.numero_allocataire %> </h4>
              <small class="font-bold">Choisir le gestionnaire</small>
            </div>
            <div class="modal-body">
              <%= f.collection_select :affectation_allocataire, @gestionnaires, :id, :full_name, label: 'Choisir gestionnaire', required: true %>

            </div>
            <div class="modal-footer">
              <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
              <button type="submit" class="btn btn-primary">Affecter la Demande</button>

            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<style>
  .progressbar-wrapper {
    width: 100%;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12%;
  }

  .progressbar li {
    list-style-type: none;
    width: 10%;
    float: left;
    font-size: 10px;
    position: relative;
    text-align: center;
    text-transform: uppercase;
    color: #7d7d7d;
  }

  .progressbar li:before {
    width: 60px;
    height: 60px;
    content: "";
    line-height: 60px;
    border: 2px solid #7d7d7d;
    display: block;
    text-align: center;
    margin: 0 auto 3px auto;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    background-color: #fff;
  }

  .progressbar li:after {
    width: 100%;
    height: 2px;
    content: '';
    position: absolute;
    background-color: #7d7d7d;
    top: 30px;
    left: -50%;
    z-index: 0;
  }

  .progressbar li:first-child:after {
    content: none;
  }

  .progressbar li.active {
    color: #000;
    font-weight: normal;
  }

  .progressbar li.active:before {
    border-color: #1ab394;
    background: #1ab394;
  }

  .progressbar li.active + li:after {
    background-color: #1ab394;
  }

  .progressbar li.active:before {
    background: #1ab394;
    background-size: 60%;
  }

  .progressbar li::before {
    background: #fff;
    background-size: 60%;
  }

  .progressbar {
    counter-reset: step;
  }

  .progressbar li:before {
    content: counter(step);
    counter-increment: step;
  }
  </style>

