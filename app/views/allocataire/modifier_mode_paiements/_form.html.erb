
<%= bootstrap_form_for([:allocataire, @modifier_mode_paiement], label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
<%= f.alert_message "Please fix the errors below." %>
  <div class="row">
    <div class="col-sm-12">
        <%= f.select :mode_paiement,
                     MODE_PAIEMENT_CAISSE_IPRES.keys.collect { |mode_paiement| [LiquidationRetraite.human_enum_name(:mode_paiement, mode_paiement), mode_paiement] },
                   include_blank: true, label: 'Mode paiement' %>
        <div id="mode_paiement_virement">
            <%= f.text_field :compte_bancaire_nom_banque, label: 'Nom de la banque' %>
            <%= f.text_field :compte_bancaire_code_banque, label: 'Code de la banque' %>
            <%= f.text_field :compte_bancaire_code_guichet, label: 'Code guichet du compte' %>
            <%= f.text_field :compte_bancaire_numero_compte, label: 'Numéro du compte' %>
            <%= f.collection_radio_buttons :motif_virement, ModifierModePaiement::MOTIF_VIREMENT.keys.collect {|k,v| [k,k]}, :first, :last do |b| %>
                    <%= b.radio_button :motif_virement %> 
            <% end %>
       </div>
        <div id="mode_paiement_mandat">
            <%= f.text_field :adresse_domicile, label: 'Adresse' %>
            <%= f.text_field :telephone, label: 'Téléphone' %>
            <%= f.text_field :numero_identification_nationale, label: 'NIN' %>
            <%= f.date_field :date_debut_changement, label: 'Debut du changement du mode' %>
        </div>

     </div>  
  </div>

      
  <div class="form-group row">
        <div class="col-sm-4 col-sm-offset-2">
            <%= link_to 'Annuler', [:allocataire, @modifier_mode_paiement], class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
        </div>
   </div>



<% end %>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function(){
          chargerInfosCompteBancaire();
          chargerInfoDomicile();
          chargerInfoMandat();
          

          $("#modifier_mode_paiement_mode_paiement").change(function () {
              chargerInfosCompteBancaire()
          });
          $("#modifier_mode_paiement_mode_paiement").change(function () {
             chargerInfoDomicile()
             chargerInfoMandat()
          });
       

          function chargerInfosCompteBancaire() {
              var mode_paiement = $('#modifier_mode_paiement_mode_paiement').val();
              elem_mode_paiement = $('#mode_paiement_virement')
              if (mode_paiement === 'virement') {
                  elem_mode_paiement.show();
              } else {
                  elem_mode_paiement.hide();
              }
          }

             function chargerInfoDomicile() {
              var mode_paiement = $('#modifier_mode_paiement_mode_paiement').val();
              elem_mode_paiement = $('#mode_paiement_paiement_a_domicile')
              if (mode_paiement === 'paiement_a_domicile') {
                  elem_mode_paiement.show();
              } else {
                  elem_mode_paiement.hide();
              }
          }
            function chargerInfoMandat() {
              var mode_paiement = $('#modifier_mode_paiement_mode_paiement').val();
              elem_mode_paiement = $('#mode_paiement_mandat')
              if (mode_paiement === 'mandat') {
                  elem_mode_paiement.show();
              } else {
                  elem_mode_paiement.hide();
              }
            }
           

          $('#modifier_mode_paiement_numero_affiliation').change(function() {
              var numero_affiliation = $('#modifier_mode_paiement_numero_affiliation').val();
              $.ajax({
                  url: "/admin/salaries/" + numero_affiliation + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function( data ) {
                      if(data){
                          $("#modifier_mode_paiement_prenom").val(data.prenom);
                          $("#modifier_mode_paiement_nom").val(data.nom);
                      }
                      else{
                          $("#modifier_mode_paiement_prenom").val('');
                          $("#modifier_mode_paiement_nom").val('');
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      $("#modifier_mode_paiement_prenom").val('');
                      $("#modifier_mode_paiement_nom").val('');
                  }
              });
          })
      })
  </script>
  <script type="text/javascript"> 
            $(document).ready(function() { 
                $('input[type="radio"]').click(function() { 
                    var inputValue = $(this).attr("value"); 
                    var targetBox = $("." + inputValue); 
                    $(".motif_virement").not(targetBox).hide(); 
                    $(targetBox).show(); 
                   
                }); 
            }); 
        </script> 
<% end %>
