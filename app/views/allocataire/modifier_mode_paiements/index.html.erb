          </div>

          <div id="rejete" class="tab-pane fade">
            <!--   START liste rejeté  -->
            <% rejetees = @rejetees.page(params[:page]).per(100) %>
            <% if @rejetees.count.zero? %>                
              <h2 style="text-align:center; margin-top:50px"><hr>La liste des demandes rejetées est vide !!!</h2>
            <% else %>
             <table class="table table-striped" style="margin-top: 20px">
              <thead>
                <tr>
                <th scope="col">N°</th>
                  <th scope="col">Matricule</th>
                  <th scope="col">Prénom</th>
                  <th scope="col">Nom</th>
                  <th scope="col">Mode paiement</th>
                  <th scope="col">Etat</th>
                  <th colspan="4"></th>
                </tr>
              </thead>
              <tbody>
                <% @rejetees.each do |modifier_mode_paiement| %>
                 <tr>
                    <td><%= modifier_mode_paiement.numero_dossier %></td>
                    <td><%= modifier_mode_paiement.numero_allocataire %></td>
