            <% else %>
             <table class="table table-striped" style="margin-top: 20px">
              <thead>
                <tr>
                <th scope="col">N°</th>
                  <th scope="col">Matricule</th>
                  <th scope="col">Prénom</th>
                  <th scope="col">Nom</th>
                  <th scope="col">Mode paiement</th>
                  <th scope="col">Etat</th>
                  <th colspan="4"></th>
                </tr>
              </thead>
              <tbody>
                <% @en_attentes_modif_soumis.each do |modifier_mode_paiement| %>
                 <tr>
                    <td><%= modifier_mode_paiement.numero_dossier %></td>
                    <td><%= modifier_mode_paiement.numero_allocataire %></td>
                    <td><%= modifier_mode_paiement.prenom %></td>
                    <td><%= modifier_mode_paiement.nom %></td>
                    <td><%= modifier_mode_paiement.mode_paiement %></td>
                     <td><%= modifier_mode_paiement.workflow_state %></td>
                    <td>
                       <%= link_to 'détails', [:admin, modifier_mode_paiement.allocataire, modifier_mode_paiement], class: 'btn btn-outline btn-primary btn-xs' %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
            <% end %>
            <%= paginate en_attentes_validation_dossier %>

            <!-- END -->
          </div>

          <div id="attente_affectation" class="tab-pane fade">
            <!--   START liste attente soumission  -->
            <% en_attentes_affectations = @en_attentes_affectations.page(params[:page]).per(100) %>
            <% if @en_attentes_affectations.count.zero? %>                
              <h2 style="text-align:center; margin-top:50px"><hr>La liste des demandes en attente d'affectation est vide !!!</h2>
            <% else %>
            <table class="table table-striped" style="margin-top: 20px">
              <thead>
                <tr>
                <th scope="col">N°</th>
                  <th scope="col">Matricule</th>
                  <th scope="col">Prénom</th>
                  <th scope="col">Nom</th>
                  <th scope="col">Mode paiement</th>
                  <th scope="col">Etat</th>
                  <th colspan="4"></th>
                </tr>
              </thead>
              <tbody>
                <% @en_attentes_affectations.each do |modifier_mode_paiement| %>
                  <tr>
                    <td><%= modifier_mode_paiement.numero_dossier %></td>
                    <td><%= modifier_mode_paiement.numero_allocataire %></td>
                    <td><%= modifier_mode_paiement.prenom %></td>
                    <td><%= modifier_mode_paiement.nom %></td>
                    <td><%= modifier_mode_paiement.mode_paiement %></td>
                     <td><%= modifier_mode_paiement.workflow_state %></td>
                    <td>
                        <%= link_to 'détails', [:admin, modifier_mode_paiement.allocataire, modifier_mode_paiement], class: 'btn btn-outline btn-primary btn-xs' %>
                    </td>
                    
                  </tr>
                
                 
                <% end %>
              </tbody>
            </table>
            <% end %>
            <%= paginate en_attentes_affectations %>

            <!-- END -->
          </div>


          <div id="valide" class="tab-pane fade">
            <!--   START liste valide  -->
            
            <% validees = @validees.page(params[:page]).per(100) %>
            <% if @validees.count.zero? %>                
              <h2 style="text-align:center; margin-top:50px"><hr>La liste des demandes validées est vide !!!</h2>
            <% else %>
              <table class="table table-striped" style="margin-top: 20px">
                <thead>
                  <tr>
                  <th scope="col">N° Dossier</th>
                    <th scope="col">Matricule</th>
                    <th scope="col">Prénom</th>
                    <th scope="col">Nom</th>
                    <th scope="col">Mode paiement</th>
                    <th scope="col">Etat</th>
                    <th colspan="4"></th>
                  </tr>
                </thead>
                <tbody>
                  <% @validees.each do |modifier_mode_paiement| %>
                    <tr>
                      <td><%= modifier_mode_paiement.numero_dossier %></td>
                      <td><%= modifier_mode_paiement.numero_allocataire %></td>
                      <td><%= modifier_mode_paiement.prenom %></td>
                      <td><%= modifier_mode_paiement.nom %></td>
                      <td><%= modifier_mode_paiement.mode_paiement %></td>
                      <td><%= modifier_mode_paiement.workflow_state %></td>
                      </td>
                      <td>
                         <%= link_to 'détails', [:admin, modifier_mode_paiement.allocataire, modifier_mode_paiement], class: 'btn btn-outline btn-primary btn-xs' %>
                      </td>
                      
                    </tr>
                  <% end %>
                </tbody>
              </table>
            <% end %>
            <%= paginate validees %>

