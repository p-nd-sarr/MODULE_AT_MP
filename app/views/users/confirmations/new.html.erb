<div class="loginColumns animated fadeInDown">
  <div class="row">

    <div class="col-md-6">
      <h2 class="font-bold">Renvoyer les informations de confirmation</h2>

      <p>
        La création de votre compte a déjà été validée par ce lien, pour accéder au site, retourner <%= link_to "sur la page d'accueil", root_path %> et connectez vous avec vos identifiants et mot de passe.
      </p>
    </div>
    <div class="col-md-6">
      <div class="ibox-content">
        <%= bootstrap_form_for(resource, as: resource_name, url: confirmation_path(resource_name)) do |f| %>
            <%= f.email_field :email, label: 'Email', autofocus: true %>
            <button type="submit" class="btn btn-primary block full-width m-b">Renvoyer les instructions</button>

            <%= render 'users/shared/links' %>
        <% end %>
      </div>
    </div>
  </div>
  <hr />
  <div class="row">
    <div class="col-md-6">
      <%= image_tag 'logo_ipres.jpg', height: 32 %>
      <%= image_tag 'logo_css.png', height: 32 %>
    </div>
    <div class="col-md-6 text-right">
      <small>© 2020</small>
    </div>
  </div>
</div>
