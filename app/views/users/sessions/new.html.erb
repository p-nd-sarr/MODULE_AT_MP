<div class="loginColumns animated fadeInDown">
  <div class="row">

    <div class="col-md-6">
      <h2 class="font-bold">Connexion</h2>

      <p>
        Veuillez mettre votre adresse email et mot de passe pour vous connecter
      </p>

    </div>
    <div class="col-md-6">
      <div class="ibox-content">
        <%= bootstrap_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <%= f.email_field :email, autofocus: true %>
            <%= f.password_field :password, label: 'Mot de passe' %>
            <%= f.check_box :remember_me, as: :boolean, label: 'Se souvenir de moi' if devise_mapping.rememberable? %>
            <button type="submit" class="btn btn-primary block full-width m-b">Se connecter</button>

            <%= render "users/shared/links" %>

        <% end %>
      </div>
    </div>
  </div>
  <hr />
  <div class="row">
    <div class="col-md-6">
      <%= image_tag 'logo_ipres.jpg', height: 32 %>
      <%= image_tag 'logo_css.png', height: 32 %>
    </div>
    <div class="col-md-6 text-right">
      <small>© 2020</small>
    </div>
  </div>
</div>

<style>
    label.required:after {
        content:"";
    }
</style>