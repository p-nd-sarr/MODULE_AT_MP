<div class="loginColumns animated fadeInDown">
  <div class="row">

    <div class="col-md-6">
      <h2 class="font-bold">Nouveau mot de passe</h2>

      <p>
        Saisissez votre nouveau mot de passe.
      </p>
    </div>
    <div class="col-md-6">
      <div class="ibox-content">
        <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: {method: :put, class: 'm-t'}) do |f| %>
            <%= devise_error_messages! %>
            <%= f.input :reset_password_token, as: :hidden %>
            <%= f.input :password, label: 'Nouveau mot de passe', autofocus: true, hint: ("minimum #{@minimum_password_length} charactères" if @minimum_password_length) %>
            <%= f.input :password_confirmation, label: 'Confirmation du nouveau mot de passe' %>
            <button type="submit" class="btn btn-primary block full-width m-b">Modifier mot de passe</button>

            <%= render 'users/shared/links' %>
        <% end %>
      </div>
    </div>
  </div>
  <hr />
  <div class="row">
    <div class="col-md-6">
      <%= image_tag 'logo_ipres.jpg', height: 32 %>
      <%= image_tag 'logo_css.png', height: 32 %>
    </div>
    <div class="col-md-6 text-right">
      <small>© 2020</small>
    </div>
  </div>
</div>
