<div class="loginColumns animated fadeInDown">
  <div class="row">

    <div class="col-md-6">
      <h2 class="font-bold">Réinitialisation de votre mot de passe</h2>

      <p>
        Saisissez votre adresse mail pour recevoir les instructions de réinitialisation.
      </p>
    </div>
    <div class="col-md-6">
      <div class="ibox-content">
        <%= bootstrap_form_for(resource, as: resource_name, url: password_path(resource_name), html: {method: :post, class: 'm-t'}) do |f| %>
            <%= f.email_field :email, autofocus: true %>
            <button type="submit" class="btn btn-primary block full-width m-b">Envoyer les instructions</button>

            <%= render 'users/shared/links' %>
        <% end %>
      </div>
    </div>
  </div>
  <hr />
  <div class="row">
    <div class="col-md-6">
      <%= image_tag 'logo_ipres.jpg', height: 32 %>
      <%= image_tag 'logo_css.png', height: 32 %>
    </div>
    <div class="col-md-6 text-right">
      <small>© 2020</small>
    </div>
  </div>
</div>
