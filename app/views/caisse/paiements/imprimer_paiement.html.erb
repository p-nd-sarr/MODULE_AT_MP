<div class="wrapper wrapper-content">
  <div class="container" style="color: black">
    <div class="text-center">
      <p>Institution de Prévoyance Retraite du Sénégal</p>
      <p>22, Avenue Léopold Sédar Senghor</p>
      <img style="height: 50px; margin-top: -7px" src="data:image/png;base64," alt="">
      <br> <br>
      <hr style="margin-top: 0; margin-bottom: 5px; border-color: black">
      <p><strong> <%= @paiement.prenom %> <%= @paiement.nom %> </strong></p>
      <p>Numéro allocataire : <strong> <%= @paiement.numero_allocataire || @paiement.ipres_ancien_matric %> </strong>
      </p>
      <p>Payé par : <strong> <%= @paiement.user.full_name %> </strong></p>
      <p>Payé le : <strong><%= @paiement.date_paiement.strftime("%d/%m/%Y à %H:%m") %></strong></p>
      <p>Période :
        <strong>
          <% if @paiement.immediate? %>
            -
          <% else %>
            <%= l @paiement.periode_debut, format: '%B %Y' %>
          <% end %>
        </strong>
      </p>

      <p>Montant payé : <strong><%= format_cfa @paiement.montant %></strong></p>
    </div>
  </div>
</div>