<%= content_for :titre_page, 'Décés salariés' %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_admin_deces_salary_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'admin/deces_salaries/search' %>
    <br>
    <hr>
    <%= paginate @admin_deces_salaries %>
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Numero affiliation</th>
        <th scope="col">Prenom</th>
        <th scope="col">Nom</th>
        <th scope="col">Date deces</th>
        <th scope="col">Numero piece</th>
        <th colspan="3"></th>
      </tr>
    </thead>

    <tbody>
    <% @admin_deces_salaries.each do |salary| %>
    <tr>
                <td><%= salary.numero_affiliation %></td>
                <td><%= salary.prenom %></td>
                <td><%= salary.nom %></td>
                <td><%= salary.date_deces %></td>
                <td><%= salary.numero_piece %></td>
            <td style="width: 75px">
        <%= link_to 'détails', admin_deces_salary_path(salary), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_deces_salary_path(salary), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_deces_salary_path(salary), method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
    <%= paginate @admin_deces_salaries %>
  </div>
</div>