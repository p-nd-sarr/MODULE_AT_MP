<%= content_for :titre_page, "Détails Dossier Prestation Ext. / CFS" %>
<%#= content_for :titre_page, "Détails cfs_reversion_veuve [#{PrestationExtFrance.human_enum_name(:etat, @cfs_reversion_veuve.etat)}]" %>

<%= content_for :titre_page_autres_details do %>
  Sens Convention : <%= "#{CfsReversionVeuve.human_enum_name(:sens_convention, @cfs_reversion_veuve.sens_convention)}" %>
  <br>
  Etat du dossier : <%= "#{@cfs_reversion_veuve.workflow_state}" %>
  <% unless @cfs_reversion_veuve.date_soumission.nil? %>
    <br>
    <strong class="text-info">Date soumission :</strong>
    <%= "#{l @cfs_reversion_veuve.date_soumission}" %>
  <% end %>
<% end %>

<%= content_for :actions_page do %>

  <% if @cfs_reversion_veuve.can_affecte_gestionnaire? and @cfs_reversion_veuve.affectation_allocataire.nil? and current_user.chef_section_liquidation?
  %>
    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#affecter-one-modal" id="affecter_allocataire_id">
      Affecter la Demande Allocation
    </button>
  <% end %>

  <% if @cfs_reversion_veuve.instruit? and @cfs_reversion_veuve.affectation_salarie.nil? and current_user.chef_service_cotisation?
  %>
    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#affecter-one-salarie" id="affecter_salarie_id">
      Affecter Validation Fiche Carrière
    </button>
  <% end %>

  <%= link_to 'Retour', admin_cfs_reversion_veuves_path, class: 'btn btn-white btn-sm' %>
  <% if @cfs_reversion_veuve.creation? and @cfs_reversion_veuve.ajoute_par == current_user %>
    <%= link_to 'Editer', edit_admin_cfs_reversion_veuve_path(@cfs_reversion_veuve), class: 'btn btn-white btn-sm' %>
    <%= (link_to 'Supprimer', [:admin, @cfs_reversion_veuve], method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-danger btn-sm') %>

    <% if @cfs_reversion_veuve.pret_pour_soumission? and current_user.can_allocataire? %>
      <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#SoumissionModal" id="soumettre_id">Soumettre</button>
    <% end %>
  <% end %>

  <% if @cfs_reversion_veuve.soumis? %>
    <%= (link_to 'Instruire Dossier', admin_cfs_reversion_veuve_instruire_path(@cfs_reversion_veuve), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') if current_user.chef_section_instruction? %>

    <% if current_user.chef_section_instruction? %>
      <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif" style="float: right;">
        Retourner Dossier
      </button>
    <% end %>
  <% end %>

  <% if @cfs_reversion_veuve.instruit? and @cfs_reversion_veuve.affecter_salarie == current_user and (@cfs_reversion_veuve.carrieres_prestation.traite.size == @cfs_reversion_veuve.carrieres_prestation.size) %>
    <%= link_to "Soumettre la validation des carrières", admin_cfs_reversion_veuve_valider_activite_prof_valid_path(@cfs_reversion_veuve), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
    <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif" style="float: right; margin-top: 5px;">
      Retourner Dossier
    </button>
  <% end %>

  <% if @cfs_reversion_veuve.carriere_soumis? and (@cfs_reversion_veuve.carrieres_prestation.traite.size == @cfs_reversion_veuve.carrieres_prestation.size) %>
    <%= (link_to 'Valider Carrière', admin_cfs_reversion_veuve_cotisation_valide_path(@cfs_reversion_veuve), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') if current_user.chef_service_cotisation? %>
    <% if current_user.chef_service_cotisation? %>
      <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif" style="float: right; margin-left: 3px;">
        Retourner Dossier
      </button>
    <% end %>
  <% end %>

  <% if @cfs_reversion_veuve.cotisation_valide? and @cfs_reversion_veuve.affecter_allocataire == current_user %>
    <%= (link_to "Soumettre la validation du tableau", admin_cfs_reversion_veuve_valider_recapitulatif_path(@cfs_reversion_veuve), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') unless @cfs_reversion_veuve.affecter_allocataire.nil? %>
    <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif" style="float: right; margin-top: 5px;">
      Retourner Dossier
    </button>
  <% end %>

  <% if @cfs_reversion_veuve.recap_soumis? %>
    <%= (link_to 'Valider Tableau Recapitulatif', admin_cfs_reversion_veuve_liquidation_valide_path(@cfs_reversion_veuve), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') if current_user.chef_section_liquidation? %>
    <% if current_user.chef_section_liquidation? %>
      <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif" style="float: right;margin-top: 5px;">
        Retourner Dossier
      </button>
    <% end %>
  <% end %>

  <% if @cfs_reversion_veuve.liquidation_valide? and current_user.chef_service_allocation? %>
    <%= (link_to 'Valider', admin_cfs_reversion_veuve_dossier_valide_path(@cfs_reversion_veuve), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') unless @cfs_reversion_veuve.traite? %>
    <%= (link_to 'Rejeter', admin_cfs_reversion_veuve_rejeter_path(@cfs_reversion_veuve), class: 'btn btn-danger btn-sm') unless @cfs_reversion_veuve.traite? %>
    <% unless @cfs_reversion_veuve.traite? %>
      <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif" style="float: right; margin-left: 3px;">
        Retourner Dossier
      </button>

    <% end %>
  <% end %>
  <%# if current_user.comptable? and not @cfs_reversion_veuve.attente_paiement? %>
  <!--    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#PaiementModal" id="soumettre_id">Valider Paiement</button>-->
  <%# end %>

<% end %>

<!-- Retour du dossier de liquidation -->
<div class="modal inmodal" id="motif" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Close</span>
        </button>
        <h4 class="modal-title">Motif du retour du dossier de Prestation Ext. / CFS</h4>
      </div>
      <%= bootstrap_form_for(@cfs_reversion_veuve, url: admin_cfs_reversion_veuve_retourner_process_path(@cfs_reversion_veuve)) do |f| %>
        <div class="modal-body">
          <%= f.text_area :motif_rejet, label: 'Motif' %>
        </div>

        <div class="modal-footer form-group">
          <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
          <%= f.button 'Retourner Dossier', class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>
<!-- Fin retour dossier -->

<div class="wrapper wrapper-content">

  <div class="row">
    <p>
      <span style="color: red"><%= (" Motif Rejet : :  #{@cfs_reversion_veuve.motif_rejet} ") unless @cfs_reversion_veuve.motif_rejet.nil? %> </span>
    </p>
    <div class="progressbar-wrapper">
      <ul class="progressbar">
        <li class="<%= ("active") if @cfs_reversion_veuve.current_state >= :creation %>">Création</li>
        <li class="<%= ("active") if @cfs_reversion_veuve.current_state >= :soumis %>">Soumission</li>
        <li class="<%= ("active") if @cfs_reversion_veuve.current_state >= :instruit %>">Instruction</li>
        <li class="<%= ("active") if @cfs_reversion_veuve.current_state >= :carriere_soumis %>">Soumission Carrière
        </li>
        <li class="<%= ("active") if @cfs_reversion_veuve.current_state >= :cotisation_valide %>">Validation
          Carrière
        </li>
        <li class="<%= ("active") if @cfs_reversion_veuve.current_state >= :recap_soumis %>">Soumission Recap</li>
        <li class="<%= ("active") if @cfs_reversion_veuve.current_state >= :liquidation_valide %>">Validation Recap
        </li>
        <li class="<%= ("active") if @cfs_reversion_veuve.current_state >= :dossier_valide %>">Validation Dossier</li>
      </ul>
    </div>

  </div>
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="row">
            <div class="col-lg-12">
              <h5 class="text-warning" style="font-family: Georgia;">
                N° Dossier : <%= @cfs_reversion_veuve.numero_dossier %>
              </h5>

              <% if @cfs_reversion_veuve.creation? %>
                <% if @cfs_reversion_veuve.pret_pour_soumission? %>
                  <p class="text-info">
                    Votre dossier est prêt pour être enregistré
                  </p>
                <% else %>
                  <p class="text-warning">
                    Merci de valider les informations sur les différents onglets pour pouvoir enregistrer le dossier
                  </p>
                <% end %>
              <% end %>


              <!-- Historique du dossier de liquidation -->
              <button type="button" class="btn btn-success btn-outline" data-toggle="modal" data-target="#history" style="float: right;">
                <span class="fa fa-history"></span> Historiques
              </button>
              <div class="modal inmodal" id="history" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
                <div class="modal-dialog">
                  <div class="modal-content animated bounceInRight">
                    <div class="modal-header">
                      <button type="button" class="close" data-dismiss="modal">
                        <span aria-hidden="true">x</span>
                        <span class="sr-only">Close</span>
                      </button>
                      <h4 class="modal-title">Historiques du dossier de liquidation</h4>
                    </div>
                    <div class="modal-body">
                      <div class="full-height-scroll">
                        <br>
                        <div class="row">
                          <div class="col-lg-4">
                            <h5>Ouvert Par: <%= @cfs_reversion_veuve.ajoute_par.full_name %></h5>
                            <h5>Date de création: <%= @cfs_reversion_veuve.created_at.strftime("%d/%m/%Y") %></h5>
                          </div>

                          <div class="col-lg-4">
                            <h5>Soumis à l'instruction: <%= @cfs_reversion_veuve.ajoute_par.full_name %></h5>
                            <h5>Date de soumission:
                              <%= (@cfs_reversion_veuve.date_soumission.strftime("%d/%m/%Y")) unless @cfs_reversion_veuve.date_soumission.nil? %>
                            </h5>
                          </div>

                          <div class="col-lg-4">
                            <h5>Instruit par:
                              <%= (@cfs_reversion_veuve.instruit_par.full_name) unless @cfs_reversion_veuve.instruit_par.nil? %>
                            </h5>
                            <h5>Date Insctruction:
                              <%= (@cfs_reversion_veuve.instruit_le.strftime("%d/%m/%Y")) unless @cfs_reversion_veuve.instruit_le.nil? %>
                            </h5>
                          </div>
                        </div>
                        <hr>
                        <div class="row">

                          <div class="col-lg-4">
                            <h5>Validé Par :
                              <%= (@cfs_reversion_veuve.valide_par.try(:full_name)) unless @cfs_reversion_veuve.valide_par.nil? %> </h5>
                            <h5>Date De Validation :
                              <%= (@cfs_reversion_veuve.date_validation.strftime("%d/%m/%Y")) unless @cfs_reversion_veuve.date_validation.nil? %></h5>
                          </div>

                          <div class="col-lg-4">
                            <h5>Gestionnaire Compte Allocataire :
                              <%= (@cfs_reversion_veuve.affecter_allocataire.full_name) unless @cfs_reversion_veuve.affecter_allocataire.nil? %>
                            </h5>
                            <h5>Date Affectation
                              : <%= (@cfs_reversion_veuve.affectation_allocataire_date.strftime("%d/%m/%Y")) unless @cfs_reversion_veuve.affectation_allocataire_date.nil? %></h5>
                          </div>

                          <div class="col-lg-4">
                            <h5>Gestionnaire Compte Salarié :
                              <%= (@cfs_reversion_veuve.affecter_salarie.full_name) unless @cfs_reversion_veuve.affecter_salarie.nil? %>
                            </h5>
                            <h5>Date Affectation :
                              <%= (@cfs_reversion_veuve.affectation_salarie_date.strftime("%d/%m/%Y")) unless @cfs_reversion_veuve.affectation_salarie_date.nil? %>
                            </h5>
                          </div>
                        </div>
                      </div>
                    </div>

                    <div class="modal-footer form-group">
                      <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
                    </div>
                  </div>
                </div>
              </div>
              <!-- Fin Historique -->
            </div>
