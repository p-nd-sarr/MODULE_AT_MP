<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">Nom</th>
    <th scope="col">Prénom</th>
    <th scope="col">Date de naissance</th>
    <th scope="col">Date de mariage</th>
  </tr>
  </thead>

  <tbody>
  <% @conjoints.valide.each do |epouse| %>
    <tr>
      <td><%= epouse.nom %></td>
      <td><%= epouse.prenom %></td>
      <td><%= l epouse.date_naissance %></td>
       <td><%= l epouse.date_mariage %></td>
    </tr>
  <% end %>
  </tbody>
</table>