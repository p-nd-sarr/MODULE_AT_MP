<%= paginate @cfs_reversion_veuves %>

<table class="table table-striped" style="margin-top: 20px">
  <thead>
  <tr>
    <th scope="col">N° dossier</th>
    <th scope="col">Prénom</th>
    <th scope="col">Nom</th>
    <th scope="col">Date de naissance</th>
    <th scope="col">Lieu de naissance</th>
    <th scope="col">Adresse résidence</th>
    <th scope="col">Mode de paiement</th>
    <th colspan="3"></th>
  </tr>
  </thead>

  <tbody>
  <% @cfs_reversion_veuves.each do |cfs_reversion_veuve| %>
    <tr>
      <td><%= cfs_reversion_veuve.numero_dossier %></td>
      <td><%= cfs_reversion_veuve.prenom %></td>
      <td><%= cfs_reversion_veuve.nom %></td>
      <td><%= l cfs_reversion_veuve.date_naissance %></td>
      <td><%= cfs_reversion_veuve.lieu_naissance %></td>
      <td><%= cfs_reversion_veuve.adresse_residence %></td>
      <td><%= CfsReversionVeuve.human_enum_name(:mode_paiement, cfs_reversion_veuve.mode_paiement) unless cfs_reversion_veuve.mode_paiement.nil? %></td>

      <td width="75px">
        <%= (link_to 'Details', admin_cfs_reversion_veuve_path(cfs_reversion_veuve), class: 'btn btn-outline btn-primary btn-xs') %>
      </td>
      <% if cfs_reversion_veuve.soumis? and current_user.chef_service_allocation? %>
        <td width="75px">
          <%= (link_to 'Affecter', admin_cfs_reversion_veuve_path(cfs_reversion_veuve), class: 'btn btn-outline btn-primary btn-xs') %>
        </td>
      <% end %>

      <% if cfs_reversion_veuve.traitement_en_cours? %>
        <td width="75px">
          <button type="button" class="btn btn-primary btn-xs" data-toggle="modal" data-target="#affecterModal" id="affecter_id" disabled>
            Deja Affecté
          </button>
        </td>
      <% end %>

      <% if cfs_reversion_veuve.date_soumission? %>
        <td> <%= link_to 'Récépissé', admin_cfs_reversion_veuve_show_facture_path(cfs_reversion_veuve.id, format: :pdf), class: "btn btn-outline-success my-2 my-sm-0", target: '_blank' %></td>
      <% end %>
    </tr>
  <% end %>
  </tbody>
</table>
<%= paginate @cfs_reversion_veuves %>
