<%= content_for :titre_page, "Détails compte [#{User.human_enum_name(:type_profil, @user.type_profil)}:N° #{@user.numero_salarie}]" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_users_path, class: 'btn btn-white btn-sm' %>
  <%= link_to 'Modifier', edit_admin_user_path(@user), class: 'btn btn-white btn-sm' %>
  <% unless current_user == @user %>
    <% if @user.actif? %>
      <%= link_to 'désactiver', admin_user_desactiver_path(@user), class: 'btn btn-danger btn-sm' %>
    <% else %>
      <%= link_to 'activer', admin_user_activer_path(@user), class: 'btn btn-primary btn-sm' %>
    <% end %>
  <% end %>
<% end %>
<div class="ibox" style="margin-top: 20px;">
  <div class="ibox-content">
    <% if @user.salarie? %>
      <%= render 'show_salarie' %>
    <% elsif @user.employeur? %>
      <%= render 'show_employeur' %>
    <% else %>
      <%= render 'show_common_infos' %>
    <% end %>
