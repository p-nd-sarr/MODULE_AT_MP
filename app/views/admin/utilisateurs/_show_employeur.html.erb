<%= render 'show_common_infos' %>

<div class="row" style="margin-top: 20px;">
  <div class="col-lg-12">
    <div class="m-b-md">
      <h2>Informations sur l'entrerprise</h2>
      <h3> Appariement Effectué :
      <% if @employeur.nil? %>
        <span style="color: red">NON</span>
      <% else %>
        <span class='text-navy'>OUI</span>
      <% end %>
      </h3>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-6">
    <d1 class="row mb-0">
      <div class="col-sm-4" style="text-align: right;">
        <dt>Raison Social:</dt>
      </div>
      <div class="col-sm-4" style="text-align: left;">
        <dd class="mb-1 text-navy"><%= @user.try(:raison_sociale) %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-4" style="text-align: right;">
        <dt>Ninea:</dt>
      </div>
      <div class="col-sm-4" style="text-align: left;">
        <dd class="mb-1 text-navy"><%= @user.try(:ninea) %></dd>
      </div>
    </d1>
  </div>
  <div class="col-lg-6">
    <d1 class="row mb-0">
      <div class="col-sm-4 text-sm-right" style="text-align: right;">
        <dt>Numéro Unique IPRES-CSS:</dt>
      </div>
      <div class="col-sm-4 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @user.numero_unique %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-4 text-sm-right" style="text-align: right;">
        <dt>Numero IPRES:</dt>
      </div>
      <div class="col-sm-4 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @user.try(:num_ipres) %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-4 text-sm-right" style="text-align: right;">
        <dt>Numero CSS:</dt>
      </div>
      <div class="col-sm-4 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @user.try(:num_css) %></dd>
      </div>
    </d1>
  </div>
</div>