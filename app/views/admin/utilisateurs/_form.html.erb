<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="ibox-content">
      <%= bootstrap_form_for([:admin, @user], layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
        <%= f.alert_message 'aa' %>
        <% if (current_user.admin? or current_user.super_admin?) and current_user != @user %>
          <%= f.select :type_profil,
                       current_user.type_profil_he_can_create.collect { |type_profil| [User.human_enum_name(:type_profil, type_profil), type_profil] },
                       label: 'Type de profil' %>
        <% end %>
        <%= f.text_field :nom, label: 'Nom' %>
        <%= f.text_field :prenom, label: 'Prénom' %>
        <%= f.select :sexe,
                     User::TYPE_SEXE.keys.collect { |sexe| [User.human_enum_name(:sexe, sexe), sexe] },
                     include_blank: true, label: 'Sexe' %>
        <%= f.email_field :email, label: 'Email', help: (@user.persisted? ? "un mail de confirmation sera envoyé si vous modifiez l'adresse mail" : '') %>
        <%= f.phone_field :telephone, label: 'Téléphone', help: "spécifiez l'indicatif du pays (ex: 221 77 000 00 00)" %>

        <%= f.collection_select :agence_id, @agences, :id, :description_prest, include_blank: true, label: 'Agence', required: true %>

        <div class="hr-line-dashed"></div>

        <div class="form-group row">
          <div class="col-sm-4 col-sm-offset-8" style="text-align: right;">
            <%= link_to 'Annuler', admin_users_path, class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>