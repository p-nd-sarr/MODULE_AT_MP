<%= render 'show_common_infos' %>

<div class="row" style="margin-top: 20px;">
  <div class="col-lg-12">
    <div class="m-b-md">
      <h2>Informations sur l'employeur actuel</h2>
    </div>
    <table class="footable table" data-page-size="8" data-filter="#filter" style="margin-top: 30px;">
      <thead>
      <tr>
        <th scope="col">Raison sociale</th>
        <th scope="col">Téléphon employeur</th>
        <th scope="col">Certificat de travail</th>
        
      </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= @user.try(:raison_sociale_employeur_actuel) %></td>
          <td><%= @user.try(:telephone_employeur_actuel) %></td>
          <td><%= link_to(image_tag('missing_logo.png', size: "100x100>", class: "m-t-xs img-responsive"), @user.certificat_travail_actuel, target: :_blank) if @user.certificat_travail_actuel.attached? %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>


<div class="row" style="margin-top: 20px;">
  <div class="col-lg-12">
    <div class="m-b-md">
      <h2>Informations sur l'employeur précédent</h2>
    </div>
    <table class="footable table" data-page-size="8" data-filter="#filter" style="margin-top: 30px;">
      <thead>
      <tr>
        <th scope="col">Raison sociale</th>
        <th scope="col">Téléphon employeur</th>
        <th scope="col">Certificat de travail</th>
        
      </tr>
      </thead>
      <tbody>
        <tr>
          <td><%= @user.try(:raison_sociale_employeur_precedent) %></td>
          <td><%= @user.try(:telephone_employeur_precedent) %></td>
          <td><%= link_to(image_tag('missing_logo.png', size: "100x100>", class: "m-t-xs img-responsive"), @user.certificat_travail_precedent, target: :_blank) if @user.certificat_travail_precedent.attached? %></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>


