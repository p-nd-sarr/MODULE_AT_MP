<%= bootstrap_form_for([:admin, @allocataire, @base_reversion], layout: :horizontal) do |f| %>
  <%= f.date_select :date_deces, label: 'Date du décès',
                    start_year: (Date.today - 65.year).year, end_year: Date.today.year,
                    default: { year: Date.today.year } %>
  <%= f.text_field :nombre_epouses_eligible %>
  <%= f.text_field :nombre_enfant_eligible %>
  <%= f.text_area :commentaire %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', [:admin, @allocataire], class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
