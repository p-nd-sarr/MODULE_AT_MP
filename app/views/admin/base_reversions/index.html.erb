<%= content_for :titre_page, 'Base Reversions' %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_base_reversion_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Numero allocataire</th>
        <th scope="col">Date deces</th>
        <th scope="col">Commentaire</th>
        <th colspan="3"></th>
      </tr>
      </thead>

      <tbody>
      <% @base_reversions.each do |base_reversion| %>
        <tr>
          <td><%= base_reversion.numero_allocataire %></td>
          <td><%= base_reversion.date_deces %></td>
          <td><%= base_reversion.commentaire %></td>
          <td style="width: 75px">
            <%= link_to 'détails', base_reversion, class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'modifier', edit_base_reversion_path(base_reversion), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'supprimer', base_reversion, method: :delete, data: {confirm: 'En êtes vous sûr?'}, class: 'btn btn-outline btn-danger btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>