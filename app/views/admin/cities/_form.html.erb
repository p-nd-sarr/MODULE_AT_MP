<%= bootstrap_form_for(@admin_city, layout: :horizontal) do |f| %>
    <%= f.text_field :description, label: 'Nom de la région' %>
    <%= f.collection_select :admin_country_id, @pays, :id, :description, label: 'Pays' %>


  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_cities_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
