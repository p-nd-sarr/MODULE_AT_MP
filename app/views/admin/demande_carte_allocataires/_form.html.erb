<%= bootstrap_form_for([:admin, @admin_demande_carte_allocataire], layout: :horizontal) do |f| %>
  <%= f.alert_message "Please fix the errors below." %>

  <%= f.hidden_field :allocataire_id %>
  <%= f.text_field :prenom %>
  <%= f.text_field :nom %>
  <%= f.date_field :date_naissance %>
  <%= f.text_field :nin %>
  <%= f.text_field :telephone %>
  <%= f.text_field :email %>
  <%= f.text_field :adresse %>
  <%= f.file_field :document_cni, label: "Pièce d'identité" %>
  <%= f.file_field :photo %>

  <%= f.select :agence_retrait_id, Admin::Agence.ipres.order(:description_prest).collect { |p| [p.description_prest, p.id] },
               { :include_blank => true }, class: 'form-control' %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', [:admin, @admin_demande_carte_allocataire.allocataire], class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
