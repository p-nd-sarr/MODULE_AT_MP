<% content_for :titre_page  do %>
<p>Dossier Rente Famille <%= "[#{@at_rente_famille.workflow_state}]" %> </p>
<% end %>
<%= content_for :titre_page_autres_details do %>
  Numéro Affiliation:  <%= " #{@arret_travail.numero_affiliation}" %> <br>
  Numéro Sinistre:  <%= " #{@arret_travail.num_dossier}" %> <br>
  Prénom et Nom: <%= @arret_travail.try(:prenom_salarie) %> <%= @arret_travail.try(:nom_salarie) %><br><br>
   <%= link_to "Dossier AT",  admin_arret_travail_path(@arret_travail), class: 'btn btn-success btn-sm' %>
