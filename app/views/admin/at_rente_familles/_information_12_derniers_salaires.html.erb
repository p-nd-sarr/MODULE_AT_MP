<div class="row" style="margin-top: 30px;" >
    <div class="col-lg-9">
        <h3>Liste des 12 derniers salaires</h3>
    </div>

    <div class="col-sm-3" style="text-align: right;">
      <% if !@at_rente_famille.valide_nb_salaire_annuel?%>
        <button class="btn btn-outline btn-success" data-toggle="modal" data-target="#salaire_at">Ajouter salaire </button>
      <% end %>
    </div>
    
      <div class="modal inmodal" id="salaire_at" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
        <div class="modal-dialog">
          <%= bootstrap_form_for(@at_salaire, url: admin_at_rente_famille_add_salaire_path(@at_rente_famille), method: :post, to: "controller#method", label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
          <%= f.alert_message "Please fix the errors below." %>
          <div class="modal-content animated fadeIn">
            <div class="modal-header">
              <button type="button" class="close" data-dismiss="modal">
                <span aria-hidden="true">x</span>
                <span class="sr-only">Close</span>
              </button>
              <h4 class="modal-title">Ajouter salaire</h4>
            </div>
            <div class="modal-body">
             <%=f.hidden_field :at_rente_famille_id, value: @at_rente_famille.id%>
                  <%=f.hidden_field :arret_travail_id, value: @at_rente_famille.arret_travail.id%>
                  <%= f.select :mois, AtSalaire::MOIS.keys.collect { |item| [ArretTravail.human_enum_name(:mois, item), item] }, label: 'Salaire du mois' %>
                  <%=f.number_field :montant %>
              </div>
            
            <div class="modal-footer form-group">
                <%= link_to 'Annuler', (@at_rente_famille.persisted? ? [:admin, @at_rente_famille] : admin_at_rente_familles_path), class: 'btn btn-white'%>
               <%= f.button 'Valider', class: 'btn btn-primary' %>
            </div>
          </div>
          <% end %>
        </div>
      </div>  
    <% if @last_salaires.count >= 0%>
    <div class="col-lg-12" style="margin-top: 20px;">
      <table class="table table-bordered table-condensed table-hover" style="margin-bottom: 30px;">
        <thead>
        <tr>
          <!--<th>Salaire N°</th> -->
          <th>Mois</th>
          <th>Montant</th>
          <th colspan="3">Actions </th>

        </tr>
        </thead>

        <tbody>
        <% @at_rente_famille.at_salaires.each_with_index do |salaire, index| %>
          <tr>
            
            <!--<td><%=index+1%></td> -->
            <td><%=salaire.mois%></td>
            <td><%=salaire.montant%> CFA</td>
           
              <td style="width: 75px">
                <% if !@at_rente_famille.information_salaire? %>
                  <%= (link_to 'Modifier',edit_admin_at_rente_famille_at_salaire_path(@at_rente_famille, id: salaire),class: 'btn btn-outline btn-warning btn-xs') %>
                <% end %>
              </td> 
            
           <!--
            <td style="width: 75px">
              <%#= (link_to 'Supprimer',admin_at_consolidation_at_salaire_path(@at_consolidation, id: salaire), method: :delete, data: { confirm: 'En êtes vous sûr?' },class: 'btn btn-outline btn-danger btn-xs') %>
            </td> 
           -->
          </tr>
        <% end %>
         <tr style="background: #1ab394; color: white">
           <th>Montant salaire annuel</th>
          <th colspan="3"><%=@at_rente_famille.salaire_annuel%></td>
        </tr>
        </tbody>
        
      </table>
    </div>
    <% end %>
</div>