<%= content_for :titre_page, 'Liste des dossiers Rentes Familles' %>

<%= content_for :actions_page do %>
    <%#= link_to 'Ajouter', new_admin_at_rente_famille_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
        <th scope="col">#</th>
        <th scope="col">Numéro dossier</th>
        <th scope="col">Prénom</th>
        <th scope="col">Nom</th>
        <th scope="col">Date du décès</th>
        <th scope="col">Etat</th>
        <th colspan="3">Actions </th>
    </tr>
    </thead>

    <tbody>
    <% @at_rente_familles.each do |at_rente_famille| %>
    <tr>
      <td><%=at_rente_famille.id%> 
      <td><%=at_rente_famille.arret_travail.try(:num_dossier)%></td>
      <td><%=at_rente_famille.arret_travail.try(:prenom_salarie)%></td>
      <td><%=at_rente_famille.arret_travail.try(:nom_salarie)%></td>
      <td><%=at_rente_famille.date_deces%></td>
      <td><%=at_rente_famille.workflow_state%> 
      <td style="width: 75px">
        <%= link_to 'détails', [:admin, at_rente_famille.arret_travail, at_rente_famille], class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>