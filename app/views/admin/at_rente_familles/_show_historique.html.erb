<div class="wrapper wrapper-content">
    <div class="row">
        <div class="col-lg-6">
            <h2> Création: </h2>
            <hr class="no-margins"> <br>

            <p><strong>Ouvert Par: </strong> <%= @at_rente_famille.ajoute_par.full_name unless @at_rente_famille.ajoute_par.nil? %></p>
            <p><strong>Date de création:  </strong> <%= @at_rente_famille.created_at.strftime("%d/%m/%Y à %H:%M") %></p>
        </div>

        <div class="col-lg-6">
            <h2> Soumission:  </h2>
                <hr class="no-margins"> <br>
            <p><strong>Soumis par: </strong><%= @at_rente_famille.soumis_par.full_name unless @at_rente_famille.soumis_par.nil? %></p>
            <p><strong>Date de soumission: </strong> <%= (@at_rente_famille.date_soumission.strftime("%d/%m/%Y à %H:%M")) unless @at_rente_famille.date_soumission.nil? %> </p>
        </div>
    </div>

    <br><br>

    <div class="row">
        <div class="col-lg-6"> 
            <h2> Validation en agence </h2>
            <hr class="no-margins"> <br>
            <p> <strong>Par: </strong> <%= @at_rente_famille.valide_chef_agence_par.full_name unless @at_rente_famille.valide_chef_agence_par.nil? %></p>
            <p><strong> Date de validation: </strong> <%= @at_rente_famille.date_validation_chef_agence.strftime("%d/%m/%Y à %H:%M") unless @at_rente_famille.date_validation_chef_agence.nil?%></p>
        </div>

        <div class="col-lg-6"> 
            <h2> Validation service AT</h2>
            <hr class="no-margins"> <br>
            <p> <strong>Par: </strong> <%= @at_rente_famille.valide_chef_service_par.full_name unless @at_rente_famille.valide_chef_service_par.nil? %></p>
            <h5><strong> Date de validation: </strong>  <%= (@at_rente_famille.date_validation_chef_service.strftime("%d/%m/%Y à %H:%M")) unless @at_rente_famille.date_validation_chef_service.nil? %> </h5>
        </div>
        
    </div>
    
    <br><br>

    <div class="row">
        <div class="col-lg-6"> 
            <h2> Validation direction AT </h2>
             <hr class="no-margins"> <br>
            <p> <strong>Par: </strong>  <%= @at_rente_famille.valide_dir_at_par.full_name unless @at_rente_famille.valide_dir_at_par.nil? %> </p> 
            <p><strong> Date de validation: </strong> <%= @at_rente_famille.date_validation_directeur_at.strftime("%d/%m/%Y à %H:%M") unless @at_rente_famille.date_validation_directeur_at.nil? %></p>
        </div>

        <div class="col-lg-6"> 
            <h2> Validation Audit CSS</h2>
            <hr class="no-margins"> <br>
            <p> <strong>Par: </strong> <%= @at_rente_famille.validation_audit_par.full_name unless @at_rente_famille.validation_audit_par.nil? %></p>
            <p> <strong>Date de validation: </strong>  <%= (@at_rente_famille.date_validation_audit.strftime("%d/%m/%Y à %H:%M")) unless @at_rente_famille.date_validation_audit.nil? %> </p>
        </div>
        
    </div>

    <div class="row">
        <div class="col-lg-6"> 
            <h2> Validation Direction Générale</h2>
            <hr class="no-margins"> <br>
            <p> <strong>Par: </strong> <%= @at_rente_famille.valide_dg_par.full_name unless @at_rente_famille.valide_dg_par.nil? %></p>
            <p> <strong>Date de validation: </strong>  <%= (@at_rente_famille.date_validation_directeur_general.strftime("%d/%m/%Y à %H:%M")) unless @at_rente_famille.date_validation_directeur_general.nil? %> </p>
        </div>
        
    </div>
</div>