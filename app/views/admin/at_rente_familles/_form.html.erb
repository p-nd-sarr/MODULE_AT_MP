<%#= bootstrap_form_for(@at_rente_famille, layout: :horizontal) do |f| %>
<%= bootstrap_form_for([:admin,@arret_travail, @at_rente_famille], label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
 <div class="row">
    <div class="col-lg-12">
        <%=f.hidden_field :ajoute_par_id, value: current_user.id%>
      <div class="col-lg-6">
        <%= f.text_area :motif_deces , label: "Motif du décès", class:'form-control' %>
      </div>

      <div class="col-lg-6">
        <%= f.date_select :date_deces, label: 'Date du décès:' %>
      </div>
    </div>
  </div>

  <div class="hr-line-dashed"></div>
  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_at_rente_familles_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
