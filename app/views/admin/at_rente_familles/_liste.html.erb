<%= paginate @at_rente_familles %>

<table class="table table-striped" style="margin-top: 20px">
  <thead>
  <tr>
    <th scope="col">#</th>
    <th scope="col">Numéro dossier</th>
    <th scope="col">Prénom</th>
    <th scope="col">Nom</th>
    <th scope="col">Date décès</th>
    <th scope="col">Etat</th>
    <th colspan="3">Actions </th>
  </tr>
  </thead>

  <tbody>
  <% @at_rente_familles.each do |at_rente_famille| %>
      <tr>
        <td></td>
        <td><%=at_rente_famille.arret_travail.num_dossier%></td>
        <td><%=at_rente_famille.arret_travail.prenom_salarie%></td>
        <td><%=at_rente_famille.arret_travail.nom_salarie%></td>
        <td><%=at_rente_famille.date_deces%></td>
        <td><%=at_rente_famille.workflow_state%> 
      
        </td>
        <td style="width: 75px">
         <%= link_to 'détails', [:admin, at_rente_famille], class: 'btn btn-outline btn-primary btn-xs' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= paginate @at_rente_familles %>
