<%= bootstrap_form_for([:admin, @at_vente_carnet], layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  <%= f.alert_message "Une erreur est survenue lors de l'enregistrement" %>

  <div class="row">
    <div class="col-sm-6">
      <h6>Informations carnet</h6>
      <hr>
      <%= f.text_field :num_employeur, class: 'form-control', label: 'Numéro Employeur', required: true %>
      <%= f.text_field :num_recu, class: 'form-control', label: 'Numéro Reçu', required: true %>
      <%= f.date_field :date_delivrance, class: 'form-control', label: 'Date Délivrance', required: true %>
      <%= f.text_field :num_carnets, class: 'form-control', label: 'Nombre de carnets', required: true %>
    </div>
    <div class="col-sm-6 scroller">
      <h6>Plage de numéros</h6>
      <hr>
      <div id="numero-carnet-box" class="numero-carnet-box">
        <%= number_field_tag "numero_carnet[]", @at_vente_carnet.numero_carnet.count.zero? ? 0 : @at_vente_carnet.numero_carnet.first, options = { class: 'form-control', id: 'numero-carnet' } %>
      </div>
    </div>
  </div>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-4">
      <%= link_to 'Annuler', (@at_vente_carnet.persisted? ? [:admin, @at_vente_carnet] : admin_at_vente_carnets_path), class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          chargerListCarnet();

          $("#at_vente_carnet_num_carnets").change(function () {
              deleteLisCarnet()
              chargerListCarnet()
          });

          $("#numero-carnet").change(function () {
              reloadListCarnets()
          });

          function chargerListCarnet() {
              let number_carnets = $("#at_vente_carnet_num_carnets").val();
              let id_carnet = $("#numero-carnet").val();

              for (let i = 1; i < number_carnets; i++) {
                  let frm_element = document.getElementById('numero-carnet').cloneNode(true);
                  frm_element.value = parseInt(id_carnet) + i
                  frm_element.classList.add("added_elt")
                  frm_element.readOnly = true
                  let vis = frm_element.style;
                  vis['margin-top'] = '15px';
                  document.getElementById("numero-carnet-box").appendChild(frm_element);
              }
          }

          function deleteLisCarnet() {
              let elements = document.getElementsByClassName("added_elt");
              if (elements.length > 0) {
                  for (let i = elements.length - 1; i >= 0; i--) {
                      elements[i].remove();
                  }
              }
          }

          function reloadListCarnets() {
              let id_carnet = $("#numero-carnet").val();
              let elements = document.getElementsByClassName("added_elt");
              for (let i = 0; i < elements.length; i++) {
                  elements[i].value = parseInt(id_carnet) + i + 1;
              }
          }
      })
  </script>
<% end %>

<style>
    .scroller {
        height: 300px;
        overflow-y: scroll;
        scrollbar-color: rebeccapurple green;
        scrollbar-width: thin;
    }
</style>
