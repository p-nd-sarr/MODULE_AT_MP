<%= bootstrap_form_for([:admin, @reversion_veuve_salarie], url: admin_base_reversion_salary_update_exceptionally_path, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  <%= f.alert_message "Please fix the errors below." %>
  <div class="row">

    <div class="col-lg-12 form-group">
      <div class="col-sm-4">
        <%= f.text_field :prenom, label: 'Prénom', required: true %>
      </div>
      <div class="col-sm-4">
        <%= f.text_field :nom, label: 'Nom', required: true %>
      </div>
    </div>

    <div class="col-lg-12 form-group">
      <div class="col-sm-6">
        <%= f.select :sexe, BaseReversionSalary::SEXE.keys.collect { |sexe| [BaseReversionSalary.human_enum_name(:sexe, sexe), sexe] }, required: true %>
      </div>
      <div class="col-sm-6">
        <%= f.date_select :date_naissance, label: 'Date de naissance', class: "form-control",
                          start_year: (Date.today - 100.year).year, end_year: (Date.today).year, required: true %>
      </div>
    </div>

    <div class="col-lg-12 form-group">
      <div class="col-sm-6">
        <%= f.date_select :date_cessation_activite, label: "Date de céssation d'activité",
                          start_year: (Date.today - 40.year).year, end_year: (Date.today + 42.year).year, required: true %>
      </div>
      <div class="col-sm-6">
        <%= f.date_select :date_deces, label: 'Date de déces',
                          start_year: (Date.today - 100.year).year, end_year: (Date.today).year, required: true %>
      </div>
    </div>

    <div class="col-lg-12 form-group">
      <hr>
      <div class="col-lg-3 col-lg-offset-9" style="text-align: right;">
        <%= link_to 'Annuler', admin_base_reversion_salary_path(@reversion_veuve_salarie), class: 'btn btn-white' %>
        <%= f.button 'Valider', class: 'btn btn-primary' %>
      </div>
    </div>

  </div>
<% end %>
