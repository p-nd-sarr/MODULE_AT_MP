<%= content_for :titre_page, "Motif du retour de la demande de reversion avant liquidation" %>

<div class="form-group row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="wrapper wrapper-content">
      <div class="ibox-content">
        <%= bootstrap_form_for(@reversion_veuve_salarie, url: admin_base_reversion_salary_retourner_process_path(@reversion_veuve_salarie), layout: :horizontal) do |f| %>
          <%= f.text_area :motif, label: 'Motif' %>

          <div class="hr-line-dashed"></div>

          <div class="form-group row">
            <div class="col-sm-4 col-sm-offset-2">
              <%= link_to 'Annuler', admin_base_reversion_salaries_path, class: 'btn btn-white' %>
              <%= f.button 'Retourner Dossier', class: 'btn btn-primary' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>