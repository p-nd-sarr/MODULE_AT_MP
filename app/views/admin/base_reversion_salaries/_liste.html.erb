<%= paginate @reversion_veuve_salaries %>

<table class="table table-striped" style="margin-top: 20px">
  <thead>
  <tr>
    <th scope="col">N° dossier</th>
    <th scope="col">Prénom</th>
    <th scope="col">Nom</th>
    <th scope="col">Date de naissance</th>
    <th scope="col">Etat</th>
    <th colspan="2"></th>
  </tr>
  </thead>

  <tbody>
  <% @reversion_veuve_salaries.each do |reversion_veuve| %>
    <tr>
      <td>
        <% if reversion_veuve.numero_dossier.nil? %>
          <%= reversion_veuve.numero_affiliation %>
        <% else %>
          <%= reversion_veuve.numero_dossier %>
        <% end %>
      </td>
      <td><%= reversion_veuve.prenom %></td>
      <td><%= reversion_veuve.nom %></td>
      <td><%= l reversion_veuve.date_naissance %></td>
      <td><%= reversion_veuve.workflow_state %></td>

      <td style="width: 75px">
        <%= link_to 'détails', [:admin, reversion_veuve], class: 'btn btn-outline btn-primary btn-xs' %>
      </td>

      <% if reversion_veuve.created_at? %>
        <td> <%= link_to 'Récépissé', admin_base_reversion_salary_show_facture_path(reversion_veuve.id, format: :pdf), class: "btn btn-outline btn-success btn-xs my-2 my-sm-0", target: '_blank' %></td>
      <% end %>

    </tr>
  <% end %>
  </tbody>
</table>
<%= paginate @reversion_veuve_salaries %>
