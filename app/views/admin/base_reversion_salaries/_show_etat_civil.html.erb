<div class="row">
  <div class="col-lg-12" style="text-align: right;">
    <% if (current_user.can_allocataire? and @reversion_veuve_salarie.ajoute_par == current_user) %>
      <%= link_to ' Modifier', edit_admin_base_reversion_salary_path(@reversion_veuve_salarie), class: "btn btn-outline btn-success fa fa-edit" %>
    <% end %>
    <% if current_user.admin? or (current_user.inspection? and current_user.admin_agence == @reversion_veuve_salarie.ajoute_par.admin_agence) %>
      <%= link_to ' Modification exceptionnelle', admin_base_reversion_salary_exceptional_edit_path(@reversion_veuve_salarie), class: "btn btn-outline btn-success fa fa-edit" %>
    <% end %>
  </div>
  <div class="col-lg-6">
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-user"></span> Prénom & nom:</dt>
      </div>
      <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
        <dd class="mb-1"><%= @reversion_veuve_salarie.prenom %> <%= @reversion_veuve_salarie.nom %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-calendar"></span> Date de naissance: </dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= l @reversion_veuve_salarie.date_naissance %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-users"></span> Nombre de femmes prévus: </dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @reversion_veuve_salarie.nombre_epouses_eligible %></dd>
      </div>
    </d1>
  </div>
  <div class="col-lg-6">
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt><span class="fa fa-calendar"></span> Date de cessation d'activité:</dt>
      </div>
      <div class="col-sm-6 text-sm-left text-danger" style="text-align: left;">
          <dd class="mb-1"><%= (l @reversion_veuve_salarie.date_cessation_activite) unless @reversion_veuve_salarie.date_cessation_activite.nil? %></dd>
      </div>
    </d1>  
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt><span class="fa fa-calendar"></span> Date de déces:</dt>
      </div>
      <div class="col-sm-6 text-sm-left text-danger" style="text-align: left;">
          <dd class="mb-1"><%= (l @reversion_veuve_salarie.date_deces) unless @reversion_veuve_salarie.date_cessation_activite.nil? %></dd>
      </div>
    </d1>  
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-users"></span> Nombre d'enfants prévu: </dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @reversion_veuve_salarie.nombre_enfant_eligible %></dd>
      </div>
    </d1>
  </div>
</div>








