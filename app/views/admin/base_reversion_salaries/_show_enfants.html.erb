<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">Nom</th>
    <th scope="col">Prénom</th>
    <th scope="col">Date de naissance</th>
    <th scope="col">Nom salarie</th>
    <th scope="col">Prénom salarié</th>
    <th scope="col">Nom complet conjoint</th>
    <th scope="col">Reversion</th>
    <th scope="col">Documents</th>
  </tr>
  </thead>

  <tbody>
  <% @reversion_veuve_salarie.enfants.each do |enfant| %>
    <tr>
      <td><%= enfant.nom %></td>
      <td><%= enfant.prenom %></td>
      <td><%= l enfant.date_naissance %></td>
      <td><%= enfant.nom_salarie %></td>
      <td><%= enfant.prenom_salarie %></td>
      <% if enfant.conjoint_id %>
        <td><%= enfant.conjoint.full_name %></td>
      <% else %>
        <td></td>
      <% end %>

      <% unless @reversion_veuve_salarie.enfants_id.nil? %>
        <td>

          <% @reversion_veuve_salarie.enfants_id.each do |enfant_id| %>
              <% if enfant.id == enfant_id.to_i%>
                <p><span class="label label-success">Demandeur</span></p>
              <% end %>
          <% end %>
        </td>
      <% end %>
      
      <td style="width: 75px">
        <%= link_to 'lien vers les documents', admin_enfant_path(enfant), :target => '_blank', class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
     
    </tr>
  <% end %>
  </tbody>
</table>


