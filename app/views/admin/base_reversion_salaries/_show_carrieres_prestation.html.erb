</table>

<div class="modal inmodal" id="create_carriere" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
   <%= bootstrap_form_for(@carriere, url: admin_base_reversion_salary_ajouter_carriere_path(@reversion_veuve_salarie), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
      <div class="modal-content animated bounceInRight">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
          <i class="fa fa-laptop modal-icon"></i>
          <h4 class="modal-title">Ajouter carrière </h4>
        </div>
        <div class="modal-body">
          <%= f.text_field :ref_employeur, label: 'Numéro Employeur', class: 'form-control', required: true %>

          <%= f.text_field :raison_sociale, label: 'Raison Sociale', readonly: true %>

          <%= f.collection_select :type_regime_id, Admin::TypeRegime.all, :id, :description, include_blank: true, label: 'Type Regime', tag: 'type_regime', required: true %>

          <%= f.select :exercice, Date.today.year - 60..Date.today.year + 0 %>

          <%= f.date_select :date_entree, label: "Date d'entrée",
                            start_year: (Date.today - 50.year).year, end_year: Date.today.year, id: "test_id " %>

          <%= f.date_select :date_sortie, label: "Date de sortie",
                            start_year: (Date.today - 50.year).year, end_year: Date.today.year %>

          <%= f.text_field :salaire1, label: 'Salaire 1', class: 'form-control' %>

          <%= f.text_field :salaire2, label: 'Salaire 2', class: 'form-control' %>

          <%#= f.select :motif, [['Certificat d emploi et de salaire', 'Certificat d emploi et de salaire'], ['Saisie de déclarations', 'Saisie de déclarations'], ['Fusion de carrière', 'Fusion de carrière']], label: "Motif"%>

        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
          <button type="submit" class="btn btn-primary" id="soumettre_button_id">Ajouter</button>
        </div>
      </div>
    <% end %>
  </div>
</div>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          chargerInfosEmployeur();


          $('#soumettre_button_id').hide();

          var exercice = $('#carriere_exercice').val();
          var date_entree = $('#carriere_date_entree_1i').val();
          var date_sortie = $('#carriere_date_sortie_1i').val();
          if (exercice === date_entree && exercice === date_sortie) {
              console.log('true');
              $('#soumettre_button_id').show();
          } else {
              $('#soumettre_button_id').hide();
          }


          $('#carriere_ref_employeur').change(function () {
              chargerInfosEmployeur();
          })

          function chargerInfosEmployeur() {
              let ref_employeur = $('#carriere_ref_employeur').val();
              $.ajax({
                  url: "/admin/employeurs/" + ref_employeur + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      if (data) {
                          $("#carriere_raison_sociale").val(data.fhrsoc);
                      } else {
                          $("#carriere_raison_sociale").val('');
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      $("#carriere_raison_sociale").val('');
                      $("#carriere_raison_sociale").val('');
                  }
              });
          }


          $("#carriere_date_entree_1i").change(function () {
              var exercice = $('#carriere_exercice').val();
              var date_entree = $('#carriere_date_entree_1i').val();
              var date_sortie = $('#carriere_date_sortie_1i').val();

              var date_entree_mois = $('#carriere_date_entree_2i').val();
              var date_sortie_mois = $('#carriere_date_sortie_2i').val();

              if (exercice === date_entree && exercice === date_sortie) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

              if (date_sortie_mois > date_entree_mois) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

          });

          $("#carriere_date_sortie_1i").change(function () {
              var exercice = $('#carriere_exercice').val();
              var date_entree = $('#carriere_date_entree_1i').val();
              var date_sortie = $('#carriere_date_sortie_1i').val();

              var date_entree_mois = $('#carriere_date_entree_2i').val();
              var date_sortie_mois = $('#carriere_date_sortie_2i').val();

              if (exercice === date_entree && exercice === date_sortie) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

              if (date_sortie_mois > date_entree_mois) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }
          });

          $("#carriere_date_entree_2i").change(function () {
              var date_entree_mois = $('#carriere_date_entree_2i').val();
              var date_sortie_mois = $('#carriere_date_sortie_2i').val();

              if (parseInt(date_sortie_mois) > parseInt(date_entree_mois)) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

          });

          $("#carriere_date_sortie_2i").change(function () {
              var date_entree_mois = $('#carriere_date_entree_2i').val();
              var date_sortie_mois = $('#carriere_date_sortie_2i').val();

              if (parseInt(date_sortie_mois) > parseInt(date_entree_mois)) {
                  $('#soumettre_button_id').show();
              } else {
                  $('#soumettre_button_id').hide();
              }

          });

      })
  </script>
<% end %>
