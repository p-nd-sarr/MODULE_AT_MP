<% if (@reversion_veuve_salarie.carrieres_prestation.traite.size < @reversion_veuve_salarie.carrieres_prestation.size) and @reversion_veuve_salarie.affecter_salarie == current_user %>
  <%= link_to "Je valide toutes les carrières", admin_base_reversion_salary_valider_all_carrieres_path(@reversion_veuve_salarie), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
 <hr>
<% end %>

<% if @reversion_veuve_salarie.can_integrate_carrieres?(current_user)%>
  <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#create_carriere" id="create_carriere_id">
    Integration de carrière
  </button>
<% end %>

<% if @reversion_veuve_salarie.current_state >= :cotisation_valide %>
  <h2>TOTAL POINTS RÉGIME GÉNÉRAL
    : <%= format_entier @reversion_veuve_salarie.carrieres_prestation.regime_general.sum(:points) %></h2>
  <h2>TOTAL POINTS RÉGIME CADRE
    : <%= format_entier @reversion_veuve_salarie.carrieres_prestation.regime_cadre.sum(:points) %></h2>
<% end %>


<h3>Régime Général</h3>
<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">Exercice</th>
    <th scope="col">Employeur</th>
    <th scope="col">Période</th>
    <!--  <th scope="col">Régime</th> -->
    <th scope="col">Salaire 1</th>
    <th scope="col">Salaire 2</th>
    <th scope="col">Salaire Réel</th>
    <th scope="col">Points</th>
    <th scope="col">Etat</th>
    <th scope="col">Est repris?</th>
    <th colspan="3">Action</th>
 
  </tr>
  </thead>

  <tbody>
  <% @reversion_veuve_salarie.carrieres_prestation.regime_general.order("date_sortie asc").each do |carriere| %>
    <tr class="<%= 'bg-danger' if carriere.points.zero? %>">
      <td><%= carriere.exercice %></td>
      <td><%= carriere.raison_sociale %></td>
      <td> <%= l carriere.date_entree %> - <%= l carriere.date_sortie %> </td>
      <!--      <td><%#= carriere.type_regime.code %></td>-->
      <td align="right"><%= format_cfa(carriere.salaire1, false) %></td>
      <td align="right"><%= format_cfa(carriere.salaire2, false) %></td>
      <td align="right"><%= format_cfa(carriere.salaire, false) %></td>
      <!--      <td align="right"><%#= carriere.points %></td>-->
      <td align="right"><%= carriere.points %></td>
      <td align="right"><%= carriere.etat %></td>
      <td align="right"><%= state_yes_no carriere.est_repris? %></td>
      <% if @reversion_veuve_salarie.affecter_salarie == current_user  %>
        <td style="width: 75px">
          <%= (link_to 'valider', admin_base_reversion_salary_valider_ligne_carriere_path(@reversion_veuve_salarie, carriere_id: carriere.id), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-outline btn-primary btn-xs') unless carriere.valide? or  carriere.rejete? %>
        </td>
        <td style="width: 75px">
         <% unless carriere.valide? or carriere.rejete? %>
            <button type="button" class="btn btn-outline btn-danger btn-xs" data-toggle="modal" data-target="#modal-<%= carriere.id %>">rejeter
            </button>

            <!-- Rejeter carriere-->
            <div class="modal inmodal" id="modal-<%= carriere.id %>" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
              <div class="modal-dialog">
                <div class="modal-content animated bounceInRight">
                  <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">
                      <span aria-hidden="true">x</span>
                      <span class="sr-only">Close</span>
                    </button>
                    <h5 class="modal-title">Rejet carriere année exercice <%= carriere.exercice %></h5>
                  </div>
                  <%= bootstrap_form_for(@carriere, url: admin_base_reversion_salary_rejeter_ligne_carriere_path(@reversion_veuve_salarie, carriere_id: carriere.id)) do |f| %>
                    <div class="modal-body">
                      <%= f.text_area :motif_rejet, label: 'Motif' %>
                    </div>

                    <div class="modal-footer form-group">
                      <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
                      <%= f.button 'rejeter', class: 'btn btn-primary' %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          <% end %>
        </td>
      <% end %>
      <td style="width: 75px">
        <%= (link_to 'detail', admin_base_reversion_salary_carriere_path(@reversion_veuve_salarie, carriere.id), class: 'btn btn-outline btn-primary btn-xs') %>
      </td>
     
    </tr>
  <% end %>
  </tbody>
</table>

