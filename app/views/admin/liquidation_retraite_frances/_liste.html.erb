<%= paginate @demande_liquidations %>

<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">N° dossier</th>
    <th scope="col">Prénom</th>
    <th scope="col">Nom</th>
    <th scope="col">Date de naissance</th>
    <th scope="col">Adresse domicile</th>
    <th scope="col">Agence</th>
    <th scope="col">Mode de paiement</th>
    <th scope="col">Etat</th>
    <th colspan="2"></th>
  </tr>
  </thead>

  <tbody>
  <% @demande_liquidations.each do |demande_liquidation| %>
    <%# if demande_liquidation.resident_fr? %>
    <tr style="background-color: mistyrose">
      <% if demande_liquidation.resident_sn? %>
      <tr style="background-color: paleturquoise">
    <% else %>
      <tr>
    <% end %>
    <td>
      <% if demande_liquidation.num_dossier.nil? %>
        <%= demande_liquidation.numero_affiliation %>
      <% else %>
        <%= demande_liquidation.num_dossier %>
      <% end %>
    </td>
    <td><%= demande_liquidation.prenom %></td>
    <td><%= demande_liquidation.nom %></td>
    <td><%= l demande_liquidation.date_naissance %></td>
    <td><%= demande_liquidation.adresse_reception_allocation %></td>
    <td><%= demande_liquidation.agence_creation.try(:description_prest) %></td>
    <td><%= demande_liquidation.mode_paiement_human %></td>
    <td><%= LiquidationRetraiteFrance.workflow_spec.states[demande_liquidation.workflow_state.to_sym].meta[:label] %></td>
    <td style="width: 75px">
      <%= (link_to 'Details', admin_liquidation_retraite_france_path(demande_liquidation), class: 'btn btn-outline btn-primary btn-xs') %>
    </td>
    <!--      <td>-->
    <%# if demande_liquidation.created_at? %>
    <%#= link_to 'Récépissé', admin_liquidation_retraite_france_show_facture_path(demande_liquidation.id, format: :pdf), class: "btn btn-outline btn-info btn-xs my-2 my-sm-0", target: '_blank' %>

    <%#= link_to 'Formulaire de liaison', admin_liquidation_retraite_france_show_formulaire_path(demande_liquidation.id, format: :pdf), class: "btn btn-outline btn-success btn-xs my-2 my-sm-0", target: '_blank' %>
    <%# end %>
    <!--      </td>-->
    <td width="90px" class="dropdown">
      <button class="btn btn-primary btn-xs dropdown-toggle" type="button" data-toggle="dropdown"> Options
        <span class="caret"></span>
      </button>
      <ul class="dropdown-menu">
        <% if demande_liquidation.created_at? %>
          <li>
            <%= link_to 'Récépissé', admin_liquidation_retraite_france_show_facture_path(demande_liquidation.id, format: :pdf), class: "btn btn-outline btn-info btn-xs my-2 my-sm-0", target: '_blank' %>
          </li>
          <li>
            <%= link_to 'Formulaire de liaison', admin_liquidation_retraite_france_show_formulaire_path(demande_liquidation.id, format: :pdf), class: "btn btn-outline btn-success btn-xs my-2 my-sm-0", target: '_blank' %>
          </li>
        <% end %>
      </ul>
    </td>
    </tr>
  <% end %>
  </tbody>
</table>

<%= paginate @demande_liquidations %>
