<div class="row" style="margin-top: 30px;">
  <div class="col-lg-9">
  </div>
  <div class="col-sm-3" style="text-align: right;">
    <button class="btn btn-outline btn-success" data-toggle="modal" data-target="#correspondance">Ajouter une
      correspondance
    </button>
    <div class="modal inmodal" id="correspondance" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
      <div class="modal-dialog">
        <%= bootstrap_form_for(@cfs_correspondance, url: admin_liquidation_retraite_france_ajouter_cfs_correspondance_path(@demande_liquidation), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
          <%= f.alert_message "Please fix the errors below." %>
          <div class="modal-content animated fadeIn">
            <div class="modal-header">
              <button type="button" class="close" data-dismiss="modal">
                <span aria-hidden="true">x</span>
                <span class="sr-only">Close</span>
              </button>
              <h4 class="modal-title">Ajouter une lettre de correspondance </h4>
            </div>
            <div class="modal-body">
              <%= f.select :provenance, CfsCorrespondance::PROVENANCE.keys.collect { |provenance| [CfsCorrespondance.human_enum_name(:provenance, provenance), provenance] }, include_blank: true, label: 'Provenance' %>
              <%= f.text_field :numero_correspondance, label: "N° Correspondance" %>
              <%= f.text_field :numero_reference, label: "N° V/Réf" %>
              <%= f.select :type_lettre, CfsCorrespondance::TYPE_LETTRE.keys.collect { |type_lettre| [CfsCorrespondance.human_enum_name(:type_lettre, type_lettre), type_lettre] }, include_blank: true, label: 'Type de la lettre' %>
              <%= f.text_field :objet, label: "Objet" %>
              <%= f.select :titre_destinataire, CfsCorrespondance::TITRE_DESTINATAIRE.keys.collect { |titre_destinataire| [CfsCorrespondance.human_enum_name(:titre_destinataire, titre_destinataire), titre_destinataire] }, label: 'Titre du destinataire' %>
              <%= f.text_field :destinataire, label: "Destinataire" %>
              <%= f.text_field :adresse_destinataire, label: "Adresse du destinataire" %>
              <%= f.text_field :expediteur, label: "Expiditeur", required: true %>
              <%= f.select :titre_demandeur, CfsCorrespondance::TITRE_DEMANDEUR.keys.collect { |titre_demandeur| [CfsCorrespondance.human_enum_name(:titre_demandeur, titre_demandeur), titre_demandeur] }, label: 'Titre du demandeur' %>
              <%= f.file_field :lettre, label: "Lettre", required: false %>
              <%= f.text_area :corps, label: "Corps", required: false %>
              <%= f.check_box :piece_jointe, label: "Piece(s) jointe(s) incluses ?", help: 'Cochez si une ou des pieces sont jointes' %>
              <div class="col-lg-12" style="background-color: rgba(240,240,240,0.6); padding-top: 10px; padding-bottom: 3px;" id="div_pj" hidden="hidden">
                <%= f.text_area :nature_piece_jointe, label: "PJ" %>
              </div>

            </div>
            <div class="modal-footer form-group">
              <%= f.button 'Valider', class: 'btn btn-primary' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<div class="wrapper wrapper-content ">
