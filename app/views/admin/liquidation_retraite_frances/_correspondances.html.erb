                      <% end %>
                    </div>
                    <div class="col-lg-11" style="margin-left: -1%;">
                      <div class="media-body" style="width: 100%; float: left">
                        <small style="float: right;">
                          il y a <%= time_ago_in_words_custom(correspondance.date) %>
                        </small>
                        <div class="row">
                          <div class="col-lg-8">
                            Correspondance n° <strong><%= correspondance.numero_correspondance %></strong>
                            <br>
                            <small class="text-muted">
                              Référence : <%= correspondance.numero_reference %>
                              <br>
                              Objet
                              : <%= CfsCorrespondance.human_enum_name(:type_lettre, correspondance.type_lettre) unless correspondance.type_lettre.nil? %>
                            </small>
                          </div>
                          <div class="col-lg-4">
                            <div class="actions" style="float: right;">
                              <%#= link_to image_tag('missing_logo.png', size: "200x200>", class: "m-t-xs img-responsive"), cfs_correspondance.lettre, target: :_blank %>

                              <%=link_to ' lettre', correspondance.lettre, class: "btn btn-outline btn-info btn-xs my-2 my-sm-0 fa fa-file-text", target: '_blank' if correspondance.lettre.attached? %>

                              <%= link_to ' supprimer', admin_liquidation_retraite_france_destroy_cfs_correspondance_path(@demande_liquidation, correspondance.id), method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs fa fa-trash' %>
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
