<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          chargerInfosPJ();

          $("#cfs_correspondance_piece_jointe").change(function () {
              chargerInfosPJ()
          });

          function chargerInfosPJ() {
              elem_infos_pj = $('#div_pj')
              if (cfs_correspondance_piece_jointe.checked === true) {
                  elem_infos_pj.show();
                  $('#cfs_correspondance_nature_piece_jointe').attr('disabled', false);
              } else {
                  elem_infos_pj.hide();
                  $('#cfs_correspondance_nature_piece_jointe').attr('disabled', true).val(null);
              }
          }
      })
  </script>
<% end %>