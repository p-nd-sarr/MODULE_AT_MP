<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          chargerInfosCompteBancaire();
          chargerInfosParticipant();
          chargerRegions();
          chargerInfosInapte();
          chargerInfosInstitution_deb();
          showAndHideNombreFemme();
          // chargerInfosActiviteConj();
          // chargerInfosAvantViellesseConj();

          // $('#liquidation_retraite_france_date_cess_act_conjoint_3i').prop("disabled", true).val('');
          // $('#liquidation_retraite_france_date_cess_act_conjoint_2i').prop("disabled", true).val('');
          // $('#liquidation_retraite_france_date_cess_act_conjoint_1i').prop("disabled", true).val('');

          // $('#liquidation_retraite_france_date_cess_act_conjoint_3i').val('');
          // $('#liquidation_retraite_france_date_cess_act_conjoint_2i').val('');
          // $('#liquidation_retraite_france_date_cess_act_conjoint_1i').val('');

          $("#liquidation_retraite_france_mode_paiement").change(function () {
              chargerInfosCompteBancaire()
          });
          $("#liquidation_retraite_france_inapte").change(function () {
              chargerInfosInapte()
          });
          $("#liquidation_retraite_france_titre_reg_special").change(function () {
              chargerInfosInstitution_deb()
          });

          $('#liquidation_retraite_france_regime_matrimoniale').on('change', function () {
              showAndHideNombreFemme();
          });
          // $("#liquidation_retraite_france_carriere_conjoint").change(function () {
          //     chargerInfosActiviteConj()
          // });
          // $("#liquidation_retraite_france_avantage_viellesse_conjoint").change(function () {
          //     chargerInfosAvantViellesseConj()
          // });

          function chargerInfosCompteBancaire() {
              let mode_paiement = $('#liquidation_retraite_france_mode_paiement').val();
              let elem_mode_paiement_virement = $('#mode_paiement_virement')
              if (mode_paiement === 'virement') {
                  $('#liquidation_retraite_france_admin_banque_agence_id').attr('disabled', false);
                  $('#liquidation_retraite_france_compte_bancaire_numero_compte').attr('disabled', false);
                  $('#liquidation_retraite_france_compte_bancaire_cle_rib').attr('disabled', false);
                  elem_mode_paiement_virement.show();
              } else {
                  elem_mode_paiement_virement.hide();
                  $('#liquidation_retraite_france_admin_banque_agence_id').attr('disabled', true);
                  $('#liquidation_retraite_france_compte_bancaire_numero_compte').attr('disabled', true);
                  $('#liquidation_retraite_france_compte_bancaire_cle_rib').attr('disabled', true);
              }
              let elem_mode_paiement_caisse = $('#mode_paiement_caisse')
              if (mode_paiement === 'caisse_ipres' || mode_paiement === 'paiement_a_domicile') {
                  $('#liquidation_retraite_france_admin_agence_id').attr('disabled', false);
                  elem_mode_paiement_caisse.show();
              } else {
                  elem_mode_paiement_caisse.hide();
                  $('#liquidation_retraite_france_admin_agence_id').attr('disabled', true);
              }
              let elem_adresse_paiement = $('#adresse_paiement')
              if (mode_paiement === 'paiement_a_domicile') {
                  $('#liquidation_retraite_france_adresse_paiment').attr('disabled', false);
                  elem_adresse_paiement.show();
              } else {
                  elem_adresse_paiement.hide();
                  $('#liquidation_retraite_france_adresse_paiment').attr('disabled', true);
              }
          }

          $('#liquidation_retraite_france_numero_affiliation').change(function () {
              chargerInfosParticipant();
          })

          function chargerInfosParticipant() {
              let numero_affiliation = $('#liquidation_retraite_france_numero_affiliation').val();
              let elem_message_erreur = $('#message-erreur')
              $.ajax({
                  url: "/admin/salaries/" + numero_affiliation + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      if (data) {
                          $("#liquidation_retraite_france_prenom").val(data.prenom);
                          $("#liquidation_retraite_france_nom").val(data.nom);
                          elem_message_erreur.hide();
                          $("#message-erreur").text(''); // Effacer le message d'erreur si le numéro est valide

                          if (Object.keys(data).length > 0) {
                              if (data.date_naissance !== null) {
                                  $("#liquidation_retraite_france_date_naissance").val(data.date_naissance);
                              }
                          }
                          if (data.numero_piece !== null) {
                              $("#liquidation_retraite_france_nin").val(data.numero_piece);
                          }

                          if (data.genre === 'HOMME') {
                              // nom_jeune_fille
                              $('#liquidation_retraite_france_nom_jeune_fille').attr("disabled", true)
                          } else {
                              $('#liquidation_retraite_france_nom_jeune_fille').attr("disabled", false)
                          }

                      } else {
                          // $("#liquidation_retraite_france_prenom").val('');
                          // $("#liquidation_retraite_france_nom").val('');

                          // En cas d'erreur AJAX, ne pas vider les champs, mais afficher un message d'erreur
                          elem_message_erreur.show();
                          $("#message-erreur").text("Le numéro n'est pas valide.");
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      // $("#liquidation_retraite_france_prenom").val('');
                      // $("#liquidation_retraite_france_nom").val('');

                      // En cas d'erreur AJAX, ne pas vider les champs, mais afficher un message d'erreur
                      // elem_message_erreur.show();
                      // $("#message-erreur").text("Le numéro n'est pas valide.");
                  }
              });
          }

