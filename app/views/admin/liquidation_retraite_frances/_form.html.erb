          function chargerRegions() {
              let zone = $('#liquidation_retraite_france_zone').val();

              if (zone === 'senegal') {
                  $('#liquidation_retraite_france_admin_region_id').attr("disabled", false);
              } else {
                  $('#liquidation_retraite_france_admin_region_id').val('').attr("disabled", true);
