<%= content_for :titre_page, "Détails" %>

<% test = true %>
<%= content_for :titre_page_autres_details do %>
  <%# if current_user == @dossier_cnav.ajoute_par and current_user.gestionnaire_compte_allocataire? %>
  <% if current_user == @dossier_cnav.ajoute_par %>
    <% unless @dossier_cnav.allocataire_cnavs.count > 0 %>
      <% test = false %>
      <button class="btn btn-warning btn-sm" data-toggle="modal" data-target="#ajoutSalarie">
        Importer Fichier
      </button>
    <% end %>
  <% end %>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_dossier_cnavs_path, class: 'btn btn-white btn-sm' %>
  <%# if current_user == @dossier_cnav.ajoute_par and current_user.gestionnaire_compte_allocataire? %>
  <% if current_user == @dossier_cnav.ajoute_par %>
    <% if @dossier_cnav.creation? %>
      <%= link_to 'Modifier', edit_admin_dossier_cnav_path(@dossier_cnav), class: 'btn btn-white btn-sm' %>
      <% if test == false %>
        <%= (link_to 'Supprim.', [:admin, @dossier_cnav], method: :delete, data: { confirm: 'Êtes-vous sûr de vouloir supprimer ?' },
                     class: 'btn btn-danger btn-sm') %>
      <% end %>
    <% end %>
    <%#= link_to 'Soumettre', admin_dossier_cnav_soumettre_path(@dossier_cnav), data: {confirm: 'Êtes-vous sûr de vouloir soumettre ?'}, class: 'btn btn-primary btn-sm' %>
  <% end %>
  <%= link_to 'Allocataires', admin_dossier_cnav_allocataire_cnavs_path(@dossier_cnav), class: 'btn btn-outline btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
            <p>
              <strong>Numero dossier : </strong>
              <%= @dossier_cnav.numero_dossier %>
            </p>

            <p>
              <strong>Date ouverture : </strong>
              <%= l @dossier_cnav.date_ouverture %>
            </p>

            <p>
              <strong>Etat : </strong>
              <%= DossierCnav.human_enum_name(:etat, @dossier_cnav.etat) %>
            </p>

            <p>
              <strong>Type Convention : </strong>
              <%= DossierCnav.human_enum_name(:type_convention, @dossier_cnav.type_convention) %>
            </p>

            <p>
              <strong>Usage : </strong>
              <%= DossierCnav.human_enum_name(:usage, @dossier_cnav.usage) %>
            </p>

            <p>
              <% unless @dossier_cnav.mois.nil? %>
                <strong>Mois : </strong>
                <%= DossierCnav.human_enum_name(:mois, @dossier_cnav.mois) %>
              <% end %>

              <% unless @dossier_cnav.trimestre.nil? %>
                <strong>Trimestre : </strong>
                <%= DossierCnav.human_enum_name(:trimestre, @dossier_cnav.trimestre) %>
              <% end %>
            </p>

            <p>
              <strong>Annee:</strong>
              <%= @dossier_cnav.annee %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal inmodal" id="ajoutSalarie" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">

    <div class="modal-content animated fadeIn">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Close</span>
        </button>
        <h4 class="modal-title">Ajouter par chargement de fichier</h4>
      </div>
      <%= form_tag admin_dossier_cnav_import_path(@dossier_cnav), multipart: true do %>
        <div class="modal-body" style="height:150px">
          <div class="col-sm-4 col-lg-offset-4">
            <div class="btn-file">
              <label>
                <%= file_field_tag :file, hide_label: true, label: '.', class: '', id: 'label_file' %>
                <div class="btn btn-success" style="margin-top: 0px; margin-left: 1px;">
                  <span class="fa fa-upload"></span> Choisir un fichier
                </div>
              </label>
            </div>
          </div>
          <div class="col-lg-12" style="text-align:center">
            <h4 id="file_name" class="text-success">Aucun fichier choisi</h4>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
          <%= submit_tag "Importer fichier", class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>`


<script type="text/javascript">
    $(document).ready(function () {
        var input = document.getElementById('label_file');
        var infoArea = document.getElementById('file_name');
        input.addEventListener('change', showFileName);

        function showFileName(event) {
            var input = event.srcElement;
            var fileName = input.files[0].name;
            infoArea.textContent = fileName;
        }
    })
</script>