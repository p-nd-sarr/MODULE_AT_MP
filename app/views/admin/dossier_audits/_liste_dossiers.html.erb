<% if @dossier_audits.count.zero? %>
  <h2 style="text-align:center; margin-top:50px">
    <hr>
    La liste des dossiers audits est vide !!!
  </h2>
<% else %>

  <%= paginate @dossier_audits %>
  <div class="table-responsive" style="margin-top: 20px; padding-bottom:100px;">
    <table class="table table-striped">
      <thead class="thead-primary">
      <tr>
        <th scope="col">#</th>
        <th scope="col">N° Dossier</th>
        <th scope="col">État Dossier</th>
        <th scope="col">Date début</th>
        <th scope="col">Moif</th>
        <th scope="col">Créer le</th>
        <th colspan="3"></th>
      </tr>
      </thead>
      <tbody>
      <% @dossier_audits.each do |dossier_audit| %>
        <tr>
          <td></td>
          <td><%= dossier_audit.num_dossier %></td>
          <td><%= "#{dossier_audit.current_state.meta[:label] }" %></td>
          <td><%= l(dossier_audit.date_debut) unless dossier_audit.date_debut.nil? %></td>
          <td><%= dossier_audit.motif %></td>
          <td>
            <%= l dossier_audit.created_at.to_date %>
          </td>
          <td style="width: 75px">
            <%= link_to 'Détails', admin_dossier_audit_path(dossier_audit), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px" class="dropdown">
            <button class="btn btn-success btn-xs dropdown-toggle" type="button" data-toggle="dropdown"> Options
              <span class="caret"></span>
            </button>
            <ul class="dropdown-menu pull-right" style="background-color:rgb(240,240,240)">
              <li>
                <%= link_to 'Modifier', edit_admin_dossier_audit_path(dossier_audit), id: "dd_hover" if dossier_audit.creation? and current_user == dossier_audit.ajoute_par %>
              </li>
              <li>
                <%= link_to 'Supprimer', admin_dossier_audit_path(dossier_audit), method: :delete, data: { confirm: 'En êtes vous sûr?' }, id: "dd_hover" if dossier_audit.creation? and current_user == dossier_audit.ajoute_par %>
              </li>
            </ul>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <%= paginate @dossier_audits %>
  </div>

<% end %>
