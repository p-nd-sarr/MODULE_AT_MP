<div class="ibox" style="margin-top:20px;">
  <div class="ibox-content">
    <br>
    <%= paginate @agents %>
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Profile</th>
        <th scope="col">Nom</th>
        <th scope="col">Prénom</th>
        <th scope="col">Téléphone</th>
        <th scope="col">Options</th>
      </tr>
      </thead>

      <tbody>
      <% @agents.each do |agent| %>
        <tr>
          <td><%= agent.type_profil.humanize %></td>
          <td><%= agent.nom %></td>
          <td><%= agent.prenom %></td>
          <td><%= agent.telephone %></td>
          <td width="200px">
            <% if @dossier_audit.is_set_manager(agent.id) %>
              <span> Est affecté  <%= link_to 'Retirer', admin_annuler_affectation_dossier_audit_path(@dossier_audit, agent.id), data: { confirm: 'En êtes vous sûr?', turbolinks: false }, class: 'btn btn-outline btn-danger btn-xs' if @dossier_audit.creation? and (current_user.auditeur? or current_user.chef_service_audit? or current_user.chef_service_controle_interne?) %></span>
            <% else %>
              <%= link_to 'Affecter au dossier', admin_affecter_dossier_audit_path(@dossier_audit, agent.id), data: { confirm: 'En êtes vous sûr?', turbolinks: false }, class: 'btn btn-outline btn-danger btn-xs' if @dossier_audit.creation? and (current_user.auditeur? or current_user.chef_service_audit? or current_user.chef_service_controle_interne?) %>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <%= paginate @agents %>
  </div>
</div>