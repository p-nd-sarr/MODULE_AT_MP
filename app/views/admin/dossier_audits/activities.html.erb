<%= content_for :titre_page, "Activités Dossier d'audit [#{@dossier_audit.num_dossier}]" %>

<%= content_for :titre_page_autres_details do %>
  <% unless @dossier_audit.ajoute_par.nil? %>
    Créé par : <%= @dossier_audit.ajoute_par.full_name unless @dossier_audit.ajoute_par.nil? %>
    <br>
    <strong class="text-info">Date création :</strong>
    <%= "#{ @dossier_audit.created_at.strftime('%d/%m/%Y') }" %>
  <% end %> <br>
  État du dossier d'audit : <%= "#{@dossier_audit.current_state.meta[:label] }" %> <br>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Dossier audit', admin_dossier_audit_path(@dossier_audit), class: 'btn btn-white btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <div class="row p-sm">
      <h3>Liste des avtivité du dossier d'audit</h3>
      <div class="text-right">
        <% if current_user.auditeur? %>
          <button type="button" class="fa fa-plus btn btn-w-m btn-success btn-outline" , style="height: 34px;" data-toggle="modal" data-target="#create_activity<%= @activity.id %>">
            <span></span> AJOUTER UNE ACTIVITÉ
          </button>
        <% end %>
      </div>
      <div class="hr-line-dashed"></div>
      <div class="row p-sm">
        <h3>Critères de recherche</h3>
        <br>
        <%= search_form_for @q, url: request.path, html: { id: 'formulaire_recherche' } do |f| %>
          <div class="row">
            <div class="col-sm-4">
              <%= f.label :created_at_lteq, 'Date création' %>
              <%= f.date_field :created_at_lteq, class: 'form-control' %>
            </div>
            <div class="col-sm-4">
              <%= f.label :workflow_state_eq, 'Etat' %>
              <%= f.select :workflow_state_eq, DossierAuditActivity.workflow_spec.states.keys.map { |k| [DossierAuditActivity.workflow_spec.states[k].meta[:label], k] },
                           { :include_blank => true }, class: 'form-control' %>
            </div>
          </div>
          <br>
          <div class="hr-line-dashed"></div>
          <%= link_to "Annuler", request.path, class: "btn btn-white" %>
          <%= f.submit 'Rechercher', class: 'btn btn-primary', id: 'action_search' %>
        <% end %>
      </div>
      <div class="hr-line-dashed"></div>
      <%= paginate @activities %>
      <table class="table table-bordered table-condensed table-hover" style="font-size: 12px">
        <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">État</th>
          <th scope="col">Description</th>
          <th scope="col">Ajoutée par</th>
          <th scope="col">Date de creation</th>
          <th colspan="3"></th>
        </tr>
        </thead>

        <tbody>
        <% @activities.each do |activity| %>
          <tr>
            <td><%= activity.id %></td>
            <td><%= "#{activity.current_state.meta[:label] }" %> </td>
            <td><%= activity.description unless activity.description.nil? %></td>
            <td><%= activity.ajoute_par.full_name unless activity.ajoute_par.nil? %>
              (<%= activity.ajoute_par.type_profil.humanize unless activity.ajoute_par.nil? %>)
            </td>
            <td><%= l activity.created_at unless activity.created_at.nil? %></td>
            <td style="width: 75px">
              <%= link_to 'Détails', admin_dossier_audit_activity_details_path(@dossier_audit, activity), class: 'btn btn-outline btn-primary btn-xs' %>
            </td>
            <td style="width: 75px" class="dropdown">
              <button class="btn btn-success btn-xs dropdown-toggle" type="button" data-toggle="dropdown"> Options
                <span class="caret"></span>
              </button>
              <ul class="dropdown-menu pull-right" style="background-color:rgb(240,240,240)">
                <li>
                  <% if activity.creation? and current_user == @dossier_audit.ajoute_par %>
                    <a class="fa btn btn-success btn-outline" data-toggle="modal" data-target="#create_activity<%= activity.id %>">
                      Modifier
                    </a>
                  <% end %>
                </li>
                <li>
                  <%= link_to 'Supprimer', admin_dossier_audit_delete_activity_path(@dossier_audit, activity), class: 'fa btn btn-success btn-outline text-center', method: :delete, data: { confirm: 'En êtes vous sûr?' }, id: "dd_hover" if activity.creation? and current_user == @dossier_audit.ajoute_par %>
                </li>
              </ul>
            </td>
            <%= render 'admin/dossier_audits/create_activity', :object => activity %>
          </tr>
        <% end %>
        </tbody>
      </table>
      <%= paginate @activities %>
    </div>
  </div>
</div>

<%= render 'admin/dossier_audits/create_activity', :object => @activity %>
