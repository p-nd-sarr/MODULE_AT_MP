<div class="modal inmodal" id="update_recommandation<%= object.id %>" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <i class="fa fa-user modal-icon btn-outline"></i>
        <h4 class="modal-title">
          Ajouter une recommandation
        </h4>
      </div>
      <div class="modal-body">
        <div class="ibox-content">
          <%= bootstrap_form_for([:admin, object], url: admin_dossier_audit_update_recommandation_path(object.dossier_audit_activity.dossier_audit, object.dossier_audit_activity, object), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>

            <div class="row">
              <div class="col-sm-12">
                <%= f.text_area :direction_response, label: "Recommandation", required: true %>
              </div>
            </div>
            <br>
            <div class="row">
              <div class="col-sm-12">
                <h4 style="font-weight: bold;">pièce joint *</h4>
                <div class="btn-file">
                  <label>
                    <%= f.file_field :response_file, hide_label: true, label: '.',
                                     required: (not object.persisted?),
                                     id: 'label-pc1' %>

                    <div class="btn btn-success" style="margin-top: -50px; margin-left: 1px;">
                      <span class="fa fa-upload"></span> Choisir un fichier
                    </div>
                  </label>
                </div>
              </div>
            </div>
            <br>
            <div class="hr-line-dashed"></div>
            <div class="row">
              <div class="modal-footer form-group">
                <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
                <%= f.button 'Modifier', class: 'btn btn-primary' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
</div>
