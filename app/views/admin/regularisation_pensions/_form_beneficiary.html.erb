<%= bootstrap_form_for([@beneficiary], url: (is_active_action('new_beneficiary') ? admin_regularisation_pension_create_beneficiary_path : admin_regularisation_pension_update_beneficiary_path(@beneficiary)), label_col: "col-sm-4", control_col: "col-sm-6") do |f| %>
  <%= f.alert_message "Please fix the errors below." %>

  <%= f.text_field :nom, label: 'Nom', required: true %>
  <%= f.text_field :prenom, label: 'Prenom', required: true %>
  <%= f.date_field :date_naissance, label: "Date de naissance", required: true %>
  <%= f.text_field :nin, label: 'Nin', required: true %>
  <%= f.phone_field :telephone, label: 'Téléphone', required: true %>

  <div class="hr-line-dashed"></div>
  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', [:admin, @regularisation_pension], class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>