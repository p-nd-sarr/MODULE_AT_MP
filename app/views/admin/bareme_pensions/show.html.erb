<%= content_for :titre_page, "Détails admin_bareme_pension" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_bareme_pensions_path, class: 'btn btn-white btn-sm' %>
  <%= link_to 'Modifier', edit_admin_bareme_pension_path(@admin_bareme_pension), class: 'btn btn-white btn-sm' %>
  <%= link_to 'Ajouter admin_bareme_pension', new_admin_bareme_pension_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
            <p>
              <strong>Admin type regime:</strong>
              <%= @admin_bareme_pension.admin_type_regime.description %>
            </p>

            <p>
              <strong>Date debut validite:</strong>
              <%= l @admin_bareme_pension.date_debut_validite %>
            </p>

            <p>
              <strong>Date fin validite:</strong>
              <%= l @admin_bareme_pension.date_fin_validite %>
            </p>

            <p>
              <strong>Valeur point annuelle:</strong>
              <%= @admin_bareme_pension.valeur_point_annuelle.try(:ceil, 4) %>
            </p>

            <p>
              <strong>Valeur point trimestrielle:</strong>
              <%= @admin_bareme_pension.valeur_point_trimestrielle.try(:ceil, 4) %>
            </p>

            <p>
              <strong>Valeur point bimestrielle:</strong>
              <%= @admin_bareme_pension.valeur_point_bimestrielle.try(:ceil, 4) %>
            </p>

            <p>
              <strong>Valeur point mensuelle:</strong>
              <%= @admin_bareme_pension.valeur_point_mensuelle.try(:ceil, 4) %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
