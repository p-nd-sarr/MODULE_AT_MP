<%= bootstrap_form_for(@admin_bareme_pension, layout: :horizontal) do |f| %>
  <%= f.collection_select :admin_type_regime_id, Admin::TypeRegime.order('description'), :id, :description %>
  <%= f.text_field :valeur_point_annuelle %>
  <%= f.text_field :valeur_point_trimestrielle %>
  <%= f.text_field :valeur_point_bimestrielle %>
  <%= f.text_field :valeur_point_mensuelle %>
  <%= f.date_select :date_debut_validite,
                    start_year: 1950, end_year: (Date.today + 1.year).year %>
  <%= f.date_select :date_fin_validite,
                    start_year: 1950, end_year: (Date.today + 1.year).year %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_bareme_pensions_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
