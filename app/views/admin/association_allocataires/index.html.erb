<%= content_for :titre_page, 'Admin Association Allocataires' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_association_allocataire_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
                <th scope="col">Name</th>
            <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_association_allocataires.each do |admin_association_allocataire| %>
    <tr>
                <td><%= admin_association_allocataire.name %></td>
            <td style="width: 75px">
        <%= link_to 'détails', admin_association_allocataire, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_association_allocataire_path(admin_association_allocataire), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_association_allocataire, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>