<%= content_for :titre_page, "Avis Tiers, allocataire : #{@allocataire.numero_allocataire}" %>

<%= content_for :actions_page do %>
  <%= (link_to 'Nouvelle Demande d\'Avis de Tiers', new_admin_allocataire_avis_tier_path(@allocataire), class: 'btn btn-primary btn-sm')if current_user.chef_service_allocation? %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">N°</th>
        <th scope="col">Numero Dossier </th>
        <th scope="col">Montant total</th>
        <th scope="col">Montant Echeance</th>
        <th scope="col">Date demande</th>
        <th scope="col">Etat</th>
        <th colspan="2"></th>
      </tr>
      </thead>

      <tbody>
      <% @avis_tiers.each do |avis_tier| %>
        <tr>
          <td><%= avis_tier.id %></td>
          <td><%= avis_tier.numero_dossier %></td>
          <td><%= avis_tier.montant %></td>
          <td><%= avis_tier.montant_mensuel %></td>
          <td><%= avis_tier.created_at %></td>
          <td><%= avis_tier.etat %></td>
          <td style="width: 75px">
            <%= link_to 'détails', [:admin, @allocataire, avis_tier], class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>