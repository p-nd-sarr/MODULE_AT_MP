<%= content_for :titre_page, "Liste des comptes allocataires modifiés du [#{ @echeance_paiement.periode_debut.strftime("%d/%m/%Y")} - #{@echeance_paiement.periode_fin.strftime("%d/%m/%Y")}]" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_echeance_paiement_path(@echeance_paiement), class: 'btn btn-white btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
    <div class="row">
      <div class="col-lg-12">
        <div class="col-lg-3">
          <%= link_to admin_echeance_paiement_changement_mode_paiements_path(@echeance_paiement) do %>
            <div class="ibox" style="box-shadow: 2px 2px 4px #1ab394;">
              <div class="ibox-title">
                <h5>MODIFICATION MODE PAIEMENT</h5>
              </div>
              <div class="ibox-content product-box">
                <h2 class="no-margins"><%= ModifierModePaiement.with_dossier_valide_state.periode(@echeance_paiement.periode_variation_debut, @echeance_paiement.periode_variation_fin).count %></h2>
                <div class="stat-percent text-success font-bold">

                </div>
                <small>Total demande</small>
                <div style="text-align:center">
                  <%= link_to ' Voir Details', admin_echeance_paiement_changement_mode_paiements_path(@echeance_paiement), class: 'btn btn-success btn-xs fa fa-home', style: 'margin-top:15px;' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <div class="col-lg-3">
          <%= link_to admin_echeance_paiement_changement_adresses_path(@echeance_paiement) do %>
            <div class="ibox " style="box-shadow: 2px 2px 4px #1ab394;">
              <div class="ibox-title">
                <h5>MODIFICATION D'ADRESSES</h5>
              </div>
              <div class="ibox-content product-box">
                <h2 class="no-margins"><%= ModifierAdresse.with_dossier_valide_state.periode(@echeance_paiement.periode_variation_debut, @echeance_paiement.periode_variation_fin).count %></h2>
                <div class="stat-percent text-success font-bold">

                </div>
                <small>Total demande</small>
                <div style="text-align:center">
                  <%= link_to ' Voir Détails', admin_echeance_paiement_changement_adresses_path(@echeance_paiement), class: 'btn btn-success btn-xs fa fa-home', style: 'margin-top:15px;' %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
</div>