<style type="text/css">

    .no-text {
        font-size: 0px;
    }

    .invalid-feedback {
        font-size: 0px;
    }

    select option[disabled] {
        display: none
    }
</style>

<%= bootstrap_form_for(@enfant, url: admin_enfant_update_incomplete_path(@enfant), label_col: "col-sm-4", control_col: "col-sm-4") do |f| %>
  <%= f.alert_message "Veuillez corriger les erreurs ci-dessous." %>

  <div class="content clearfix">
    <h2 class="text-navy" style="font-weight:bold">Informations de l'enfant à fiabiliser</h2>
    <hr>
    <div class="row">
      <div class="form-group" style="align-content: center">
        <div class="col-sm-12">
          <hr>
          <div class="col-sm-6">
            <%= f.text_field :numero_affiliation, label: 'Numéro affiliation' %>
            <span id="num_aff_error" style="display: none; font-size: 12px; color: red; -webkit-text-stroke-width: medium;">Le numéro d'affiliation doit être numérique</span>
          </div>

          <div class="col-sm-6">
            <%= f.text_field :prenom, label: 'Prénom enfant', required: true %>
          </div>

          <div class="col-sm-6">
            <%= f.text_field :nom, label: 'Nom enfant', required: true %>
          </div>


          <div class="col-sm-6">
            <%= f.date_field :date_naissance, label: 'Date de naissance',
                             start_year: (Date.today - 100.year).year, end_year: (Date.today - 14.year).year %>
          </div>

          <div class="col-sm-6">
            <%= f.select :sexe,
                         Enfant::SEXE.keys.collect { |sexe| [Enfant.human_enum_name(:sexe, sexe), sexe] },
                         label: "Sexe de l'enfant" %>
          </div>

        </div>

      </div>
      <div class="form-group col-sm-12">
        <hr>
        <div class="col-sm-9"></div>
        <div class="col-sm-3" style="text-align: right;">
          <%= link_to 'Annuler', admin_enfant_path(@enfant), class: 'btn btn-white' %>
          <%= f.submit 'Valider', class: 'btn btn-primary', id: 'submit_button' %>
        </div>
      </div>
    </div>
  </div>
<% end %>