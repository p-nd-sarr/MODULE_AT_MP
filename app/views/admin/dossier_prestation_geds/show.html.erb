<div class="row wrapper border-bottom white-bg page-heading">
  <div class="col-lg-10">
    <h2>Détails du dossier prestation GED</h2>
    <ol class="breadcrumb">
      <li>
        <%= link_to 'Accueil', admin_root_path %>
      </li>
      <li>
        <%= link_to 'Dossiers Prestation GED', admin_dossier_prestation_geds_path %>
      </li>
      <li class="active">
        <strong>Détails</strong>
      </li>
    </ol>
  </div>
</div>

<div class="wrapper wrapper-content animated fadeInRight">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>Informations du dossier</h5>
        </div>
        <div class="ibox-content">
          <div class="row">
            <div class="col-md-6">
              <h3>Informations personnelles</h3>
              <p><strong>Numéro d'affiliation:</strong> <%= @dossier_prestation_ged.num_affiliation %></p>
              <p><strong>Nom:</strong> <%= @dossier_prestation_ged.nom %></p>
              <p><strong>Prénom:</strong> <%= @dossier_prestation_ged.prenom %></p>
              <p><strong>Sexe:</strong> <%= @dossier_prestation_ged.sexe_salarie&.humanize %></p>
              <p><strong>Date de naissance:</strong> <%= @dossier_prestation_ged.date_naissance&.strftime('%d/%m/%Y') %></p>
              <p><strong>Lieu de naissance:</strong> <%= @dossier_prestation_ged.lieu_naissance %></p>
              <p><strong>NIN:</strong> <%= @dossier_prestation_ged.nin %></p>
              <p><strong>Nationalité:</strong> <%= @dossier_prestation_ged.nationalite&.humanize %></p>
              <p><strong>Adresse:</strong> <%= @dossier_prestation_ged.adresse_domicile %></p>
              <p><strong>Téléphone:</strong> <%= @dossier_prestation_ged.telephone %></p>
            </div>
            
            <div class="col-md-6">
              <h3>Informations professionnelles</h3>
              <p><strong>Employeur actuel:</strong> <%= @dossier_prestation_ged.employeur_actuel %></p>
              <p><strong>Date d'embauche:</strong> <%= @dossier_prestation_ged.date_embauche&.strftime('%d/%m/%Y') %></p>
              <p><strong>Agence:</strong> <%= @dossier_prestation_ged.admin_agence&.description_prest %></p>
              <p><strong>Date de réception:</strong> <%= @dossier_prestation_ged.date_reception&.strftime('%d/%m/%Y') %></p>
            </div>
          </div>
          
          <div class="row">
            <div class="col-md-12">
              <h3>Informations GED</h3>
              <p><strong>Réf:</strong> <%= @dossier_prestation_ged.id_item %></p>
                <%= link_to 'Lien vers documents', "http://192.168.125.242/laserfiche/Browse.aspx?db=CSS-IPRES#?id=#{@dossier_prestation_ged.id_item}", class: 'btn btn-primary', target: '_blank' %>
            </div>
          </div>
          <div class="row">
            <div class="col-md-12">
              <div class="hr-line-dashed"></div>
              <% if @dossier_prestation_ged.peut_traiter?(current_user) %>
              <div class="btn-group">
                <%= link_to 'Modifier', edit_admin_dossier_prestation_ged_path(@dossier_prestation_ged), class: 'btn btn-white' %>
                <%= link_to 'Retour', admin_dossier_prestation_geds_path, class: 'btn btn-white' %>
              </div>
              <div class="btn-group">
                <%= link_to 'Migrer en production', admin_dossier_prestation_ged_migrer_prod_path(@dossier_prestation_ged), data: { confirm: 'Êtes-vous sûr de vouloir migrer cette demande en production ?' }, class: 'btn btn-green' %>                
              </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>