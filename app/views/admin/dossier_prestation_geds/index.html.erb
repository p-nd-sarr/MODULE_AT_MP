<div class="row wrapper border-bottom white-bg page-heading">
  <div class="col-lg-10">
    <h2>Dossiers Prestation GED</h2>
    <ol class="breadcrumb">
      <li>
        <%= link_to 'Accueil', admin_root_path %>
      </li>
      <li class="active">
        <strong>Dossiers Prestation GED</strong>
      </li>
    </ol>
  </div>
  <%#div class="col-lg-2">
    <%= link_to 'Nouveau Dossier', new_admin_dossier_prestation_ged_path, class: 'btn btn-primary mt-3' %>
  <%#/div%>
</div>

<div class="wrapper wrapper-content animated fadeInRight">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>Liste des dossiers prestation GED</h5>
        </div>
        <div class="ibox-content">
          <%= search_form_for @q, url: admin_dossier_prestation_geds_path, class: 'form-inline mb-4' do |f| %>
            <div class="row">
              <div class="col-sm-4">
                <%= f.label :num_affiliation_cont, "Numéro d'affiliation" %>
                <%= f.search_field :num_affiliation_cont, class: 'form-control' %>
              </div>
              <div class="col-sm-4">
                <%= f.label :nom_cont, "Nom" %>
                <%= f.search_field :nom_cont, class: 'form-control' %>
              </div>
              <div class="col-sm-4">
                <%= f.label :prenom_cont, "Prénom" %>
                <%= f.search_field :prenom_cont, class: 'form-control' %>
              </div>
            </div>
            <br>
            <div class="row">
              <div class="col-sm-4">
                <%= f.label :status_ged_eq, "Statut GED" %>
                <%= f.select :status_ged_eq, DossierPrestationGed.status_geds.keys.map { |k| [k.humanize, k] }, { include_blank: true }, class: 'form-control' %>
              </div>
              <% unless !current_user.admin? %>
              <div class="col-sm-4">
                <%= f.label :admin_agence_id_eq, "Agence" %>
                <%= f.collection_select :admin_agence_id_eq, Admin::Agence.css.order(:description_prest), :id, :description_prest, { include_blank: true }, class: 'form-control' %>
              </div>
              <% end %>
              <%= f.submit "Rechercher", class: 'btn btn-primary' %>
            </div>
          <% end %>
        </div>

        <div class="ibox-content">
          <div class="table-responsive">
            <table class="table table-striped table-bordered table-hover dataTables-example">
              <thead>
                <tr>
                  <th>Numéro affiliation</th>
                  <th>Nom</th>
                  <th>Prénom</th>
                  <th>Date de naissance</th>
                  <th>NIN</th>
                  <th>Employeur</th>
                  <th>Date réception</th>
                  <th>Statut GED</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @dossier_prestation_geds.each do |dossier| %>
                  <tr>
                    <td><%= dossier.num_affiliation %></td>
                    <td><%= dossier.nom %></td>
                    <td><%= dossier.prenom %></td>
                    <td><%= dossier.date_naissance&.strftime('%d/%m/%Y') %></td>
                    <td><%= dossier.nin %></td>
                    <td><%= dossier.employeur_actuel %></td>
                    <td><%= dossier.date_reception&.strftime('%d/%m/%Y') %></td>
                    <td><%= dossier.status_ged %></td>
                    <td>
                      <%= link_to 'Voir', admin_dossier_prestation_ged_path(dossier), class: 'btn btn-primary btn-xs' %>
                      <% if dossier.peut_traiter?(current_user) %>
                        <%#= link_to 'Modifier', edit_admin_dossier_prestation_ged_path(dossier), class: 'btn btn-warning btn-xs' %>
                        <%#= link_to 'Supprimer', admin_dossier_prestation_ged_path(dossier), method: :delete, data: { confirm: 'Êtes-vous sûr?' }, class: 'btn btn-danger btn-xs' %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          
          <div class="text-center">
            <%= paginate @dossier_prestation_geds %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>