<%= bootstrap_form_for(@admin_departement, layout: :horizontal) do |f| %>
  <%= f.collection_select :admin_region_id, Admin::Region.all, :id, :designation, label: 'Region', required: true %>
  <%= f.text_field :designation %>
  <%= f.text_field :code %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_departements_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
