<%= content_for :titre_page, 'Admin Rentes' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_rente_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
        <th scope="col">Age</th>
        <th scope="col">Prix(CFA)</th>
        <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_rentes.each do |admin_rente| %>
    <tr>
      <td>
        <%=admin_rente.age%>
      </td>
      <td>
        <%=admin_rente.prix%>
      </td>
      <td style="width: 75px">
        <%= link_to 'détails', admin_rente, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_rente_path(admin_rente), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_rente, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>