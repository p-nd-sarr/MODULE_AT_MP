<div class="ibox-content" style="font-size: 13px">
  <div class="row">
    <div class="tab-content">
      <div class="full-height-scroll">
        <table class="table table-bordered table-condensed table-hover">
          <thead>
          <tr>
            <th align="center">Prénom conjoint</th>
            <th align="center">Nom conjoint</th>
            <th align="center">Date de naissance</th>
            <th align="center">Lieu de naissance</th>
            <th align="center">Etat du couple</th>
            <th colspan="3">Action</th>
          </tr>
          </thead>
          <tbody>
          <% @conjoints.each do |conjoint| %>
            <tr>
              <td><%= conjoint.prenom %></td>
              <td><%= conjoint.nom %></td>
              <td><%= conjoint.date_naissance.strftime('%d/%m/%Y') %></td>
              <td><%= conjoint.lieu_naissance %></td>
              <td><%= CafConjoint.human_enum_name(:etat_couple, conjoint.etat_couple) %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
