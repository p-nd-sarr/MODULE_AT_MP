<div class="modal inmodal" id="PieceJustificativeModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <i class="fa fa-check modal-icon btn-primary"></i>
        <h4 class="modal-title">
          Modifier la pièce justificative
        </h4>
      </div>
      <div class="modal-body">
        <div class="ibox-content">
          <%= bootstrap_form_for(@prestation_exterieure, url: admin_prestation_exterieure_add_numero_caf_path(@prestation_exterieure.id), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <h4 style="font-weight: bold;">Pièce d'identité *</h4>
            <div class="btn-file">
              <label>
                <%= f.file_field :piece_justificative_caf, hide_label:true, label: '.',
                                 required: (not @prestation_exterieure.persisted?),
                                 id:'label-pc1' %>

                <div class="btn btn-success" style="margin-top: -50px; margin-left: 1px;"><span class="fa fa-upload"></span> Choisir un fichier
                </div>
              </label>
            </div>
            <div class="form-group row">
              <div class="modal-footer">
                <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
                <%= f.button 'Enregistrer', class: 'btn btn-primary' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>