<div class="modal inmodal" id="motif" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Close</span>
        </button>
        <h4 class="modal-title">Motif de retour</h4>
      </div>
      <%= bootstrap_form_for(object, url: admin_prestation_exterieure_retourner_indemnite_path(@prestation_exterieure, object)) do |f| %>
        <div class="modal-body">
          <%= f.text_area :motif_retour, label: 'Motif de retour', required: true %>
        </div>

        <div class="modal-footer form-group">
          <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
          <% if !object.init? %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>