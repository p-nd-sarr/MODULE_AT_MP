<%= content_for :titre_page, "Dossier De Prestation exterieure [#{PrestationExterieure.human_enum_name(:state, @prestation_exterieure.current_state)}]" %>

<%= content_for :actions_page do %>
  <% if @prestation_exterieure.pret_pour_soumission_etf? and (current_user.admin? or current_user.gestionnaire_compte_allocataire?) and ((@prestation_exterieure.ajoute_par == current_user and not @prestation_exterieure.est_repris?) or @prestation_exterieure.est_repris?) %>
    <button type="button" class="btn btn-primary btn-xs" data-toggle="modal" data-target="#SoumissionEtatFamilleModal" id="soumettre_id">Soumettre
      l'état de famille
    </button>
  <% end %>

  <% if current_user.chef_groupe_caf? and @prestation_exterieure.soumission_etat_chef_grp? %>
    <%= (link_to "Valider l'état de famille", admin_prestation_exterieure_valider_etat_famille_path(@prestation_exterieure.id), class: 'btn btn-primary btn-xs') %>
    <button type="button" class="btn btn-danger btn-xs" data-toggle="modal" data-target="#RejetEtatFamilleModal">Rejeter
      l'état de famille
    </button>
  <% end %>

  <td> <%= link_to ' Récipissé de dépot', admin_prestation_exterieure_recipisse_depot_path(@prestation_exterieure.id, format: :pdf), class: "btn btn-white btn-xs fa fa-download", target: '_blank' if @prestation_exterieure.current_state >= :soumission_etat_chef_grp and (current_user.admin? or current_user.gestionnaire_compte_allocataire?) %></td>
  <td> <%= link_to " Etat de famille", admin_prestation_exterieure_generate_etat_path(@prestation_exterieure.id, format: :pdf), class: "btn btn-white btn-xs fa fa-download" if @prestation_exterieure.pret_pour_generation_etat? and (current_user.admin? or current_user.gestionnaire_compte_allocataire?) %></td>
  <td> <%= link_to 'Ouvrir le dossier à nouveau', admin_prestation_exterieure_reouvrir_dossier_path(@prestation_exterieure.id), class: "btn btn-white btn-xs" if @prestation_exterieure.est_rejetee_etat_famille? and (current_user.admin? or current_user.gestionnaire_compte_allocataire?) %></td>

  <%= link_to 'Retour', admin_prestation_exterieure_path(@prestation_exterieure.id), class: 'btn btn-white btn-xs' if current_user.admin? or current_user.gestionnaire_compte_allocataire? %>
  <%= link_to 'Retour', admin_etats_famille_path, class: 'btn btn-white btn-xs' if current_user.chef_groupe_caf? and @prestation_exterieure.soumission_etat_chef_grp? %>
  <%= link_to 'Retour', admin_droits_liquidation_details_path(@prestation_exterieure.id), class: 'btn btn-white btn-xs' if current_user.chef_groupe_caf? and @prestation_exterieure.dossier_valide? %>
  <%= link_to 'Retour', admin_droits_liquidation_details_path(@prestation_exterieure.id), class: 'btn btn-white btn-xs' if current_user.chef_subdivision_caf? or current_user.comptable? %>

  <div style="margin-top: 5px">
    <% if @prestation_exterieure.initialisation? and !@prestation_exterieure.motif_rejet_etf? %>
      <p class="text-info">
        L'état de famille est en cours de création
      </p>
    <% end %>
    <% if (current_user.admin? or current_user.gestionnaire_compte_allocataire?) and @prestation_exterieure.soumission_etat_chef_grp? %>
      <p class="text-info">
        L'état de famille à été soumis au chef de groupe CAF
      </p>
    <% end %>
    <% if @prestation_exterieure.current_state >= :dossier_valide %>
      <p class="text-info">
        L'état de famille à été validé par le chef de groupe CAF :
        <br> <%= @prestation_exterieure.valide_etf_par.full_name unless @prestation_exterieure.valide_etf_par.nil? %>
      </p>
    <% end %>
    <% if @prestation_exterieure.valide? and @prestation_exterieure.initialisation? and @prestation_exterieure.motif_rejet_etf? %>
      <p class="text-info">
        L'état de famille à été rejeté <br>
        Date de rejet : <%= @prestation_exterieure.date_rejet_etf %>
      </p>
      <p class="text-info">
        <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#MotifRejetModal" id="">Voir
          le motif de rejet
        </button>
        <%= render 'motif_rejet' %>
      </p>
    <% end %>
  </div>
<% end %>

<div class="wrapper wrapper-content" style="font-size:medium;">
  <div class="ibox">
    <div class="ibox-content">
      <div class="row" style="margin-top: 50px;">
        <div class="col-lg-12">
          <div class="col-lg-5" style="text-align: center;">
            <h3>Institution de Prévoyance Retraite du Sénégal</h3>
            <p><img style="width: 30%; height: 30%; border-radius: 100%"
                    src="data:image/png;base64," alt="">
            </p>
            <h4>22, Avenue Léopold Sédar Senghor</h4>
          </div>
          <div class="col-lg-4 col-lg-offset-3" style="text-align: center;">
            <h3>Caisse de Sécurité Sociale (C.S.S)</h3>
            <p><img style="width: 18%; height: 18%; border-radius: 100%"
                    src="data:image/jpeg;base64," alt="">
            </p>
            <h4>Place de l'OIT, Colobane</h4>
          </div>
        </div>
        <div class="col-lg-12 text-center" style="margin-top: 20px;">
          <h2>ETAT DE FAMILLE</h2>
          <small>Art. 18, 19, 20 de la convension <br>
            art. 23 de l'Arrangement Administratif Général</small>
          <% unless @prestation_exterieure.numero_caf.nil? %>
            <h4 style="margin-top: 15px;">Dossier CAF N ° <%= @prestation_exterieure.numero_caf %></h4>
          <% end %>
          <h4 style="margin-top: 15px;">Dossier local N ° <%= @prestation_exterieure.numero_dossier %></h4>
        </div>
        <div class="col-lg-12" style="margin-top: 25px;">
          <h2 class="text-success"> Informations du salarié
            <hr>
          </h2>
          <div class="col-lg-8" style="font-size: 15px;">
            <p>
              <strong>Prénom: </strong>  <%= @prestation_exterieure.prenom %>
            </p>
            <p>
              <strong>Nom: </strong>&nbsp;&nbsp; <%= @prestation_exterieure.nom %>
            </p>
            <% if @prestation_exterieure.feminin? %>
              <p>
                <strong>Nom de jeune
                  fille: </strong> &nbsp;&nbsp;<%= (@prestation_exterieure.nom_jeune_fille) unless @prestation_exterieure.nom_jeune_fille.nil? %>
              </p>
            <% end %>
            <p>
              <strong>Date de
                naissance: </strong> &nbsp;&nbsp;<%= l(@prestation_exterieure.date_naissance) unless @prestation_exterieure.date_naissance.nil? %>
            </p>
            <p>
              <strong>Lieu de naissance: </strong> &nbsp;&nbsp;<%= @prestation_exterieure.lieu_naissance %>
            </p>
            <p>
              <strong>Sexe salarié: </strong> &nbsp;&nbsp;<%= @prestation_exterieure.sexe_salarie %>
            </p>
            <p>
              <strong>Type de
                pièce: </strong> &nbsp;&nbsp;<%= PrestationExterieure.human_enum_name(:type_piece, @prestation_exterieure.type_piece) unless @prestation_exterieure.type_piece.nil? %>
            </p>
            <p>
              <strong>Numéro d'identification nationale: </strong> &nbsp;&nbsp;<%= @prestation_exterieure.nin_salarie %>
            </p>
            <p>
              <strong>Situation
                matrimoniale: </strong> &nbsp;&nbsp;<%= PrestationExterieure.human_enum_name(:situation_matrimoniale_salarie, @prestation_exterieure.situation_matrimoniale_salarie) %>
            </p>
            <p>
              <strong>Nationalité: </strong> &nbsp;&nbsp;<%= @prestation_exterieure.nationalite_salarie %>
            </p>
            <p>
              <strong>Adresse dans le pays
                d'origine: </strong> &nbsp;&nbsp; <%= @prestation_exterieure.adresse_pays_origine %>
            </p>
            <p>
              <strong>Adresse dans le pays
                d'emploi: </strong> &nbsp;&nbsp; <%= @prestation_exterieure.adresse_pays_emploi %>
            </p>
          </div>
          <div class="col-lg-4">
            <% @prestation_exterieure.documents.each do |document_prestation| %>
              <div class="col-sm-12" style="margin-top: 10px;">
                <h5>
                  <%= Document.human_enum_name(:type_document, document_prestation.type_document) %>
                </h5>
                <a href="<%= url_for(document_prestation.document) %>" target="_blank">
                  <div class="col-sm-12">
                    <div class="text-center">
                      <%= image_tag document_prestation.document.preview(resize: "500x500>"), class: "m-t-xs img-responsive center-block img-card-size-1" %>
                    </div>
                  </div>
                </a>
              </div>
            <% end %>
          </div>
        </div>
        <div class="col-lg-12" style="margin-top: 70px;">
          <h2 class="text-success">Informations conjoint (s)
            <hr>
          </h2>
          <% @conjoints.each do |conjoint| %>
            <table class="table table-bordered table-hover" style="margin-top: 30px; font-size: 12px;">
              <caption><p style="font-style: italic; text-transform: uppercase;">
                <strong><%= conjoint.prenom %> <%= conjoint.nom %></strong> né le
                <strong> <%= l(conjoint.date_naissance) unless conjoint.date_naissance.nil? %></strong> à
                <strong><%= conjoint.lieu_naissance %></strong>
              </p></caption>
              <thead>
              <tr>
                <th scope="col">Nom de jeune fille</th>
                <th scope="col">Adresse précise</th>
                <th scope="col">Date de mariage</th>
                <% if conjoint.date_separation? %>
                  <th scope="col">Date de séparation
                  </th>
                <% end %>
                <% if conjoint.date_divorce %>
                  <th scope="col">
                    Date de divorce
                  </th>
                <% end %>
              </tr>
              </thead>
              <tbody>
              <tr>
                <td><%= (conjoint.nom_jeune_fille) unless @prestation_exterieure.nom_jeune_fille.nil? %>
                </td>
                <td><%= conjoint.adresse_precise %></td>
                <td><%= l(conjoint.date_mariage) unless conjoint.date_mariage.nil? %></td>
                <% if conjoint.date_separation? %>
                  <td><%= l(conjoint.date_separation) unless conjoint.date_separation.nil? %></td>
                <% end %>
                <% if conjoint.date_divorce %>
                  <td><%= l(conjoint.date_divorce) unless conjoint.date_divorce.nil? %></td>
                <% end %>
              </tr>
              </tbody>
              <tfoot>
              <tr>
                <td colspan="5" style="text-align: center;">
                  <div class="row">
                    <div class="col-sm-3 col-sm-offset-3">
                      <h5>Certificat de mariage </h5>
                      <% if conjoint.certificat_mariage.attached? %>
                        <a href="<%= url_for(conjoint.certificat_mariage) %>" target="_blank">
                          <div class="row">
                            <div class="text-center">
                              <%= image_tag conjoint.certificat_mariage.preview(resize: "200x200>"), class: "m-t-xs img-responsive center-block img-card-size" %>
                            </div>
                          </div>
                        </a>
                      <% else %>
                        <h6 style="font-weight: bold; font-style: italic; margin-top: 20px;" class="text-danger">
                          <small>Certificat de mariage enregistré non enregistrée</small></h6>
                      <% end %>
                    </div>
                    <div class="col-sm-3">
                      <h5>Pièce d'identité </h5>
                      <% if conjoint.piece_identite.attached? %>
                        <a href="<%= url_for(conjoint.piece_identite) if conjoint.piece_identite.attached? %>" target="_blank">
                          <div class="row">
                            <div class="text-center">
                              <%= image_tag conjoint.piece_identite.preview(resize: "200x200>"), class: "m-t-xs img-responsive center-block img-card-size" if conjoint.piece_identite.attached? %>
                            </div>
                          </div>
                        </a>
                      <% else %>
                        <h6 style="font-weight: bold; font-style: italic; margin-top: 20px;" class="text-danger">
                          <small>Pièce d'identité non enregistrée</small></h6>
                      <% end %>
                    </div>
                  </div>
                </td>
              </tr>
              </tfoot>
            </table>
          <% end %>
        </div>

        <div class="col-lg-12" style="margin-top: 50px;">
          <h2 class="text-success">Informations enfant (s)
            <hr class="text-success
              ">
          </h2>
          <% @enfants.each do |enfant| %>
            <table class="table table-bordered table-hover" style="margin-top: 30px; font-size: 12px;">
              <caption><p style="font-style: italic; text-transform: uppercase;">
                <strong><%= enfant.prenom %> <%= enfant.nom %></strong> né le
                <strong> <%= l(enfant.date_naissance) unless enfant.date_naissance.nil? %></strong> à
                <strong><%= enfant.lieu_naissance %></strong>
              </p></caption>
              <thead>
              <tr>
                <th scope="col">Numéro de pièce</th>
                <th scope="col">Sexe</th>
                <th scope="col">Lien de parenté</th>
                <th scope="col">Conjoint</th>
                <th scope="col">Observations</th>
              </tr>
              </thead>
              <tbody>
              <tr>
                <td> <%= enfant.numero_piece %></td>
                <td> <%= CafEnfant.human_enum_name(:sexe, enfant.sexe) %></td>
                <td><%= CafEnfant.human_enum_name(:lien_parente, enfant.lien_parente) %></td>
                <td><%= enfant.caf_conjoint.prenom %> <%= enfant.caf_conjoint.nom %></td>
                <td> <%= enfant.observations %></td>
              </tr>
              </tbody>
              <tfoot>
              <tr>
                <td colspan="5" style="text-align: center;">
                  <div class="row">
                    <div class="col-sm-3"></div>
                    <% enfant.documents.each do |doc| %>
                      <div class="col-sm-3">
                        <h5>
                          <%= Document.human_enum_name(:type_document, doc.type_document) %>
                        </h5>
                        <a href="<%= url_for(doc.document) %>" target="_blank">
                          <div class="row">
                            <div class="text-center">
                              <%= image_tag doc.document.preview(resize: "200x200>"), class: "m-t-xs img-responsive center-block img-card-size " %>
                            </div>
                          </div>
                        </a>
                      </div>
                    <% end %>
                  </div>
                </td>
              </tr>
              </tfoot>
            </table>
          <% end %>
        </div>
        <div class="col-lg-12" style="margin-bottom: 100px; margin-top: 30px">
          <h3 style="text-align: center;">CERTIFIE</h3>
          <p style="text-align: justify;">
            <small>que les renseignements d'état civil consigné dans le présent document sont conformes aux indications
              figurant sur les documents officiels présentés par le travailleur, et atteste L'existence, à la présente
              date, des personnes énumérées ci-dessus.</small></p>

          <div class="col-lg-3 col-lg-offset-1">
            <p style="text-align: center; font-style: italic;">
              <small>Visa de l'autorité d'état civil ou cachet de l'institution</small></p>
          </div>
          <div class="col-lg-3 col-lg-offset-4">
            <p style="text-align: center; font-style: italic;">
              <small>Signature de l'officier d'état civil ou du représentant de l'organisation</small></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render 'soumission_etat_famille' %>
<%= render 'rejeter_etat_famille_form' %>
