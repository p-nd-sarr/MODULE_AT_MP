<%= content_for :titre_page, "Dossier De Prestation exterieure [#{PrestationExterieure.human_enum_name(:state, @prestation_exterieure.current_state)}]" %>

<%= content_for :titre_page_autres_details do %>
  statut dossier: <%= @prestation_exterieure.get_status? ? 'Complet' : 'Incomplet' %>
  <br>
  <%# if @prestation_exterieure.require_pieces_change? %>
  <!--    <p>-->
  <%# if @prestation_exterieure.dossier_suspendu? %>
  <!--        Votre dossier est suspendu, merci de renouveler les pièces :-->
  <%# else %>
  <!--        Attention! Veuillez svp renouveler les pièces avant le 01 avril :-->
  <%# end %>
  <%#= link_to "Je renouvelle les pièces", admin_prestation_exterieure_renouveler_pieces_path(@prestation_exterieure), class: 'btn btn-danger btn-sm' %>
  <!--    </p>-->
  <%# end %>

  Salarié : <%= @prestation_exterieure.prenom unless @prestation_exterieure.nil? %> <%= @prestation_exterieure.nom unless @prestation_exterieure.nil? %>
  <br>
  Etat du dossier : <%= "#{PrestationExterieure.human_enum_name(:etat, @prestation_exterieure.etat)}" %>
  <br>
  Crée le : <%= l(@prestation_exterieure.created_at) %>
<% end %>

<%= content_for :actions_page do %>
  <% if @prestation_exterieure.dossier_valide? %>
    <%= link_to 'Modifier dossier', admin_prestation_exterieure_modifier_dossier_path(@prestation_exterieure), class: 'btn btn-primary btn-xs' %>
  <% end %>

  <%= link_to 'Retour', admin_prestation_exterieures_path, class: 'btn btn-white btn-xs' %>
  <% unless @prestation_exterieure.information_valid %>
    <%= link_to 'Editer', edit_admin_prestation_exterieure_path(@prestation_exterieure), class: 'btn btn-white btn-xs' %>
  <% end %>
  <br>
  <% if @prestation_exterieure.pret_pour_validation? and @prestation_exterieure.initialisation? and !@prestation_exterieure.valide? %>
    <br>
    <button type="button" class="btn btn-primary btn-xs" data-toggle="modal" data-target="#SoumissionModal" id="soumettre_id">Valider
      le dossier
    </button>
  <% end %>
  <% if @prestation_exterieure.valide? %>
    <br>
    <%= link_to 'Régularisation', admin_prestation_exterieure_reouvrir_dossier_path(@prestation_exterieure), class: 'btn btn-primary btn-xs' if @prestation_exterieure.dossier_valide? %>
    <%= link_to 'voir etat de famille', admin_prestation_exterieure_generate_etat_path(@prestation_exterieure), class: 'btn btn-primary btn-xs' %>
  <% end %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="ibox float-e-margins">
      <div class="ibox-content">
        <div class="row">
          <div class="progressbar-wrapper">
            <ul class="progressbar">
              <li class="<%= ("active") if @prestation_exterieure.current_state >= :initialisation %>">Création</li>
              <li class="<%= ("active") if @prestation_exterieure.current_state >= :soumission_etat_chef_grp %>">Soumission
                état de famille CAF
              </li>
              <li class="<%= ("active") if @prestation_exterieure.current_state >= :dossier_valide %>">Validation
                dossier
                CAF
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

