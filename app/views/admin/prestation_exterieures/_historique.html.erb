<div class="ibox-content" style="font-size: 13px">
  <div class="full-height-scroll">
    <div class="row">
      <h4>
        Historiqie du dossier de prestations exterieures CAF
      </h4>
    </div>
    <hr>
    <div class="row">
      <div class="col-sm-4">
        <h5>Ouvert Par :  <%= @prestation_exterieure.ajoute_par.full_name %> </h5>
        <h5>Date de création : <%= @prestation_exterieure.created_at.strftime("%d/%m/%Y") %> </h5>
      </div>

      <div class="col-sm-4">
        <h5>Soumission état de famille par
          : <%= @prestation_exterieure.soumis_etf_par.full_name unless @prestation_exterieure.soumis_etf_par.nil? %> </h5>
        <h5>Date de soumission
          : <%= @prestation_exterieure.date_soumission_etf.strftime("%d/%m/%Y") unless @prestation_exterieure.date_soumission_etf.nil? %> </h5>
      </div>


      <div class="col-sm-4">
        <h5>Validation état de famille par
          : <%= @prestation_exterieure.valide_etf_par.full_name unless @prestation_exterieure.valide_etf_par.nil? %>  </h5>
        <h5>Date
          Date de validation
          : <%= @prestation_exterieure.date_validation_etf.strftime("%d/%m/%Y") unless @prestation_exterieure.date_validation_etf.nil? %> </h5>
      </div>

    </div>
    <hr>
    <div class="row">
      <h4>
        Historiqie des droits de liquidation
      </h4>
    </div>
    <hr>
