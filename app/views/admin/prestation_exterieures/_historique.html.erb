    <div class="row">

      <%= paginate @droits_liquidations %>
      <table class="table table-bordered table-condensed table-hover">
        <thead>
        <tr>
          <th align="center">Période indemnités</th>
          <th align="center">Liquidation</th>
          <th align="center">Validation chef grp</th>
          <th align="center">Validation chef sub CAF</th>
          <th align="center">Validation comptable</th>
        </tr>
        </thead>
        <tbody>
        <% @droits_liquidations.each do |droits_liquidation| %>
          <tr>
            <td><%= droits_liquidation.date_debut %> - <%= droits_liquidation.date_fin %></td>
            <td>
                  <span>
                    par : <%= droits_liquidation.liquide_par.prenom unless droits_liquidation.liquide_par.nil? %> <%= droits_liquidation.liquide_par.nom unless droits_liquidation.liquide_par.nil? %>
                  </span> <br>
              <span>
                    le <%= droits_liquidation.date_liquidation.strftime('%d/%m/%Y') unless droits_liquidation.date_liquidation.nil? %>
                  </span>
            </td>
            <td>
                  <span>
                    par : <%= droits_liquidation.valide_chef_grp_par.prenom unless droits_liquidation.valide_chef_grp_par.nil? %> <%= droits_liquidation.valide_chef_grp_par.nom unless droits_liquidation.valide_chef_grp_par.nil? %>
                  </span> <br>
              <span>
                    le <%= droits_liquidation.date_validation_chef_grp.strftime('%d/%m/%Y') unless droits_liquidation.date_validation_chef_grp.nil? %>
                  </span>
            </td>
            <td>
                  <span>
                    par : <%= droits_liquidation.valide_chef_sub_par.prenom unless droits_liquidation.valide_chef_sub_par.nil? %> <%= droits_liquidation.valide_chef_sub_par.nom unless droits_liquidation.valide_chef_sub_par.nil? %>
                  </span> <br>
              <span>
                    le <%= droits_liquidation.date_validation_chef_sub.strftime('%d/%m/%Y') unless droits_liquidation.date_validation_chef_sub.nil? %>
                  </span>
            </td>
            <td>
                  <span>
                    par : <%= droits_liquidation.valide_cpt_par.prenom unless droits_liquidation.valide_cpt_par.nil? %> <%= droits_liquidation.valide_cpt_par.nom unless droits_liquidation.valide_cpt_par.nil? %>
                  </span> <br>
              <span>
                    le <%= droits_liquidation.date_validation_cpt.strftime('%d/%m/%Y') unless droits_liquidation.date_validation_cpt.nil? %>
                  </span>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
      <%= paginate @droits_liquidations %>
    </div>

  </div>
</div>

