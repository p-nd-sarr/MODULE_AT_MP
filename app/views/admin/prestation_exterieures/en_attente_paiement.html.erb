<%= content_for :titre_page, 'Demandes De Prestation exterieure' %>
<div class="row" style="margin-top: -50px; min-height: 300px;">
  <div class="col-lg-12">
    <div class="ibox ">
      <div class="ibox-title">
        <h5>Prestations exterieures en attente de paiement</h5>
        <span class="label label-warning">Total demande <%= @q.result.with_dossier_valide_state.count %></span>
      </div>


      <div class="ibox-content">
        <div class="row">
          <div class="row">
            <div class="col-sm-3 col-sm-offset-8">
              <%= search_form_for @q, url: admin_en_attente_paiement_path do |f| %>
                <div class="input-group mb-3" style="float: right;">
                  <%= f.search_field :prenom_or_nom_or_numero_dossier_cont, class: "form-control form-control-sm", placeholder: "Search", style: "width:150px; position: relative; z-index: 1" %>
                  <div class="input-group-append" style="float: right; position:relative; z-index: 2">
                    <%= f.submit "Go!", :class => "btn btn-sm btn-primary", :style => "height:34px" %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        </div>
        <div id="tous" class="tab-pane fade in">
          <%= paginate @prestation_en_attente_paiement %>
          <table class="table table-bordered table-condensed table-hover" style="margin-top: 20px">
            <thead>
            <tr>
              <th scope="col">N° Dossier</th>
              <th align="center">Prénom</th>
              <th align="center">Nom</th>
              <th align="center">Date de naissance</th>
              <th align="center">Lieu de naissance</th>
              <th align="center">Etat</th>

              <th colspan="3"></th>
            </tr>
            </thead>
            <tbody>
            <% @prestation_en_attente_paiement.each do |prestation| %>
              <tr>
                <td><%= prestation.numero_dossier %></td>
                <td><%= prestation.prenom %></td>
                <td><%= prestation.nom %></td>
                <td><%= prestation.date_naissance.strftime('%d/%m/%Y') %></td>
                <td><%= prestation.lieu_naissance %></td>
                <td><%= prestation.etat %></td>
                <td style="width: 75px">
                  <%= link_to 'détails', admin_prestation_exterieure_path(prestation.id), class: 'btn btn-outline btn-primary btn-xs' %>
                </td>
                <% if prestation.current_state >= :dossier_valide %>
                  <td style="width: 75px">
                    <%= link_to 'générer état', admin_prestation_exterieure_generate_etat_path(prestation, prestation.id, format: :pdf), class: 'btn btn-outline btn-danger btn-xs', target: '_blank' %>
                  </td>
                <% end %>
              </tr>
            <% end %>
            </tbody>
          </table>
          <%= paginate @prestation_en_attente_paiement %>
        </div>
      </div>
    </div>
  </div>
</div>
