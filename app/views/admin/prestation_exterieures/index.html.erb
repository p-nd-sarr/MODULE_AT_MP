            <% if current_user.gestionnaire_compte_allocataire? %>
              <div class="col-sm-2">
                <%= link_to ' AJOUTER', new_admin_prestation_exterieure_path, class: 'fa fa-plus btn btn-w-m btn-outline btn-success', style: 'height: 34px' %>
              </div>
            <% end %>
          </div> 
          <div class="tab-content">
            <div id="tous" class="tab-pane fade in active">
              <%= paginate @prestation_exterieures %>
              <table class="table table-bordered table-condensed table-hover" style="margin-top: 20px">
                <thead>
                <tr>
                  <th scope="col">N° Dossier</th>
                  <th align="center">Prénom</th>
                  <th align="center">Nom</th>
                  <th align="center">Date de naissance</th>
                  <th align="center">Lieu de naissance</th>
                  <th align="center">Etat</th>
                  <th align="center">Statut dossier</th>
                  <th align="center">Options</th>
                </tr>
                </thead>
                <tbody>
                <% @prestation_exterieures.each do |prestation| %>
                  <tr>
                    <td><%= prestation.numero_dossier %></td>
                    <td><%= prestation.prenom %></td>
                    <td><%= prestation.nom %></td>
                    <td><%= prestation.date_naissance.strftime('%d/%m/%Y') unless prestation.date_naissance.nil? %></td>
                    <td><%= prestation.lieu_naissance %></td>
                    <td><%= "#{PrestationExterieure.human_enum_name(:state, prestation.current_state)}" %></td>
                    <td> <%= prestation.get_status? ? 'Complet' : 'Incomplet' %> </td>
                    <td>
                      <%= link_to 'détails', admin_prestation_exterieure_path(prestation.id), class: 'btn btn-outline btn-primary btn-xs' %>
                      <% if prestation.creation? %>
                        <%= link_to 'supprimer', admin_prestation_exterieure_path(prestation.id), method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
                      <% end %>
                      <% if prestation.current_state >= :dossier_valide %>
                        <%= link_to 'Télécharger état', admin_prestation_exterieure_generate_etat_path(prestation, prestation.id, format: :pdf), class: 'btn btn-outline btn-danger btn-xs', target: '_blank' %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
              <%= paginate @prestation_exterieures %>
            </div>
