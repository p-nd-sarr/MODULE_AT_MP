<%= content_for :titre_page, "Prestation exterieure / Historique" %>

<%= content_for :titre_page_autres_details do %>
  statut dossier: <%= @prestation_exterieure.get_status? ? 'Complet' : 'Incomplet' %>
  <br>

  Salarié : <%= @prestation_exterieure.prenom unless @prestation_exterieure.nil? %> <%= @prestation_exterieure.nom unless @prestation_exterieure.nil? %>
  <br>
  Etat du dossier : <%= "#{PrestationExterieure.human_enum_name(:etat, @prestation_exterieure.etat)}" %>
  <br>
  Crée le : <%= l(@prestation_exterieure.created_at) %>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_prestation_exterieure_path(@prestation_exterieure), class: 'btn btn-white btn-xs' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content" style="font-size: 13px">
    <div class="ibox-content" style="font-size: 13px">
      <div class="full-height-scroll">
        <div class="row">
          <h4>
            Historiqie du dossier de prestations exterieures CAF
          </h4>
        </div>
        <hr>
        <div class="row">
          <div class="col-sm-4">
            <h5>Ouvert Par
              :  <%= @prestation_exterieure.ajoute_par.full_name unless @prestation_exterieure.ajoute_par.nil? %> </h5>
            <h5>Date de création : <%= @prestation_exterieure.created_at.strftime("%d/%m/%Y") %> </h5>
          </div>

          <div class="col-sm-4">
            <h5>Soumission état de famille par
              : <%= @prestation_exterieure.soumis_etf_par.full_name unless @prestation_exterieure.soumis_etf_par.nil? %> </h5>
            <h5>Date de soumission
              : <%= @prestation_exterieure.date_soumission_etf.strftime("%d/%m/%Y") unless @prestation_exterieure.date_soumission_etf.nil? %> </h5>
          </div>


          <div class="col-sm-4">
            <h5>Validation état de famille par
              : <%= @prestation_exterieure.valide_etf_par.full_name unless @prestation_exterieure.valide_etf_par.nil? %>  </h5>
            <h5>Date
              Date de validation
              : <%= @prestation_exterieure.date_validation_etf.strftime("%d/%m/%Y") unless @prestation_exterieure.date_validation_etf.nil? %> </h5>
          </div>

        </div>
        <hr>
        <div class="row">
          <h4>
            Historiqie des droits de liquidation
          </h4>
        </div>
        <hr>
        <div class="row">
          <%= paginate @droits_liquidations %>
          <table class="table table-bordered table-condensed table-hover">
            <thead>
            <tr>
              <th align="center">Période indemnités</th>
              <th align="center">Liquidation</th>
              <th align="center">Validation chef grp</th>
              <th align="center">Validation chef sub CAF</th>
              <th align="center">Validation comptable</th>
            </tr>
            </thead>
            <tbody>
            <% @droits_liquidations.each do |droits_liquidation| %>
              <tr>
                <td><%= droits_liquidation.date_debut %> - <%= droits_liquidation.date_fin %></td>
                <td>
                  <span>
                    par : <%= droits_liquidation.liquide_par.prenom unless droits_liquidation.liquide_par.nil? %> <%= droits_liquidation.liquide_par.nom unless droits_liquidation.liquide_par.nil? %>
                  </span> <br>
                  <span>
                    le <%= droits_liquidation.date_liquidation.strftime('%d/%m/%Y') unless droits_liquidation.date_liquidation.nil? %>
                  </span>
                </td>
                <td>
                  <span>
                    par : <%= droits_liquidation.valide_chef_grp_par.prenom unless droits_liquidation.valide_chef_grp_par.nil? %> <%= droits_liquidation.valide_chef_grp_par.nom unless droits_liquidation.valide_chef_grp_par.nil? %>
                  </span> <br>
                  <span>
                    le <%= droits_liquidation.date_validation_chef_grp.strftime('%d/%m/%Y') unless droits_liquidation.date_validation_chef_grp.nil? %>
                  </span>
                </td>
                <td>
                  <span>
                    par : <%= droits_liquidation.valide_chef_sub_par.prenom unless droits_liquidation.valide_chef_sub_par.nil? %> <%= droits_liquidation.valide_chef_sub_par.nom unless droits_liquidation.valide_chef_sub_par.nil? %>
                  </span> <br>
                  <span>
                    le <%= droits_liquidation.date_validation_chef_sub.strftime('%d/%m/%Y') unless droits_liquidation.date_validation_chef_sub.nil? %>
                  </span>
                </td>
                <td>
                  <span>
                    par : <%= droits_liquidation.valide_cpt_par.prenom unless droits_liquidation.valide_cpt_par.nil? %> <%= droits_liquidation.valide_cpt_par.nom unless droits_liquidation.valide_cpt_par.nil? %>
                  </span> <br>
                  <span>
                    le <%= droits_liquidation.date_validation_cpt.strftime('%d/%m/%Y') unless droits_liquidation.date_validation_cpt.nil? %>
                  </span>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
          <%= paginate @droits_liquidations %>
        </div>

      </div>
    </div>
  </div>
</div>

