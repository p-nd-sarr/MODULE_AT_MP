<%= content_for :titre_page, "Dossier De Prestation exterieure [#{PrestationExterieure.human_enum_name(:state, @prestation_exterieure.current_state)}]" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_prestation_exterieure_path(@prestation_exterieure.id), class: 'btn btn-white btn-sm' %>
<% end %>



<% if @prestation_exterieure.creation?  %>
  <div class="ibox ">
    <div class="ibox-title">
      <h5>Modification  des documents</h5>
    </div>
    <div class="ibox-content">
      <table class="table table-striped table-bordered table-hover">
        <thead>
        <tr>
          <th scope="col"  style="width: 300px">Type</th>
          <th scope="col" style="width: 500px">Choisir document</th>
          <th scope="col" style="width: 100px">Action</th>
        </tr>
        </thead>
        <% DocumentPrestationExterieure::TYPE_DOCUMENT.each do |document_name| %>
          <tbody>
          <%= bootstrap_form_for(@document_prestation_exterieure, url: admin_prestation_exterieure_update_document_path(@prestation_exterieure, @document_prestation_exterieure), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <tr>
              <td >
                <%= f.hidden_field :type_document, value:document_name.first%>
                <%=DocumentPrestationExterieure.human_enum_name(:type_document, document_name.first)%>
              </td>
              <td>
                <%= f.file_field :document, label: ''.html_safe%>
              </td>

              <td>
                <%= f.button 'Modifier', class: 'btn btn-outline btn-primary btn-xs' %>
              </td>
            </tr>
          <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>
<% end %>