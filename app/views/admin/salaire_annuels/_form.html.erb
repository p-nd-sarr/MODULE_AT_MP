<%= bootstrap_form_for(@admin_salaire_annuel, layout: :horizontal) do |f| %>
    <%= f.text_field :annee %>
    <%= f.number_field :coefficient %>
    <%= f.date_select :date_effet %>
    <%= f.date_select :date_reval %>
    <%= f.text_field :plancher %>
    <%= f.text_field :plafond %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_salaire_annuels_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
