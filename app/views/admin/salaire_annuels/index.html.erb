<%= content_for :titre_page, 'Admin Salaire Annuels' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_salaire_annuel_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
                <th scope="col">Annee</th>
                <th scope="col">Coefficient</th>
                <th scope="col">Date effet</th>
                <th scope="col">Date reval</th>
                <th scope="col">Plancher</th>
                <th scope="col">Plafond</th>
            <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_salaire_annuels.each do |admin_salaire_annuel| %>
    <tr>
                <td><%= admin_salaire_annuel.annee %></td>
                <td><%= admin_salaire_annuel.coefficient %></td>
                <td><%= admin_salaire_annuel.date_effet %></td>
                <td><%= admin_salaire_annuel.date_reval %></td>
                <td><%= admin_salaire_annuel.plancher %></td>
                <td><%= admin_salaire_annuel.plafond %></td>
            <td style="width: 75px">
        <%= link_to 'détails', admin_salaire_annuel, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_salaire_annuel_path(admin_salaire_annuel), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_salaire_annuel, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>