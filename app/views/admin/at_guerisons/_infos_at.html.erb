<p>
  <strong>Prénom:</strong>
  <%= @arret_travail.try(:prenom_salarie) %>
</p>

<p>
  <strong>Nom:</strong>
  <%= @arret_travail.try(:nom_salarie) %>
</p>

<p>
  <strong>Date de naissance:</strong>

 <%= @arret_travail.try(:date_de_naissance_salarie).strftime("%d-%m-%Y") unless @arret_travail.nil? %>
</p>

<p>
  <strong>Date accident:</strong>
  <%= @arret_travail.try(:date_accident).strftime("%d-%m-%Y") unless @arret_travail.nil? %>
</p>

<p>
  <strong>Téléphone:</strong>
  <%= @arret_travail.try(:telephone) %>
</p>

<p>
  <strong>Etat dossier AT:</strong>
  <%= @at_guerison.arret_travail.try(:etat) %>
</p>

<p>
  <strong>N° SINISTRE:</strong>
  <%= @arret_travail.try(:num_dossier) %>
</p>