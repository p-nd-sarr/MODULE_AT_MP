<style type="text/css">
  label[title="required"] {
    display: none;
  }

  .invalid-feedback {
    font-size: 0px;
  }
</style>

  <div class="row" style="margin-top: 20px;">
    <div class="col-lg-4">
      <h2>Liste des documents</h2>
    </div>
    <%# unless @admin_reversion_veuve_salary.documents_valide! %>
      <div class="col-lg-8">
        <div class="alert alert-info alert-dismissable">
          <button ariahidden="true" data-dismiss="alert" class="close" type="button">
            <font style="vertical-align: inherit;">
              <font style="vertical-align: inherit;">x</font>
            </font>
          </button>
          <font style="vertical-align: inherit;">
            <font style="vertical-align: inherit;"><span class="fa fa-info-o"></span> Veuillez renseigner des documents
              au format PDF</font>
          </font>
        </div>
      </div>
    <%# end %>
  </div>



<% if @at_guerison.creation? %>
<%= render 'documents/liste',
           object: @at_guerison,
           documents: @at_guerison.documents,
           include_add: @at_guerison.creation?,
           include_delete: @at_guerison.creation?,
           type_documents: AtGuerison::TYPE_DOCUMENT,
           type_documents_obligatoires: AtGuerison::TYPE_DOCUMENT_OBLIGATOIRE,
           back_url: admin_arret_travail_at_guerison_path(@at_guerison)
%>

  <%= render 'documents/modal_form',
            type_documents: AtGuerison::TYPE_DOCUMENT,
            document: Document.new(documentable: @at_guerison),
             back_url: admin_arret_travail_at_guerison_path(@at_guerison)
  %>
<% else %>
<%= render 'documents/liste',
           object: @at_guerison,
           documents: @at_guerison.documents,
           include_add: false, 
           include_delete: false, 
           type_documents: AtGuerison::TYPE_DOCUMENT,
           type_documents_obligatoires: AtGuerison::TYPE_DOCUMENT_OBLIGATOIRE,
           back_url: admin_arret_travail_at_guerison_path(@at_guerison)
%>
<%end%>
