<% content_for :titre_page %>
<%= content_for :titre_page_autres_details do %>
  Numéro Affiliation:  <%= " #{@at_guerison.arret_travail.numero_affiliation}" %> <br>
   Numéro Sinistre:  <%= " #{@at_guerison.arret_travail.num_dossier}" %> <br>
  <p class="text-danger">
    <span><%= (" Motif retour Dossier :  #{@at_guerison.motif} ") unless @at_guerison.motif.nil? %> </span>
  </p>
  <%= link_to 'Retour', admin_at_guerisons_path, class: 'btn btn-white btn-sm' %>
  <%= link_to "Dossier AT",  admin_arret_travail_path(@at_guerison.arret_travail), class: 'btn btn-success btn-sm' %>
<% end %>


<%= content_for :actions_page do %>
  
  <% if @at_guerison.can_update?(current_user) %>
    <%= link_to 'Modifier', edit_admin_at_guerison_path(@at_guerison), class: 'btn btn-white btn-sm' %>
    <%= (link_to 'Supprimer',admin_at_guerison_path(@at_guerison), method: :delete, data: {confirm: 'Êtes-vous sûr de vouloir supprimer ?'}, class: 'btn btn-danger btn-sm') %>
  <% end %>

  <% if @at_guerison.pret_pour_soumission?(current_user) && @at_guerison.creation? %>
    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#SoumissionSalaireModal" id="soumettre_id">Soumettre</button>
     <%= render 'soumission_form' %>
  <% end %>

  <% if @at_guerison.can_valide_agence?(current_user) %>
    <%= link_to "Validation",  admin_at_guerison_validation_chef_agence_path(@at_guerison), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
      <button type="button" class="btn btn-warning btn-sm" data-toggle="modal" data-target="#motif">Retourner dossier</button>
      <%= render 'modal_retour' %>
      <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif">Rejeter dossier</button>
      <%= render 'modal_rejet' %>
  <% end %>

  <% if @at_guerison.can_valide_dir?(current_user) %>
    <%= link_to "Validation",  admin_at_guerison_validation_chef_service_path(@at_guerison), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
      <button type="button" class="btn btn-warning btn-sm" data-toggle="modal" data-target="#motif">Retourner dossier</button>
      <%= render 'modal_retour' %>
      <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif">Rejeter dossier</button>
      <%= render 'modal_rejet' %>
  <% end %>

<% end %>

<div class="wrapper wrapper-content">
  <div class="progressbar-wrapper">
    <ul class="progressbar">
      <li class="<%= ("active") if @at_guerison.current_state >= :creation %>">Création</li>
      <% if @at_guerison.arret_travail.creer_en_agence?  %>
          <li class="<%= ("active") if @at_guerison.current_state  >= :soumis_chef_agence %>">Soumis chef agence </li>
      <% else %>
        <li class="<%= ("active") if @at_guerison.current_state  >= :soumis_chef_service %>">Soumis chef service </li>    
      <% end %>
    

      <% if @at_guerison.current_state == :guerison_validee %>
        <li class="<%= ("active") if @at_guerison.current_state >= :guerison_validee %>">Guerison validée</li>
      <% end %>

      <% if @at_guerison.current_state == :guerison_rejetee %>
        <li class="<%= ("active") if @at_guerison.current_state >= :guerison_rejetee %>">Guerison rejetée</li>
      <% end %>

    </ul>
  </div><!--End ProgressBar"-->
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
              <div class="tabs-container">
            <ul class="nav nav-tabs" id='mes_navbars' style="font-size: 11px;">
            
              <li class="nav-item active">
                <a class="nav-link" data-toggle="tab" href="#tab-1">Info. Générales
                    <%= '<span class="label label-warning">à valider</span>'.html_safe  unless @at_guerison.information_generale?  %>
                    <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @at_guerison.information_generale? %>   
                </a>
              </li>

              <li class="nav-item">
                <a data-toggle="tab" href="#tab-2">Documents
                  <%= '<span class="label label-warning">à valider</span>'.html_safe unless @at_guerison.documents_valide? %>
                  <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @at_guerison.documents_valide? %>     
                </a>
              </li>

            

             

              <li class="nav-item">
                <a data-toggle="tab" href="#tab-4">Historiques
                  <%#= '<span class="label label-warning">à valider</span>'.html_safe unless @demande_arret_travail.detail_accident_valid? %>
                  <%#= '<span class="label label-primary">&#10003;</span>'.html_safe if @demande_arret_travail.detail_accident_valid? %>     
                </a>
              </li>
            
            </ul>
            <div class="tab-content">
              <div id="tab-1" class="tab-pane active">
                <div class="full-height-scroll">
                  <br>
                  <% if !@at_guerison.information_generale?   %>
                    <%= link_to "Validation des informations", admin_at_guerison_valider_information_generale_path(@at_guerison), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
                    <hr>
                  <% end %>
                  <%= render 'show_informations' %>
                </div>
              </div>
              <div id="tab-2" class="tab-pane">
                <div class="full-height-scroll">
                  <br>
                
                  <% if !@at_guerison.documents_valide?   %>
                    <%= link_to "Validation des documents", admin_at_guerison_valider_documents_path(@at_guerison), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
                    <hr>
                  <% end %>
                    <%= render 'show_documents' %>
                </div>
              </div>

            </div>
          </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>

  .progressbar-wrapper {
    width: 100%;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 2%;
  }

  .progressbar li {
    list-style-type: none;
    width: 10%;
    float: left;
    font-size: 10px;
    position: relative;
    text-align: center;
    text-transform: uppercase;
    color: #7d7d7d;
  }

  .progressbar li:before {
    width: 60px;
    height: 60px;
    content: "";
    line-height: 60px;
    border: 2px solid #7d7d7d;
    display: block;
    text-align: center;
    margin: 0 auto 3px auto;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    background-color: #fff;
  }

  .progressbar li:after {
    width: 100%;
    height: 2px;
    content: '';
    position: absolute;
    background-color: #7d7d7d;
    top: 30px;
    left: -50%;
    z-index: 0;
  }

  .progressbar li:first-child:after {
    content: none;
  }

  .progressbar li.active {
    color: #000;
    font-weight: normal;
  }

  .progressbar li.active:before {
    border-color: #1ab394;
    background: #1ab394;
  }

  .progressbar li.active + li:after {
    background-color: #1ab394;
  }

  .progressbar li.active:before {
    background: #1ab394;
    background-size: 60%;
  }

  .progressbar li::before {
    background: #fff;
    background-size: 70%;
  }

  .progressbar {
    counter-reset: step;
  }

  .progressbar li:before {
    content: counter(step);
    counter-increment: step;
  }
  .progressbar li.rejet.active:before {
    background-color: red;
  }
</style>