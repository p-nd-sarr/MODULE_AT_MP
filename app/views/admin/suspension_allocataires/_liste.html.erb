
<table class="table table-striped" style="margin-top: 20px">
  <thead>
    <tr>
      <th scope="col">Matricule</th>
      <th scope="col">Prénom</th>
      <th scope="col">Nom</th>
      <th scope="col">Etat</th>
      <th colspan="2"></th>
    </tr>
  </thead>
  <tbody>
    <% @suspension_allocataires.each do |suspension_allocataire| %>
      <tr>
       
        <td><%= suspension_allocataire.numero_allocataire %></td>
        <td><%= suspension_allocataire.prenom %></td>
        <td><%= suspension_allocataire.nom %></td>
        <td><%= suspension_allocataire.workflow_state %></td>
        <td>
          <%= link_to 'détails', [:admin, suspension_allocataire.allocataire, suspension_allocataire], class: 'btn btn-outline btn-primary btn-xs' %>
        </td>
        
      </tr>
    <% end %>
  </tbody>
</table>

