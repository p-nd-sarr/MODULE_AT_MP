<style type="text/css">

    .no-text{
        font-size:0px;
    }
    .invalid-feedback{
        font-size:0px;
    }
</style>
<%= bootstrap_form_for([:admin, @admin_deces_enfant], layout: :horizontal) do |f| %>
  <%= f.alert_message "Veuillez corriger les erreurs ci-dessous." %>
  <div class="content clearfix">
    <h2 class="text-navy" style="font-weight:bold">Informations sur les parents</h2>
    <hr>
    <div class="row">
      <div class="form-group">
        <div class="col-sm-12">
          <div class="col-sm-12">
            <div class="col-sm-6">
              <%= f.text_field :numero_affiliation, label: 'Numéro affiliation salarié' %>
            </div>

            <div class="col-sm-6">
              <%= f.text_field :prenom_salarie, label: 'Prénom salarié', readonly: true %>
            </div>
          </div>

          <div class="col-sm-12">
            <div class="col-sm-6">
              <%= f.text_field :nom_salarie, label: 'Nom salarié', readonly: true %>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
  <br>
  <div class="content clearfix">
    <h2 class="text-navy" style="font-weight:bold">Informations de l'enfant à ajouter</h2>
    <hr>
    <div class="row">
      <div class="form-group">

        <div class="col-sm-12">
          <div class="col-sm-6">
            <%= f.collection_select :enfant_id, Enfant.where(id: @admin_deces_enfant.enfant), :id, :full_name, label: "Nom de l'enfant" %>
          </div>

          <div class="col-sm-6">
            <%= f.date_field :date_deces, label: "Date de décés",
                             start_year: (Date.today - 50.year).year, end_year: Date.today.year, end_month: Date.today.month%>
          </div>
        </div>
        <div class="col-sm-12">
          <div class="col-sm-6">
            <%= f.select :type_piece,
                         DecesEnfant::TYPE_PIECE.keys.collect { |piece_jointe| [DecesEnfant.human_enum_name(:piece_jointe, piece_jointe), piece_jointe] },
                         label: "Type de pièce" %>
          </div>

          <div class="col-sm-6">
            <%= f.text_field :numero_piece, label: "Numéro de pièce *" %>
          </div>
        </div>
        <div class="col-sm-12">
          <div class="col-sm-6" style="height: 60px;  margin-top: 30px;">
            <h4 style="font-weight: bold;">Pièce justificatif *</h4>
            <div class="btn-file">
              <label class="no-text">
                <%= f.file_field :justificatif_deces, hide_label:true, label: '.',
                                 help: (@admin_deces_enfant.persisted?), id:'label-cert'  %>
                <div class="btn btn-success" style="margin-left: 1px;"><span class="fa fa-upload"></span> Choisir un fichier
                </div>
              </label>
            </div>
            <small id="certeficat-name"></small>
          </div>
        </div>
      </div>
    </div>
  </div>

  <br>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_deces_enfants_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
  </div>
<% end %>

<% content_for :javascript do %>
  <script type="text/javascript">

      $(document).ready(function () {
          load_salarie()
          load_enfants()
      });

      $('#deces_enfant_numero_affiliation').change(
          function () {
              load_salarie()
              load_enfants()
          }
      )

      function load_salarie() {
          $('#deces_enfant_numero_affiliation').change(function () {
                  let numero_affiliation = $('#deces_enfant_numero_affiliation').val();
                  $.ajax({
                      url: "/admin/conjoints/salaries/" + numero_affiliation + ".json",
                      method: 'get',
                      dataType: "json",
                      success: function (data) {
                          if (data) {
                              salarie = data
                              $("#deces_enfant_prenom_salarie").val(data[0].prenom);
                              $("#deces_enfant_nom_salarie").val(data[0].nom);

                          } else {
                              alert("There is an error with AJAX!");
                              $("#deces_enfant_prenom_salarie").val('');
                              $("#deces_enfant_nom_salarie").val('');
                          }
                      },
                      error: function (XMLHttpRequest, textStatus, errorThrown) {
                          alert("There is an error with AJAX!");
                          $("#deces_enfant_prenom_salarie").val('');
                          $("#deces_enfant_nom_salarie").val('');
                      }

                  });
              }
          );
      }

      function load_enfants() {
          var numero_affiliation = $('#deces_enfant_numero_affiliation').val();
          $.ajax({
              url: "/admin/enfants/listenfant/" + numero_affiliation + ".json",
              method: 'get',
              dataType: "json",
              success: function (data) {
                  if (data) {
                      html = '<option value=""></option>';

                      $.each(data, function (key, data) {
                          html += '<option value="' + data.id + '">' + data.prenom + ' ' + data.nom + '</option>';
                      });

                      $("#deces_enfant_enfant_id").html(html);
                  } else {
                      $("#deces_enfant_enfant_id").html('<option value=""></option>');
                  }
              },
              error: function (XMLHttpRequest, textStatus, errorThrown) {
                  $("#deces_enfant_enfant_id").html('<option value=""></option>');
              }
          });
      }

      const input2=document.getElementById('label-cert');
      const infoArea2=document.getElementById('certeficat-name');
      input2.addEventListener('change', showFileName2);
      function showFileName2(event){
          var input=event.srcElement;
          var fileName=input.files[0].name;
          infoArea2.textContent=fileName;
      }
  </script>
<% end %>
