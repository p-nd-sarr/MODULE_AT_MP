<%= content_for :titre_page, 'Décés Enfants' %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_admin_deces_enfant_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'admin/deces_enfants/search' %>
    <br>
    <hr>
    <%= paginate @admin_deces_enfants %>
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Numero affiliation</th>
        <th scope="col">Prenom</th>
        <th scope="col">Nom</th>
        <th scope="col">Date naissance</th>
        <th scope="col">Date deces</th>
        <th scope="col">Prenom salarie</th>
        <th scope="col">Nom salarie</th>
            <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_deces_enfants.each do |deces_enfant| %>
    <tr>
                <td><%= deces_enfant.numero_affiliation %></td>
                <td><%= deces_enfant.enfant.prenom unless deces_enfant.enfant.nil? %></td>
                <td><%= deces_enfant.enfant.nom unless deces_enfant.enfant.nil? %></td>
                <td><%= deces_enfant.enfant.date_naissance unless deces_enfant.enfant.nil? %></td>
                <td><%= deces_enfant.date_deces unless deces_enfant.date_deces.nil?%></td>
                <td><%= deces_enfant.prenom_salarie unless deces_enfant.prenom_salarie.nil?%></td>
                <td><%= deces_enfant.nom_salarie unless deces_enfant.nom_salarie.nil?%></td>
            <td style="width: 75px">
        <%= link_to 'détails', admin_deces_enfant_path(deces_enfant), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_deces_enfant_path(deces_enfant), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_deces_enfant_path(deces_enfant), method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
    <%= paginate @admin_deces_enfants %>
  </div>
</div>