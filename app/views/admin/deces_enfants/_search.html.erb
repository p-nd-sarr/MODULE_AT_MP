<h3>Critères de recherche</h3>
<br>

<%= search_form_for @q, url: request.path, html: { id: 'formulaire_recherche' } do |f| %>
  <div class="row">
    <div class="col-sm-3">
      <%= f.label :numero_affiliation_cont, 'Numéro Affiliation' %>
      <%= f.search_field :numero_affiliation_cont, class: 'form-control' %>
    </div>

    <div class="col-sm-3">
      <%= f.label :enfant_prenom_cont, 'Prénom' %>
      <%= f.search_field :enfant_prenom_cont, class: 'form-control' %>
    </div>

    <div class="col-sm-3">
      <%= f.label :enfant_nom_cont, 'Nom' %>
      <%= f.search_field :enfant_nom_cont, class: 'form-control' %>
    </div>
  </div>
  <div class="hr-line-dashed"></div>
  <%= f.submit 'Rechercher', class: 'btn btn-primary', id: 'action_search' %>
<% end %>