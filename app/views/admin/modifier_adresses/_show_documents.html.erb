<style type="text/css">
  label[title="required"] {
    display: none;
  }

  .invalid-feedback {
    font-size: 0px;
  }
</style>


<ul class="text-danger">
  <% if @modifier_adresse.documents.where(type_document: [:cni, :attestation_travail, :certificat_mariage, :passeport, :carte_consulaire]).empty? %>
    <li>Veuillez ajouter une copie du CNI ou passeport ou carte consulaire</li>
  <% end %>
</ul>


  <div class="row" style="margin-top: 20px;">
    <div class="col-lg-4">
      <h2>Liste des documents</h2>
    </div>
    <%# unless @admin_reversion_veuve_salary.documents_valide! %>
      <div class="col-lg-8">
        <div class="alert alert-info alert-dismissable">
          <button ariahidden="true" data-dismiss="alert" class="close" type="button">
            <font style="vertical-align: inherit;">
              <font style="vertical-align: inherit;">x</font>
            </font>
          </button>
          <font style="vertical-align: inherit;">
            <font style="vertical-align: inherit;"><span class="fa fa-info-o"></span> Veuillez renseigner des documents
              au format PDF</font>
          </font>
        </div>
      </div>
    <%# end %>
  </div>



<% if @modifier_adresse.creation? %>
<%= render 'documents/liste',
           object: @modifier_adresse,
           documents: @modifier_adresse.documents,
           include_add: @modifier_adresse.creation?,
           include_delete: @modifier_adresse.creation?,
           type_documents: ModifierAdresse::TYPE_DOCUMENT,
           type_documents_obligatoires: ModifierAdresse::TYPE_DOCUMENT_OBLIGATOIRE,
           back_url: admin_allocataire_modifier_adress_path(@allocataire,@modifier_adresse)
%>

  <%= render 'documents/modal_form',
            type_documents: ModifierAdresse::TYPE_DOCUMENT,
            document: Document.new(documentable: @modifier_adresse),
             back_url: admin_allocataire_modifier_adress_path(@allocataire,@modifier_adresse)
  %>
<% else %>
<%= render 'documents/liste',
           object: @modifier_adresse,
           documents: @modifier_adresse.documents,
           include_add: false, 
           include_delete: false, 
           type_documents: ModifierModePaiement::TYPE_DOCUMENT,
           type_documents_obligatoires: ModifierAdresse::TYPE_DOCUMENT_OBLIGATOIRE,
           back_url: admin_allocataire_modifier_adress_path(@allocataire,@modifier_adresse)
%>
<%end%>