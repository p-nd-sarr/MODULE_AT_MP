<%= content_for :titre_page, "Détail allocation prenatale migrée" %>

<%= content_for :titre_page_autres_details do %>
  <% unless @dossier_prestation.nil? %>
    Allocataire : <%= @dossier_prestation.full_name %> <br>
  <% end %>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Dossier de l’allocataire', admin_dossier_prestation_path(@dossier_prestation), class: 'btn btn-white btn-sm' unless @dossier_prestation.nil? %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <div class="row">
      <div class="col-lg-6">
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Conjoint ID:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.conjoint_id unless @allocation_prenatale_migree.conjoint_id.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Nom conjoint:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.conjoint_nom unless @allocation_prenatale_migree.conjoint_nom.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Prenom conjoint:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.conjoint_prenom unless @allocation_prenatale_migree.conjoint_prenom.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Volet:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.volet unless @allocation_prenatale_migree.volet.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> État:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.etat unless @allocation_prenatale_migree.etat.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Montant liquidé:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.montant_liquide unless @allocation_prenatale_migree.montant_liquide.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Numéro liquidation:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.numero_liquidation unless @allocation_prenatale_migree.numero_liquidation.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Ajouté Par:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.ajoute_par unless @allocation_prenatale_migree.ajoute_par.nil? %></dd>
          </div>
        </d1>
      </div>
      <div class="col-lg-6">
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Date visite:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.date_visite unless @allocation_prenatale_migree.date_visite.nil? %></dd>
          </div>
        </d1>

        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Date création:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.date_creation unless @allocation_prenatale_migree.date_creation.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Date liquidation:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.date_liquidation unless @allocation_prenatale_migree.date_liquidation.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Date validation:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.date_validation unless @allocation_prenatale_migree.date_validation.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Date paiement:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.date_paiement unless @allocation_prenatale_migree.date_paiement.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Bénéficiaire ID:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.beneficiaire_id unless @allocation_prenatale_migree.beneficiaire_id.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Nom bénéficiaire:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.beneficiaire_nom unless @allocation_prenatale_migree.beneficiaire_nom.nil? %></dd>
          </div>
        </d1>
        <d1 class="row mb-0">
          <div class="col-sm-6 text-sm-right" style="text-align: right;">
            <dt><span class="fa fa-arrow-right"></span> Prenom bénéficiaire:</dt>
          </div>
          <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
            <dd class="mb-1"><%= @allocation_prenatale_migree.beneficiaire_prenom unless @allocation_prenatale_migree.beneficiaire_prenom.nil? %></dd>
          </div>
        </d1>
      </div>
    </div>
  </div>
</div>
</div>