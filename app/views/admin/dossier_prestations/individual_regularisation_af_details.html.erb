<%= content_for :titre_page, "Dossier De Prestation / Détails Régularisation Individuelle AF" %>

<%= content_for :titre_page_autres_details do %>
  Etat du dossier : <%= "#{DossierPrestation.human_enum_name(:etat, @dossier_prestation.etat)}" %> <br>
  <span style="font-style: italic">Est repris?</span> : <%= state_yes_no @dossier_prestation.est_repris %>
  <% unless @dossier_prestation.date_soumission.nil? %>
    <br>
    <strong class="text-info">Date soumission :</strong>
    <%= "#{l @dossier_prestation.date_soumission}" %>
  <% end %> <br>
  Année : <%= @annee %> <br>
  Trimestre : <%= CarriereDossierPrestation.human_enum_name(:trimestre, params[:trimestre]) %> <br>
  Montant global à payé pour ce trimestre : <%= format_cfa @dossier_prestation.get_amount_af_to_pay(@annee, @trimestre) unless @dossier_prestation.get_amount_af_to_pay(@annee, @trimestre).nil? %>
  <br>
  Montant déjà payé pour ce trimestre : <%= format_cfa @dossier_prestation.get_amount_af_paid(@annee, @trimestre) unless @dossier_prestation.get_amount_af_paid(@annee, @trimestre).nil? %>
  <br>
  Montant à régulariser pour ce trimestre : <%= format_cfa @dossier_prestation.get_amount_af_to_regularize(@annee, @trimestre) unless @dossier_prestation.get_amount_af_to_regularize(@annee, @trimestre).nil? %>
  <br>
  Employeur : <%= @dossier_prestation.psrm_employeur.fhnum unless @dossier_prestation.psrm_employeur.nil? %> <br>
<% end %>


<%= content_for :actions_page do %>
  <%= link_to ' Retour', admin_dossier_prestation_individual_regularisation_af_path(@dossier_prestation), class: 'btn btn-white btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <% if @dossier_prestation.get_amount_af_to_regularize(@annee, @trimestre).zero? %>
            <h3>Aucune régularisation possible !</h3>
            <br>
            <hr>
          <% end %>
          <table class="table table-bordered table-condensed table-hover">
            <thead>
            <tr>
              <th scope="col">Prénom enfant</th>
              <th scope="col">Nom enfant</th>
              <th scope="col">Date de naissance</th>
              <th scope="col">Document valide ?</th>
              <th scope="col">Options</th>
            </tr>
            </thead>
            <tbody>
            <% @enfants.each do |enfant| %>
              <tr>
                <td><%= enfant.prenom %></td>
                <td><%= enfant.nom %></td>
                <td><%= l enfant.date_naissance %></td>
                <td><%= state_yes_no (not enfant.document_expired_at_term?(@annee, @trimestre)) %></td>
                <td>
                  <%= link_to 'Renouveler pièce', admin_enfant_path(enfant), class: 'btn btn-outline btn-primary btn-xs', target: '_blank' if not @dossier_prestation.get_amount_af_to_regularize(@annee, @trimestre).zero? and enfant.document_expired_at_term?(@annee, @trimestre) and not enfant.has_allocation_for_period(@trimestre, @annee) %>
                  <%= link_to 'Générer allocation familiale', admin_dossier_prestation_individual_regularisation_pay_child_path(@dossier_prestation, enfant.id, @trimestre, @annee), data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-primary btn-xs', 'data-turbolinks': false if not @dossier_prestation.get_amount_af_to_regularize(@annee, @trimestre).zero? and not enfant.document_expired_at_term?(@annee, @trimestre) and not enfant.has_allocation_for_period(@trimestre, @annee) %>
                  <%= link_to 'Voir allocation', admin_dossier_prestation_allocation_familiales_path(@dossier_prestation), class: 'btn btn-outline btn-primary btn-xs', 'data-turbolinks': false, target: '_blank' if enfant.has_allocation_for_period(@trimestre, @annee) %>
                </td>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>