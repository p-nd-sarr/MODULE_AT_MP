<div class="modal inmodal" id="cloture_demande_details" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <i class="fa fa-ban modal-icon btn-outline"></i>
        <h4 class="modal-title">
          Détails demande de clôture
        </h4>
      </div>
      <div class="modal-body">
        <div class="ibox-content">
          <dt>Motif :
            <span> <%= DemandePfCloture.human_enum_name(:motif, object.motif) unless object.motif.nil? %> </span></dt>
          <hr>
          <dt>Commentaire : <span> <%= object.commentaire unless object.commentaire.nil? %> </span></dt>
          <hr>
          <dt>Dcument justificatif :</dt>
          <d1 class="row mb-0">
            <div class="col-lg-6" style="text-align: right; margin-top: 0px;">
              <%= link_to image_tag('missing_logo.png', size: "200x200>", class: "m-t-xs img-responsive"), object.document_justificatif, target: '_blank' if object.document_justificatif.attached? %>
            </div>
          </d1>
          <span></span>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
        <%= link_to 'Clôturer dossier', admin_dossier_prestation_cloturer_path(object.dossier_prestation, object), class: 'btn btn-primary  btn-xs', data: { confirm: 'En êtes vous sûr?' } %>
      </div>
    </div>
  </div>
</div>
