
<div class="table-responsive" style="margin-top: 20px; padding-bottom:100px;">
  <table class="table table-striped">
    <thead class="thead-primary">
        <tr>
          <th scope="col">#</th>
          <th scope="col">N° liquidation</th>
          <th scope="col">Volet</th>
          <th scope="col">Date liquidation</th>
          <th scope="col">Montant liquidé</th>
          <th colspan="3"></th>
        </tr>
    </thead>
    <tbody>
    <% @mes_dossiers_valides.est_valide.each do |dossier_prestation| %>
        <% dossier_prestation.allocation_postnatales.est_liquide.each do |postnatale| %>
        <tr>
            <td></td>
            <td>
            <%if postnatale.num_volet_generer? %>
                <%= postnatale.num_volet_generer %>
            <%end %>
            </td>
            <td><%= AllocationPostnatale.human_enum_name(:volet, postnatale.volet) %></td>
            <td>
                <% unless postnatale.date_soumission.nil? %>
                    <%= l postnatale.date_soumission %>
                <% end %>
            </td>
            <td>
                <% unless postnatale.date_soumission.nil? %>
                    <%= postnatale.montant_paiement %>
                <% end %> 
            </td>
            <td style="width: 75px">
                <%= (link_to 'Valider', admin_dossier_prestation_allocation_postnatale_attente_validation_path(dossier_prestation, postnatale), class: 'btn btn-primary btn-sm') %>
            </td>
            <td style="width: 75px">
                <%= link_to "Détails de l'allocation", [:admin, dossier_prestation, postnatale], class: 'btn btn-success btn-sm btn-outline' %>
            </td>
            <td style="width: 75px">
                <%= link_to 'Détails du dossier', admin_dossier_prestation_path(dossier_prestation), class: 'btn btn-success btn-sm btn-outline' %>
            </td>
        </tr>
        <% end %>
        <% end %>
      </tbody>
    </table>
</div>
