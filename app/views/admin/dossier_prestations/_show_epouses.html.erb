<%= bootstrap_form_for([:admin, @dossier_prestation], layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %><div class="row" style="margin-left: 20%;">

  <div class="col-sm-8">
    <p style="margin-top: 3%;">
        <%= f.alert_message "Please fix the errors below." %>

        <%= f.collection_select :conjoint_id, @dossier_prestation.conjoints, :id, :full_name,
                                include_blank: true, label: 'Conjoint' %>
    </p>
    <div class="hr-line-dashed"></div>

    <% unless @dossier_prestation.conjoint_valid? %>
      <div class="form-group row">
        <div class="col-sm-4 col-sm-offset-2">
          <%= link_to 'Annuler', (@dossier_prestation.persisted? ? [:admin, @dossier_prestation] : admin_dossier_prestations_path), class: 'btn btn-white' %> &nbsp; &nbsp;
          <%= f.button 'Valider', class: 'btn btn-primary' %>
        </div>
      </div>
    <%end %>
  </div>
</div>

<% end %>
