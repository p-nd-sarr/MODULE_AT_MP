<%= content_for :titre_page, 'Détails dossier prestaion allocataires' %>

<%= content_for :actions_page do %>
  <%#= link_to 'Ajouter un allocataire PF', admin_salaries_path, class: 'fa fa-plus btn btn-w-m btn-success btn-outline' %>
<% end %>


<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="row">
            <div class="col-lg-12" style="margin-bottom: 25px">
              <%#= link_to 'Prénatales', admin_dossier_prestation_allocation_prenatales_path(@dossier_prestation),
                          class: 'btn btn-outline btn-primary btn-sm' %>

              <%#= link_to 'Postnatales', admin_dossier_prestation_allocation_postnatales_path(@dossier_prestation),
                          class: 'btn btn-outline btn-primary btn-sm' %>

              <%#= link_to 'Familiales', admin_dossier_prestation_allocation_familiales_path(@dossier_prestation),
                          class: 'btn btn-outline btn-primary btn-sm' %>
            </div>
            <div class="col-lg-12">
              <div>
                <ul class="nav nav-tabs" style="font-size:10px">
                  <!--                <span class="pull-right small text-muted">1406 Elements</span>-->
                  <li class="active"><a data-toggle="tab" href="#tab-1"><i class="fa fa-user"></i>Etat Civil Demandeur
                  </a></li>
                  <li class=""><a data-toggle="tab" href="#tab-2"><i class="fa fa-calendar"></i>Grappe familiale
                  </a></li>
                  <li class=""><a data-toggle="tab" href="#tab-3"><i class="fa fa-briefcase"></i>DPPN
                  </a></li>
                  <li class=""><a data-toggle="tab" href="#tab-4"><i class="fa fa-folder"></i>Documents
                  </a></li>
                  <li class=""><a data-toggle="tab" href="#tab-5"><i class="fa fa-folder"></i>Demande de prestation
                  </a></li>
                  <li class=""><a data-toggle="tab" href="#tab-6"><i class="fa fa-folder"></i>Paiements
                  </a></li>
                </ul>
                <div class="tab-content">
                  <div id="tab-1" class="tab-pane active">
                    <div class="full-height-scroll">
                      <br>
                      <%= render 'show_etat_civil' %>
                    </div>
                  </div>

                  <div id="tab-2" class="tab-pane">
                    <div class="full-height-scroll">
                      <br>
                      <%= render 'allocataire_grappe_familiale' %>
                    </div>
                  </div>
                  <div id="tab-3" class="tab-pane">
                    <div class="full-height-scroll">
                      <br>
                      <%= render 'dppn' %>
                    </div>
                  </div>
                  <div id="tab-4" class="tab-pane">
                    <div class="full-height-scroll">
                      <br>
                      <%= render 'list_document' %>
                    </div>
                  </div>

                  <div id="tab-5" class="tab-pane">
                    <div class="full-height-scroll">
                      <br>
                      <%#= render 'show_prestations' %>
                    </div>
                  </div>

                  <div id="tab-6" class="tab-pane">
                    <div class="full-height-scroll">
                      <br>
                      <%#= render 'paiements_prestation' %>
                    </div>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>