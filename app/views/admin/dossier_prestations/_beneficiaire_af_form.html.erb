<div class="modal inmodal" id="beneficiaire" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" style="width: 90%">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <ul class="nav nav-tabs" style="font-size:10px">
          <li class="active">
            <a data-toggle="tab" href="#modal-left"><i class="fa fa-user"></i>Attributaire tière</a>
          </li>
          <li class="">
            <a data-toggle="tab" href="#modal-right"><i class="fa fa-users"></i>Bénéficiaires</a>
          </li>
        </ul>

        <i class="fa fa-user modal-icon btn-outline"></i>
        <h4 class="modal-title">
          Attributaire tierce / Bénéficiaire
        </h4>
      </div>
      <div class="modal-body">
        <div class=" ibox-content">
          <div class="tab-content">
            <div id="modal-left" class="tab-pane active">
              <div class="full-height-scroll">
                <div class="row">
                  <div class="col-sm-6" style="border-right: #000000 solid 1px;">
                    <h4 class="">
                      Ajouter un attributaire
                    </h4>
                    <br>
                    <%= bootstrap_form_for([:admin, @attributaire_tierce], url: admin_dossier_prestation_create_attributaire_tierce_path(@dossier_prestation), label_col: "col-sm-6", control_col: "col-sm-6") do |f| %>
                      <%= f.alert_message "Veuillez corriger les erreurs ci-dessous." %>
                      <div class="row">
                        <%= f.text_field :prenom, label: 'Prenom', required: true %>
                      </div>
                      <div class="row">
                        <%= f.text_field :nom, label: 'Nom', required: true %>
                      </div>
                      <div class="row">
                        <%= f.text_field :nin, label: 'NIN', required: true %>
                      </div>
                      <div class="row" style="margin-top: 30px">
                        <div class="col-sm-12" style="text-align: center;">
                          <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
                          <%= f.submit 'Valider', class: 'btn btn-primary', id: 'submit_button' %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                </div>
                <hr>
                <hr>
                <div class="row" style="margin-top: 30px">
                  <h4>Historique attributaires tierce</h4>
                  <hr>
                  <div class="panel" style="">
                    <table class="table table-striped table-responsive">
                      <thead class="thead-primary">
                      <tr>
                        <th scope="col">#</th>
                        <th scope="col">Prenom</th>
                        <th scope="col">Nom</th>
                        <th scope="col">NIN</th>
                        <th scope="col">Etat</th>
                        <th scope="col">Soumis le</th>
                        <th scope="col">Validé le</th>
                        <th scope="col">Rejeté le</th>
                        <th scope="col">Retiré le</th>
                        <th colspan="3"></th>
                      </tr>
                      </thead>
                      <tbody>
                      <% @dossier_prestation.attributaire_tierces.order('created_at DESC').each do |at| %>
                        <tr>
                          <td></td>
                          <td><%= at.prenom %></td>
                          <td><%= at.nom %></td>
                          <td><%= at.nin %></td>
                          <td>
                            <%= AttributaireTierce.human_enum_name(:workflow_state, at.workflow_state) %>
                          </td>
                          <td>
                            <%= l at.date_soumission.to_date unless at.date_soumission.nil? %>
                          </td>
                          <td>
                            <%= l at.date_validation.to_date unless at.date_validation.nil? %>
                          </td>
                          <td>
                            <%= l at.date_rejet.to_date unless at.date_rejet.nil? %>
                          </td>
                          <td>
                            <%= l at.date_cloturation.to_date unless at.date_cloturation.nil? %>
                          </td>
                          <td style="width: 75px">
                            <% if at.creation? %>
                              <%= link_to admin_dossier_prestation_destroy_attributaire_tierce_path(@dossier_prestation, at.id), 'data-turbolinks': false, class: "btn btn-white", method: :delete, data: { confirm: 'En êtes vous sûr?' } do %>
                                Supptimer
                              <% end %>
                            <% end %>
                          </td>
                          <td style="width: 75px">
                            <% if at.creation? %>
                              <%= link_to admin_dossier_prestation_soumettre_attributaire_tierce_path(@dossier_prestation, at.id), 'data-turbolinks': false, class: "btn btn-white", data: { confirm: 'En êtes vous sûr?' } do %>
                                Soumettre
                              <% end %>
                            <% end %>
                          </td>
                          <td style="width: 75px">
                            <% if at.rejete? %>
                                <span>
                                  <a data-toggle="modal" data-target="#rejet_attributaire<%= at.id %>" id="" class="btn btn-danger btn-sm"> Voir motif </a>
                                </span>
                              <%= render 'admin/dossier_prestations/rejet_attributaire', object: at %>
                            <% end %>
                          </td>
                        </tr>
                      <% end %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
            <div id="modal-right" class="tab-pane">
              <div class="full-height-scroll">
                <div class="row">
                  <div class="col-sm-6">
                    <h4 class="">
                      Choisir une nouvelle association
                    </h4>
                    <br>
                    <%= bootstrap_form_for([:admin, @beneficiary_association], label_col: "col-sm-6", control_col: "col-sm-6") do |f| %>
                      <%= f.alert_message "Veuillez corriger les erreurs ci-dessous." %>
                      <div class="row">
                        <%= f.select :type_beneficiary,
                                     BeneficiaryAssociationsToDp::TYPE_BENEFICIARY.keys.collect { |type_beneficiary| [BeneficiaryAssociationsToDp.human_enum_name(:type_beneficiary, type_beneficiary), type_beneficiary] },
                                     label: "Type bénéficiaire" %>
                      </div>
                      <div class="row" id="conjoint_exist">
                        <%= f.collection_select :conjoint_id, Conjoint.where(numero_affiliation: @dossier_prestation.num_affiliation), :id, :full_name, include_blank: true, label: 'Conjoint' %>
                      </div>
                      <div class="row" id="attributaire_exist">
                        <%= f.collection_select :attributaire_tierce_id, AttributaireTierce.est_valide.where(dossier_prestation_id: @dossier_prestation.id), :id, :full_name, include_blank: true, label: 'Attributaire tierce' %>
                      </div>
                      <div class="row">
                        <%= f.collection_radio_buttons :enfant_id, @dossier_prestation.enfants.not_deleted.not_incomplete.not_chosen_yet(@dossier_prestation), :id, :full_name, required: true unless @dossier_prestation.enfants.not_chosen_yet(@dossier_prestation).length == 0 %>
                      </div>
                      <%= f.hidden_field :dossier_prestation_id, :value => @dossier_prestation.id %> <br/>
                      <div class="row" style="margin-top: 30px">
                        <div class="col-sm-12" style="text-align: center;">
                          <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
                          <%= f.submit 'Valider', disabled: @dossier_prestation.enfants.not_chosen_yet(@dossier_prestation).count.zero?, class: 'btn btn-primary', id: 'submit_button' %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                  <div class="col-sm-6">
                    <h4>Liste des associations</h4>
                    <hr>
                    <% @beneficiary_associations.each do |association| %>
                      <div class="row">
                        <% if BeneficiaryAssociationsToDp.type_beneficiaries[association.first] == 1 %>
                          <div class="col-sm-12">
                            <table class="table table-striped">
                              <thead class="thead-primary">
                              <tr>
                                <th scope="col">#</th>
                                <th scope="col">Conjoint</th>
                                <th scope="col">Enfant</th>
                              </tr>
                              </thead>
                              <tbody>
                              <% association.last.each do |beneficiary| %>
                                <tr>
                                  <td></td>
                                  <td>
                                    <%= beneficiary.conjoint.full_name %>
                                  </td>
                                  <td>
                                    <%= beneficiary.enfant.full_name %>
                                  </td>
                                  <td style="width: 75px">
                                    <%= link_to admin_beneficiary_associations_to_dp_path(beneficiary), class: "btn btn-white", method: :delete, data: { confirm: 'En êtes vous sûr?' } do %>
                                      <i class="fa fa-trash btn-circle"></i>
                                    <% end %>
                                  </td>
                                </tr>
                              <% end %>
                              </tbody>
                            </table>
                          </div>
                        <% elsif BeneficiaryAssociationsToDp.type_beneficiaries[association.first] == 2 %>
                          <div class="col-sm-12">
                            <table class="table table-striped">
                              <thead class="thead-primary">
                              <tr>
                                <th scope="col">#</th>
                                <th scope="col">Attributaire</th>
                                <th scope="col">Enfant</th>
                                <th scope="col">Options</th>
                              </tr>
                              </thead>
                              <tbody>
                              <% association.last.each do |beneficiary| %>
                                <tr>
                                  <td></td>
                                  <td>
                                    <%= beneficiary.attributaire_tierce.full_name %>
                                  </td>
                                  <td>
                                    <%= beneficiary.enfant.full_name %>
                                  </td>
                                  <td style="width: 75px">
                                    <%= link_to admin_beneficiary_associations_to_dp_path(beneficiary), class: "btn btn-white", method: :delete, data: { confirm: 'En êtes vous sûr?' } do %>
                                      <i class="fa fa-trash btn-circle"></i>
                                    <% end %>
                                  </td>
                                </tr>
                              <% end %>
                              </tbody>
                            </table>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </div>
                <hr>
                <hr>
                <div class="row" style="margin-top: 30px">

                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          add_info_beneficiary()
          $('#beneficiary_associations_to_dp_type_beneficiary').change(function (event) {
              add_info_beneficiary()
          });

          const radioButtons = document.querySelectorAll('input[name="beneficiary_associations_to_dp[enfant_id]"]');
          $('#beneficiary_associations_to_dp_conjoint_id').change(function (event) {
              set_childreen_list(event)
          });

          function set_childreen_list(event) {

              let children = <%= @dossier_prestation.enfants.not_chosen_yet(@dossier_prestation).to_json.html_safe %>;
              children = children.filter(child => {
                  return (child.conjoint_id === parseInt(event.target.value)) || event.target.value == ''
              })
              const children_ids = children.map(x => x.id)

              radioButtons.forEach(radio => {
                  if (children_ids.includes(parseInt(radio.value))) {
                      radio.removeAttribute("hidden")
                  } else {
                      radio.setAttribute("hidden", true)
                  }
              });
          }

          function add_info_beneficiary() {
              const type_beneficiary = $('#beneficiary_associations_to_dp_type_beneficiary').val();
              if (type_beneficiary == 'conjoint') {
                  $("#conjoint_exist").show();
                  $("#attributaire_exist").hide();
                  $("#beneficiary_associations_to_dp_attributaire_tierce_id").val('');
              } else if (type_beneficiary == 'attributaire') {
                  $("#conjoint_exist").hide();
                  $("#attributaire_exist").show();
                  $("#beneficiary_associations_to_dp_conjoint_id").val('');
              }
          }

      })
  </script>
<% end %>
