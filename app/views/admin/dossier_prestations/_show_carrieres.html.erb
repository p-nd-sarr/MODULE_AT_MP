<%#end %>

<script type="text/javascript">
    $(document).ready(function () {
        $("#ajouter_document_tdp").click(function () {
            $('#ajouter_document_tdp').hide();
            $('#new_carriere_dossier_prestation').show();
            return false;
        });
    })
</script>
<!-- modal tdp -->
<div class="modal inmodal" id="tdp" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Close</span>
        </button>
        <h4 class="modal-title">Renseigner le temps de présence</h4>
      </div>


      <%# if @dossier_prestation.creation? %>
      <%= bootstrap_form_for(@carriere_dossier_prestation, url: admin_dossier_prestation_create_document_tdp_path(@dossier_prestation), label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
        <div class="modal-body">
          <div class="row">
            <%= f.alert_message '' %>
            <div class="col-sm-6"></div>
            <div class="col-sm-6">
              <%= f.select :trimestre, CarriereDossierPrestation::TRIMESTRE.keys.collect { |trimestre|
                [CarriereDossierPrestation.human_enum_name(:trimestre, trimestre), trimestre] },
                           label: 'Trimestre' %>
            </div>
            <div class="col-sm-6">
              <%= f.text_field :num_employeur, label: "Numéro Employeur premier mois", value: @dossier_prestation.try(:employeur_actuel) %>
            </div>
            <div class="col-sm-6">
              <%= f.text_field :raison_sociale, value: @ref_employeur.last.try(:raison_sociale), readonly: true %>
            </div>
            <div class="col-sm-6">
              <%= f.number_field :premier_mois, min: 0, id: 'premier_mois' %>
            </div>
            <div class="col-sm-12" style="display: none" id="justifier_mois1">
              <div class="col-sm-6">
                <%= f.check_box :est_justifier, value: "1", checked: true, unchecked: false, label: ' est justifier?', style: "margin-top:30px;" %>
              </div>
              <div class="col-sm-6">
                <%= f.select :motif_mois1, ['Congé payé', 'ATMP', 'Arrêt maladie de moins de 6 mois', 'Congé de maternité', 'Fin de contrat', 'Retraite', 'Licenciement'], prompt: "Choisir motif", label: "Motif d'absence" %>
              </div>
            </div>
            <div class="col-sm-6">
              <%= f.text_field :num_employeur_mois_2, label: "Numéro Employeur deuxième mois", value: @dossier_prestation.try(:employeur_actuel) %>
            </div>
            <div class="col-sm-6">
              <%= f.text_field :raison_sociale_employeur_mois_2, value: @ref_employeur.last.try(:raison_sociale), readonly: true %>
            </div>
            <div class="col-sm-6">
              <%= f.number_field :deuxiem_mois, min: 0, label: 'Deuxième mois', id: 'deuxiem_mois' %>
            </div>
            <div class="col-sm-12" style="display: none" id="justifier_mois2">
              <div class="col-sm-6">
                <%= f.check_box :est_justifier_mois2, value: "1", checked: true, unchecked: false, label: ' est justifier?', style: "margin-top:30px;" %>
              </div>
              <div class="col-sm-6">
                <%= f.select :motif_mois2, ['Congé payé', 'ATMP', 'Arrêt maladie de moins de 6 mois', 'Congé de maternité', 'Fin de contrat', 'Retraite', 'Licenciement'], prompt: "Choisir motif", label: "Motif d'absence" %>
              </div>
            </div>
            <div class="col-sm-6">
              <%= f.text_field :num_employeur_mois_3, label: "Numéro Employeur troisième mois", value: @dossier_prestation.try(:employeur_actuel) %>
            </div>
            <div class="col-sm-6">
              <%= f.text_field :raison_sociale_employeur_mois_3, value: @ref_employeur.last.try(:raison_sociale), readonly: true %>
            </div>
            <div class="col-sm-6">
              <%= f.number_field :troisiem_mois, min: 0, label: 'Troisième mois', id: 'troisiem_mois' %>
            </div>
            <div class="col-sm-12" style="display: none" id="justifier_mois3">
              <div class="col-sm-6">
                <%= f.check_box :est_justifier_mois3, value: "1", checked: true, unchecked: false, label: ' est justifier?', style: "margin-top:30px;" %>
              </div>
              <div class="col-sm-6">
                <%= f.select :motif_mois3, ['Congé payé', 'ATMP', 'Arrêt maladie de moins de 6 mois', 'Congé de maternité', 'Fin de contrat', 'Retraite', 'Licenciement'], prompt: "Choisir motif", label: "Motif d'absence" %>
              </div>
            </div>
            <div class="col-sm-6" style="height:75px;">
              <%#= f.check_box :infos_jour, value: "1", checked: true, label: ' Présence saisie en jours', style: "margin-top:30px;" %>
              <%= f.select :infos_jour, [['Jour', true], ['Heure', false]], label: "Présence saisie en jours ?" %>
            </div>

            <div class="col-sm-6">
              <h4 style="font-weight: bold;">Document *</h4>
              <div class="btn-file">
                <label class="no-text">
                  <%= f.file_field :document, hide_label: true, label: '.',
                                   required: true, id: 'label-ext' %>
                  <div class="btn btn-success" style="margin-top:-20px; margin-left: 1px;">
                    <span class="fa fa-upload"></span> Choisir un fichier
                  </div>
                </label>
                <small id="doc-name"></small>

              </div>

            </div> <!--modal body-->

            <!--            <div class="modal-footer form-group">-->
            <!--              <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>-->
            <%#= f.button 'Enregistrer', class: 'btn btn-primary' %>
            <!--            </div>-->

            <div class="col-sm-6" style="padding-top:9px">
              <h4>Année de présence</h4>
              <%= date_select('annee', 'presence', discard_day: true, discard_month: true, required: true, label: 'Année de présence',
                              start_year: (Date.today - 5.year).year, end_year: Date.today.year) %>
            </div>

            <div class="col-sm-12" style="padding-top:19px">
              <%= f.date_select :date_document, label: "Déposé le ",
                                start_year: (Date.today - 1.year).year, end_year: (Date.today + 1.year).year %>
            </div>
          </div>
        </div> <!--modal body-->
        <div class="modal-footer form-group">
          <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
          <%= f.button 'Enregistrer', class: 'btn btn-primary' %>
        </div>
      <% end %>
      <%#end %>
    </div> <!--modal content -->
  </div> <!--modal dialog-->
</div>  <!--modal-->
<!-- Fin modal tdp -->
<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          $('#est_justifier').hide()
          var input = document.getElementById('label-ext');
          var infoArea = document.getElementById('doc-name');
          input.addEventListener('change', showFileName);
          load_rc1();
          load_rc2();
          load_rc3();

          function showFileName(event) {
              var input = event.srcElement;
              var fileName = input.files[0].name;
              infoArea.textContent = fileName;
          }

          $('#premier_mois, #carriere_dossier_prestation_infos_jour').change(function () {

              if ($('#carriere_dossier_prestation_infos_jour').val() === "true") {
                  if ($('#premier_mois').val() < 18) {
                      $('#justifier_mois1').show()
                  } else {
                      $('#justifier_mois1').hide()
                  }
              } else if ($('#carriere_dossier_prestation_infos_jour').val() === "false") {
                  if ($('#premier_mois').val() < 120) {
                      $('#justifier_mois1').show()
                  } else {
                      $('#justifier_mois1').hide()
                  }
              }
          })

          $('#deuxiem_mois, #carriere_dossier_prestation_infos_jour').change(function () {

              if ($('#carriere_dossier_prestation_infos_jour').val() === "true") {
                  if ($('#deuxiem_mois').val() < 18) {
                      $('#justifier_mois2').show()
                  } else {
                      $('#justifier_mois2').hide()
                  }
              } else if ($('#carriere_dossier_prestation_infos_jour').val() === "false") {
                  if ($('#deuxiem_mois').val() < 120) {
                      $('#justifier_mois2').show()
                  } else {
                      $('#justifier_mois2').hide()
                  }
              }
          })

          $('#troisiem_mois, #carriere_dossier_prestation_infos_jour').change(function () {

              if ($('#carriere_dossier_prestation_infos_jour').val() === "true") {
                  if ($('#troisiem_mois').val() < 18) {
                      $('#justifier_mois3').show()
                  } else {
                      $('#justifier_mois3').hide()
                  }
              } else if ($('#carriere_dossier_prestation_infos_jour').val() === "false") {
                  if ($('#troisiem_mois').val() < 120) {
                      $('#justifier_mois3').show()
                  } else {
                      $('#justifier_mois3').hide()
                  }
              }
          })

          $('#carriere_dossier_prestation_num_employeur').change(function () {
              load_rc1();
          });

          $('#carriere_dossier_prestation_num_employeur_mois_2').change(function () {
              load_rc2();
          });

          $('#carriere_dossier_prestation_num_employeur_mois_3').change(function () {
              load_rc3()
          });

          function load_rc1() {
              const fhnum1 = $('#carriere_dossier_prestation_num_employeur').val();

              $.ajax({
                  url: "/admin/dossier_prestations/employeur/" + fhnum1 + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      if (data) {
                          $("#carriere_dossier_prestation_raison_sociale").val(data.fhrsoc);
                      } else {
                          $("#carriere_dossier_prestation_raison_sociale").val('');
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      $("#carriere_dossier_prestation_raison_sociale").val('');
                  }
              });
          }

          function load_rc2() {
              const fhnum2 = $('#carriere_dossier_prestation_num_employeur_mois_2').val();

              $.ajax({
                  url: "/admin/dossier_prestations/employeur/" + fhnum2 + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      if (data) {
                          $("#carriere_dossier_prestation_raison_sociale_employeur_mois_2").val(data.fhrsoc);
                      } else {
                          $("#carriere_dossier_prestation_raison_sociale_employeur_mois_2").val('');
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      $("#carriere_dossier_prestation_raison_sociale_employeur_mois_2").val('');
                  }
              });
          }

          function load_rc3() {
              const fhnum3 = $('#carriere_dossier_prestation_num_employeur_mois_3').val();

              $.ajax({
                  url: "/admin/dossier_prestations/employeur/" + fhnum3 + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      if (data) {
                          $("#carriere_dossier_prestation_raison_sociale_employeur_mois_3").val(data.fhrsoc);
                      } else {
                          $("#carriere_dossier_prestation_raison_sociale_employeur_mois_3").val('');
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      $("#carriere_dossier_prestation_raison_sociale_employeur_mois_3").val('');
                  }
              });
          }

      });

  </script>
