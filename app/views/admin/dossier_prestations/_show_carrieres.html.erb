<style type="text/css">
  .no-text {
    font-size: 0px;
  }

  .invalid-feedback {
    font-size: 0px;
  }
</style>



<!--Ajout de des d'embauche ,  delai de stage-->


<div class="col-lg-12">
  <div class="col-lg-5">
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-calendar"></span> Date d'embauche :</dt>
      </div>

      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <% unless @dossier_prestation.participant.nil? %>
          <%= l(@dossier_prestation.participant.date_premiere_embauche) unless @dossier_prestation.participant.date_premiere_embauche.nil? %>
        <% end %>
      </div>


    </d1>
  </div>

  <div class="col-lg-5">
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-calendar"></span> Durée de travail :</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <% unless @dossier_prestation.participant.nil? %>
          <%= @dossier_prestation.participant.duree_derniere_carriere %> jours
        <% end %>
      </div>

    </d1>
  </div>

  <div class="col-lg-5">
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-calendar"></span> Délai de stage :</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <%= @dossier_prestation.delai_de_stage unless @dossier_prestation.delai_de_stage.nil? %>
      </div>

    </d1>
  </div>
  <br>

</div>





<!--Fin ajout des dates -->


<div class="ibox" style="margin-top:20px;">
  <div class="ibox-title" style="background-color:rgb(240, 240, 240)">
    <div class="ibox-tools">
      <% unless @dossier_prestation.suspendu? || !@dossier_prestation.has_acceptable_age || not(current_user.gestionnaire_compte_allocataire?) %>
        <button type="button" class="btn btn-xs btn-success" data-toggle="modal" data-target="#tdp">
          <span class="fa fa-plus"></span> Renseigner un temps de présence
        </button>
      <% end %>
    </div>
  </div>
  <div class="ibox-content">
    <% unless @temps_de_presences.count.zero? %>
      <div class="project-list">
        <table class="table table-hover">
          <tbody>
          <% @temps_de_presences.each do |tdp| %>
            <tr>
              <td class="project-status" style="width:200px">
              <span class="label label-primary">
               <strong>
                  <%= CarriereDossierPrestation.human_enum_name(:trimestre, tdp.trimestre) %>
                </strong>
              </span>
              </td>
              <td class="project-title" style="width:350px;">
                <h4>Durée de travail:
                  <% temps = 0 %>
                  <% unless @dossier_prestation.carriere_dossier_prestations.nil? %>
                    <% temps = tdp.premier_mois + tdp.deuxiem_mois + tdp.troisiem_mois %>
                  <% end %>
                  <% if tdp.infos_jour? %>
                    <%= temps %> jours
                  <% else %>
                    <%= temps %> heures
                  <% end %>
                  <br>
                </h4>
                <small><strong>Année:</strong> <%= tdp.annee %></small><br>
                <small><strong>Numéro employeur premier
                  mois:</strong> <%= tdp.num_employeur unless tdp.num_employeur.nil? %></small><br>
                <small><strong>Raison sociale:</strong> <%= tdp.raison_sociale unless tdp.raison_sociale.nil? %></small><br>
                <% unless tdp.motif_mois1.blank? %>
                  <small><strong>Motif premier mois :</strong> <%= tdp.motif_mois1 %></small><br>
                <% end %>
                <small><strong>Numéro employeur deuxième
                  mois:</strong> <%= tdp.num_employeur_mois_2 unless tdp.num_employeur_mois_2.nil? %></small><br>
                <small><strong>Raison
                  sociale:</strong> <%= tdp.raison_sociale_employeur_mois_2 unless tdp.raison_sociale_employeur_mois_2.nil? %>
                </small><br>
                <% unless tdp.motif_mois2.blank? %>
                  <small><strong>Motif deuxième mois :</strong> <%= tdp.motif_mois2 %></small><br>
                <% end %>
                <small><strong>Numéro employeur troisième
                  mois:</strong> <%= tdp.num_employeur_mois_3 unless tdp.num_employeur_mois_3.nil? %></small><br>
                <small><strong>Raison
                  sociale:</strong> <%= tdp.raison_sociale_employeur_mois_3 unless tdp.raison_sociale_employeur_mois_3.nil? %>
                </small><br>
                <% unless tdp.motif_mois3.blank? %>
                  <small><strong>Motif troisième mois :</strong> <%= tdp.motif_mois3 %></small><br>
                <% end %>

                <h5 style="font-style:italic" class="text-success">

                  <% if tdp.document.attached? %>
                    <strong> Déposé le </strong> <%= l(tdp.date_document) unless tdp.date_document.nil? %>
                  <% end %>
                  <% unless tdp.bordereau_collectif.nil? %>
                    <strong> Déposé le
                      le </strong> <%= l(tdp.bordereau_collectif.date_document) unless tdp.bordereau_collectif.date_document.nil? %>
                    <br> <br>
                    <p class="badge">Traitement collectif </p>

                  <% end %>
                </h5>
              </td>
              <td class="project-completion" style="width:350px;">
                <% if tdp.infos_jour? %>
                  <small><strong>Premier mois:</strong> <%= tdp.premier_mois %> jours</small>
                <% else %>
                  <small><strong>Premier mois:</strong> <%= tdp.premier_mois %> heures</small>
                <% end %>
                <div class="progress progress-mini">
                  <div style="width: <%= (tdp.premier_mois + tdp.deuxiem_mois + tdp.troisiem_mois).zero? ? 0 : tdp.premier_mois*100/(tdp.premier_mois + tdp.deuxiem_mois + tdp.troisiem_mois)%>%;" class="progress-bar"></div>
                </div>
                <br>
                <% if tdp.infos_jour? %>
                  <small><strong>Deuxième mois:</strong> <%= tdp.deuxiem_mois %> jours</small>
                <% else %>
                  <small><strong>Deuxième mois:</strong> <%= tdp.deuxiem_mois %> heures</small>
                <% end %>
                <div class="progress progress-mini">
                  <div style="width: <%= (tdp.premier_mois + tdp.deuxiem_mois + tdp.troisiem_mois).zero? ? 0 : tdp.deuxiem_mois*100/(tdp.premier_mois + tdp.deuxiem_mois + tdp.troisiem_mois)%>%;" class="progress-bar"></div>
                </div>
                <br>
                <% if tdp.infos_jour? %>
                  <small><strong>Troisième mois:</strong> <%= tdp.troisiem_mois %> jours</small>
                <% else %>
                  <small><strong>Troisième mois:</strong> <%= tdp.troisiem_mois %> heures</small>
                <% end %>
                <div class="progress progress-mini">
                  <div style="width: <%= (tdp.premier_mois + tdp.deuxiem_mois + tdp.troisiem_mois).zero? ? 0 : tdp.troisiem_mois*100/(tdp.premier_mois + tdp.deuxiem_mois + tdp.troisiem_mois)%>%;" class="progress-bar"></div>
                </div>
              </td>
              <td>
                <div class="m-b-sm thumbnail">
                  <% if tdp.document.attached? %>
                    <a href="<%= url_for(tdp.document) %>" target="_blank">
                      <%= image_tag tdp.document.preview(resize: "100x100>"), class: "m-t-xs img-responsive" %>
                    </a>
                  <% end %>
                  <% unless tdp.bordereau_collectif.nil? %>
                    <% if tdp.bordereau_collectif.document.attached? %>
                      <a href="<%= url_for(tdp.bordereau_collectif.document) %>" target="_blank">
                        <%= image_tag tdp.bordereau_collectif.document.preview(resize: "100x100>"), class: "m-t-xs img-responsive" %>
                      </a>
                    <% end %>
                  <% end %>

                </div>
              </td>
              <% unless tdp.echeance_caisse.nil? %>
                <td>
                  <%= link_to 'Voir dans écheance', admin_echeance_caisse_path(tdp.echeance_caisse), class: 'btn btn-primary btn-xs', target: '_blank' if current_user.gestionnaire_compte_allocataire? or current_user.chef_agence? or current_user.comptable? %>
                </td>
              <% else %>
                <td>
                  <div class="m-b-sm thumbnail">
                    <%= link_to 'supprimer', admin_dossier_prestation_delete_carriere_path(@dossier_prestation, tdp), method: :delete, data: { confirm: 'Êtes-vous sûr de vouloir supprimer ?' }, class: 'btn-danger btn-xs' unless @dossier_prestation.has_paid_allocations_f?(tdp.annee, tdp.trimestre) %>
                  </div>
                </td>
                <td>
                  <div class="m-b-sm thumbnail">
                    <%= link_to 'éditer', admin_dossier_prestation_edit_carriere_path(@dossier_prestation, tdp) unless @dossier_prestation.has_paid_allocations_f?(tdp.annee, tdp.trimestre) %>
                  </div>
                </td>
              <% end %>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <h2> Temps de présence non renseigné !!! </h2>
    <% end %>
  </div>
</div>


