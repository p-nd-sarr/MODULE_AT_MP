<%= content_for :titre_page, 'Dossier De Prestation (Incomplets)' %>

<%= content_for :actions_page do %>
  <%= link_to ' Liste des allocataires PF', admin_allocataire_pf_index_path, class: "btn btn-primary btn-outline btn-sm fa fa-list" if current_user.gestionnaire_compte_allocataire? || current_user.chef_agence? || current_user.comptable? %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row" style="margin-top: -50px;">
    <div class="col-lg-12">
      <div class="ibox">
        <div class="ibox-title">
          <h5>Dossiers de prestation </h5>
          <span class="label label-warning">Total demande <%= DossierPrestation.en_agence(current_user.admin_agence.id).count %></span>
          <div class="ibox-tools">
            <a class="collapse-link">
              <i class="fa fa-chevron-up"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
              <i class="fa fa-wrench"></i>
            </a>
            <ul class="dropdown-menu dropdown-user">
              <li><a href="#" class="dropdown-item">Config option 1</a>
              </li>
              <li><a href="#" class="dropdown-item">Config option 2</a>
              </li>
            </ul>
            <a class="close-link">
              <i class="fa fa-times"></i>
            </a>
          </div>
        </div>
        <div class="ibox-content">
          <% if current_user.gestionnaire_compte_allocataire? %>
            <div class="text-right">
              <%= (link_to ' AJOUTER UNE DEMANDE', new_admin_dossier_prestation_path, class: 'fa fa-plus btn btn-w-m btn-success btn-outline', style: 'height: 34px;') unless current_user.comptable? %>
            </div>
          <% end %>
          <br>
          <div class="tab-content">
            <div id="tous" class="tab-pane fade in active">
              <%= render 'admin/dossier_prestations/search_incomplete' %>
              <br>
              <%= render 'liste_dossiers' %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

