<%= bootstrap_form_for([:admin, @dossier_prestation], label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  <%= f.alert_message "Please fix the errors below." %>
  <div class="row">
    <div class="col-lg-12">
      <div class="col-lg-6">
        <%= f.text_field :num_affiliation, label: 'Numéro affiliation' %>
        <span id="num_aff_error" style="display: none; font-size: 12px; color: red; -webkit-text-stroke-width: medium;">Le numéro d'affiliation doit être numérique</span>
      </div>
      <div class="col-lg-6">
        <%= f.text_field :prenom, label: 'Prénom', readonly: true %>
      </div>
      <div class="col-lg-6">
        <%= f.text_field :nom, label: 'Nom', readonly: true %>
      </div>
      <div class="col-lg-6">
        <%= f.text_field :sexe_salarie, label: 'Sexe salarié', readonly: true %>
      </div>
      <div class="col-lg-6" id="id_date_naissance_salarie">
        <%= f.date_field :date_naissance, label: "Date de naissance", value: '',
                         start_year: (Date.today - 65.year).year, end_year: (Date.today - 18.year).year %>
      </div>
      <div class="col-lg-6">
        <%= f.text_field :lieu_naissance, label: "lieu de naissance" %>
      </div>
      <div class="col-lg-6">
        <%= f.text_field :adresse_domicile, label: "Adresse domicile" %>
      </div>

      <div class="col-lg-6">
        <%= f.text_field :nin, label: 'NIN' %>
      </div>

      <div class="col-sm-6">
        <%= f.select :nationalite,
                     DossierPrestation::NATIONALITE.keys.collect { |nationalite| [DossierPrestation.human_enum_name(:nationalite, nationalite), nationalite] },
                     label: "Nationalité" %>
      </div>

      <div class="col-lg-6">
        <%= f.date_field :date_reception, label: "Date de dépôt du dossier" %>
      </div>

      <div class="col-sm-6">
        <%= f.date_field :date_soumission, :value => Time.now.strftime('%Y-%m-%d'), label: 'Date de création du dossier', readonly: true, required: true %>
      </div>

      <div class="col-lg-6">
        <%= f.date_field :date_embauche, label: "Date d'embauche", value: @dateEmbauche %>
      </div>

      <div class="col-lg-6">
        <%= f.text_field :employeur_actuel, label: 'Employeur actuel' %>
        <div class="bdge">
          <span id="employeur_fhrsoc"></span>
        </div>
      </div>

      <div class="col-lg-6">
        <%= f.text_field :telephone, label: 'Numéro de téléphone' %>
      </div>

    </div>
    <div class=" col-lg-12 form-group">
      <hr>
      <div class="col-lg-3 col-lg-offset-9" style="text-align: right;">
        <%= link_to 'Annuler', (@dossier_prestation.persisted? ? [:admin, @dossier_prestation] : admin_dossier_prestations_path), class: 'btn btn-white' %>
        <%= f.button 'Valider', class: 'btn btn-primary', id: 'submit_button' %>
      </div>
    </div>
  </div>
<% end %>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          load_infos_participant();
          load_salaries()
          var date_naissance_is_available = false;
          var date_embauche_is_available = false;

          $('#dossier_prestation_employeur_actuel').change(function () {
              load_employer();
          });

          function convertDate(inputFormat) {
              function pad(s) {
                  return (s < 10) ? '0' + s : s;
              }

              var d = new Date(inputFormat)
              return [pad(d.getDate()), pad(d.getMonth() + 1), d.getFullYear()].join('/')
          }

          $('#dossier_prestation_num_affiliation').keyup(function () {
              if (isNaN($("#dossier_prestation_num_affiliation").val())) {
                  $('#num_aff_error').show();
                  $('#submit_button').attr("disabled", true)
              } else {
                  $('#num_aff_error').hide();
                  $('#submit_button').attr("disabled", false)
              }
          })

          $('#dossier_prestation_num_affiliation').change(function () {
              load_infos_participant();
              load_salaries()
          });

          function load_infos_participant() {
              var numero_affiliation = $('#dossier_prestation_num_affiliation').val();
              $.ajax({
                  url: "/admin/salaries/" + numero_affiliation + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      if (data) {
                          console.log(data);
                          $("#dossier_prestation_prenom").val(data.prenom);
                          $("#dossier_prestation_nom").val(data.nom);
                          $("#dossier_prestation_nin").val(data.numero_piece);
                          $("#dossier_prestation_employeur_actuel").val(data.id_employeur);
                          load_employer();
                          if (Object.keys(data).length > 0 && data.date_naissance !== null) {
                              $("#dossier_prestation_date_naissance").val(data.date_naissance);
                              date_naissance_is_available = true
                          } else {
                              date_naissance_is_available = false
                          }
                          if (Object.keys(data).length > 0 && data.date_embauche !== null) {
                              $("#dossier_prestation_date_embauche").val(data.date_embauche);
                              date_embauche_is_available = true
                          } else {
                              date_embauche_is_available = false
                          }
                          if (data.genre === 'HOMME' || data.numero_piece.slice(0, 1) == 1) {
                              $("#dossier_prestation_sexe_salarie").val('masculin');
                          } else if (data.genre === 'FEMME' || data.numero_piece.slice(0, 1) == 2) {
                              $("#dossier_prestation_sexe_salarie").val('feminin');
                          } else {
                              $("#dossier_prestation_sexe_salarie").val('');
                          }
                      } else {
                          $("#dossier_prestation_prenom").val('');
                          $("#dossier_prestation_nom").val('');
                          $("#dossier_prestation_nin").val('');
                          $("#dossier_prestation_sexe_salarie").val('');
                          $("#dossier_prestation_employeur_actuel").val('');

                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      $("#dossier_prestation_prenom").val('');
                      $("#dossier_prestation_nom").val('');
                      $("#dossier_prestation_nin").val('');
                      $("#dossier_prestation_sexe_salarie").val('');
                      $("#dossier_prestation_employeur_actuel").val('');

                  }
              });
          }

          function load_conjoints() {
              var numero_affiliation = $('#dossier_prestation_num_affiliation').val();
              $.ajax({
                  url: "/admin/conjoints/valides.json?numero_affiliation=" + numero_affiliation,
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      console.log(data);
                      if (data) {
                          html = '<option value=""></option>';

                          $.each(data, function (key, conjoint) {
                              html += '<option value="' + conjoint.id + '">' + conjoint.full_name + '</option>';
                          });

                          $("#dossier_prestation_conjoint_id").html(html);
                      } else {
                          $("#dossier_prestation_conjoint_id").html('<option value=""></option>');
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      $("#dossier_prestation_conjoint_id").html('<option value=""></option>');
                  }
              });
          }

          function load_salaries() {
              const numero_affiliation = $('#dossier_prestation_num_affiliation').val();
              $.ajax({
                  url: "/admin/conjoints/listsalaries/" + numero_affiliation + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      if (data) {
                          if (date_naissance_is_available === false) {
                              $("#dossier_prestation_date_naissance").val(data.date_naissance);
                          }
                          if (date_embauche_is_available === false) {
                              $("#dossier_prestation_ate_embauche").val(data.ate_embauche);
                          }
                      }
                  }, error: function (XMLHttpRequest, textStatus, errorThrown) {
                      console.log(errorThrown)
                  }
              });
          }

          function load_employer() {
              const fhnum = $('#dossier_prestation_employeur_actuel').val();
              const label_to_show = document.getElementById('employeur_fhrsoc')
              $.ajax({
                  url: "/admin/dossier_prestations/employeur/" + fhnum + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      console.log(data.fhrsoc)
                      if (data && data.fhrsoc !== undefined) {
                          label_to_show.textContent = data.fhrsoc
                          $('#submit_button').attr("disabled", false)
                      } else {
                          label_to_show.textContent = "Raison sociale introuvable"
                          $('#submit_button').attr("disabled", true)
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      label_to_show.textContent = "Raison sociale introuvable"
                      $('#submit_button').attr("disabled", true)
                  }
              });
          }

      })
  </script>
<% end %>
