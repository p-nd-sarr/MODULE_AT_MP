<%= content_for :titre_page, "Détails Dossier De Prestation [#{DossierPrestation.human_enum_name(:etat, @dossier_prestation.etat)}]" %>

<%= content_for :titre_page_autres_details do %>
  <% unless @dossier_prestation.conjoint.nil? %>
    Avec : <%= @dossier_prestation.conjoint.full_name unless @dossier_prestation.conjoint.nil? %> <br>
  <% end %>
  Etat du dossier : <%= "#{DossierPrestation.human_enum_name(:etat, @dossier_prestation.etat)}" %> <br>
  <% unless @dossier_prestation.get_maintien_prestations_active.nil? %>
    pour cause de <%= MaintienPrestation.human_enum_name(:type_maintien, @dossier_prestation.get_maintien_prestations_active.type_maintien) unless @dossier_prestation.get_maintien_prestations_active.type_maintien.nil? %>
    <br>
  <% end %>
  <span style="font-style: italic">Est repris?</span> : <%= state_yes_no @dossier_prestation.est_repris %>
  <% if @dossier_prestation.has_cloture_request? %>
    Demande de clôture soumise le
    <%= @dossier_prestation.get_cloture_request.created_at.strftime('%Y%m%d') unless @dossier_prestation.get_cloture_request.nil? %>
    <br>
  <% end %>
  <% if @dossier_prestation.has_rejected_cloture_request? %>
    Demande de clôture rejetée le <%= @dossier_prestation.get_rejected_cloture_request.created_at.strftime('%Y%m%d') %>
    <span>
      <a data-toggle="modal" data-target="#rejet_demande" id="" class="btn btn-danger btn-sm"> Voir motif </a>
    </span>
    <%= render 'admin/dossier_prestations/rejet_demande_cloture', object: @dossier_prestation.get_rejected_cloture_request %>
    <br>
  <% end %>
  <% unless @dossier_prestation.date_soumission.nil? %>
    <br>
    <strong class="text-info">Date soumission :</strong>
    <%= "#{l @dossier_prestation.date_soumission}" %>
  <% end %>
  <% if @dossier_prestation.creation? and @dossier_prestation.motif_retour? %>
    <br>
    <strong class="text-info">Motif retour dossier :</strong>
    <%= @dossier_prestation.motif_retour %>
  <% end %>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Dossier de l’allocataire', admin_dossier_prestation_path(@dossier_prestation.find_base_folder), class: 'btn btn-white  btn-xs' unless @dossier_prestation.conjoint.nil? %>
  <%= link_to 'Retour Accueil PF', admin_dossier_prestations_path, class: 'btn btn-white btn-sm' %>
  <% if @dossier_prestation.conjoint_id.nil? %>
    <span>
      <a data-toggle="modal" data-target="#beneficiaire" id="" class="btn btn-primary  btn-xs"> Bénéficiaire </a>
    </span>
  <% end %>
  <% if @dossier_prestation.creation? %>
    <br> <br>
    <%= (link_to 'Modifier', edit_admin_dossier_prestation_path(@dossier_prestation), class: 'btn btn-white  btn-xs') if @dossier_prestation.creation? and (current_user == @dossier_prestation.ajoute_par or current_user == @dossier_prestation.affecte_a) %>
    <%= (link_to 'Supprimer', [:admin, @dossier_prestation], method: :delete, data: { confirm: 'En êtes vous sûr?' },
                 class: 'btn btn-danger  btn-xs') if @dossier_prestation.creation? and (current_user == @dossier_prestation.ajoute_par or current_user == @dossier_prestation.affecte_a) %>

    <% if @dossier_prestation.pret_pour_soumission? and (current_user == @dossier_prestation.ajoute_par or current_user == @dossier_prestation.affecte_a) and current_user.gestionnaire_compte_allocataire? %>
      <!--      <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#SoumissionDossierModal" id="soumettre_id">Soumettre-->
      <!--      </button>-->
      <%= link_to 'Soumettre', admin_dossier_prestation_soumettre_path(@dossier_prestation), class: 'btn btn-primary  btn-xs' %>
    <% end %>
    <% if current_user.chef_agence? %>
      <span>
          <a data-toggle="modal" data-target="#affectation_agent" id="" class="btn btn-primary  btn-xs"> Affectation dossier </a>
        </span>
    <% end %>
  <% end %>
  <% unless @dossier_prestation.has_cloture_request? %>
    <% if @dossier_prestation.can_cloture? and @dossier_prestation.conjoint_id.nil? %>
      <br> <br>
      <span>
          <a data-toggle="modal" data-target="#cloture_modal" id="" class="btn btn-primary  btn-xs"> Soumettre une demande de clôture </a>
      </span>
    <% end %>
  <% end %>

  <% if current_user.chef_agence? and @dossier_prestation.soumis? %>
    <% if @dossier_prestation.conjoint_id.nil? %>
      <%= (link_to 'Valider', admin_dossier_prestation_valider_path(@dossier_prestation), class: 'btn btn-primary  btn-xs') %>
    <% else %>
      <%= (link_to 'Valider', admin_dossier_prestation_valider_path(@dossier_prestation), class: 'btn btn-primary  btn-xs') if DossierPrestation.exists?(num_affiliation: @dossier_prestation.num_affiliation, etat: :valide, conjoint_id: nil) %>
    <% end %>
    <%= (link_to 'Rejeter', admin_dossier_prestation_rejeter_path(@dossier_prestation), class: 'btn btn-danger  btn-xs') %>
    <%= (link_to 'Retourner le dossier', admin_dossier_prestation_retour_path(@dossier_prestation), class: 'btn btn-warning  btn-xs') %>
  <% end %>

  <% if current_user.comptable? and not @dossier_prestation.attente_paiement? and (@dossier_prestation.valide? or @dossier_prestation.suspendu?) %>
    <button type="button" class="btn btn-primary  btn-xs" data-toggle="modal" data-target="#PaiementModal" id="soumettre_id">Valider
      Paiement
    </button>
  <% end %>
<% end %>

<% if @dossier_prestation.conjoint.nil? %>
  <div class="wrapper wrapper-content">
    <div class="row">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="row">
            <div class="progressbar-wrapper">
              <ul class="progressbar">
                <li class="<%= ("active") if @dossier_prestation.current_state >= :creation %>">Création</li>
                <li class="<%= ("active") if @dossier_prestation.current_state >= :soumis %>">Soumission</li>
                <% if @dossier_prestation.current_state <= :valide %>
                  <li class="<%= ("active") if @dossier_prestation.current_state >= :valide %>">Validation</li>
                <% end %>
                <% if @dossier_prestation.suspendu? %>
                  <li class="<%= ("active") if @dossier_prestation.current_state >= :suspendu %>">Suspension</li>
                <% end %>
                <% if @dossier_prestation.cloturer? %>
                  <li class="<%= ("active") if @dossier_prestation.current_state >= :suspendu %>">Cloturer</li>
                <% end %>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

