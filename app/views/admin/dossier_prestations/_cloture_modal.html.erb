<div class="modal inmodal" id="cloture_modal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <i class="fa fa-close modal-icon btn-outline"></i>
        <h4 class="modal-title">
          Demande de clôture
        </h4>
      </div>
      <div class="modal-body">
        <div class="ibox-content">
          <%= bootstrap_form_for(@cloture_request, url: admin_dossier_prestation_create_cloture_request_path(@dossier_prestation), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <div class="form-group">
              <%= f.select :motif,
                           DemandePfCloture::MOTIF.keys.collect { |motif| [DemandePfCloture.human_enum_name(:motif, motif), motif] },
                           label: "Motif", required: true %>
            </div>
            <div class="form-group">
              <%= f.text_area :commentaire, label: 'Commentaire', required: true %>
            </div>
            <div class="form-group">
              <%= f.file_field :document_justificatif, required: true %>
            </div>

            <div class="form-group row">
              <div class="modal-footer">
                <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
                <%= f.submit 'Valider', class: 'btn btn-primary btn-xs' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>