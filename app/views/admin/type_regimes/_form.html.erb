<%= bootstrap_form_for(@admin_type_regime, layout: :horizontal) do |f| %>
    <%= f.text_field :code %>
    <%= f.text_field :description %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_type_regimes_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
