<%= content_for :titre_page, "Détails admin_commune" %>

<%= content_for :actions_page do %>
    <%= link_to 'Retour', admin_communes_path, class: 'btn btn-white btn-sm' %>
    <%= link_to 'Modifier', edit_admin_commune_path(@admin_commune), class: 'btn btn-white btn-sm' %>
    <%= link_to 'Ajouter admin_commune', new_admin_commune_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
                            <p>
                  <strong>Admin ville:</strong>
                  <%= @admin_commune.admin_ville %>
                </p>

                            <p>
                  <strong>Code:</strong>
                  <%= @admin_commune.code %>
                </p>

                            <p>
                  <strong>Designation:</strong>
                  <%= @admin_commune.designation %>
                </p>

                      </div>
        </div>
      </div>
    </div>
  </div>
</div>
