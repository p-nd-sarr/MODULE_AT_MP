<%= content_for :titre_page, 'Admin Communes' %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_admin_commune_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Admin ville</th>
        <th scope="col">Code</th>
        <th scope="col">Designation</th>
        <th colspan="3"></th>
      </tr>
      </thead>

      <tbody>
      <% @admin_communes.each do |admin_commune| %>
        <tr>
          <td><%= admin_commune.admin_ville.designation %></td>
          <td><%= admin_commune.code %></td>
          <td><%= admin_commune.designation %></td>
          <td style="width: 75px">
            <%= link_to 'détails', admin_commune, class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'modifier', edit_admin_commune_path(admin_commune), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'supprimer', admin_commune, method: :delete, data: {confirm: 'En êtes vous sûr?'}, class: 'btn btn-outline btn-danger btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>