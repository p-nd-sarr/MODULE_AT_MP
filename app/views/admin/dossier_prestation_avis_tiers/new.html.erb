<%= content_for :titre_page do %>
  Ajout avis à tiers
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-sm-4">
      <div class="ibox">
        <div class="ibox-title">
          <h5>Dossier Prestation <%= link_to @dossier_prestation.num_affiliation, [:admin, @dossier_prestation] %></h5>
        </div>
        <div class="ibox-content">
          <%= render 'admin/dossier_prestation_avis_tiers/info_dossier' %>
        </div>
      </div>
    </div>

    <div class="col-sm-8">
      <div class="ibox">
        <div class="ibox-title">
          <h5>Formulaire d'ajout</h5>
        </div>
        <div class="ibox-content">
          <%= render 'form' %>
        </div>
      </div>
    </div>
  </div>
</div>