<%= content_for :titre_page, 'Liste des dossiers CIP' %>

<%= content_for :actions_page do %>
  <%= link_to 'Nouveau dossier CIP', new_admin_cip_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'admin/cips/search' %>
    <br>
    <%= paginate @cips %>
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th>Prénom</th>
        <th>Nom</th>
        <th>CNI</th>
        <th>Type de demande</th>
        <th>Ajouter par:</th>
        <th colspan="2">Actions</th>
      </tr>
    </thead>

    <tbody>
    <% @cips.each do |cip| %>
    <tr>
      <td><%= cip.prenom%></td>
      <td><%= cip.nom%></td>
      <td><%= cip.nin%></td>
      <td><%= cip.demande_type%></td>
      <td><%= cip.ajoute_par.try(:full_name)%></td>
      <td style="width: 75px">
        <%= link_to 'détails', [:admin, cip], class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_cip_path(cip), class: 'btn btn-outline btn-primary btn-xs' if current_user.admin? %>
      </td>
      <!--<td style="width: 75px">
        <%= link_to 'supprimer', [:admin, cip], method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td> -->
    </tr>
    <% end %>
    </tbody>
    </table>
    <%= paginate @cips %>
  </div>
</div>