<%= content_for :titre_page, "Détails dossier CIP" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_cips_path, class: 'btn btn-white btn-sm' %>
  <%= link_to 'Modifier', edit_admin_cip_path(@cip), class: 'btn btn-white btn-sm' if current_user.admin? %>
  <%= link_to 'Récipissé', admin_cip_show_recipisse_path(@cip, format: :pdf), class: 'btn btn-primary btn-sm', target: '_blank' %>
  <%#= link_to 'Nouveau dossier CIP', new_admin_cip_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
            <div class="row">
              <div class="col-lg-6">
                <d1 class="row mb-0">
                  <div class="col-sm-4 text-sm-right" style="text-align: right;">
                    <dt>Prénom:</dt>
                  </div>
                  <div class="col-sm-4 text-sm-left" style="text-align: left;">
                    <dd class="mb-1"><%= @cip.prenom %></dd>
                  </div>
                </d1>
                <d1 class="row mb-0">
                  <div class="col-sm-4 text-sm-right" style="text-align: right;">
                    <dt>Nom:</dt>
                  </div>
                  <div class="col-sm-4 text-sm-left" style="text-align: left;">
                    <dd class="mb-1"><%= @cip.nom %></dd>
                  </div>
                </d1>

                <d1 class="row mb-0">
                  <div class="col-sm-4 text-sm-right" style="text-align: right;">
                    <dt>CNI:</dt>
                  </div>
                  <div class="col-sm-4 text-sm-left" style="text-align: left;">
                    <dd class="mb-1"><%= @cip.nin %></dd>
                  </div>
                </d1>
              </div>
              <div class="col-lg-6">
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt>Type de demande:</dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @cip.demande_type %></dd>
                </div>
              </d1>
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt>Ajouter par:</dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @cip.ajoute_par.try(:full_name) %></dd>
                </div>
              </d1>

              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt>Date création:</dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @cip.created_at.strftime("%d/%m/%Y") %></dd>
                </div>
              </d1>
              </div>
            </div>

            <div class="row">
              <div class="col-lg-6">
                <d1 class="row mb-0">
                  <div class="col-sm-6 text-sm-right" style="text-align: right;">
                    <dt>Observation:</dt>
                  </div>
                  <div class="col-sm-6 text-sm-left" style="text-align: right;">
                    <dd class="mb-1"><%= @cip.observation %></dd>
                  </div>
                </d1>
              </div>
              <div class="col-lg-6">
                <d1 class="row mb-0">
                  <div class="col-sm-6 text-sm-right" style="text-align: right;">
                    <dt>CNI:</dt>
                  </div>
                  <div class="col-sm-6 text-sm-left" style="text-align: left;">
                    <%= link_to image_tag('missing_logo.png', size: "300x300>", class: "m-t-xs img-responsive"), @cip.piece_identite, target: :_blank if @cip.piece_identite.attached? %>
                    <%#= link_to image_tag(@cip.piece_identite.preview(resize: "300x300>"), class: "m-t-xs img-responsive"), @cip.piece_identite, target: :_blank if @cip.piece_identite.attached? %>
                  </div>
                </d1>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>


