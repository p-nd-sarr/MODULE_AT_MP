<style type="text/css">
  label[title="required"] {
    display: none;
  }

  .invalid-feedback {
    font-size: 0px;
  }
</style>

  <div class="row" style="margin-top: 20px;">
    <div class="col-lg-4">
      <h2>Liste des documents</h2>
    </div>
    <%# unless @admin_reversion_veuve_salary.documents_valide! %>
      <div class="col-lg-8">
        <div class="alert alert-info alert-dismissable">
          <button ariahidden="true" data-dismiss="alert" class="close" type="button">
            <font style="vertical-align: inherit;">
              <font style="vertical-align: inherit;">x</font>
            </font>
          </button>
          <font style="vertical-align: inherit;">
            <font style="vertical-align: inherit;"><span class="fa fa-info-o"></span> Veuillez renseigner des documents
              au format PDF</font>
          </font>
        </div>
      </div>
    <%# end %>
  </div>


<% if @at_dossier_reversion_rente.veuve?%>
 
    <%= render 'documents/liste',
              object: @at_dossier_reversion_rente,
              documents: @at_dossier_reversion_rente.documents,
              include_add: @at_dossier_reversion_rente.creation?,
              include_delete: @at_dossier_reversion_rente.creation?,
              type_documents: AtDossierReversionRente::TYPE_DOCUMENT_VEUVE,
              type_documents_obligatoires: AtDossierReversionRente::TYPE_DOCUMENT_OBLIGATOIRE_VEUVE,
              back_url: admin_at_dossier_reversion_rente_path(@at_dossier_reversion_rente)
    %>

    <%= render 'documents/modal_form',
              type_documents: AtDossierReversionRente::TYPE_DOCUMENT_VEUVE,
              document: Document.new(documentable: @at_dossier_reversion_rente),
              back_url: admin_at_dossier_reversion_rente_path(@at_dossier_reversion_rente)
    %>

<%end%>

<% if @at_dossier_reversion_rente.orphelin?%>
  <% if @at_dossier_reversion_rente.creation? %>
    <%= render 'documents/liste',
              object: @at_dossier_reversion_rente,
              documents: @at_dossier_reversion_rente.documents,
              include_add: @at_dossier_reversion_rente.creation?,
              include_delete: @at_dossier_reversion_rente.creation?,
              type_documents: AtDossierReversionRente::TYPE_DOCUMENT_ORPHELIN,
              type_documents_obligatoires: AtDossierReversionRente::TYPE_DOCUMENT_OBLIGATOIRE_ORPHELIN,
              back_url: admin_at_dossier_reversion_rente_path(@at_dossier_reversion_rente)
    %>

    <%= render 'documents/modal_form',
              type_documents: AtDossierReversionRente::TYPE_DOCUMENT_ORPHELIN,
              document: Document.new(documentable: @at_dossier_reversion_rente),
              back_url: admin_at_dossier_reversion_rente_path(@at_dossier_reversion_rente)
    %>
  <% else %>
    <%= render 'documents/liste',
              object: @at_dossier_reversion_rente,
              documents: @at_dossier_reversion_rente.documents,
              include_add: false, 
              include_delete: false, 
              type_documents: AtDossierReversionRente::TYPE_DOCUMENT_ORPHELIN,
              type_documents_obligatoires: AtDossierReversionRente::TYPE_DOCUMENT_OBLIGATOIRE_ORPHELIN,
              back_url: admin_at_dossier_reversion_rente_path(@at_dossier_reversion_rente)
    %>
  <%end%>
<%end%>