<%= content_for :titre_page, "Détails admin_profession" %>

<%= content_for :actions_page do %>
    <%= link_to 'Retour', admin_professions_path, class: 'btn btn-white btn-sm' %>
    <%= link_to 'Modifier', edit_admin_profession_path(@admin_profession), class: 'btn btn-white btn-sm' %>
    <%= link_to 'Ajouter admin_profession', new_admin_profession_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
                            <p>
                  <strong>Code:</strong>
                  <%= @admin_profession.code %>
                </p>

                            <p>
                  <strong>Description:</strong>
                  <%= @admin_profession.description %>
                </p>

                      </div>
        </div>
      </div>
    </div>
  </div>
</div>
