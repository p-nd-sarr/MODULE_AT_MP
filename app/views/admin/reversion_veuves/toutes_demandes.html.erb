<%= content_for :titre_page, "Reversions veuves" %>

<%= content_for :actions_page do %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'liste' %>
  </div>
</div>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(function () {
          $('#action_export').click(function () {
              $('#formulaire_recherche').attr('action', '<%= toutes_demandes_admin_reversion_veuves_path(format: :xlsx) %>')
          })
          $('#action_search').click(function () {
              $('#formulaire_recherche').attr('action', '<%= toutes_demandes_admin_reversion_veuves_path %>')
          })
          $('#formulaire_recherche').submit(function (e) {
              e.preventDefault(); // dont submit multiple times
              this.submit(); // use native js submit

              setTimeout(function () {
                  $('#action_export').prop("disabled", false);
                  $('#action_search').prop("disabled", false);
              }, 500);
          });
      });
  </script>
<% end %>