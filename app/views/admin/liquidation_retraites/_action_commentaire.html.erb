<!-- Soumettre -->
<div class="modal inmodal" id="action_liquidation0" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Close</span>
        </button>
        <h4 class="modal-title">Valider l'instruction</h4>
      </div>
      <%= bootstrap_form_for(@demande_liquidation, url: admin_liquidation_retraite_soumettre_action_path(@demande_liquidation)) do |f| %>
        <div class="modal-body">
          <%= f.text_area :commentaire_affectation_salaire, label: 'Commentaire' %>
        </div>

        <div class="modal-footer form-group">
          <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
          <%= f.button 'Valider', class: 'btn btn-primary' %>
        </div>
      <% end %>
    </div>
  </div>
</div>



