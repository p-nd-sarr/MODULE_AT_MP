<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col">Nom</th>
    <th scope="col">Prénom</th>
    <th scope="col">Date de naissance</th>
    <th scope="col">Date de mariage</th>
    <th scope="col">NIN</th>
    <th scope="col">Documents</th>
    
  </tr>
  </thead>

  <tbody>
  <% @demande_liquidation.conjoints.valide.each do |epouse| %>
    <tr>
      <td><%= epouse.nom %></td>
      <td><%= epouse.prenom %></td>
      <td><%= l epouse.date_naissance %></td>
      <td><%= l epouse.date_mariage %></td>
      <td><%= epouse.numero_piece %></td>
      <td style="width: 75px">
        <%= link_to 'lien vers les documents', admin_conjoint_path(epouse), :target => '_blank', class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>