<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="ibox-content">

      <%= bootstrap_form_for(@admin_type_dossier_juridique, layout: :horizontal, label_col: "col-sm-3", control_col: "col-sm-9") do |f| %>
        <%= f.text_field :title, label: 'Titre' %>
        <%= f.text_field :description, label: 'Desceiption' %>

        <div class="hr-line-dashed"></div>

        <div class="form-group row">
          <div class="col-sm-4 col-sm-offset-2">
            <%= link_to 'Annuler', admin_type_dossier_juridiques_path, class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
