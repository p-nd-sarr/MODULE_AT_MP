<%= content_for :titre_page, "Détails de l'avis à tiers [#{ DossierMaterniteAvisTier.human_enum_name(:etat, @dossier_maternite_avis_tier.etat)}]" %>

<%= content_for :actions_page do %>

  <%= link_to 'Retour', admin_dossier_maternite_dossier_maternite_avis_tiers_path(@dossier_maternite), 'data-turbolinks': false, class: 'btn btn-white btn-sm' %>
  <% if @dossier_maternite_avis_tier.creation? and current_user.gestionnaire_compte_allocataire? %>
    <%= link_to 'Modifier', edit_admin_dossier_maternite_dossier_maternite_avis_tier_path(@dossier_maternite, @dossier_maternite_avis_tier), 'data-turbolinks': false, class: 'btn btn-white btn-sm' %>
    <%= (link_to "Soumettre avis à tiers au Chef d'Agence", admin_dossier_maternite_dossier_maternite_avis_tier_soumettre_path(@dossier_maternite, @dossier_maternite_avis_tier), 'data-turbolinks': false, 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') %>
  <% end %>

  <% if @dossier_maternite_avis_tier.soumis? and current_user.chef_agence? %>
    <%= (link_to 'Valider', admin_dossier_maternite_dossier_maternite_avis_tier_valider_path(@dossier_maternite, @dossier_maternite_avis_tier), 'data-turbolinks': false, 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') %>
    <button type="button" class="btn btn-warning btn-sm" data-toggle="modal" data-target="#motif">Retourner Avis à
      tiers
    </button>
    <%= render 'modal_retour' %>
  <% end %>

  <% if current_user.comptable? and @dossier_maternite_avis_tier.attente_paiement? and @dossier_maternite.valide? %>
      <button type="button" class="btn btn-warning btn-sm" data-toggle="modal" data-target="#motif">Retourner Avis à
        tiers
      </button>
    <%= render 'modal_retour' %>

    <button type="button" class="btn btn-primary  btn-xs" data-toggle="modal" data-target="#PaiementModal" id="soumettre_id">Valider
      Paiement
    </button>
  <% end %>

<% end %>

<div class="wrapper wrapper-content">
  <div class="row">

    <div class="col-sm-4">
      <div class="col-sm-12">
        <div class="ibox">
          <div class="ibox-title">
            <h5>ICM
              <%= link_to @dossier_maternite.num_dossier, [:admin, @dossier_maternite] %></h5> &nbsp;
          </div>
          <div class="ibox-content">
            <%= render 'admin/dossier_maternite_avis_tiers/info_dossier' %>
          </div>
        </div>
      </div>

      <div class="col-sm-12">
        <div class="ibox">
          <div class="ibox-title">
            <h5>Historique</h5>
          </div>
          <div class="ibox-content">
            <% unless @dossier_maternite_avis_tier.ajoute_par.nil? %>
              <h5><strong class="text-navy">Création Gestionnaire de compte allocataire</strong>
                : <%= (@dossier_maternite_avis_tier.ajoute_par.try(:full_name)) unless @dossier_maternite_avis_tier.ajoute_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date de création</strong>
                : <%= (@dossier_maternite_avis_tier.created_at.strftime("%d/%m/%Y")) unless @dossier_maternite_avis_tier.created_at.nil? %>
              </h5>
              <hr>
            <% end %>
            <% unless @dossier_maternite_avis_tier.soumis_par.nil? %>
              <h5><strong class="text-navy">Soumission Gestionnaire de compte allocataire</strong>
                : <%= (@dossier_maternite_avis_tier.soumis_par.try(:full_name)) unless @dossier_maternite_avis_tier.soumis_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date de soumission</strong>
                : <%= (@dossier_maternite_avis_tier.date_soumission.strftime("%d/%m/%Y")) unless @dossier_maternite_avis_tier.date_soumission.nil? %>
              </h5>
              <hr>
            <% end %>
            <% unless @dossier_maternite_avis_tier.valide_par.nil? %>
              <h5><strong class="text-navy">Validation Chef d'agence</strong>
                : <%= (@dossier_maternite_avis_tier.valide_par.try(:full_name)) unless @dossier_maternite_avis_tier.valide_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date de validation</strong>
                : <%= (@dossier_maternite_avis_tier.date_validation.strftime("%d/%m/%Y")) unless @dossier_maternite_avis_tier.date_validation.nil? %>
              </h5>
              <hr>
            <% end %>
            <% unless @dossier_maternite_avis_tier.traite_par.nil? %>
              <h5><strong class="text-navy">Validation comptable</strong>
                : <%= (@dossier_maternite_avis_tier.traite_par.try(:full_name)) unless @dossier_maternite_avis_tier.traite_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date de validation</strong>
                : <%= (@dossier_maternite_avis_tier.traite_le.strftime("%d/%m/%Y")) unless @dossier_maternite_avis_tier.traite_le.nil? %>
              </h5>
              <hr>
            <% end %>
            <% unless @dossier_maternite_avis_tier.retourne_par.nil? %>
              <h5><strong class="text-navy">Retourné Par</strong>
                : <%= (@dossier_maternite_avis_tier.retourne_par.try(:full_name)) unless @dossier_maternite_avis_tier.retourne_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date retour</strong>
                : <%= (@dossier_maternite_avis_tier.date_retour.strftime("%d/%m/%Y")) unless @dossier_maternite_avis_tier.date_retour.nil? %>
              </h5>
              <h5><strong class="text-navy">Motif retour</strong>
                : <%= (@dossier_maternite_avis_tier.motif_retour) unless @dossier_maternite_avis_tier.motif_retour.nil? %>
              </h5>
            <% end %>
          </div>
        </div>
      </div>

    </div>

    <div class="col-sm-8">
      <div class="col-sm-12">
        <div class="ibox">
          <div class="ibox-title">
            <h5>Informations sur la
              demande <%= @dossier_maternite_avis_tier.motif_retour.nil? ? '' : '(Retourné)' %> </h5>
            <% if (@dossier_maternite_avis_tier.creation? or @dossier_maternite_avis_tier.soumis?) and !@dossier_maternite_avis_tier.retourne_par.nil? %>
              <button type="button" style="margin-left: 5px;" class="btn btn-warning btn-xs" data-toggle="modal" data-target="#motif">Voir
                motif
              </button>
              <%= render 'modal_retour' %>
            <% end %>
          </div>
          <div class="ibox-content">
            <p>
              <strong>Type avis :</strong>
              <%= DossierMaterniteAvisTier.human_enum_name(:type_avis, @dossier_maternite_avis_tier.type_avis) %>
            </p>
            <p>
              <strong>Motif :</strong>
              <%= DossierMaterniteAvisTier.human_enum_name(:type_motif, @dossier_maternite_avis_tier.type_motif) %>
            </p>
            <p>
              <strong>Commentaire avis :</strong>
              <%= @dossier_maternite_avis_tier.motif_avis %>
            </p>
            <% if @dossier_maternite_avis_tier.salaire_reference_errone? %>
              <p>
                <strong>Salaire référence considéré:</strong>
                <% if @dossier_maternite_avis_tier.trop_percu? %>
                  <%= format_cfa @dossier_maternite.avis_tiers_salaire_reference_errone %>
                <% else %>
                  <%= format_cfa @dossier_maternite.salaire_reference %>
                <% end %>
              </p>
              <p>
                <strong>Salaire de référence à considérer :</strong>
                <%= format_cfa @dossier_maternite_avis_tier.sal_ref_a_considere %>
              </p>
              <p>
                <strong>Ecart sur salaire de référence :</strong>
                  <% if @dossier_maternite_avis_tier.trop_percu? %>
                    <%= format_cfa(@dossier_maternite.avis_tiers_salaire_reference_errone - @dossier_maternite_avis_tier.sal_ref_a_considere) %>
                  <% else %>
                    <%= format_cfa(@dossier_maternite_avis_tier.sal_ref_a_considere - @dossier_maternite.salaire_reference) %>
                  <% end %>
              </p>
              <p>
                <strong>Nombre de jours total indemnisés :</strong>
                <%= @dossier_maternite_avis_tier.total_jours_payes %>
              </p>
            <% end %>                    
            <% if @dossier_maternite_avis_tier.nombre_jours_errone? %>
              <p>
                <strong>Nombre de jours total indemnisés :</strong>
                <%= @dossier_maternite_avis_tier.total_jours_indemnises %>
              </p>
              <p>
                <strong>Nombre de jours total à indemniser :</strong>
                <%= @dossier_maternite_avis_tier.nbre_jours_a_indemnise %>
              </p>
              <p>
                <strong>Nombre de jours à régulariser :</strong>
                <% if @dossier_maternite_avis_tier.trop_percu? %>
                  <%= @dossier_maternite_avis_tier.total_jours_indemnises - @dossier_maternite_avis_tier.nbre_jours_a_indemnise %>
                <% else %>
                  <%= @dossier_maternite_avis_tier.nbre_jours_a_indemnise - @dossier_maternite_avis_tier.total_jours_payes %>
                <% end %>
              </p>
              <p>
                <strong>Salaire de référence :</strong>
                <%= format_cfa @dossier_maternite.salaire_reference %>
              </p>
            <% end %>
            <p>
              <% if @dossier_maternite_avis_tier.trop_percu? %>    
                <strong>Montant trop perçu total :</strong>
              <% elsif @dossier_maternite_avis_tier.moins_percu? %>
                <strong>Montant moins perçu total :</strong>
              <% end %>
              <%= format_cfa @dossier_maternite_avis_tier.montant_avis %>
            </p>
            <% if @dossier_maternite_avis_tier.commentaire.present? %>
              <p>
              <strong>Commentaire sur retour :</strong> 
              <%= @dossier_maternite_avis_tier.commentaire %>
              </p>
            <% end %>
            <p>
              <strong>Statut :</strong>
              <% if @dossier_maternite_avis_tier.trop_percu? %>
                <%= @dossier_maternite_avis_tier.paye? ? 'Déduit' : 'Non Déduit' %>
              <% else %>
                <%= @dossier_maternite_avis_tier.paye? ? 'Traité' : 'En cours' %>
              <% end %>
            </p>
          </div>
        </div>
      </div>

      <div class="col-sm-12">
        <div class="ibox">
          <div class="ibox-title">
            <h5>Liste des ordres de paiement avis à tiers </h5>
          </div>
          <div class="ibox-content">
            <table class="table table-bordered table-condensed table-hover">
              <thead>
              <tr>
                <th scope="col">N°</th>
                <th scope="col">N° Ordre de paiement</th>
                <th scope="col">Montant</th>
                <th scope="col">Visualiser Ordre de paiement</th>
                <th colspan="2"></th>
              </tr>
              </thead>

              <tbody>
              <% @dossier_maternite_avis_tier.ligne_icm_avis_tiers_transactions.each_with_index do |li, i| %>
                <tr>
                  <td><%= i + 1 %></td>
                  <td><%= li.ordre_paiement.numero %></td>
                  <td><%= li.montant_paye %></td>
                  <td><%= link_to "<i class='fa fa-file-pdf-o'></i> Paiement".html_safe, admin_paiement_generer_paiement_icm_path(li.ordre_paiement.id, format: :pdf), class: 'btn btn-outline btn-default btn-xs', target: :_blank %>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render 'valider_paiement' %>
