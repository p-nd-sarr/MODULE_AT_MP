<div class="modal inmodal" id="motif" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Close</span>
        </button>
        <h4 class="modal-title">Motif retour</h4>
      </div>
      <%= bootstrap_form_for(@dossier_maternite_avis_tier, url: admin_dossier_maternite_dossier_maternite_avis_tier_retourner_path(@dossier_maternite, @dossier_maternite_avis_tier)) do |f| %>
      <div class="modal-body">
      <%= f.text_area :motif_retour, 
      label: 'Motif de retour', 
      required: true,
      disabled: !@dossier_maternite_avis_tier.retourne_par.nil? && !(current_user.chef_agence? || current_user.comptable?) 
      %>
      </div>

        <div class="modal-footer form-group">
          <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
          <% if (!@dossier_maternite_avis_tier.creation? && @dossier_maternite_avis_tier.retourne_par.nil?) || 
          (@dossier_maternite_avis_tier.soumis? && @dossier_maternite_avis_tier.retourne_par.present? && current_user.chef_agence?) %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>