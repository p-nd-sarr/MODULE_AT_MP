<%= content_for :titre_page, 'Admin Motif Sorties' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_motif_sortie_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
                <th scope="col">Code</th>
                <th scope="col">Description</th>
            <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_motif_sorties.each do |admin_motif_sortie| %>
    <tr>
                <td><%= admin_motif_sortie.code %></td>
                <td><%= admin_motif_sortie.description %></td>
            <td style="width: 75px">
        <%= link_to 'détails', admin_motif_sortie, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_motif_sortie_path(admin_motif_sortie), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_motif_sortie, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>