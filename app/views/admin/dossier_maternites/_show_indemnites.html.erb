<div class="row" style="margin-left: 10%;">
  <div class="col-sm-10">
    <div class="panel">
      <div class="panel-body">
        <div class="table-responsive" style="margin-top: 20px; ">
          <% unless @dossier_maternite.salaire_valid? %>
            <button class="btn btn-success btn-outline" style="float:right;" data-toggle="modal" data-target="#salaire">
              <span class="fa fa-plus"></span> Ajouter Comp. Salaire
            </button>
          <% end %>
          <% if @dossier_maternite.revenu_brut > 5_000_000 %>
            <button class="btn btn-success btn-outline" style="float:right; margin-right: 5px; " data-toggle="modal" data-target="#montant_ir">
              <% if @dossier_maternite.montant_ir.nil? %>
                <span class="fa fa-plus"></span> Ajouter montant IR
              <% else %>
                <span class="fa fa-edit"></span> Modifier montant IR
              <% end %>
            </button>
          <% end %>


          <!-- modal salaire et indemnite-->
          <div class="modal inmodal" id="salaire" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
            <div class="modal-dialog">
              <div class="modal-content animated bounceInRight">
                <div class="modal-header">
                  <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">x</span>
                    <span class="sr-only">Close</span>
                  </button>
                  <h4 class="modal-title">Ajout composant salaire</h4>
                </div>
                <%= bootstrap_form_for(@composant_salaire_icm, url: admin_dossier_maternite_create_composant_path(@dossier_maternite), label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
                  <div class="modal-body">

                    <div class="row">
                      <%= f.alert_message '' %>
                      <div class="col-sm-12">
                        <%= f.collection_select :composant_salaire_id, @composants, :id, :designation, label: 'Composant', required: true %>
                      </div>
                      <div class="col-sm-12">
                        <%= f.number_field :montant, label: "Montant" %>
                      </div>
                    </div>

                  </div> <!--modal body-->

                  <div class="modal-footer form-group">
                    <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
                    <%= f.button 'Ajouter', class: 'btn btn-primary' %>
                  </div>
                <% end %>
              </div> <!--modal content -->
            </div> <!--modal dialog-->
          </div>  <!--modal-->
          <!-- Fin modal salaire et indemnite-->

          <!-- modal montant IR-->
          <div class="modal inmodal" id="montant_ir" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
            <div class="modal-dialog">
              <div class="modal-content animated bounceInRight">
                <div class="modal-header">
                  <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">x</span>
                    <span class="sr-only">Close</span>
                  </button>
                  <% if @dossier_maternite.montant_ir.nil? %>
                    <h4 class="modal-title">Ajout montant IR </h4>
                  <% else %>
                    <h4 class="modal-title">Modification montant IR </h4>
                  <% end %>
                </div>
                <%= bootstrap_form_for([:admin, @dossier_maternite], label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
                  <div class="modal-body">

                    <div class="row">
                      <%= f.alert_message '' %>
                      <div class="col-sm-12">
                        <%= f.number_field :montant_ir, label: "Montant IR" %>
                      </div>
                    </div>

                  </div> <!--modal body-->

                  <div class="modal-footer form-group">
                    <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
                    <% if @dossier_maternite.montant_ir.nil? %>
                      <%= f.button 'Ajouter', class: 'btn btn-primary' %>
                    <% else %>
                      <%= f.button 'Modifier', class: 'btn btn-primary' %>
                    <% end %>
                  </div>
                <% end %>
              </div> <!--modal content -->
            </div> <!--modal dialog-->
          </div>  <!--modal-->
          <!-- Fin modal montant IR -->

          <% unless @dossier_maternite.composant_salaire_icms.empty? %>
            <table class="table table-striped table-bordered">
              <thead class="thead-primary">
              <tr>
                <th scope="col">Composant</th>
                <th scope="col">Montant</th>
                <th scope="col">Prise en compte</th>
                <% unless @dossier_maternite.salaire_valid? %>
                  <th colspan="1"></th>
                <% end %>
              </tr>
              </thead>

              <tbody>
              <% @dossier_maternite.composant_salaire_icms.each do |composant_salaire_icm| %>
                <tr>
                  <td><%= composant_salaire_icm.composant_salaire.designation %></td>
                  <td><%= format_cfa composant_salaire_icm.montant %></td>
                  <td>
                    <% if composant_salaire_icm.composant_salaire.prise_en_compte? %>
                      Oui
                    <% else %>
                      Non
                    <% end %>
                  </td>
                  <% unless @dossier_maternite.salaire_valid? %>
                    <td style="width: 75px">
                      <%= link_to "Supprimer", admin_dossier_maternite_destroy_composant_path(@dossier_maternite, composant_salaire_icm.id), method: :delete, data: {confirm: 'Êtes-vous sûr de vouloir supprimer ?'}, class: 'btn btn-outline btn-danger btn-xs' %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
              </tbody>
            </table>
          <% end %>
        </div>

        <div>
          <!--            <h5>-->
          <!--              <strong>Dernier Salaire Mensuel :</strong> &nbsp;<%#= format_cfa @dossier_maternite.montant_salaire unless @dossier_maternite.montant_salaire.nil? %>-->
          <!--            </h5>-->
          <h4>
            <strong>Revenu Brut :</strong> &nbsp;<%= format_cfa @dossier_maternite.revenu_brut %>
            <br>
            <strong>Montant Trimf :</strong> &nbsp;<%= format_cfa @dossier_maternite.montant_trimf %>
            <br>
            <strong>Part Trimf :</strong>
            <%if @dossier_maternite.un_trimf?%>
              1
            <% elsif @dossier_maternite.deux_trimf?%>
              2
            <% end %>
            <br>
            <strong>Valeur Trimf :</strong> &nbsp;<%= format_cfa @dossier_maternite.valeur_trimf %>
            <br><br>
            <strong>Nbre de Part :</strong> &nbsp;
            <%if @dossier_maternite.un?%>
                1
              <% elsif @dossier_maternite.un_cinq?%>
                1,5
              <% elsif @dossier_maternite.deux?%>
                2
              <% elsif @dossier_maternite.deux_cinq?%>
                2,5
              <% elsif @dossier_maternite.trois?%>
                3
            <% elsif @dossier_maternite.trois_cinq? %>
              3,5
            <% elsif @dossier_maternite.quatre? %>
              4
            <% elsif @dossier_maternite.quatre_cinq? %>
              4,5
            <% elsif @dossier_maternite.cinq? %>
              5
            <% end %>
            <br>

            <% if @dossier_maternite.revenu_brut <= 5_000_000 %>
              <strong>Montant IR :</strong> &nbsp;<%= format_cfa @dossier_maternite.valeur_part %>
            <% else %>
              <strong>Montant IR :</strong> &nbsp;<%= format_cfa @dossier_maternite.montant_ir %>
            <% end %>
            <br><br>
            <span class="text-warning">
              <strong>Salaire de référence :</strong> &nbsp;<%= format_cfa @dossier_maternite.salaire_reference %>
            </span>
            <% if @dossier_maternite.salaire_valid? %>
              <br><br><br>
              <span class="text-danger">
                <strong>Salaire journalier :</strong> &nbsp;<%= format_cfa_not_rounded (@dossier_maternite.salaire_reference.to_f / 30) %>
              </span>
            <% end %>
          </h4>
        </div>
      </div>
    </div>

  </div>
</div>