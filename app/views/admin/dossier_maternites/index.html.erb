<%= content_for :titre_page, 'Dossier Indemnité de Congés Maternité' %>


<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-6">
      <div class="ibox option_menu" style="box-shadow: 2px 2px 4px #1ab394;">
        <div class="ibox-title text-success">
          <h5>Demande de dossiers d'indemnité de congé maternité</h5>
        </div>
        <div class="ibox-content">
          <h1 class="no-margins">0</h1>
          <small>Nombre demande</small>
          <div style="text-align:center; margin-top:20px;">
            <%= link_to 'En attente de validation', en_attente_admin_dossier_maternites_path, class: "btn btn-xs btn-primary", style: "margin-right:10px" %>
            <%= link_to "Que j'ai ajoutées", ajoutee_admin_dossier_maternites_path, class: "btn btn-xs btn-success" %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="ibox option_menu" style="box-shadow: 2px 2px 4px #1ab394;">
        <div class="ibox-title text-success">
          <h5>Demande de liquidation de prestations</h5>
        </div>
        <div class="ibox-content">
          <h1 class="no-margins">0</h1>
          <small>Nombre de demande</small>
          <div style="text-align:center; margin-top:20px;">
            <a href="#" class="btn btn-xs btn-primary" style="margin-right:10px;">En attente de
              validation</a><%#= link_to 'En attente de validation', en_attente_admin_liquidation_retraites_path, class:"btn btn-xs btn-primary" %>
            <a href="#" class="btn btn-xs btn-success">Que j'ai
              ajoutées</a><%#= link_to "Que j'ai ajoutées", ajoutee_admin_liquidation_retraites_path, class:"btn btn-xs btn-success" %>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-12">
      <div class="ibox">
        <div class="ibox-title">
          <h5>Evolution des demandes</h5>
        </div>
        <div class="ibox-content">
          <div class="row">
            <div class="col-lg-9">
              <%= area_chart DossierMaternite.group_by_month(:created_at).count, height: "200px" %>
            </div>
            <div class="col-lg-3">
              <ul class="stat-list">
                <li>
                  <h2 class="no-margins"><%= DossierMaternite.soumis.count %></h2>
                  <small>Soumis</small>
                  <div class="stat-percent">
                    <%= DossierMaternite.count.zero? ? 0 : DossierMaternite.soumis.count * 100 / DossierMaternite.count %>
                    %
                    <i class="fa fa-level-up text-navy"></i>
                  </div>
                  <div class="progress progress-mini">
                    <div style="width: <%=DossierMaternite.count.zero? ? 0 : DossierMaternite.soumis.count * 100 / DossierMaternite.count %>%" class="progress-bar"></div>
                  </div>
                </li>
                <li>
                  <h2 class="no-margins"><%= DossierMaternite.valide.count %></h2>
                  <small>Validé</small>
                  <div class="stat-percent">
                    <%= DossierMaternite.count.zero? ? 0 : DossierMaternite.valide.count * 100 / DossierMaternite.count %>
                    <i class="fa fa-level-up text-navy"></i>
                  </div>
                  <div class="progress progress-mini">
                    <div style="width: <%= DossierMaternite.count.zero? ? 0 : DossierMaternite.valide.count * 100 / DossierMaternite.count %>%" class="progress-bar">
                    </div>
                  </div>
                </li>
                <li>
                  <h2 class="no-margins"><%= DossierMaternite.rejete.count %></h2>
                  <small>Rejeté</small>
                  <div class="stat-percent">
                    <%= DossierMaternite.count.zero? ? 0 : DossierMaternite.rejete.count * 100 / DossierMaternite.count %>
                    <i class="fa fa-level-up text-navy"></i>
                  </div>
                  <div class="progress progress-mini">
                    <div style="width: <%= DossierMaternite.count.zero? ? 0 : DossierMaternite.rejete.count * 100 / DossierMaternite.count %>%" class="progress-bar">
                    </div>
                  </div>
                </li>
              </ul>
            </div>
          </div>
          <div class="m-t-md">
            <small class="float-right" style="float: right;">
              <i class="fa fa-clock-o"></i>
              Update on 16.12.2020
            </small>
            <small>
              <strong>Analysis of sales</strong>
              the value has been change over time and last month reach a level
            </small>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="row">

      </div>
    </div>
  </div>
  <div class="row" style="margin-top: -50px;">
    <div class="col-lg-12">
      <div class="ibox ">
        <div class="ibox-title">
          <h5>Dossiers ICM </h5>
          <span class="label label-warning">Total demande <%= DossierMaternite.count %></span>
          <div class="ibox-tools">
            <a class="collapse-link">
              <i class="fa fa-chevron-up"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
              <i class="fa fa-wrench"></i>
            </a>
            <ul class="dropdown-menu dropdown-user">
              <li><a href="#" class="dropdown-item">Config option 1</a>
              </li>
              <li><a href="#" class="dropdown-item">Config option 2</a>
              </li>
            </ul>
            <a class="close-link">
              <i class="fa fa-times"></i>
            </a>
          </div>
        </div>
        <div class="ibox-content">
          <% if current_user.gestionnaire_compte_allocataire? %>
            <div class="text-right">
              <%= link_to ' AJOUTER UNE DEMANDE', new_admin_dossier_maternite_path, class: 'fa fa-plus btn btn-w-m btn-success btn-outline', style: 'height: 34px; float:right' %>
            </div>
          <% end %>
          <br>
          <div class="tab-content">
            <div id="tous" class="tab-pane fade in active">
              <%= render 'admin/dossier_maternites/search' %>
              <br>
              <%= render 'liste' %>
            </div>
            <div id="valide" class="tab-pane fade">
              <!--      START liste validé     -->
              <% @dossiers_valides = DossierMaternite.valide.page(params[:page]).per(100) %>
              <% if @dossiers_valides.count.zero? %>

                <h2 style="text-align:center; margin-top:50px">
                  <hr>
                  La liste des dossiers validés est vide !!!
                </h2>
              <% else %>
                <%= paginate @dossiers_valides %>
                <div class="table-responsive" style="margin-top: 20px; padding-bottom:100px;">
                  <table class="table table-striped">
                    <thead class="thead-primary">
                    <tr>
                      <th scope="col">N° Dossier</th>
                      <th scope="col">Allocataire</th>
                      <th scope="col">Debut grossesse</th>
                      <th scope="col">Soumis le</th>
                      <th scope="col">Traité le</th>
                      <th colspan="2"></th>
                    </tr>
                    </thead>

                    <tbody>
                    <% @dossiers_valides.each do |dossier_maternite| %>
                      <tr>
                        <td><%= dossier_maternite.num_dossier unless dossier_maternite.num_dossier.nil? %></td>
                        <td><%= dossier_maternite.full_name unless dossier_maternite.full_name.nil? %></td>
                        <td><%= dossier_maternite.debut_grossesse.strftime('%d-%m-%Y') unless dossier_maternite.debut_grossesse.nil? %></td>
                        <td>
                          <% unless dossier_maternite.date_soumission.nil? %>
                            <%= dossier_maternite.date_soumission.strftime('%d-%m-%Y') %>
                          <% end %>
                        </td>
                        <td>
                          <% unless dossier_maternite.traite_le.nil? %>
                            <%= dossier_maternite.traite_le.strftime('%d-%m-%Y') %>
                          <% end %>
                        </td>

                        <td style="width: 75px">
                          <%= link_to 'Détails', admin_dossier_maternite_path(dossier_maternite), class: 'btn btn-outline btn-primary btn-xs' %>
                        </td>

                        <td width="90px" class="dropdown" style="background-color:rgb(240,240,240)">
                          <button class="btn btn-primary btn-xs dropdown-toggle" type="button" data-toggle="dropdown">
                            Options <span class="caret"></span>
                          </button>
                          <ul class="dropdown-menu">
                            <li>
                              <%= link_to 'Historique', admin_dossier_maternite_historique_dossier_path(dossier_maternite), id: "dd_hover" %>
                            </li>
                            <% if dossier_maternite.pret_pour_soumission? %>
                              <li>
                                <a href="<%= url_for(admin_dossier_maternite_recipisse_maternites_path(dossier_maternite, format: :pdf)) %>" target="_blank" id="dd_hover">
                                  Recipissé</a>
                              </li>
                            <% end %>
                          </ul>
                        </td>
                        <%#if dossier_maternite.soumis? %>
                        <!--                          <td style="width: 75px">-->
                        <%#= (link_to 'Valider', admin_dossier_maternite_valider_path(dossier_maternite), class: 'btn btn-outline btn-primary btn-xs', id:"dd_hover" )%>
                        <!--                          </td>-->
                        <!--                          <td style="width: 75px">-->
                        <%#= (link_to 'Rejeter', admin_dossier_maternite_rejeter_path(dossier_maternite), class: 'btn btn-outline btn-danger btn-xs', id:"dd_hover" )%>
                        <!--                          </td>-->
                        <%#end %>
                      </tr>
                    <% end %>
                    </tbody>
                  </table>
                </div>
                <%= paginate @dossiers_valides %>
              <% end %>
              <!-- END -->
            </div>
            <div id="attente_validation" class="tab-pane fade">

              <!-- START Liste en attente de validation-->
              <% @en_attente_validation = DossierMaternite.soumis.page(params[:page]).per(100) %>
              <% if @en_attente_validation.count.zero? %>
