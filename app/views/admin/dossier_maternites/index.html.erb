              <% else %>
                <%= paginate @dossiers_rejetes %>
                <div class="table-responsive" style="margin-top: 20px; padding-bottom:100px;">
                  <table class="table table-striped">
                    <thead class="thead-primary">
                    <tr>
                      <th scope="col">N° Dossier</th>
                      <th scope="col">Allocataire</th>
                      <th scope="col">Debut grossesse</th>
                      <th scope="col">Soumis le</th>
                      <th scope="col">Traité le</th>
                      <th colspan="3"></th>
                    </tr>
                    </thead>

                    <tbody>
                    <% @dossiers_rejetes.each do |dossier_maternite| %>
