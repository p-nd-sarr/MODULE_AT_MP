                      <th scope="col">Debut grossesse</th>
                      <th scope="col">Soumis le</th>
                      <th scope="col">Traité le</th>
                      <th colspan="3"></th>
                    </tr>
                    </thead>

                    <tbody>
                    <% @en_attente_validation.each do |dossier_maternite| %>
