                        <td>
                          <% unless dossier_maternite.date_soumission.nil? %>
                            <%= l dossier_maternite.date_soumission %>
                          <% end %>
                        </td>
                        <td>
                          <% unless dossier_maternite.traite_le.nil? %>
                            <%= l dossier_maternite.traite_le %>
                          <% end %>
                        </td>

                        <td style="width: 75px">
                          <%= link_to 'Détails', admin_dossier_maternite_path(dossier_maternite), class: 'btn btn-outline btn-primary btn-xs', id: "dd_hover" %>
                        </td>

                        <td width="90px" class="dropdown">
                          <button class="btn btn-primary btn-xs dropdown-toggle" type="button" data-toggle="dropdown">
                            Options <span class="caret"></span>
                          </button>
                          <ul class="dropdown-menu" style="background-color:rgb(240,240,240)">
                            <li>
                              <%= link_to 'Historique', admin_dossier_maternite_historique_dossier_path(dossier_maternite), id: "dd_hover" %>
                            </li>
                            <% if dossier_maternite.pret_pour_soumission? %>
                              <li>
                                <a href="<%= url_for(admin_dossier_maternite_recipisse_maternites_path(dossier_maternite, format: :pdf)) %>" target="_blank" id="dd_hover">
                                  Recipissé</a>
                              </li>
                            <% end %>
                          </ul>
                        </td>
                        <% if dossier_maternite.soumis? %>
                          <td style="width: 75px">
                            <%= (link_to 'Valider', admin_dossier_maternite_valider_path(dossier_maternite), class: 'btn btn-outline btn-primary btn-xs', id: "dd_hover") %>
                          </td>
                          <td style="width: 75px">
                            <%= (link_to 'Rejeter', admin_dossier_maternite_rejeter_path(dossier_maternite), class: 'btn btn-outline btn-danger btn-xs', id: "dd_hover") %>
                          </td>
                        <% end %>
                      </tr>
                    <% end %>
                    </tbody>
                  </table>
                </div>
                <%= paginate @en_attente_validation %>
              <% end %>
              <!-- END -->
            </div>
            <div id="rejete" class="tab-pane fade">
              <!-- START Liste rejete -->
              <% @dossiers_rejetes = DossierMaternite.rejete.page(params[:page]).per(100) %>
              <% if @dossiers_rejetes.count.zero? %>
