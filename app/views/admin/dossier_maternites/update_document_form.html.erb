<%= content_for :titre_page, "Modification d'un document" %>


<%= content_for :actions_page do %>
  <%= link_to ' Retour', admin_dossier_maternite_path(@dossier_maternite), class: 'btn btn-white btn-sm fa fa-arrow-left' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
  <% if @dossier_maternite.creation? %>
  <div class="ibox " style="margin-top:20px;">
    <div class="ibox-title">
      <h3>Modifier ou remplacer le document: <strong class="text-navy" style="font-style:italic"><%=DocumentDossierMaternite.find(params[:document_dossier_maternite_id]).type_document%></strong></h3>
    </div>
    <div class="ibox-content">
      <table class="table table-striped table-bordered table-hover">
        <thead style="text-align: center;">
        <tr>
          <th scope="col"  style="width: 300px; text-align: center;">Type</th>
          <th scope="col" style="width: 500px; text-align: center;">Choisir document *</th>
          <th scope="col" style="width: 100px; text-align: center;">Action</th>
        </tr>
        </thead>
        <% DocumentDossierMaternite::TYPE_DOCUMENT.each do |document_name| %>
          <tbody>
          <%= bootstrap_form_for(@document_dossier_maternite, url: admin_dossier_maternite_update_document_path(@dossier_maternite, @document_dossier_maternite ), layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <tr>
              <td style="text-align:center">
                <%= f.hidden_field :type_document, value:document_name.first%>
                <%=DocumentDossierMaternite.human_enum_name(:type_document, document_name.first)%>
              </td>
              <td>
                <div class="col-sm-4" style="height: 40px;">
                  <div class="btn-file">
                    <label>
                      <%= f.file_field :document, hide_label:true, label: '.', class: "document-label"%>
                      <div class="btn btn-success btn-sm" style="margin-top: -50px; margin-left: 1px; font-size: 10px;"><span class="fa fa-upload"></span> Choisir un fichier
                      </div>
                    </label>
                  </div>
                </div>
                <div class="col-sm-8" style="margin-top: 10px; margin-left: 0px;">
                  <small class="document-name"></small>
                </div>
              </td>

              <td style="text-align:center">
                <%= f.button 'Modifier', class: 'btn btn-outline btn-primary btn-sm' %>
              </td>
            </tr>
          <% end %>
          </tbody>
        <% end %>
      </table>
    </div>
  </div>
<% end %>
</div>
</div>
</div>



  <script type="text/javascript">
      var inputDoc=document.getElementsByClassName('document-label');
      var inputName=document.getElementsByClassName('document-name');

      for (let i=0; i<inputDoc.length; i++){
        inputDoc[i].addEventListener('change', function(event){
          showFileName(event, i, inputName);
        });
      }

      function showFileName(event, i, array_label){
        let input=event.srcElement;
        let fileName=input.files[0].name;
        array_label[i].textContent=fileName;
      }

  </script>