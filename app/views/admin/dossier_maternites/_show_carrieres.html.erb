<script type="text/javascript">
    $(document).ready(function () {

        $("#ajouter_document_tdp").click(function () {
            $('#ajouter_document_tdp').hide();
            $('#new_carriere_dossier_maternite').show();
            return false;
        });
    })
</script>
<!-- modal tdp -->
<% unless @dossier_maternite.carriere_valid? %>
<div class="modal inmodal" id="tdp" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Close</span>
        </button>
        <h4 class="modal-title">Renseigner le temps de présence</h4>
      </div>
        <%= bootstrap_form_for(@carriere_dossier_maternite, url: admin_dossier_maternite_create_document_tdp_path(@dossier_maternite), label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
          <div class="modal-body">

            <div class="row">
              <%= f.alert_message '' %>
              <div class="col-lg-12">
                <div class="col-sm-4">
                  <%= f.number_field :annee, min: 2000, max: 2500, label: 'Année' %>
                </div>
                <div class="col-sm-4">
                  <%= f.select :trimestre, CarriereDossierMaternite::TRIMESTRE.keys.collect { |trimestre|
                    [CarriereDossierMaternite.human_enum_name(:trimestre, trimestre), trimestre] }, label: 'Trimestre' %>
                </div>
                <div class="col-sm-4"style="padding-top:3%">
                  <%= f.check_box :presence_en_heure, label: 'Présence en h' %>
                </div>
              </div>
              <div class="col-lg-12">
                <div class="col-sm-4">
                  <%= f.number_field :premier_mois, min: 0, label: 'Deuxième mois' %>
                </div>
                <div class="col-sm-4">
                  <%= f.number_field :deuxiem_mois, min: 0, label: 'Deuxième mois' %>
                </div>
                <div class="col-sm-4">
                  <%= f.number_field :troisiem_mois, min: 0, label: 'Troisième mois' %>
                </div>
              </div>
              <div class="col-sm-4">
                <h4 style="font-weight: bold;">Document *</h4>
                <div class="btn-file">
                  <label class="no-text">
                    <%= f.file_field :document, hide_label: true, label: '.',
                                     required: true, id: 'label-ext' %>
                    <div class="btn btn-success" style="margin-top:-20px; margin-left: 1px;">
                      <span class="fa fa-upload"></span> Choisir un fichier
                    </div>
                  </label>
                  <small id="doc-name"></small>
                </div>
              </div>
              <div class="col-sm-12">
                <%= f.date_select :date_document, label: "Fait le ",
                                  start_year: (Date.today - 1.year).year, end_year: (Date.today + 1.year).year %>

              </div>
            </div>

          </div> <!--modal body-->

          <div class="modal-footer form-group">
            <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
            <%= f.button 'Enregistrer', class: 'btn btn-primary' %>
          </div>
        <% end %>
    </div> <!--modal content -->
  </div> <!--modal dialog-->
</div>  <!--modal-->
<% end %>
<!-- Fin modal tdp -->

<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {

          var input = document.getElementById('label-ext');
          var infoArea = document.getElementById('doc-name');
          input.addEventListener('change', showFileName);

          function showFileName(event) {
              var input = event.srcElement;
              var fileName = input.files[0].name;
              infoArea.textContent = fileName;
          }
      });
  </script>
<% end %>