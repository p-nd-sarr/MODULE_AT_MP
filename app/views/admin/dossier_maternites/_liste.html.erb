<% if @dossier_maternites.count.zero? %>
  <h2 style="text-align:center; margin-top:50px">
    <hr>
    La liste des dossiers ICM est vide !!!
  </h2>
<% else %>

  <%= paginate @dossier_maternites %>
  <div class="table-responsive" style="margin-top: 20px; padding-bottom:100px;">
    <table class="table table-striped">
      <thead class="thead-primary">
      <tr>
        <th scope="col">N° Dossier</th>
        <th scope="col">Allocataire</th>
        <th scope="col">Date debut congés</th>
        <!--        <th scope="col">Début de grossesse (approximative)</th>-->
        <th scope="col">Est repris?</th>
        <th scope="col">Etat</th>
        <th scope="col">Soumis le</th>
        <th scope="col">Traité le</th>
        <th colspan="2"></th>
      </tr>
      </thead>

      <tbody>
      <% @dossier_maternites.each do |dossier_maternite| %>
        <tr>
          <td><%= dossier_maternite.num_dossier %></td>
          <%#full_name = ''
             unless dossier_maternite.prenom.nil?
               full_name = dossier_maternite.prenom
             end
             unless dossier_maternite.nom.nil?
               full_name += ' ' + dossier_maternite.nom
             end
          %>
          <!--          <td><%#= full_name %></td>-->
          <!--          <td><%#= dossier_maternite.prenom + ' ' + dossier_maternite.nom %></td>-->
          <td><%= dossier_maternite.full_name unless dossier_maternite.full_name.nil? %></td>
          <!--          <td><%#= l(dossier_maternite.debut_grossesse) unless dossier_maternite.debut_grossesse.nil? %></td>-->
          <td><%= l(dossier_maternite.debut_conges) unless dossier_maternite.debut_conges.nil? %></td>
          <td>
            <%= state_yes_no dossier_maternite.est_repris %>
          </td>
          <td><%= DossierMaternite.human_enum_name(:etat, dossier_maternite.etat) %></td>
          <td>
            <% unless dossier_maternite.date_soumission.nil? %>
              <%= l dossier_maternite.date_soumission %>
            <% end %>
          </td>
          <td>
            <% unless dossier_maternite.traite_le.nil? %>
              <%= l dossier_maternite.traite_le %>
            <% end %>
          </td>

          <td style="width: 75px">
            <%= link_to 'Détails', admin_dossier_maternite_path(dossier_maternite), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>

          <td width="90px" class="dropdown">
            <button class="btn btn-primary btn-xs dropdown-toggle" type="button" data-toggle="dropdown"> Options
              <span class="caret"></span>
            </button>
            <ul class="dropdown-menu">
              <li>
                <%= link_to 'Historique', admin_dossier_maternite_historique_dossier_path(dossier_maternite) %>
              </li>
              <% unless dossier_maternite.est_repris? %>
                <li>
                  <a href="<%= url_for(admin_dossier_maternite_recipisse_maternites_path(dossier_maternite, format: :pdf)) %>" target="_blank">
                    Recipissé</a>
                </li>
              <% end %>

              <% if dossier_maternite.soumis? %>
                <li>
                  <%= link_to 'Indemnités', admin_dossier_maternite_indemnite_conges_maternites_path(dossier_maternite) %>
                </li>
              <% end %>
            </ul>
          </td>
          <%# if dossier_maternite.soumis? %>
          <!--            <td style="width: 75px">-->
          <%#= (link_to 'valider', admin_dossier_maternite_valider_path(dossier_maternite), class: 'btn btn-outline btn-primary btn-xs') %>
          <!--            </td>-->
          <!--            <td style="width: 75px">-->
          <%#= (link_to 'rejeter', admin_dossier_maternite_rejeter_path(dossier_maternite), class: 'btn btn-outline btn-danger btn-xs') %>
          <!--            </td>-->
          <%# end %>
          <%# unless dossier_maternite.creation? %>
          <!--            <td style="width: 75px">-->
          <%#= link_to 'indemnités', admin_dossier_maternite_indemnite_conges_maternites_path(dossier_maternite), class: 'btn btn-outline btn-success btn-xs' %>
          <!--            </td>-->
          <%# end %>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
  <%= paginate @dossier_maternites %>

<% end %>
