<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Historique du  dossier de marternité Numéro: <%=@dossier_maternite.num_dossier%></h5>
                <div class="ibox-tools">

                    <a class="close-link">
                        <%= link_to 'Retour', admin_dossier_maternites_path, class: 'btn btn-primary btn-sm' %>
                    </a>
                </div>
            </div>
            <div class="ibox-content table-responsive">
                <table class="table table-hover no-margins">
                    <thead>
                    <tr>
                      <th scope="col">Status</th>
                      <th scope="col">Date</th>
                      <th scope="col">Utilisateurs</th>
                      <th scope="col">Progression</th>
                    </tr>
                    </thead>
                  <tbody>
                  <tr>
                    <td><small>Ajouté</small></td>
                    <td><i class="fa fa-clock-o"></i><%= @dossier_maternite.created_at.strftime("%d/%m/%Y") %> </td>
                    <td><%= @dossier_maternite.ajoute_par.full_name unless @dossier_maternite.ajoute_par.nil? %></td>
                    <td class="text-navy"><i class="fa fa-level-up"></i> 25%</td>
                  </tr>
                  <tr>
                    <td><span class="label label-warning">modifié</span></td>
                    <td><i class="fa fa-clock-o"></i>  <%= @dossier_maternite.updated_at.strftime("%d/%m/%Y") %></td>
                    <td><%= @dossier_maternite.ajoute_par.full_name unless @dossier_maternite.ajoute_par.nil? %></td>
                    <td class="text-navy"><i class="fa fa-level-up"></i> -</td>
                  </tr>
                  <% if @dossier_maternite.soumis? %>
                    <tr>
                      <td><small>Soumis</small></td>
                      <td>
                        <i class="fa fa-clock-o"></i> <%= @dossier_maternite.date_soumission.strftime("%d/%m/%Y") unless @dossier_maternite.date_soumission.nil? %>
                      </td>
                      <td><%= @dossier_maternite.ajoute_par.full_name unless @dossier_maternite.ajoute_par.nil? %></td>
                      <td class="text-navy"><i class="fa fa-level-up"></i> 50%</td>
                    </tr>
                  <% end %>
                  <% if @dossier_maternite.valide? %>
                    <tr>
                      <td><small>validé</small></td>
                      <td>
                        <i class="fa fa-clock-o"></i> <%= @dossier_maternite.traite_le.strftime("%d/%m/%Y") unless @dossier_maternite.traite_le.nil? %>
                      </td>
                      <td><%= @dossier_maternite.traite_par.full_name unless @dossier_maternite.traite_par.nil? %></td>
                      <td class="text-navy"><i class="fa fa-level-up"></i> 100%</td>
                    </tr>
                  <% end %>
                  <!-- <tr>
                      <td><small>Pending...</small> </td>
                      <td><i class="fa fa-clock-o"></i> 12:08am</td>
                      <td>Damian</td>
                      <td class="text-navy"> <i class="fa fa-level-up"></i> 23% </td>
                  </tr> -->
                  </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
