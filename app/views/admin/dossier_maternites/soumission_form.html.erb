<%= content_for :titre_page, 'Conditions Soumission Dossier' %>

<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="wrapper wrapper-content">
      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>Soumission du dossier de maternite</h5>
        </div>
        <div class="ibox-content">
          <%= bootstrap_form_for(@dossier_maternite, url: admin_dossier_maternite_soumettre_path(@dossier_maternite),
                                 layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
            <%= f.alert_message "Une erreur est survenue lors de la soumission." %>
            <p>
              En soumettant le dossier, j'accepte les conditions suivantes :
            </p>

            <%= f.check_box :condition_1, label: "Condition 1 : " %>
            <%= f.check_box :condition_2, label: "Condition 2 : Je déclare n'avoir pas adressé d'autre dossier de
              maternite à la CSS." %>
            <%= f.check_box :condition_3, label: "Condition 3 : Je certifie que les renseignements portés sur la présente demande
              sont exacts." %>

            <div class="hr-line-dashed"></div>

            <div class="form-group row">
              <div class="col-sm-4 col-sm-offset-4">
                <%= link_to 'Annuler', [:admin, @dossier_maternite], class: 'btn btn-white' %>
                <%= f.button 'Soumettre', class: 'btn btn-primary' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>