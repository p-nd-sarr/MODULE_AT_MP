<%= content_for :titre_page, "Motif du rejet du dossier de maternite" %>

<div class="form-group row">
  <div class="col-sm-8 col-sm-offset-2">
<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= bootstrap_form_for(@dossier_maternite, url: admin_dossier_maternite_rejeter_create_path(@dossier_maternite), layout: :horizontal) do |f| %>
      <%= f.text_area :motif_rejet, label: 'Motif du rejet' %>

      <div class="hr-line-dashed"></div>

      <div class="form-group row">
        <div class="col-sm-4 col-sm-offset-2">
          <%= link_to 'Annuler', admin_dossier_maternites_path, class: 'btn btn-white' %>
          <%= f.button 'Rejeter', class: 'btn btn-primary' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
</div>
</div>