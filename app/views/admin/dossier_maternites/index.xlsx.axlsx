wb = xlsx_package.workbook

wb.add_worksheet(name: 'liste') do |sheet|
  titre = [
      'Numéro d''affiliation',
      'Numéro dossier',
      'Nom',
      'Prénom',
      'NIN',
      'Etat'
  ]
  sheet.add_row titre, :b => true
  @dossier_maternites.each do |t|
    sheet.add_row [
                      t.num_affiliation,
                      t.num_dossier,
                      t.nom,
                      t.prenom,
                      t.nin,
                      t.etat_human
                  ]
  end
end
