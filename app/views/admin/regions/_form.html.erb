<%= bootstrap_form_for(@admin_region, layout: :horizontal) do |f| %>
  <%= f.collection_select :admin_country_id, Admin::Country.all, :id, :description, label: 'Pays', required: true %>
  <%= f.text_field :designation %>
  <%= f.text_field :code %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_regions_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
