<%= content_for :titre_page, 'Admin Regions' %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_admin_region_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Designation</th>
        <th scope="col">Code</th>
        <th scope="col">Pays</th>
        <th colspan="3"></th>
      </tr>
      </thead>

      <tbody>
      <% @admin_regions.each do |admin_region| %>
        <tr>
          <td><%= admin_region.designation %></td>
          <td><%= admin_region.code %></td>
          <td><%= admin_region.admin_country.description %></td>
          <td style="width: 75px">
            <%= link_to 'détails', admin_region, class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'modifier', edit_admin_region_path(admin_region), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'supprimer', admin_region, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>