<div class="row" style="margin-top:30px">
  <% if @rentier.conjoints.valide.empty? %>
  <div>
    <h2>Liste des conjoints vide !!! </h2>
  </div>
  <% else %>
  <div class="col-lg-12">
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Nom</th>
        <th scope="col">Prénom</th>
        <th scope="col">Date de naissance</th>
        <th scope="col">Date de mariage</th>
 
      </tr>
      </thead>

      <tbody>
      <% @rentier.conjoints.valide.each do |epouse| %>
        <tr>
          <td><%= epouse.nom %></td>
          <td><%= epouse.prenom %></td>
          <td><%= l epouse.date_naissance %></td>
          <td><%= l epouse.date_mariage %></td>
       
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
  <% end %>
</div>

