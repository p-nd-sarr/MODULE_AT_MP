<%= content_for :titre_page, "Motif du Retour Volet" %>

<div class="form-group row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="wrapper wrapper-content">
      <div class="ibox-content">
        <div class="row">
          <%= bootstrap_form_for([@dossier_prestation, @allocation_postnatale], url: admin_dossier_prestation_allocation_postnatale_retour_volet_path(@dossier_prestation, @allocation_postnatale)) do |f| %>
            <div class="col-lg-12">
              <%= f.text_area :motif_retour_volet, label: 'Motif' %>
            </div>

            <div class="form-group col-lg-12">
              <hr>
              <div class="col-sm-8 col-sm-offset-4" style="text-align:right">
                <%= link_to 'Annuler', admin_dossier_prestation_allocation_postnatales_path(@allocation_postnatale), class: 'btn btn-white' %>
                <%= f.button 'Retourner volet', class: 'btn btn-primary' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>