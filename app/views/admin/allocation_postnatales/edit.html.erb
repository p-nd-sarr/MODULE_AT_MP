<style type="text/css">
  
.no-text{
  font-size:0px;
}
.invalid-feedback{
  font-size:0px;
}

</style>
<%= content_for :titre_page, "Modification Allocation Postnatale #{AllocationPostnatale.human_enum_name(:volet, @allocation_postnatale.volet)}" %>

<% @enfant ||= @allocation_postnatale.enfant %>
<%= bootstrap_form_for([:admin, @dossier_prestation, @allocation_postnatale]) do |f| %>

<div class="ibox" style="margin-top:20px;">
  <div class="ibox-content">
    <div class="row">
      <div class="col-lg-8 col-lg-offset-2" >
        <%= f.alert_message '' %>
        <%= f.hidden_field :enfant_id, value: @enfant.id %>
        <%= f.hidden_field :date_accouchement, value: @enfant.date_naissance %>
        <div class="col-lg-12" style="margin-top:30px;">
        <% unless AllocationPostnatale.human_enum_name(:volet, @allocation_postnatale.volet) == "Volet 4" %>
          <div id="date_visite_edit">
              <div class="col-sm-6">
                <%= f.date_field :date_visite_1, label: 'Date de la première visite' %>
              </div>

              <div class="col-sm-6">
                <%= f.date_field :date_visite_2, label: 'Date de la deuxième visite' %>
              </div>

              <div class="col-sm-6">
                <%= f.date_field :date_visite_3, label: 'Date de la troisième visite' %>
              </div>
          </div>
        <% end %>   

          <div class="col-lg-12">
            <h4 style="font-weight: bold;">Document *</h4> 
            <div class="btn-file">
              <label class= "no-text" >
                <%= f.file_field :document, hide_label: true, label: '.',
                            required: true, id:'label-ext'%>
                <div class="btn btn-success" style="margin-top:-20px; margin-left: 1px;"><span class="fa fa-upload"></span> Choisir un fichier
                </div>
              </label>
              <small id="doc-name"></small>
            </div>
            
        </div>
        <div class="col-lg-12">
          <%= f.text_area :commentaire, label: 'Commentaire' %>
        </div>

        <div class="form-group col-lg-12">
          <div class="col-lg-9 col-lg-offset-3" style="text-align:right;">
            <%= link_to 'Annuler', admin_dossier_prestation_allocation_postnatales_path(@dossier_prestation), class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>

<% content_for :javascript do %>
  <script type="text/javascript">
    $(document).ready(function(){

      var input=document.getElementById('label-ext');
      var infoArea=document.getElementById('doc-name');
      input.addEventListener('change', showFileName);
      function showFileName(event){
        var input=event.srcElement;
        var fileName=input.files[0].name;
        infoArea.textContent=fileName;
      }
    });
  </script>
<% end %>
