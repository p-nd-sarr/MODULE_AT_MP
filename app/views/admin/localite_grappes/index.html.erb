<%= content_for :titre_page, 'Admin Localite Grappes' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_localite_grappe_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <div style="text-align: center">
      <%= paginate @admin_localite_grappes%>
    </div>
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
                <th scope="col">Code pays</th>
                <th scope="col">Code localite</th>
                <th scope="col">Localite</th>
            <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_localite_grappes.each do |admin_localite_grappe| %>
    <tr>
                <td><%= admin_localite_grappe.code_pays %></td>
                <td><%= admin_localite_grappe.code_localite %></td>
                <td><%= admin_localite_grappe.localite %></td>
            <td style="width: 75px">
        <%= link_to 'détails', admin_localite_grappe, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_localite_grappe_path(admin_localite_grappe), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_localite_grappe, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
    <div style="text-align: center">
      <%= paginate @admin_localite_grappes%>
    </div>
  </div>
</div>