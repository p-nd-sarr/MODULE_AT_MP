<%= bootstrap_form_for(@admin_localite_grappe, layout: :horizontal) do |f| %>
    <%= f.text_field :code_pays %>
    <%= f.text_field :code_localite %>
    <%= f.text_field :localite %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_localite_grappes_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
