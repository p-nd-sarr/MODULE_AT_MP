<div class="row" style="margin-top: 30px;" >
    <div class="col-lg-9">
        <h3>Liste des 12 derniers salaires</h3>
    </div>
    <div class="col-sm-3" style="text-align: right;">
      <% if !@at_consolidation.valide_nb_salaire_annuel?%>
        <button class="btn btn-outline btn-success" data-toggle="modal" data-target="#salaire">Ajouter salaire </button>
      <% end %>
      <div class="modal inmodal" id="salaire" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
        <div class="modal-dialog">
          <%= bootstrap_form_for(@at_salaire, url: admin_at_consolidation_add_salaire_path(@at_consolidation), method: :post, to: "controller#method", label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
          <%= f.alert_message "Please fix the errors below." %>
          <div class="modal-content animated fadeIn">
            <div class="modal-header">
              <button type="button" class="close" data-dismiss="modal">
                <span aria-hidden="true">x</span>
                <span class="sr-only">Close</span>
              </button>
              <h4 class="modal-title">Ajouter salaire</h4>
            </div>
            <div class="modal-body">
                  <%=f.hidden_field :arret_travail_id, value: @at_consolidation.arret_travail.id%>
                   <%=f.hidden_field :at_consolidation_id, value: @at_consolidation.id%>
                  <%= f.select :mois, AtSalaire::MOIS.keys.collect { |item| [ArretTravail.human_enum_name(:mois, item), item] }, label: 'Salaire du mois' %>
                  <%=f.number_field :montant %>
              </div>
            
            <div class="modal-footer form-group">
               <%= link_to 'Annuler', (@at_consolidation.persisted? ? [:admin, @at_consolidation] : admin_at_consolidations_path), class: 'btn btn-white'%>
               <%= f.button 'Valider', class: 'btn btn-primary' %>
            </div>
          </div>
          <% end %>
        </div>
      </div>     
    </div>
    <% if @at_consolidation.at_salaires.count >= 0%>
    <div class="col-lg-12" style="margin-top: 20px;">
      <table class="table table-bordered table-condensed table-hover" style="margin-bottom: 30px;">
        <thead>
        <tr>
          <!--<th>Salaire N°</th> -->
          <th>Mois</th>
          <th>Montant</th>
          <% if !@at_consolidation.information_salaire_valide?%>
          <th colspan="1">Actions </th>
          <% end %>

        </tr>
        </thead>

        <tbody>
        <% @at_consolidation.at_salaires.each_with_index do |salaire, index| %>
          <tr>
            
            <!--<td><%=index+1%></td>-->
            <td><%=salaire.mois%></td>
            <td><%=salaire.montant%> CFA</td>
            <% if !@at_consolidation.information_salaire_valide?%>
              <td style="width: 75px">
                <%= (link_to 'Modifier',edit_admin_at_consolidation_at_salaire_path(@at_consolidation, id: salaire),class: 'btn btn-outline btn-warning btn-xs') %>
              </td> 
            <% end %>
           <!--
            <td style="width: 75px">
              <%#= (link_to 'Supprimer',admin_at_consolidation_at_salaire_path(@at_consolidation, id: salaire), method: :delete, data: { confirm: 'En êtes vous sûr?' },class: 'btn btn-outline btn-danger btn-xs') %>
            </td> 
           -->
          </tr>
        <% end %>
         <tr style="background: #1ab394; color: white">
           <th>Montant salaire annuel</th>
          <th colspan="3"><%=@at_consolidation.salaire_annuel%></td>
        </tr>
        </tbody>
        
      </table>
    </div>
    <% end %>
</div>