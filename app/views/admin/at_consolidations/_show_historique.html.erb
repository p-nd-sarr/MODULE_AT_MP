<div class="wrapper wrapper-content">
    <div class="row">
        <div class="col-lg-6">
            <h2> Création: </h2>
            <hr class="no-margins"> <br>

            <p><strong>Ouvert Par: </strong> <%= @at_consolidation.ajoute_par.full_name unless @at_consolidation.ajoute_par.nil? %></p>
            <p><strong>Date de création:  </strong> <%= @at_consolidation.created_at.strftime("%d/%m/%Y à %H:%M") %></p>
        </div>

        <div class="col-lg-6">
            <h2> Soumission:  </h2>
                <hr class="no-margins"> <br>
            <p><strong>Soumis par: </strong><%= @at_consolidation.soumis_par.full_name unless @at_consolidation.soumis_par.nil? %></p>
            <p><strong>Date de soumission: </strong> <%= (@at_consolidation.date_soumission_tech.strftime("%d/%m/%Y à %H:%M")) unless @at_consolidation.date_soumission_tech.nil? %> </p>
        </div>
    </div>

    <br><br>

    <div class="row">
        <div class="col-lg-6"> 
            <h2> Validation en agence </h2>
            <hr class="no-margins"> <br>
