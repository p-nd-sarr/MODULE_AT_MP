            <p><strong> Date de validation: </strong> <%= @at_consolidation.date_validation_chef_agence.strftime("%d/%m/%Y à %H:%M") unless @at_consolidation.date_validation_chef_agence.nil?%></p>
        </div>

        <div class="col-lg-6"> 
