            <h5><strong> Date de validation: </strong>  <%= (@at_consolidation.date_validation_chef_service.strftime("%d/%m/%Y à %H:%M")) unless @at_consolidation.date_validation_chef_service.nil? %> </h5>
        </div>
        
    </div>
    
    <br><br>

    <div class="row">
        <div class="col-lg-6"> 
