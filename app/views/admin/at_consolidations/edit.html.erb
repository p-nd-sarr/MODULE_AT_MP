
<%= content_for :titre_page do %>
  Modification d'un dossier de consolidation
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
   <div class="col-sm-4">
      <div class="ibox">
        <div class="ibox-title">
          <h5>Accident du travail <%= link_to @at_consolidation.arret_travail.numero_affiliation, [:admin, @at_consolidation.arret_travail] %></h5>
        </div>
        <div class="ibox-content">
          <%= render 'infos_at' %>
        </div>
      </div>
    </div>

    <div class="col-sm-8">
      <div class="ibox">
        <div class="ibox-title">
          <h5>Formulaire d'édition</h5>
        </div>
        <div class="ibox-content">
          <%= render 'form' %>
        </div>
      </div>
    </div>
  </div>
</div>