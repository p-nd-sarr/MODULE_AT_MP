
  <div class="wrapper wrapper-content">
    <div class="row">
    
          <div class="col-lg-12">
            <div class="col-lg-10" style="text-align: right;">
              <% if @at_consolidation.creation? and (current_user.technicien_at? || current_user.technicien_direction_at?) %>
                  <%= link_to ' Modifier', edit_admin_at_consolidation_path(@at_consolidation), class:"btn btn-outline btn-white fa fa-edit" %>
              <% end %>
            </div>
            <div class="col-lg-6">
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-user"></span> Prénom et Nom: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_consolidation.arret_travail.try(:prenom_salarie) %> <%= @at_consolidation.arret_travail.try(:nom_salarie) %>
                </div>
              </d1>

              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-folder"></span> N° Sinistre: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_consolidation.arret_travail.try(:num_dossier) %>
                </div>
              </d1>

              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-phone"></span> Numéro Téléphone: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_consolidation.arret_travail.try(:telephone) %>
                </div>
              </d1>


       
            </div>

             <div class="col-lg-6">
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-calendar"></span> Taux Ipp médecin traitant: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= !@at_consolidation.taux_ipp_medecin_traitant.nil? ? @at_consolidation.taux_ipp_medecin_traitant : "A determiner"%>
                </div>
              </d1>

               <d1 class="row mb-0">
                 <div class="col-sm-6 text-sm-right" style="text-align: right;">
                   <dt><span class="fa fa-calendar"></span> Date consolidation:</dt>
                 </div>
                 <div class="col-sm-6 text-sm-left" style="text-align: left;">
                   <dd class="mb-1"> <%= !@at_consolidation.date_consolidation_medecin_traitant.nil? ? @at_consolidation.date_consolidation_medecin_traitant.strftime("%d-%m-%Y à %H:%M") : "A determiner" %>
                 </div>
               </d1>

               <d1 class="row mb-0">
                 <div class="col-sm-6 text-sm-right" style="text-align: right;">
                   <dt><span class="fa fa-calendar"></span> Date visite:</dt>
                 </div>
                 <div class="col-sm-6 text-sm-left" style="text-align: left;">
                   <dd class="mb-1"> <%= @at_consolidation.date_visite.strftime("%d-%m-%Y à %H:%M") unless @at_consolidation.date_visite.nil? %>
                 </div>
               </d1>
             </div>
          </div>
    </div>
  </div>








