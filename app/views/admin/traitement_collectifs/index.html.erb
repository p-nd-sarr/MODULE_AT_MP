<%= content_for :titre_page, 'Traitement collectif de dossiers prestations' %>

<%= content_for :actions_page do %>
  <%= link_to 'Liquider tous les bordereaux', admin_liquider_all_bordereau_path, data: { turbolinks: false }, class: 'btn btn-white btn-sm' if current_user.gestionnaire_compte_allocataire? %>
  <%= link_to 'Retour', admin_options_list_path, class: 'btn btn-white btn-sm' if current_user.gestionnaire_compte_allocataire? %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <h3></h3>
    <br>
    <ul style="list-style-type: none; padding: 0">
      <li class="<%= 'active' if params[:q] && params[:q].has_key?(:fhnum_cont) %>">
        <a class="btn btn-primary" data-toggle="tab" href="#collapseExample1">
          Recherche employeurs
        </a>
      </li>

      <!--
      <li class="<%#= 'active' if params[:q] && params[:q].has_key?(:fhnum_cont) %>" style="float: left; margin-right: 3px">
        <a class="btn btn-primary" data-toggle="tab" href="#collapseExample1">
          Recherche employeurs
        </a>
      </li>
-->
      <!--
      <li class="<%#= 'active' unless params[:annee].nil? %>">
        <a class="btn btn-primary" data-toggle="tab" href="#collapseExample2">
          Génération collective ( Etat de contrôle )
        </a>
      </li>
-->
    </ul>
    <br>
    <div class="tab-content">
      <div id="collapseExample1" class="tab-pane <%= 'active' if params[:q] && params[:q].has_key?(:fhnum_cont) %>">
        <div class="card card-header">
          <h3>Critères employeurs</h3>
          </li>
        </div>
        <hr>
        <div class="card card-body">
          <%= search_form_for @req, url: admin_traitement_collectifs_path do |f| %>

            <div class="row">
              <div class="col-sm-3">
                <%= f.label :fhnum_cont, 'Numéro employeur' %>
                <%= f.search_field :fhnum_cont, class: 'form-control' %>
              </div>
              <div class="col-sm-3">
                <%= f.label :ancien_num_ipres_cont, 'Ancien numéro IPRES' %>
                <%= f.search_field :ancien_num_ipres_cont, class: 'form-control' %>
              </div>
              <div class="col-sm-3">
                <%= f.label :ancien_num_css_cont, 'Ancien numéro CSS' %>
                <%= f.search_field :ancien_num_css_cont, class: 'form-control' %>
              </div>
              <div class="col-sm-3">
                <%= f.label :fhrsoc_cont, 'Raison sociale' %>
                <%= f.search_field :fhrsoc_cont, class: 'form-control' %>
              </div>
            </div>

            <div class="hr-line-dashed"></div>
            <%= link_to "Annuler", request.path, class: "btn" %>
            <%= f.submit class: 'btn btn-primary' %>
          <% end %>
        </div>
        <br>
      </div>
      <div id="collapseExample2" class="tab-pane <%= 'active' unless params[:annee].nil? %>">
        <div class="card card-header">
          <h3>Etat de contrôle</h3>
        </div>
        <hr>
        <div class="card card-body">
          <div class="search_section">
            <%= form_tag(admin_traitement_collectifs_path, method: :get) do %>
              <div class="row">
                <div class="col-sm-3">
                  <span class="margin-bottom: 5px">
                    <Strong>
                    Année
                    </Strong>
                  </span> <br>
                  <%= date_select('annee', 'presence', discard_day: true, discard_month: true, class: 'form-control', required: true,
                                  start_year: (Date.today - 1.year).year, end_year: Date.today.year, selected: params[:annee].nil? ? Date.today : Date.civil(params[:annee]["presence(1i)"].to_i, params[:annee]["presence(2i)"].to_i, params[:annee]["presence(3i)"].to_i)) %>
                </div>
                <div class="col-sm-3">
                  <span>
                    <strong>
                    Trimestre
                    </strong>
                  </span> <br>
                  <%= select_tag :trimestre, options_for_select([]), class: 'form-control', required: true %>
                </div>
              </div>
              <div class="hr-line-dashed"></div>
              <%= link_to "Annuler", request.path, class: "btn" %>
              <%= submit_tag 'Générer les états de contrôle', id: 'submit_button', class: 'btn btn-primary', name: nil %>
            <% end %>
          </div>
        </div>
        <br>
      </div>
    </div>
    <br>

    <div class="row">
      <div class="col-sm-4">
        <h5>
          Liste des employeurs
          <span class="label label-warning"> <%= @req.result.length %></span>
        </h5>
      </div>
      <div class="col-sm-8">
        <% if params[:annee] and @cpt %>
          Trimestre =>  <%= @trimestre %> Année => <%= @annee %>
          <%= link_to "Voir l'état de contrôle, collectif", admin_generate_all_bordereau_path(@trimestre, @annee, format: :pdf), class: 'btn btn-outline btn-primary btn-xs' if current_user.gestionnaire_compte_allocataire? %>
        <% end %>
        <% if params[:annee] and !@cpt %>
          <h5>Aucun état de contrôle disponible pour le trimestre <%= @trimestre %> de <%= @annee %></h5>
        <% end %>
      </div>
    </div>
    <br> <br>

    <%= paginate @employeurs %>
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Numéeo employeur</th>
        <th scope="col">Ancien numéro IPRES</th>
        <th scope="col">Ancien numero CSS</th>
        <th scope="col">Raison sociale</th>
        <th scope="col"></th>
      </tr>
      </thead>

      <tbody>
      <% @employeurs.each do |employeur| %>
        <tr>
          <td><%= employeur.fhnum %></td>
          <td><%= employeur.ancien_num_ipres %></td>
          <td><%= employeur.ancien_num_css %></td>
          <td><%= employeur.fhrsoc %></td>

          <td style="width: 75px">
            <%= link_to 'détails', admin_traitement_collectif_path(employeur.fhnum), class: 'btn btn-outline btn-primary btn-xs' if current_user.gestionnaire_compte_allocataire? %>
            <%= link_to 'détails', admin_traitement_collectif_list_bordereau_path(employeur.fhnum), class: 'btn btn-outline btn-primary btn-xs' if current_user.chef_agence? or current_user.comptable? %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <%= paginate @employeurs %>
  </div>
</div>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          $('.message-box').hide()

          var trimestre = document.getElementById('trimestre');
          set_trimestre();
          <% unless params[:trimestre].nil? %>
          if ($('#annee_presence_1i').val() == new Date().getFullYear()) {
              trimestre.selectedIndex = <%= @trimestre %> -1
          } else {
              trimestre.selectedIndex = 4 -
              <%= @trimestre %>
          }

          if ($('#annee_presence_1i').val() == new Date().getFullYear()) {
              let checkout = true

              if (trimestre.selectedIndex === 0 && new Date().getMonth() <= 2) {
                  checkout = false
              }
              if (trimestre.selectedIndex === 1 && new Date().getMonth() <= 5) {
                  checkout = false
              }
              if (trimestre.selectedIndex === 2 && new Date().getMonth() <= 8) {
                  checkout = false
              }
              if (trimestre.selectedIndex === 3 && new Date().getMonth() <= 11) {
                  checkout = false
              }

              if (!checkout) {
                  $('.submit-box').hide()
                  $('.message-box').show()
              }
          }

          <% end %>

          $('#annee_presence_1i').change(function () {
              set_trimestre();
          });

          function set_trimestre() {
              let annee = $('#annee_presence_1i').val();
              var html = '';
              if (annee == new Date().getFullYear()) {
                  i = 1;
                  let nb_month = new Date().getMonth() + 1;
                  while (nb_month > 0) {
                      html += '<option value="' + i + '">Trimestre' + i + '</option>';
                      i++;
                      nb_month -= 3;
                  }
              } else {
                  i = 4;
                  let nb_month = 12 - (new Date().getMonth() + 1);
                  while (nb_month > 0) {
                      html += '<option value="' + i + '">Trimestre' + i + '</option>';
                      i--;
                      nb_month -= 3;
                  }
              }

              $("#trimestre").each(function () {
                  $(this).html(html);
              });
          }
      });

  </script>`
<% end %>
