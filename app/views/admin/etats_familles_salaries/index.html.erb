<%= content_for :titre_page, 'Etats de famille des salariés' %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox">
        <div class="ibox-title">
          <h5> Affichage de la liste des salariés </h5>
          <div class="ibox-tools">
            <a class="collapse-link">
              <i class="fa fa-chevron-up"></i>
            </a>
            <a class="dropdown-toggle" data-toggle="dropdown" href="#">
              <i class="fa fa-wrench"></i>
            </a>
            <ul class="dropdown-menu dropdown-user">
              <li><a href="#" class="dropdown-item">Config option 1</a>
              </li>
              <li><a href="#" class="dropdown-item">Config option 2</a>
              </li>
            </ul>
            <a class="close-link">
              <i class="fa fa-times"></i>
            </a>
          </div>
        </div>
        <div class="ibox-content">
          <div class="row">
            <div class="col-lg-12">
              <%= search_form_for @q, url: admin_etats_familles_salaries_path do |f|%>
                <div class="input-group col-lg-12">
                  <div class="col-lg-10">
                    <%= f.search_field :prenom_or_nom_or_matric_cont, class:"form-control form-control-sm", placeholder: "Entrer le numéro d'affiliation, nom ou prénom d'un salarié ", style: "width:100%; position: relative; z-index: 1"%>
                  </div>
                  <div class="input-group-append col-lg-2" style="padding-left: 0px;">
                    <%= f.submit "Chercher un salarié", :class => "btn btn-outline btn-success", :style=>"height:34px"%>
                  </div>
                </div>
              <%end%>
            </div>

            <div class="col-lg-12">
              <%= paginate @participants %>
              <table class="footable table table-stripped table-hover" data-page-size="8" data-filter="#filter" style="margin-top: 20px;">
                <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Numéro d'affiliation</th>
                  <th scope="col">Prénom</th>
                  <th scope="col">Nom</th>
                  <th colspan="2"></th>
                </tr>
                </thead>

                <tbody>
                <% @participants.each do |participant| %>
                  <tr>
                    <td></td>
                    <td><%= participant.matric %></td>
                    <td><%= participant.prenom %></td>
                    <td><%= participant.nom %></td>
                    <td>
                      <%= link_to 'Voir état de famille',  admin_etats_familles_salary_path(participant.matric), class: 'btn btn-outline btn-primary btn-xs' %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
              <%= paginate @participants %>

            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
