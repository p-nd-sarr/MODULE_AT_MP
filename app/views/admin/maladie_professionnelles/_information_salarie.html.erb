<%= bootstrap_form_for([:admin, @demande_maladie_professionnelle], label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  <%= f.alert_message "Please fix the errors below." %>

<div class="row">
  <div class="col-md-12 col-sm-12 offset-6">
    <h5 style="margin-top: 20px; margin-bottom: 20px;"><span class="label label-info">Complèter le dossier </span> </h5>
  </div>
  <div class="col-sm-12 col-md-12">
      <%=hidden_field_tag :custom_page, 'information_salarie'%>
    <div class="col-sm-4 col-md-4">
      <%= f.text_field :numero_affiliation, label: 'Numéro affiliation', readonly: true %>
    </div>
    <div class="col-sm-4 col-md-4">
      <%= f.text_field :prenom_salarie, label: 'Prénom salarié', readonly: true %>
    </div>
    <div class="col-sm-4 col-md-4">
      <%= f.text_field :nom_salarie, label: 'Nom salarié', readonly: true %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.text_field :adresse_domiciliaire_salarie, label: 'Adresse domiciliaire' %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.text_field :telephone_salarie, label: 'Téléphone' %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.select :situation_matrimoniale_salarie, 
            MaladieProfessionnelle::SITUATION_MATRIMONIALE.keys.collect{|sit_mat| [sit_mat, sit_mat]}, label: 'Situation matrimoniale' %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.select :nationalite_salarie, 
          ArretTravail::NATIONALITE_SALARIE.keys.collect{|nat| [nat, nat]}, label: 'Nationalité'%>
    </div>
     <div class="col-sm-6 col-md-6">
      <%= f.date_select :date_de_naissance_salarie, label: "Date de naissance",
                            start_year: (Date.today - 65.year).year, end_year: (Date.today - 18.year).year %>
    </div>
  </div>
  <div class="col-sm-12 col-md-12">
    <hr>
    <div class="col-sm-6 col-md-6">
      <%= f.select :qualification_professionnelle_salarie, 
          MaladieProfessionnelle::QUALIFICATION_PROFESSIONNELLE.keys.collect{|item| [item, item]}, label: 'Qualification professionnelle' %>
    </div>
    <div class="col-sm-6 col-md-6">      
      <%= f.text_field :nin_salarie, label: 'NINEA' %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.text_field :carnet_accident_travail, label:"Carnet d'accident de travail" %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.date_select :date_embauche_salarie , label: "Date d'embauche",
                               start_year: (Date.today - 65.year).year, end_year: (Date.today - 18.year).year %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.number_field :anciennete_salarie %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.select :type_de_contrat_travail_salarie, 
          MaladieProfessionnelle::TYPE_DE_CONTRAT_TRAVAIL.keys.collect{|tc| [tc, tc]}, label: 'Type de contrat' %>
    </div>
  </div>
  <div class="form-group col-sm-12 col-md-12">
    <hr>
    <div class="col-sm-3 col-sm-offset-9" style="text-align: right;">
      <%= link_to 'Annuler', (@demande_maladie_professionnelle.persisted? ? [:admin, @demande_maladie_professionnelle] : admin_maladie_professionnelles_path), class: 'btn btn-white' %>
      <%= f.button 'Mettre à jour', class: 'btn btn-primary' %>
    </div>
  </div>

</div>
<% end %>