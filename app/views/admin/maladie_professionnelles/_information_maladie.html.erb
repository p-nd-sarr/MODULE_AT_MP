<%= bootstrap_form_for([:admin, @demande_maladie_professionnelle], label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  <%= f.alert_message "Please fix the errors below." %>

<div class="row">
  <div class="col-md-12 col-sm-12 offset-6">
     <h5 style="margin-top: 20px; margin-bottom: 20px;"><span class="label label-info"> Complèter le dossier</span> </h5>
  </div>
  <div class="col-sm-12 col-md-12">
    <%=hidden_field_tag :custom_page, 'information_maladie'%>
    <div class="col-sm-6 col-md-6">     
      <%= f.text_field :nature_du_travail_au_moment_accident, label:"Nature du travail au moment de l'accident" %>
    </div>
    <div class="col-sm-12 col-md-12">
      <hr>
      <div class="col-sm-4 col-md-4 box2">
        <%= f.check_box :infirmite_anterieure_accident, label:"Infirmité antérieure accident", id:"infAcc" %>
      </div>
      <div class="col-sm-4 col-md-4">
        <div  id="num_rente">
          <%= f.text_field :numero_rente_infirmite_anterieure_accident %>
        </div>
      </div>
      <div class="col-sm-4 col-md-4">
        <div  id="taux_rente">
         <%= f.number_field :taux_infirmite_anterieure_accident %>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-md-6">          
      <%= f.text_field :duree_exposition %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.text_field :type_de_travaux %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.number_field :horaire_travail %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.text_area :histoire_professionnelle %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.text_field :nature_de_la_maladie %>
    </div>
    <div class="col-sm-6 col-md-6">
      <%= f.text_area :produits_utilises %>
    </div>        
  </div>
  <div class="col-sm-12 col-md-12">
    <hr>
    <div class="col-sm-6 col-md-6">
      <%= f.text_area :condition_travail, label:'Condition de travail' %>
    </div>
    <div class="col-md-6 col-sm-6">
      <%= f.text_area :autre, label:"Autre" %>
    </div>
    <div class="col-md-6 col-sm-6">
      <%= f.date_select :date_premier_constatation_maladie , label: "Date déclaration",
                            start_year: (Date.today - 65.year).year, end_year: (Date.today - 18.year).year%>
    </div>
    <div class="col-md-6 col-sm-6">
      <%= f.text_area :circonstance_apparition_maladie, label:"Circonstance apparition maladie" %>
    </div>
    <div class="col-md-6 col-sm-6">
      <%= f.text_field :numero_tableau_mp_correspondante, label:"Numéro tableau MP correspondante" %>
    </div>
    <div class="col-md-6 col-sm-6 box1" style="padding-bottom: 13px;">
      <%= f.check_box :salaire_verse_en_totalite_en_mp, label:"Salaire versé en totalité en MP" %>
    </div>
    <div class="col-md-6 col-sm-6">
      <%= f.datetime_select :date_declaration , label: "Date déclaration",
                            start_year: (Date.today - 65.year).year, end_year: (Date.today - 18.year).year%>
    </div>
    <div class="col-md-6 col-sm-6">
      <%= f.text_field :nom_declarant, label:"Nom déclarant" %>
    </div>
    <div class="col-md-6 col-sm-6">
      <%= f.text_field :prenom_declarant, label:"Prénom déclarant" %>
    </div>
    <div class="col-md-6 col-sm-6">
      <%= f.text_field :lieu_declaration, label:"Lieu déclarant" %>
    </div>
  </div>
  <div class="form-group col-sm-12 col-md-12">
    <hr>
    <div class="col-sm-3 col-sm-offset-9" style="text-align: right;">
      <%= link_to 'Annuler', (@demande_maladie_professionnelle.persisted? ? [:admin, @demande_maladie_professionnelle] : admin__maladie_professionnelles_path), class: 'btn btn-white' %>
      <%= f.button 'Mettre à jour', class: 'btn btn-primary' %>
    </div>
  </div>
</div>

<% end %>