<%= content_for :titre_page, 'Déclaration de divorce ou de décés conjoints' %>

<%= content_for :actions_page do %>
  <%= link_to ' Ajouter une déclaration ', new_admin_declaration_divorce_ou_deces_conjoint_path, class: 'btn btn-primary fa fa-plus' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'admin/declaration_divorce_ou_deces_conjoints/search' %>
    <br>
    <hr>
    <%= paginate @declaration_divorce_ou_deces_conjoints %>
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Numéro d'affiliation</th>
        <th scope="col">Prénom conjoint</th>
        <th scope="col">Nom conjoint</th>
        <th scope="col">Date de naissance</th>
        <th scope="col">Date du mariage</th>
        <th scope="col">Date de déclaration</th>
        <th scope="col">Situation avec le conjoint</th>
        <th colspan="3"></th>
      </tr>
      </thead>

      <tbody>
      <% @declaration_divorce_ou_deces_conjoints.each do |declaration_divorce_ou_deces_conjoint| %>
        <tr>
          <td><%= declaration_divorce_ou_deces_conjoint.try(:numero_affiliation) %></td>
          <td><%= declaration_divorce_ou_deces_conjoint.conjoint.try(:prenom) %></td>
          <td><%= declaration_divorce_ou_deces_conjoint.conjoint.try(:nom) %></td>
          <td><%= l(declaration_divorce_ou_deces_conjoint.conjoint.date_naissance) unless declaration_divorce_ou_deces_conjoint.conjoint.try(:date_naissance).nil? %></td>
          <td><%= l(declaration_divorce_ou_deces_conjoint.conjoint.date_mariage) unless declaration_divorce_ou_deces_conjoint.conjoint.try(:date_mariage).nil? %></td>
          <td><%= l(declaration_divorce_ou_deces_conjoint.date_declaration) unless declaration_divorce_ou_deces_conjoint.date_declaration.nil? %></td>
          <td><%= DeclarationDivorceOuDecesConjoint.human_enum_name(:status_with_conjoint, declaration_divorce_ou_deces_conjoint.status_with_conjoint) unless declaration_divorce_ou_deces_conjoint.status_with_conjoint.nil? %></td>
          <td style="width: 75px">
            <%= link_to 'Détails', admin_declaration_divorce_ou_deces_conjoint_path(declaration_divorce_ou_deces_conjoint), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'Modifier', edit_admin_declaration_divorce_ou_deces_conjoint_path(declaration_divorce_ou_deces_conjoint), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'Supprimer', admin_declaration_divorce_ou_deces_conjoint_path(declaration_divorce_ou_deces_conjoint), method: :delete, data: {confirm: 'En êtes vous sûr?'}, class: 'btn btn-outline btn-danger btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <%= paginate @declaration_divorce_ou_deces_conjoints %>
  </div>
</div>