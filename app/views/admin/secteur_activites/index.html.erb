<%= content_for :titre_page, 'Admin Secteur Activites' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_secteur_activite_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
      <th width="10px">ID</th>
                <th scope="col">Description</th>
            <th colspan="2"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_secteur_activites.each do |admin_secteur_activite| %>
    <tr>
      <td><%= link_to "##{admin_secteur_activite.id}", admin_secteur_activite %></td>
                <td><%= admin_secteur_activite.description %></td>
            <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_secteur_activite_path(admin_secteur_activite), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_secteur_activite, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>