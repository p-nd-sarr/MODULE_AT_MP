
<%= bootstrap_form_for([:admin, @allocataire, @extinction_allocataire], layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  
  <%= f.hidden_field :etat , class:'form-control', value:2 %>
      <div class="form-group">
    <%= f.date_field :date_deces, label: "Date décés: ", class:'form-control' %>
    <%= f.text_area :motif_extinction , class:'form-control' %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-4">
      <%= link_to 'Annuler', (@extinction_allocataire.persisted? ? [:admin, @allocataire, @extinction_allocataire] : admin_allocataire_extinction_allocataires_path(@allocataire)), class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
