<table class="table table-striped" style="margin-top: 20px">
  <thead>
  <tr>
    <th scope="col">Matricule</th>
    <th scope="col">Prénom</th>
    <th scope="col">Nom</th>
    <th scope="col">Etat</th>
    <th scope="col" colspan="2"></th>
  </tr>
  </thead>
  <tbody>
  <% @extinction_allocataires.each do |extinction_allocataire| %>
    <tr>
      <td><%= extinction_allocataire.numero_allocataire %></td>
      <td><%= extinction_allocataire.get_allocataire.try(:prenom) %></td>
      <td><%= extinction_allocataire.get_allocataire.try(:nom) %></td>
      <td><%= extinction_allocataire.workflow_state %></td>
      <td>
        <%= link_to 'détails', [:admin, extinction_allocataire.get_allocataire, extinction_allocataire], class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
    </tr>
  <% end %>
  </tbody>
</table>
