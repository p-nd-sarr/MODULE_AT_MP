<%= content_for :titre_page, "Détails demande de remboursement [#{@demande_remboursement_cotisation.workflow_state}]" %>
<%= content_for :actions_page do %>

     <!-- Création et soumission de la demande -->
  <%= link_to 'Retour', admin_demande_remboursement_cotisations_path, class: 'btn btn-white btn-sm' %> 
  <% if @demande_remboursement_cotisation.creation? %>
    <%#= link_to 'Modifier', edit_admin_demande_remboursement_cotisation_path(@demande_remboursement_cotisation), class: 'btn btn-white btn-sm' %>
    <% if @demande_remboursement_cotisation.pret_pour_soumission? and current_user.can_allocataire? and @demande_remboursement_cotisation.ajoute_par == current_user %>
      <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#SoumissionModal" id="soumettre_id">Soumettre</button>
    <% end %>
  <% end %>


     <!-- Demande instruite -->
  <% if @demande_remboursement_cotisation.soumis? %>
    <%= (link_to 'Instruire Dossier', admin_demande_remboursement_cotisation_instruire_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') if current_user.chef_section_instruction? %>
    <%#= (link_to 'Retourner Dossier', admin_demande_remboursement_cotisation_retour_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-danger btn-sm') if current_user.chef_section_instruction? %>
    <% if current_user.chef_section_instruction? %>
     <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif"style="float: right; margin-left: 3px;">RETOURNER DOSSIER</button>
    <% end%>
  <% end %>

    <!-- Affecter la demande à un gestionnaire salarié -->
  <% if @demande_remboursement_cotisation.instruit? and @demande_remboursement_cotisation.affectation_salarie.nil? and current_user.chef_service_cotisation?%>
    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#affecter-one-salarie" id="affecter_salarie_id">
      Affecter Validation fiche Remboursements
    </button>
  <% end %>


     <!-- Le gestionnaire salarié soumet les lignes de carrieres pour les remboursements -->
  <% if @demande_remboursement_cotisation.instruit? and @demande_remboursement_cotisation.affecter_salarie == current_user  and (@demande_remboursement_cotisation.remboursement_cotisations.soumis.size > 0) %>
      <%= link_to "Soumettre la validation des remboursements", admin_demande_remboursement_cotisation_valider_carriere_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
      <%= (link_to 'Retour Dossier', admin_demande_remboursement_cotisation_retour_path(@demande_remboursement_cotisation), class: 'btn btn-danger btn-sm') %>
  <% end %>

  
    <!-- chef service cotisation valide lignes de carrieres soumises -->
  <% if @demande_remboursement_cotisation.carriere_soumis? and (@demande_remboursement_cotisation.remboursement_cotisations.traite.size == @demande_remboursement_cotisation.remboursement_cotisations.size) %>
      <%= (link_to 'Valider les remboursements', admin_demande_remboursement_cotisation_cotisation_valide_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') if current_user.chef_service_cotisation? %>
      <%= (link_to 'Retourner Dossier', admin_demande_remboursement_cotisation_retour_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-danger btn-sm') if current_user.chef_service_cotisation? %>
    <% end %>

     <!-- chef service liquidation liquide la demande et fait une affectation aux gestionnaires allocataire -->
  <% if @demande_remboursement_cotisation.can_affecte_gestionnaire? and @demande_remboursement_cotisation.affectation_allocataire.nil? and current_user.chef_section_liquidation?%>
    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#affecter-one-modal" id="affecter_allocataire_id">
      Affecter la Demande Allocation
    </button>
  <% end %>

     <!-- Le gestionnaire allocataire verifie et soumet le recap pour la validation -->
  <% if @demande_remboursement_cotisation.cotisation_valide? and @demande_remboursement_cotisation.affecter_allocataire == current_user %>
    <%= (link_to "Soumettre la validation du tableau", admin_demande_remboursement_cotisation_valider_recapitulatif_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') unless @demande_remboursement_cotisation.affecter_allocataire.nil? %>
    <%= (link_to 'Retour Dossier', admin_demande_remboursement_cotisation_retour_path(@demande_remboursement_cotisation), class: 'btn btn-danger btn-sm') %>
  <% end %>

     <!-- Le chef service liquidation valide le recap -->
  <% if @demande_remboursement_cotisation.recap_soumis? %>
    <%= (link_to 'Valider Tableau Recapitulatif', admin_demande_remboursement_cotisation_liquidation_valide_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') if current_user.chef_section_liquidation? %>
    <%= (link_to 'Retourner Dossier', admin_demande_remboursement_cotisation_retour_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-danger btn-sm') if current_user.chef_section_liquidation? %>
  <% end %>

      <!-- Le chef service allocataire valide la liquidation -->
  <% if @demande_remboursement_cotisation.liquidation_valide? and current_user.chef_service_allocation? %>
    <%= (link_to 'Valider', admin_demande_remboursement_cotisation_dossier_valide_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') unless @demande_remboursement_cotisation.traite? %>
    <%= (link_to 'Rejeter', admin_demande_remboursement_cotisation_rejeter_path(@demande_remboursement_cotisation), class: 'btn btn-danger btn-sm') unless @demande_remboursement_cotisation.traite? %>
    <%unless @demande_remboursement_cotisation.traite?%>
      <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif" style="float: right; margin-left: 3px;">Retourner
        Dossier
      </button>
    <% end %>
  <% end %>
  <!-- Le Dp effectue le bon à payer   -->
  <% if @demande_remboursement_cotisation.dossier_valide? and current_user.directeur_prestation? %>
    <%= (link_to 'BON A PAYER', admin_demande_remboursement_cotisation_regulariser_remboursement_path(@demande_remboursement_cotisation), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') %>
  <% end %>
  <% if @demande_remboursement_cotisation.remboursement_regularise? and current_user.directeur_prestation? %>
    <%= (link_to 'recue', admin_demande_remboursement_cotisation_show_recue_remboursement_path(@demande_remboursement_cotisation, format: :pdf), class: 'btn btn-warning btn-sm') %>
  <% end %>

  <!-- L'inspection valide la demande   -->
  <% if @demande_remboursement_cotisation.remboursement_regularise? and current_user.inspection? %>
    <%= (link_to 'Valider la demande', admin_demande_remboursement_cotisation_validation_inspection_path(@demande_remboursement_cotisation), 'data-turbolinks': false, 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') %>
  <% end %>
  <% if @demande_remboursement_cotisation.validation_inspection? %>
    <%= (link_to 'Voir ordre de paiement', admin_demande_remboursement_cotisation_payment_order_path(@demande_remboursement_cotisation, format: :pdf), target: '_blank', 'data-turbolinks': false, class: 'btn btn-warning btn-sm') %>
  <% end %>
<% end %>


<!-- Retour du dossier de liquidation -->
