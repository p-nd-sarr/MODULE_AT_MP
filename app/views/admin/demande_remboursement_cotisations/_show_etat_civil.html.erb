<div class="row">
  <div class="col-lg-12" style="text-align: right;">
    <% if @demande_remboursement_cotisation.creation? and current_user.can_allocataire? and @demande_remboursement_cotisation.ajoute_par == current_user %>
        <%= link_to ' Modifier', edit_admin_demande_remboursement_cotisation_path(@demande_remboursement_cotisation), class:"btn btn-outline btn-white fa fa-edit" %>
    <% end %>
  </div>
  <div class="col-lg-6">
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-user"></span> Prénom & nom: </dt>
      </div>
      <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
        <dd class="mb-1"><%= @demande_remboursement_cotisation.prenom %> <%= @demande_remboursement_cotisation.nom %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-calendar"></span> Date de naissance: </dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= l @demande_remboursement_cotisation.date_naissance %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-map-marker"></span> Lieu de naissance: </dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_remboursement_cotisation.lieu_naissance %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-address-card"></span> Adresse de réception de l'allocation: </dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_remboursement_cotisation.adresse_reception_allocation %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-address-card"></span> Adresse domicile: </dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_remboursement_cotisation.adresse_domicile %></dd>
      </div>
    </d1>
  </div>
  <div class="col-lg-6">
    <%unless @demande_remboursement_cotisation.email.nil? or @demande_remboursement_cotisation.email==""%>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt><span class="fa fa-envelope"></span> Email:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
          <dd class="mb-1"><%= @demande_remboursement_cotisation.email %></dd>
      </div>
    </d1>
  
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt><span class="fa fa-file"></span> Motif de revision: </dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
          <dd class="mb-1"><%= @demande_remboursement_cotisation.motif_remboursement %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt><span class="fa fa-file"></span> Periode remboursement:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
          <dd class="mb-1"><%= @demande_remboursement_cotisation.periode_remboursement %></dd>
      </div>
    </d1>
    <%end%>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt><span class="fa fa-credit-card"></span> Mode de paiement:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
          <dd class="mb-1"><%= LiquidationRetraite.human_enum_name(:mode_paiement, @demande_remboursement_cotisation.mode_paiement) unless @demande_remboursement_cotisation.mode_paiement.nil? %>
          </dd>          
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-12" style="text-align: center; font-size: 11px; color: rgb(50, 50 50);">
          <% if @demande_remboursement_cotisation.virement? %>
            <div class="notes">
                <p><strong style="font-style: italic;" class="text-info">Nom banque:</strong> <%= @demande_remboursement_cotisation.compte_bancaire_nom_banque %></p>
                <p><strong style="font-style: italic;" class="text-info">Code banque:</strong> <%= @demande_remboursement_cotisation.compte_bancaire_code_banque %></p>
                <p><strong style="font-style: italic;" class="text-info">Code guichet:</strong> <%= @demande_remboursement_cotisation.compte_bancaire_code_guichet %></p>
                <p><strong style="font-style: italic;" class="text-info">Numéro compte:</strong> <%= @demande_remboursement_cotisation.compte_bancaire_numero_compte %></p>
            </div>
          <% end %>
      </div>
    </d1>    
  </div>
</div>