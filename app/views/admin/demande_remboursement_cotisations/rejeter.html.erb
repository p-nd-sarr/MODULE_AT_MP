<%= content_for :titre_page, "Motif du rejet de la demande de liquidation retraite" %>

<div class="form-group row">
  <div class="col-sm-8 col-sm-offset-2">
<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= bootstrap_form_for(@demande_remboursement_cotisation, url: admin_demande_remboursement_cotisation_rejeter_process_path(@demande_remboursement_cotisation), layout: :horizontal) do |f| %>
      <%= f.text_area :motif, label: 'Motif' %>

      <div class="hr-line-dashed"></div>

      <div class="form-group row">
        <div class="col-sm-4 col-sm-offset-2">
          <%= link_to 'Annuler', admin_demande_remboursement_cotisations_path, class: 'btn btn-white' %>
          <%= f.button 'Rejeter', class: 'btn btn-primary' %>
        </div>
      </div>
    <% end %>
  </div>
</div>
</div>
</div>