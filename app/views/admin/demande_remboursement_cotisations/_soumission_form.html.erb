<div class="modal inmodal" id="SoumissionModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <i class="fa fa-check modal-icon btn-primary"></i>
        <h4 class="modal-title">
          Soumission de la demande de remboursement de cotisation
        </h4>

      </div>
      <div class="modal-body">
        <table class="table table-condensed table-hover">
         
          <% if @demande_remboursement_cotisation.quitter_definitivement_pays? %>
            <tr>
              <td><input type="checkbox" name="vehicle1" value="Bike"></td>
              <td>
                <strong>Condition 1 : Je m’engage à quitter le pays definitivement.</strong>
              </td>
            </tr>
          <% end %>
            <tr>

              <td> <input type="checkbox" name="vehicle1" value="Bike">
              </td>

              <td><strong>Condition 2 : Je certifie que les renseignements portés sur la présente demande sont exacts.</strong></td>
            </tr>
        </table>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
        <%= link_to 'Valider la soumission', admin_demande_remboursement_cotisation_soumettre_path(@demande_remboursement_cotisation), class: 'btn btn-primary', id: 'soummetre_valide' %>
      </div>
    </div>
  </div>
</div>

<script>

    $(document).ready(function(){

        $('input:checkbox').removeAttr('checked');

        $("#soummetre_valide").hide();
        var all_checkboxes = $('#SoumissionModal input[type="checkbox"]');

        $(".modal-body").change(function(){

            if (all_checkboxes.length === all_checkboxes.filter(":checked").length) {
                $("#soummetre_valide").show();
            }else{
                $("#soummetre_valide").hide();

            }

        });

    });

</script>

