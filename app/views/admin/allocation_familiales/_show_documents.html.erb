<div class="row" style="margin-top:20px;">
  <div class="col-lg-12">
    <hr>
    <h2>Documents sur Grappe familiale </h2>
  </div>
  <% @enfants.each do |enfant| %>

    <div class="col-lg-2" style="margin-top: 10px;">
      <div class="panel panel-default">
        <div class="panel-heading" style="text-align: center;height: 50px;">
          <% if enfant.extrait_naissance.attached? %>
            <h5>
              <%= Enfant.human_enum_name(:type_piece, enfant.type_piece) unless enfant.type_piece.nil? %>
            </h5>
          <% end %>
        </div>
        <div class="panel-body"  style="min-height: 150px">
          <%= link_to image_tag('missing_logo.png', size: "400x400>", class: "m-t-xs img-responsive"), enfant.extrait_naissance, target: :_blank if enfant.extrait_naissance.attached? %>
          <%#= link_to image_tag(enfant.extrait_naissance.preview(resize: "400x400>"), class: "m-t-xs img-responsive"), enfant.extrait_naissance, target: :_blank if enfant.extrait_naissance.attached? %>
        </div>
      </div>
    </div>
  <% end %>
</div>
