
<% if @allocation_familiale.enfant.date_naissance < 14.years.ago %>
  <%= render 'documents/liste',
             object: @allocation_familiale.enfant,
             documents: @allocation_familiale.enfant.documents,
             include_add: @allocation_familiale.enfant,
             include_delete: @allocation_familiale.enfant,
             include_edit: @allocation_familiale.enfant,
             type_documents: Enfant::TYPE_DOCUMENT,
             type_documents_obligatoires: Enfant::TYPE_DOCUMENT_OBLIGATOIRE,
             back_url: admin_dossier_prestation_allocation_familiale_path(@dossier_prestation, @allocation_familiale)
  %>
  <%= render 'documents/modal_form',
             type_documents: Enfant::TYPE_DOCUMENT,
             document: Document.new(documentable: @allocation_familiale.enfant),
             back_url: admin_dossier_prestation_allocation_familiale_path(@dossier_prestation, @allocation_familiale)
  %>
<% elsif @allocation_familiale.enfant.date_naissance > 14.years.ago %>
  <%= render 'documents/liste',
             object: @allocation_familiale.enfant,
             documents: @allocation_familiale.enfant.documents,
             include_add: @allocation_familiale.enfant,
             include_delete: @allocation_familiale.enfant,
             include_edit: @allocation_familiale.enfant,
             type_documents: Enfant::TYPE_DOCUMENT_1,
             type_documents_obligatoires: Enfant::TYPE_DOCUMENT_OBLIGATOIRE,
             back_url: admin_dossier_prestation_allocation_familiale_path(@dossier_prestation, @allocation_familiale)
  %>
  <%= render 'documents/modal_form',
             type_documents: Enfant::TYPE_DOCUMENT_1,
             document: Document.new(documentable: @allocation_familiale.enfant),
             back_url: admin_dossier_prestation_allocation_familiale_path(@dossier_prestation, @allocation_familiale)
  %>
<%end %>

