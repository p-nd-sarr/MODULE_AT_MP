                              Rejeter
                            </button>
                          <% end %>
                        </li>
                      </ul>
                    </td>
                  <% end %>
                </tr>
                <%= render 'rejeter_allocation_familiale_form', object: allocation_familiale if allocation_familiale.soumis? %>
              <% end %>
            <% end %>
            </tbody>
          </table>
        </div>
