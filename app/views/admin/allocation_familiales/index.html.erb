<%= content_for :titre_page do %>
  Allocations Familiales -
  <span style="font-size: 60%; font-family: Georgia;">
    <%= link_to "Dossier #{@dossier_prestation.num_dossier}", admin_dossier_prestation_path(@dossier_prestation), class: 'text-info' %>
  </span>
<% end %>
<%= content_for :actions_page do %>
  <%= link_to ' Retour', admin_dossier_prestations_path, class: 'btn btn-white btn-sm fa fa-arrow-left' %>
  <%#= link_to ' Ajouter', new_admin_dossier_prestation_allocation_familiale_path(@dossier_prestation), class: 'btn btn-primary btn-sm fa fa-plus' if @dossier_prestation.current_state <= :valide %>
  <%= (link_to 'Tout Valider', admin_dossier_prestation_valider_familiales_path(@dossier_prestation), data: { confirm: 'En êtes vous sûr?' },
               class: 'btn btn-primary btn-sm') if (@dossier_prestation.valide? or @dossier_prestation.suspendu?) and current_user.chef_agence? and not @dossier_prestation.allocation_familiales.not_from_echeance.soumis.empty? %>
  <%#= (link_to 'Tout Rejeter', admin_dossier_prestation_rejeter_familiales_path(@dossier_prestation), data: { confirm: 'En êtes vous sûr?' },
               class: 'btn btn-primary btn-sm') if (@dossier_prestation.valide? or @dossier_prestation.suspendu?) and current_user.chef_agence? and not @dossier_prestation.allocation_familiales.soumis.empty? %>

  <% if @dossier_prestation.can_all_liquidate? %>
    <%= link_to 'Tout liquider', admin_dossier_prestation_liquider_familiales_path(@dossier_prestation), data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-primary' %>
    <!--     <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#liquiderModal" id="liquider_id">TOUT LIQUIDER</button>-->
  <% end %>
<% end %>


<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-2">
      <div class="ibox volet5">
        <div class="ibox-title">
          <h4>Trimestre 1</h4>
        </div>
        <div class="ibox-content">
          <h3 class="no-margins">
            <%= format_cfa tri1 = @dossier_prestation.allocation_familiales.trimestre1.valide.map(&:montant_paiement).sum(&:to_i) %>
          </h3>
        </div>
      </div>
    </div>
    <div class="col-lg-2">
      <div class="ibox volet4">
        <div class="ibox-title">
          <h4>Trimestre 2</h4>
        </div>
        <div class="ibox-content">
          <h3 class="no-margins">
            <%= format_cfa tri2 = @dossier_prestation.allocation_familiales.trimestre2.valide.map(&:montant_paiement).sum(&:to_i) %>
          </h3>
        </div>
      </div>
    </div>
    <div class="col-lg-2">
      <div class="ibox volet7">
        <div class="ibox-title">
          <h4>Trimestre 3</h4>
        </div>
        <div class="ibox-content">
          <h3 class="no-margins">
            <%= format_cfa tri3 = @dossier_prestation.allocation_familiales.trimestre3.valide.map(&:montant_paiement).sum(&:to_i) %>
          </h3>
        </div>
      </div>
    </div>
    <div class="col-lg-2">
      <div class="ibox volet6 ">
        <div class="ibox-title">
          <h4>Trimestre 4</h4>
        </div>
        <div class="ibox-content">
          <h3 class="no-margins">
            <%= format_cfa tri4 = @dossier_prestation.allocation_familiales.trimestre4.valide.map(&:montant_paiement).sum(&:to_i) %>
          </h3>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="ibox ">
        <div class="ibox-title" style="border-bottom:1px solid #1ab394;">
          <h3><strong class="text-navy">Total</strong></h3>
        </div>
