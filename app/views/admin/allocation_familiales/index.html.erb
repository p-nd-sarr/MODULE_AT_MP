    </div>
  </div>
  <div class="ibox-content">
    <div class="row m-b-xs">
      <div class="col-sm-9 m-b-xs">
        <div data-toggle="buttons" class="btn-group btn-group-toggle">
          <label class="btn btn-sm btn-white " data-toggle="pill" href="#tous">
            <input type="radio" id="option1" name="options"> Tous
          </label>
          <label class="btn btn-sm btn-white active" data-toggle="pill" href="#echues">
            <input type="radio" id="option1" name="options"> Échues
          </label>
          <label class="btn btn-sm btn-white" data-toggle="pill" href="#non_echues">
            <input type="radio" id="option1" name="options"> Non échues
          </label>
          <label class="btn btn-sm btn-white" data-toggle="pill" href="#soumis">
            <input type="radio" id="option1" name="options"> Soumises
          </label>
          <label class="btn btn-sm btn-white" data-toggle="pill" href="#valides">
            <input type="radio" id="option2" name="options"> validés </label>
          <label class="btn btn-sm btn-white" data-toggle="pill" href="#rejetes">
            <input type="radio" id="option3" name="options"> Rejetés
          </label>
          <label class="btn btn-sm btn-white" data-toggle="pill" href="#suspendus">
            <input type="radio" id="option4" name="options"> Suspendues
          </label>
          <label class="btn btn-sm btn-white" data-toggle="pill" href="#prescrit">
            <input type="radio" id="option4" name="options"> Prescrites
          </label>
          <label class="btn btn-sm btn-white" data-toggle="pill" href="#eligible">
            <input type="radio" id="option5" name="options"> Enfants éligibles
          </label>
        </div>
      </div>
    </div>
    <div class="row m-b-lg">
      <div class="col-sm-6 col-sm-offset-6">
        <%= search_form_for @q, url: admin_dossier_prestation_allocation_familiales_path(params[:dossier_prestation_id]) do |f| %>
          <div class="input-group mb-3" style="float: right;">
            <%= f.search_field :annee_eq, class: "form-control form-control-sm", placeholder: "Année", style: "width:150px; position: relative; z-index: 1" %>
            <%= f.search_field :trimestre_eq, class: "form-control form-control-sm", placeholder: "Trimestre", style: "width:150px; position: relative; z-index: 1" %>

            <div class="input-group-append" style="float: right; position:relative; z-index: 2">
              <%= f.submit "Go!", :class => "btn btn-sm btn-primary", :style => "height:34px" %>
              <% unless params[:q].nil? or (params[:q][:trimestre_eq] === '' and params[:q][:annee_eq] === '') %>
                <% unless (params[:q][:trimestre_eq].nil? and params[:q][:annee_eq].nil?) or @allocation_familiales.size == 0 %>
                  <%= link_to 'Tout liquider', admin_dossier_prestation_liquider_familiales_by_period_path(@dossier_prestation, params[:q][:annee_eq], params[:q][:trimestre_eq]), data: { confirm: 'Voulez-vous tout liquider ?' }, class: 'btn btn-sm btn-primary', :style => "height:34px" if current_user.gestionnaire_compte_allocataire? and @dossier_prestation.has_valid_allocations?(@allocation_familiales) and not params[:q][:trimestre_eq] === '' %>
                  <%= link_to 'Tout liquider', admin_dossier_prestation_liquider_familiales_by_year_path(@dossier_prestation, params[:q][:annee_eq]), data: { confirm: 'Voulez-vous tout liquider ?' }, class: 'btn btn-sm btn-primary', :style => "height:34px" if current_user.gestionnaire_compte_allocataire? and @dossier_prestation.has_valid_allocations?(@allocation_familiales) and params[:q][:trimestre_eq] === '' %>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
        <% unless params[:q].nil? %>
          <% if (params[:q][:trimestre_eq] != '' or params[:q][:annee_eq] != '') and @dossier_prestation.has_valid_allocations?(@allocation_familiales) %>
            <p style="margin-top: 30px" class="badge">Cliquez sur le bouton Tout liquider pour liquider
              (<%= @dossier_prestation.number_allocations_valid(@allocation_familiales) %>) allocation(s)
              familiale(s). </p>
          <% else %>
            <p style="margin-top: 30px" class="badge">Vous n'avez aucune allocation à liquider</p>
          <% end %>
        <% end %>

      </div>
    </div>
    <div class="row">
      <div class="tab-content">
        <div id="tous" class="tab-pane fade in">
          <table class="table table-bordered table-condensed table-hover">
            <thead>
            <tr>
              <th scope="col">Enfant</th>
              <th scope="col">Trimestre</th>
              <th scope="col">Année</th>
              <th scope="col">Etat</th>
              <th scope="col">Date Création</th>
              <th scope="col">Date Liquidation</th>
              <th scope="col">Montant Liquidé</th>
              <th scope="col">Date de validation</th>
              <th scope="col">Date Paiement</th>
              <th scope="col">Numéro liquidation généré</th>
              <th scope="col">Est repris?</th>
              <th colspan="2"></th>
            </tr>
            </thead>

            <tbody>
            <% unless @allocation_familiales.nil? %>
              <% @allocation_familiales.each do |allocation_familiale| %>
                <% if allocation_familiale.motif_rejet? %>
                  <p class="text-danger">
                    Motif retour: <%= allocation_familiale.motif_rejet %>
                  </p>
                <% end %>
                <tr>
                  <td> <%= allocation_familiale.enfant.full_name %></td>
                  <td><%= AllocationFamiliale.human_enum_name(:trimestre, allocation_familiale.trimestre) %></td>
                  <td><%= allocation_familiale.annee %></td>
                  <td><%= AllocationFamiliale.human_enum_name(:etat, allocation_familiale.etat) %></td>
                  <td><%= allocation_familiale.created_at.strftime('%d-%m-%Y') %></td>
                  <td>
                    <% unless allocation_familiale.date_liquidation.nil? %>
                      <%= allocation_familiale.date_liquidation.strftime('%d-%m-%Y') %>
                    <% end %>
                  </td>
                  <td><%= allocation_familiale.montant_paiement unless allocation_familiale.creation? %></td>
                  <td>
                    <% unless allocation_familiale.date_validation.nil? %>
                      <%= l allocation_familiale.date_validation %>
                    <% end %>
                  </td>
                  <td>
                    <% unless allocation_familiale.date_paiement.nil? %>
                      <%= l allocation_familiale.date_paiement %>
                    <% end %>
                  </td>
                  <td> <%= allocation_familiale.numero_liquidation_generer unless allocation_familiale.numero_liquidation_generer.nil? %></td>
                  <td> <%= state_yes_no allocation_familiale.est_repris %></td>
                  <td style="width: 75px">
                    <%= link_to 'Détails', [:admin, @dossier_prestation, allocation_familiale],
                                class: 'btn btn-outline btn-primary btn-xs' %>
                  </td>
                  <% if allocation_familiale.creation? and @dossier_prestation.current_state < :cloturer and (allocation_familiale.echeance_caisse.nil? or (not allocation_familiale.echeance_caisse.nil? and allocation_familiale.is_from_ech_paid?)) %>
                    <td width="90px" class="dropdown">
                      <button class="btn btn-success btn-xs dropdown-toggle" type="button" data-toggle="dropdown">
                        Action <span class="caret"></span>
                      </button>
                      <ul class="dropdown-menu">
                        <!--       <li>
                          <%#= link_to 'Modifier', edit_admin_dossier_prestation_allocation_familiale_path(@dossier_prestation, allocation_familiale)%>
                        </li>
                        <li>
                          <%#= link_to 'Supprimer', [:admin, @dossier_prestation, allocation_familiale], method: :delete, data: { confirm: 'En êtes vous sûr?' } %>
                        </li>-->
                        <li>
                          <%= link_to 'Liquider', admin_dossier_prestation_allocation_familiale_soumettre_path(@dossier_prestation, allocation_familiale), class: 'btn btn-primary btn-sm' if current_user.gestionnaire_compte_allocataire? and allocation_familiale.can_be_liquidate? and allocation_familiale.pret_pour_soumission? %>
                        </li>
                      </ul>
                    </td>
                  <% elsif @dossier_prestation.current_state >= :soumis and @dossier_prestation.current_state < :cloturer and current_user.chef_agence? and (allocation_familiale.echeance_caisse.nil? or (not allocation_familiale.echeance_caisse.nil? and allocation_familiale.is_from_ech_paid?)) %>
                    <td width="90px" class="dropdown">
                      <button class="btn btn-success btn-xs dropdown-toggle" type="button" data-toggle="dropdown">
                        Action <span class="caret"></span>
                      </button>
                      <ul class="dropdown-menu">
                        <li>
                          <%= (link_to 'Valider', admin_dossier_prestation_allocation_familiale_valider_path(@dossier_prestation, allocation_familiale)) if allocation_familiale.soumis? %>
                        </li>
                        <li>
                          <% if allocation_familiale.soumis? %>
