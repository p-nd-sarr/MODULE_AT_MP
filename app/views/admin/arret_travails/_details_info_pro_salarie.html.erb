<div class="row" style="margin-top: 20px;">
  <div class="col-lg-12">
    <div class="m-b-md">
      <% unless @demande_arret_travail.info_pro_salarie_valid? %>
        <% if @demande_arret_travail.meme_agence?(current_user) && @demande_arret_travail.can_update?(current_user) %>
          <button type="button" class="btn btn-outline btn-white fa fa-edit" data-toggle="modal" data-target="#infoProAT" style="float: left;"></span> Modifier</button>
          <div class="modal inmodal" id="infoProAT" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
            <div class="modal-dialog modal-lg">
              <%= bootstrap_form_for([:admin, @demande_arret_travail], label_col: "col-sm-4", control_col: "col-sm-6") do |f| %>
              <%= f.alert_message "Please fix the errors below." %>
    
              <div class="modal-content animated fadeIn">
                <div class="modal-header">
                  <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">x</span>
                    <span class="sr-only">Close</span>
                  </button>
                  <h4 class="modal-title">Modifier les informations professionnelles du salarié</h4>
                </div>
                <div class="modal-body">            
                  <div class="row">
                    <div class="col-sm-12">
                      <%=hidden_field_tag :custom_page, 'information_pro_salarie'%>                    
                      <div class="col-sm-6 col-md-6">
                        <%= f.select :qualification_professionnelle_salarie,
                        ArretTravail::QUALIFICATION_PROFESSIONNELLE.keys.collect { |qualification_professionnelle_salarie| [qualification_professionnelle_salarie] },
                        { include_blank: 'Sélectionner'} %>
                      </div>
                      <div class="col-sm-6 col-md-6">
                        <%= f.text_field  :carnet_accident_travail ,readonly: @demande_arret_travail.read_only?%>
                      </div>
                      <div class="col-sm-6 col-md-6">
                        <%= f.date_field  :date_embauche_salarie ,readonly: @demande_arret_travail.read_only?%>
                      </div>
                      <div class="col-sm-6 col-md-6">
                        <%= f.text_field  :anciennete_salarie ,readonly: @demande_arret_travail.read_only?%>
                      </div>
                      <div class="col-sm-6 col-md-6">
                         <%= f.check_box :infirmite_anterieure_accident ,readonly: @demande_arret_travail.read_only?%>
                      </div>
                                       
                      <div class="col-sm-6 col-md-6">
                        <%= f.select :type_de_contrat_travail_salarie,
                        ArretTravail::TYPE_DE_CONTRAT_TRAVAIL.keys.collect { |type_de_contrat_travail_salarie| [type_de_contrat_travail_salarie] },
                        { include_blank: 'Sélectionner'} %>
                      </div>
                      <div class="col-sm-6 col-md-6">
                         <%= f.text_field  :taux_infirmite_anterieure_accident ,readonly: @demande_arret_travail.read_only?%>
                      </div>
                      <div class="col-sm-6 col-md-6">
                         <%= f.text_field  :numero_rente_infirmite_anterieure_accident ,readonly: @demande_arret_travail.read_only?%>
                      </div>
                    </div>
                  </div>
                </div>
                
                <div class="modal-footer form-group">
                  <%= link_to 'Annuler', (@demande_arret_travail.persisted? ? [:admin, @demande_arret_travail] : admin_arret_travails_path), class: 'btn btn-white' %>
                  <% if @demande_arret_travail.meme_agence?(current_user) && @demande_arret_travail.can_update?(current_user)%>
                  <%= f.button 'Mettre à jour', class: 'btn btn-primary' %>
                <%end%>
                </div>
              </div>
              <%end%>
            </div>
          </div>
          <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-lg-6">
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Qualification professionnelle:</dt>
      </div>
      <div class="col-sm-6 text-sm-right" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.qualification_professionnelle_salarie %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Carnet d'accident de travail:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.carnet_accident_travail %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Date d'embauche:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.date_embauche_salarie.strftime("%d-%m-%Y") unless @demande_arret_travail.date_embauche_salarie.nil? %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Ancienneté:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.anciennete_salarie %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Infirmite anterieure accident:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.infirmite_anterieure_accident ? 'OUI' : 'NON' %></dd>
      </div>
    </d1>

  </div>
  <div class="col-lg-6">
    <!--d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Numéro dossier:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%#= @demande_arret_travail.num_dossier %></dd>
      </div>
    </d1-->

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Type de contrat de travail:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.type_de_contrat_travail_salarie %></dd>
      </div>
    </d1>
    
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Salaire maintenu:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.is_subrogation? ? 'OUI' : 'NON' %></dd>
      </div>
    </d1>
    
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">        
        <% unless not @demande_arret_travail.is_subrogation? %>  
          <dt>Salaire du mois:</dt>
          </div>
          <div class="col-sm-6 text-sm-left" style="text-align: left;">
          <dd class="mb-1"><%= @demande_arret_travail.salaire_du_mois %></dd>        
        <% else %>
          <dt>Salaire du jour:</dt>
          </div>
          <div class="col-sm-6 text-sm-left" style="text-align: left;">
          <dd class="mb-1"><%= @demande_arret_travail.salaire_du_jour %></dd>
        <% end %>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Taux infirmité anterieur:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.taux_infirmite_anterieure_accident %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt>Numéro rente anterieur:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.numero_rente_infirmite_anterieure_accident %></dd>
      </div>
    </d1>

  </div>
</div>
