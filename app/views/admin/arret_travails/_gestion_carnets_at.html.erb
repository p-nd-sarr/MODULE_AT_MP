


<div class="row" style="margin-top: 30px;" >
  <div class="col-lg-9">
    <h3>Liste des carnets</h3>
  </div>
  <div class="col-sm-3" style="text-align: right;">
    <button class="btn btn-outline btn-success" data-toggle="modal" data-target="#carnet1">Ajouter un carnet</button>
  
    <div class="modal inmodal" id="carnet1" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
      <div class="modal-dialog">
        <%= bootstrap_form_for(@at_carnet, url:  admin_arret_travail_ajouter_carnet_path(@demande_arret_travail), label_col: "col-sm-5", control_col: "col-sm-7") do |f| %>
          <%= f.alert_message "Please fix the errors below." %>
          <div class="modal-content animated fadeIn">
            <div class="modal-header">
              <button type="button" class="close" data-dismiss="modal">
                <span aria-hidden="true">x</span>
                <span class="sr-only">Close</span>
              </button>
              <h4 class="modal-title">Ajouter un carnet AT</h4>
            </div>
            <div class="modal-body">
                <%=f.hidden_field :arret_travail_id, value: @demande_arret_travail.id%>
                <%= f.text_field  :numero_carnet %>
                <%= f.text_field  :numero_employeur %>
                <%= f.text_field :raison_sociale, label: 'Raison Sociale', readonly: true %>
                <%=f.date_field :date_achat, label: "Date achat carnet"%> 
            </div>
            <div class="modal-footer form-group">
              <%= link_to 'Annuler', (@demande_arret_travail.persisted? ? [:admin, @demande_arret_travail] : admin_arret_travails_path), class: 'btn btn-white'%>
              <%= f.button 'Valider', class: 'btn btn-primary' %>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="col-lg-12" style="margin-top: 20px;">
    <table class="table table-bordered table-condensed table-hover" style="margin-bottom: 30px;">
      <thead>
      <tr>
        <th>N° Carnet</th>
        <th>N° Employeur</th>
        <th>Raison social</th>
        <th>Date achat</th>
        <th>Existe dans AT vente ?</th>
        <th colspan="2">Action</th>

      </tr>
      </thead>
      <tbody>
      <% @demande_arret_travail.at_carnets.each do |carnet| %>
        <tr>
          <td><%= carnet.numero_carnet %></td>
          <td><%= carnet.numero_employeur %></td>
          <td><%= carnet.raison_sociale %></td>
          <td><%= carnet.date_achat.strftime('%d/%m/%Y') unless carnet.date_achat.nil? %></td>
          <td><%= state_yes_no carnet.is_verified? %></td>
          <td style="width: 75px">
            <%= (link_to 'Modifier', edit_admin_arret_travail_at_carnet_path(@demande_arret_travail, id: carnet), data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-warning btn-xs') %>
          </td>
          <td style="width: 75px">
            <%= link_to 'Supprimer', [:admin, @demande_arret_travail, carnet], method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>



