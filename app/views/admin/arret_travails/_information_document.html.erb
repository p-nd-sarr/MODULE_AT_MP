<style type="text/css">
  label[title="required"] {
    display: none;
  }

  .invalid-feedback {
    font-size: 0px;
  }
</style>


<ul class="text-danger">
  <% if @demande_arret_travail.documents.where(type_document: [:certificat_medical]).empty? %>
  
  <% end %>
</ul>


  <div class="row" style="margin-top: 20px;">
    <div class="col-lg-4">
      <h2>Liste des documents</h2>
    </div>
    <%# unless @admin_reversion_veuve_salary.documents_valide! %>
      <div class="col-lg-8">
        <div class="alert alert-info alert-dismissable">
          <button ariahidden="true" data-dismiss="alert" class="close" type="button">
            <font style="vertical-align: inherit;">
              <font style="vertical-align: inherit;">x</font>
            </font>
          </button>
          <font style="vertical-align: inherit;">
            <font style="vertical-align: inherit;"><span class="fa fa-info-o"></span> Veuillez renseigner des documents
              au format PDF</font>
          </font>
        </div>
      </div>
    <%# end %>
  </div>



<% if @demande_arret_travail.current_state <= :accepte %>
<%= render 'documents/liste',
           object: @demande_arret_travail,
           documents: @demande_arret_travail.documents,
           include_add: @demande_arret_travail.creation?,
           include_delete: @demande_arret_travail.creation?,
           type_documents: ArretTravail::TYPE_DOCUMENT,
           type_documents_obligatoires: ArretTravail::TYPE_DOCUMENT_OBLIGATOIRE,
           back_url: admin_arret_travail_path(@demande_arret_travail)
%>

  <%= render 'documents/modal_form',
            type_documents: ArretTravail::TYPE_DOCUMENT,
            document: Document.new(documentable: @demande_arret_travail),
            back_url:admin_arret_travail_path(@demande_arret_travail)
  %>
<% else %>
<%= render 'documents/liste',
           object: @demande_arret_travail,
           documents: @demande_arret_travail.documents,
           include_add: false, 
           include_delete: false, 
           type_documents: ArretTravail::TYPE_DOCUMENT,
           type_documents_obligatoires: ArretTravail::TYPE_DOCUMENT_OBLIGATOIRE,
           back_url: admin_arret_travail_path(@demande_arret_travail)
%>
<% end %>