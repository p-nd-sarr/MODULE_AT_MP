                  <%= '<span class="label label-warning">à valider</span>'.html_safe unless @demande_arret_travail.info_salarie_valid? and @demande_arret_travail.info_employeur_valid? and @demande_arret_travail.document_valid? %>
                  <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @demande_arret_travail.info_salarie_valid? and @demande_arret_travail.info_employeur_valid? and @demande_arret_travail.document_valid? %>   
                </a>
              </li>
             <li class="nav-item tab-link-top">
