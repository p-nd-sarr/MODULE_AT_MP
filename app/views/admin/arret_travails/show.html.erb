<%content_for :javascript do %>
<script type="text/javascript">
  $(document).ready(function() {
    $('#at_carnet_numero_employeur').change(function () {
              chargerInfosEmployeur();
              chargerInfosCarnet()
          });
          $('#at_carnet_numero_carnet').change(function () {
              chargerInfosCarnet();
          });

          function chargerInfosCarnet() {
              let ref_carnet = $('#at_carnet_numero_carnet').val();
              let ref_employeur = $('#at_carnet_numero_employeur').val();

              if (ref_carnet && ref_employeur) {
                  $.ajax({
                      url: "/admin/at_vente_carnets/employeur_carnet/" + ref_employeur + "/" + ref_carnet + ".json",
                      method: 'get',
                      dataType: "json",
                      success: function (data) {
                          console.log(data)
                          if (data) {
                              $("#at_carnet_date_achat").val(data.date_delivrance);
                          } else {
                              $("#at_carnet_date_achat").val('');
                          }
                      },
                      error: function (XMLHttpRequest, textStatus, errorThrown) {
                          $("#at_carnet_date_achat").val('');
                      }
                  });
              }
          }

          function chargerInfosEmployeur() {
              let ref_employeur = $('#at_carnet_numero_employeur').val();
              if (ref_employeur) {
                  $.ajax({
                      url: "/admin/employeurs/single_employeur/" + ref_employeur + ".json",
                      method: 'get',
                      dataType: "json",
                      success: function (data) {
                          if (data) {
                              $("#at_carnet_raison_sociale").val(data.fhrsoc);
                          } else {
                              $("#at_carnet_raison_sociale").val('');
                          }
                      },
                      error: function (XMLHttpRequest, textStatus, errorThrown) {
                          $("#at_carnet_raison_sociale").val('');
                      }
                  });
              }
          }
      });
      ;
</script>
<%end%>


<style>

  .progressbar-wrapper {
    width: 100%;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 2%;
  }

  .progressbar li {
    list-style-type: none;
    width: 10%;
    float: left;
    font-size: 10px;
    position: relative;
    text-align: center;
    text-transform: uppercase;
    color: #7d7d7d;
  }

  .progressbar li:before {
    width: 60px;
    height: 60px;
    content: "";
    line-height: 60px;
    border: 2px solid #7d7d7d;
    display: block;
    text-align: center;
    margin: 0 auto 3px auto;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    background-color: #fff;
  }

  .progressbar li:after {
    width: 100%;
    height: 2px;
    content: '';
    position: absolute;
    background-color: #7d7d7d;
    top: 30px;
    left: -50%;
    z-index: 0;
  }

  .progressbar li:first-child:after {
    content: none;
  }

  .progressbar li.active {
    color: #000;
    font-weight: normal;
  }

  .progressbar li.active:before {
    border-color: #1ab394;
    background: #1ab394;
  }

  .progressbar li.active + li:after {
    background-color: #1ab394;
  }

  .progressbar li.active:before {
    background: #1ab394;
    background-size: 60%;
  }

  .progressbar li::before {
    background: #fff;
    background-size: 70%;
  }

  .progressbar {
    counter-reset: step;
  }

  .progressbar li:before {
    content: counter(step);
    counter-increment: step;
  }
  .progressbar li.rejet.active:before {
    background-color: red;
  }


  
</style>
