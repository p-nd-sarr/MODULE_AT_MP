<%= bootstrap_form_for([:admin, @demande_arret_travail], label_col: "col-sm-4", control_col: "col-sm-6") do |f| %>
  <%= f.alert_message "Please fix the errors below." %>
      <div class="row">
        <div class="col-md-12 col-sm-12 offset-6">
          <h5 style="margin-top: 20px; margin-bottom: 20px;"><span class="label label-info"> Complèter le dossier</span> </h5>
        </div>
        <div class="col-sm-12 col-md-12">
          <%=hidden_field_tag :custom_page, 'information_salarie'%>
          <div class="col-sm-6 col-md-6">
            <%= f.text_field :numero_affiliation, label: 'Numéro affiliation', readonly: true %>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.text_field :nin_salarie, required: is_required_field?(ArretTravail, 'nin_salarie'), readonly: @demande_arret_travail.read_only? %>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.text_field :prenom_salarie, readonly: true %>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.text_field :nom_salarie, readonly: true %>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.date_select :date_de_naissance_salarie, label: "Date de naissance",
                            start_year: (Date.today - 100.year).year, end_year: (Date.today + 100.year).year, required: is_required_field?(ArretTravail, 'date_de_naissance_salarie') , disabled: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.text_field :telephone_salarie, required: is_required_field?(ArretTravail, 'telephone_salarie') ,readonly: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.select :situation_matrimoniale_salarie, 
            ArretTravail::SITUATION_MATRIMONIALE.keys.collect{|sit_mat| [sit_mat, sit_mat]}, label: 'Situation Matrimoniale', required: is_required_field?(ArretTravail, 'situation_matrimoniale_salarie') ,disabled: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.select :qualification_professionnelle_salarie, 
            ArretTravail::QUALIFICATION_PROFESSIONNELLE.keys.collect{|item| [item, item]}, label: 'Qualification professionnelle' , required: is_required_field?(ArretTravail, 'qualification_professionnelle_salarie'),readonly: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.text_field :adresse_domiciliaire_salarie , required: is_required_field?(ArretTravail, 'adresse_domiciliaire_salarie') ,readonly: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6 box1">
            <%= f.check_box :infirmite_anterieure_accident , label:"Taux IPP", disabled: @demande_arret_travail.read_only?, class:"form-check-input"%>
          </div>
        </div>
        <div class="col-sm-12 col-md-12">
           <hr>
          <div class="col-sm-6 col-md-6">   
            <%= f.text_field :num_dossier, readonly:true %>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.text_field :carnet_accident_travail, required: is_required_field?(ArretTravail, 'carnet_accident_travail') ,readonly: @demande_arret_travail.read_only?%>
           </div>
           <div class="col-sm-6 col-md-6">
            <%= f.date_select :date_embauche_salarie , label: "Date d'embauche",
                                 start_year: (Date.today - 100.year).year, end_year: (Date.today + 100.year).year , required: is_required_field?(ArretTravail, 'qualification_professionnelle_salarie') ,disabled: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.number_field :anciennete_salarie, required: is_required_field?(ArretTravail, 'date_embauche_salarie') ,readonly: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.select :type_de_contrat_travail_salarie, 
            ArretTravail::TYPE_DE_CONTRAT_TRAVAIL.keys.collect{|tc| [tc, tc]}, label: 'Type Contrat', required: is_required_field?(ArretTravail, 'type_de_contrat_travail_salarie') ,disabled: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6">
             <%= f.number_field :salaire_du_jour, required: is_required_field?(ArretTravail, 'salaire_du_jour') ,readonly: @demande_arret_travail.read_only?%>
          </div>
          <div class="col-sm-6 col-md-6">
            <%= f.number_field :salaire_du_mois, required: is_required_field?(ArretTravail, 'salaire_du_mois') ,readonly: @demande_arret_travail.read_only?%>
          </div>
        </div>
        <div class="form-group col-md-12">
          <hr>
          <div class="col-sm-9"></div>
          <div class="col-sm-3" style="text-align: right;">
            <%= link_to 'Annuler', (@demande_arret_travail.persisted? ? [:admin, @demande_arret_travail] : admin_arret_travails_path), class: 'btn btn-white' %>
           <% if @demande_arret_travail.meme_agence?(current_user) && @demande_arret_travail.can_update?(current_user)%>
            <%= f.button 'Mettre à jour', class: 'btn btn-primary' %>
            <%end%>
          </div>
        </div>
      </div>
<% end %>