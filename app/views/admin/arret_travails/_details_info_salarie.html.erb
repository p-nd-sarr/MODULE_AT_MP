$( "#arret_travail_type_de_contrat_travail_salarie" ).on('change', function() {
  

      checkJournalier();
         
      });
      
      function checkJournalier() {
        var journalier = $( "#arret_travail_type_de_contrat_travail_salarie" ).val();
        console.log(journalier);
        var elem4= $('#bloc_journalier');
        var elem5 =$('#bloc_autre');
        if (journalier == "journalier"){
          elem4.show();
          elem5.hide();
        }else {
          elem4.hide();
          elem5.show();
        }
      }


