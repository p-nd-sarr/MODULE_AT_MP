      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @employeur.fhadr? ? @employeur.fhadr : "indéfini" %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
