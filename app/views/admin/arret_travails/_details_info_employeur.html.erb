<div class="row" style="margin-top: 20px;">
  <div class="col-lg-12">
    <div class="m-b-md">
      <% unless  @demande_arret_travail.info_employeur_valid?%>
        <%if  @demande_arret_travail.meme_agence?(current_user) && @demande_arret_travail.can_update?(current_user) %>
        <button type="button" class="btn btn-outline btn-white fa fa-edit" data-toggle="modal" data-target="#infoEmployeurAT" style="float: left;"></span> Modifier</button>
        <%end%>
      <%end%>
      <div class="modal inmodal" id="infoEmployeurAT" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
        <div class="modal-dialog modal-lg">
          <%= bootstrap_form_for([:admin, @demande_arret_travail], label_col: "col-sm-4", control_col: "col-sm-6") do |f| %>
          <%= f.alert_message "Please fix the errors below." %>

          <div class="modal-content animated fadeIn">
            <div class="modal-header">
              <button type="button" class="close" data-dismiss="modal">
                <span aria-hidden="true">x</span>
                <span class="sr-only">Close</span>
              </button>
              <h4 class="modal-title">Modifier les informations de l'employeur</h4>
            </div>
            <div class="modal-body">            
              <div class="row">
                <div class="col-sm-12">
                  <%=hidden_field_tag :custom_page, 'information_employeur'%>
                
                  <div class="col-sm-6 col-md-6">
                    <%= f.text_field  :raison_sociale_employeur ,readonly: @demande_arret_travail.read_only?%>
                  </div>
                  <div class="col-sm-6 col-md-6">
                    <%= f.text_field  :numero_employeur ,readonly: @demande_arret_travail.read_only?%>
                  </div>
                  <div class="col-sm-6 col-md-6">
                    <%= f.text_field  :adresse_employeur ,readonly: @demande_arret_travail.read_only?%>
                  </div>
                  <div class="col-sm-6 col-md-6">
                    <%= f.text_field  :boite_postale_employeur ,readonly: @demande_arret_travail.read_only?%>
                  </div>
                  <div class="col-sm-6 col-md-6">
                     <%= f.text_field  :email_employeur ,readonly: @demande_arret_travail.read_only?%>
                  </div>
                  <div class="col-sm-6 col-md-6">
                    <%= f.text_field  :telephone_employeur ,readonly: @demande_arret_travail.read_only?%>
                  </div>
                </div>
              </div>
            </div>
            
            <div class="modal-footer form-group">
              <%= link_to 'Annuler', (@demande_arret_travail.persisted? ? [:admin, @demande_arret_travail] : admin_arret_travails_path), class: 'btn btn-white' %>
              <% if @demande_arret_travail.meme_agence?(current_user) && @demande_arret_travail.can_update?(current_user)%>
              <%= f.button 'Mettre à jour', class: 'btn btn-primary' %>
            <%end%>
            </div>
          </div>
          <%end%>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
<% if @employeur.nil?%>
  <div class="col-lg-6">
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt>Raison sociale:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.raison_sociale_employeur? ? @demande_arret_travail.raison_sociale_employeur : "indéfini" %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt>N° employeur:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.numero_employeur? ? @demande_arret_travail.numero_employeur : "indéfini" %></dd>
      </div>
    </d1>
    
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt>Adresse employeur:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
       <dd class="mb-1"><%= @demande_arret_travail.adresse_employeur? ? @demande_arret_travail.adresse_employeur : "indéfini" %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt>Téléphone:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.telephone_employeur? ? @demande_arret_travail.telephone_employeur : "indéfini" %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt>Email:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @demande_arret_travail.email_employeur? ? @demande_arret_travail.email_employeur : "indéfini" %></dd>
      </div>
    </d1>
  </div>
  <% else %>
    <div class="col-lg-6">
      <d1 class="row mb-0">
        <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt>Numéro unique:</dt>
        </div>
        <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @employeur.fhnum? ? @employeur.fhnum : "indéfini" %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt>Ancien numéro IPRES:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @employeur.ancien_num_ipres? ? @employeur.ancien_num_ipres : "indéfini" %> </dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt>Ancien numéro CSS:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @employeur.ancien_num_css? ? @employeur.ancien_num_css : "indéfini" %></dd>
      </div>
    </d1>
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt>Raison sociale:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @employeur.fhrsoc? ? @employeur.fhrsoc : "indéfini" %></dd>
      </div>
    </d1>
  
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
