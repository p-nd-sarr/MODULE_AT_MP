<%= bootstrap_form_for(@admin_activite_principale, layout: :horizontal) do |f| %>
  <%= f.collection_select :admin_secteur_activite_id, Admin::SecteurActivite.order('description'), :id, :description %>
  <%= f.text_field :description %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_activite_principales_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
