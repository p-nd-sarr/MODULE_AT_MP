<%= bootstrap_form_for([:admin, @allocataire, @pret_allocataire], layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  <%= f.select :type_pret,
               PretAllocataire::TYPE_PRET.keys.collect { |type_pret| [PretAllocataire.human_enum_name(:type_pret, type_pret), type_pret] },
               include_blank: true, label: 'Type motif' %>

  <%= f.text_area :commentaire , class:'form-control' %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-4">
      <%= link_to 'Annuler', (@pret_allocataire.persisted? ? [:admin, @pret_allocataire] : admin_pret_allocataires_path()), class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
