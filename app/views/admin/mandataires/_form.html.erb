<div class="row">
  <div class="col-sm-8 col-sm-offset-2">
    <div class="ibox-content">
      <%= bootstrap_form_for(@mandataire, layout: :horizontal, label_col: "col-sm-3", control_col: "col-sm-9") do |f| %>
        <%= f.alert_message "Please fix the errors below." %>
        <%= f.text_field :numero_employeur, label: 'Numéro employeur', required: true %>
        <div class="bdge text-right" style="margin-bottom: 3px">
          <span id="employeur_fhrsoc"></span>
        </div>
        <%= f.text_field :prenom, required: true %>
        <%= f.text_field :nom, required: true %>
        <%= f.select :sexe,
                     Admin::Mandataire::SEXE.keys.collect { |sit_mat| [sit_mat, sit_mat] }, label: 'Sexe' %>
        <%= f.text_field :nin, required: true %>
        <%= f.phone_field :telephone, required: true %>
        <%= f.email_field :email, required: true %>

        <div class="hr-line-dashed"></div>

        <div class="form-group row">
          <div class="col-sm-4 col-sm-offset-3">
            <%= link_to 'Annuler', admin_mandataires_path, class: 'btn btn-white' %>
            <%= f.submit 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(document).ready(function () {
          $('#admin_mandataire_numero_employeur').change(function () {
              const fhnum = $('#admin_mandataire_numero_employeur').val();
              const label_to_show = document.getElementById('employeur_fhrsoc')
              $.ajax({
                  url: "/admin/dossier_prestations/employeur/" + fhnum + ".json",
                  method: 'get',
                  dataType: "json",
                  success: function (data) {
                      console.log(data.fhrsoc)
                      if (data && data.fhrsoc !== undefined) {
                          label_to_show.textContent = data.fhrsoc
                          $('#submit_button').attr("disabled", false)
                      } else {
                          label_to_show.textContent = "Raison sociale introuvable"
                          $('#submit_button').attr("disabled", true)
                      }
                  },
                  error: function (XMLHttpRequest, textStatus, errorThrown) {
                      label_to_show.textContent = "Raison sociale introuvable"
                      $('#submit_button').attr("disabled", true)
                  }
              });
          });
      })
  </script>
<% end %>
