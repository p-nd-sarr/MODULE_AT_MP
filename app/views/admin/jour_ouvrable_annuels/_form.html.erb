<%= bootstrap_form_for(@admin_jour_ouvrable_annuel, layout: :horizontal) do |f| %>
    <%= f.select :mois, (1..12).map {|m| I18n.l(DateTime.parse(Date::MONTHNAMES[m]), format: "%B")} %>
    <%= f.select :mois_en_chiffre, 1..12 %>
    <%= f.text_field :annee %>
    <%= f.text_field :nombre_jour_ouvrable %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_jour_ouvrable_annuels_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
