<%= content_for :titre_page, 'Admin Jour Ouvrable Annuels' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_jour_ouvrable_annuel_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
        <th scope="col">Mois</th>
        <th scope="col">Mois en chiffre</th>
        <th scope="col">Année</th>
        <th scope="col">Nombre jour ouvrable</th>
        
        <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_jour_ouvrable_annuels.each do |admin_jour_ouvrable_annuel| %>
    <tr>
                <td><%= admin_jour_ouvrable_annuel.mois %></td>
                <td><%= admin_jour_ouvrable_annuel.mois_en_chiffre %></td>
                <td><%= admin_jour_ouvrable_annuel.annee %></td>
                <td><%= admin_jour_ouvrable_annuel.nombre_jour_ouvrable %></td>
                
            <td style="width: 75px">
        <%= link_to 'détails', admin_jour_ouvrable_annuel, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_jour_ouvrable_annuel_path(admin_jour_ouvrable_annuel), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_jour_ouvrable_annuel, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>