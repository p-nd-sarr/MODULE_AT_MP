<style type="text/css">

    .no-text {
        font-size: 0px;
    }

    .invalid-feedback {
        font-size: 0px;
    }

    select option[disabled] {
        display: none
    }
</style>

<%= bootstrap_form_for(@conjoint, url: admin_conjoint_update_incomplete_path(@conjoint), label_col: "col-sm-4", control_col: "col-sm-4") do |f| %>
  <%= f.alert_message "Veuillez corriger les erreurs ci-dessous." %>

  <div class="content clearfix">
    <h2 class="text-navy" style="font-weight:bold">Informations du conjoint à ajouter</h2>
    <hr>
    <div class="row">
      <div class="form-group" style="align-content: center">
        <div class="col-sm-12">
          <hr>
          <div class="col-sm-6">
            <%= f.text_field :numero_affiliation, label: 'Numéro affiliation' %>
            <span id="num_aff_error" style="display: none; font-size: 12px; color: red; -webkit-text-stroke-width: medium;">Le numéro d'affiliation doit être numérique</span>
          </div>

          <div class="col-sm-6">
            <%= f.text_field :prenom, label: 'Prénom conjoint', required: true %>
          </div>

          <div class="col-sm-6">
            <%= f.text_field :nom, label: 'Nom conjoint', required: true %>
          </div>


          <div class="col-sm-6">
            <%= f.date_field :date_naissance, label: 'Date de naissance',
                             start_year: (Date.today - 100.year).year, end_year: (Date.today - 14.year).year %>
            <div id="alert_age_conjoint" class="alert-danger" style="border-radius: 50px; margin-bottom: 5px; margin-top: 5px;">L'âge
              requis pour se marier n'est pas respecter.
            </div>
          </div>

          <div class="col-sm-6">
            <%= f.date_field :date_mariage, label: "Date de célébration du mariage",
                             start_year: (Date.today - 80.year).year, end_year: Date.today.year %>
          </div>

        </div>

      </div>
      <div class="form-group col-sm-12">
        <hr>
        <div class="col-sm-9"></div>
        <div class="col-sm-3" style="text-align: right;">
          <%= link_to 'Annuler', admin_conjoint_path(@conjoint), class: 'btn btn-white' %>
          <%= f.submit 'Valider', class: 'btn btn-primary', id: 'submit_button' %>
        </div>
      </div>
    </div>
  </div>
<% end %>