<%= bootstrap_form_for(@admin_banque_agence, layout: :horizontal) do |f| %>
  <%= f.collection_select :admin_banque_id, Admin::Banque.order('nom'), :id, :nom, label: 'Banque' %>
  <%= f.text_field :nom, label: "Nom Agence" %>
  <%= f.text_field :code, label: "Code Agence" %>
  <%= f.text_field :bank_branch_id, label: "Bank Branch ID" %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_banque_agences_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
