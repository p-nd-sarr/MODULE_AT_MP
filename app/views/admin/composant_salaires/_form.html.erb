<%= bootstrap_form_for([@admin_composant_salaire], label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  <div class="row">
    <div class="col-lg-12">
    <%= f.alert_message 'aa' %>
      <div class="col-lg-7">
        <%= f.text_field :code %>
        <%= f.text_field :designation %>
        <%= f.check_box :prise_en_compte, label: "Prise en compte" %>

        <div class="hr-line-dashed"></div>

        <div class="form-group row">
          <div class="col-sm-4 col-sm-offset-2">
            <%= link_to 'Annuler', (@admin_composant_salaire.persisted? ? [@admin_composant_salaire] : admin_composant_salaires_path), class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    </div>
  </div>
<% end %>
