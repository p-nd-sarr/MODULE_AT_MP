<%= content_for :titre_page, "Détails composant_salaire" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_composant_salaires_path, class: 'btn btn-white btn-sm' %>
  <%= link_to 'Modifier', edit_admin_composant_salaire_path(@admin_composant_salaire), class: 'btn btn-white btn-sm' %>
  <%= link_to 'Ajouter', new_admin_composant_salaire_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
            <p>
              <strong>Code:</strong>
              <%= @admin_composant_salaire.code %>
            </p>

            <p>
              <strong>Description:</strong>
              <%= @admin_composant_salaire.designation %>
            </p>

            <% unless @admin_composant_salaire.prise_en_compte.nil? %>
              <% if @admin_composant_salaire.prise_en_compte? %>
                Oui
              <% else %>
                Non
              <% end %>
            <% end %>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
