<%= bootstrap_form_for(@admin_convention_collective, layout: :horizontal) do |f| %>
    <%= f.text_field :code %>
    <%= f.text_field :description %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_convention_collectives_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
