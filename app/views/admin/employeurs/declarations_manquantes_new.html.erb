<%= content_for :titre_page, "Ajout déclaration manquante" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', declarations_manquantes_admin_employeurs_path, class: 'btn btn-white btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-sm-12">
      <div class="ibox">
        <div class="ibox-content">
          <%= bootstrap_form_for(@declaration, url: declarations_manquantes_create_admin_employeurs_path, layout: :horizontal) do |f| %>
            <%= f.text_field :numero, label: "Numéro adhérent" %>
            <%= f.text_field :raison_sociale %>
            <%= f.number_field :zone %>
            <%= f.text_field :adresse %>
            <%= f.number_field :exercice %>
            <%= f.select :regime,
                         DeclarationSalaireManquante::REGIME.keys.collect { |regime| [DeclarationSalaireManquante.human_enum_name(:regime, regime), regime] },
                         label: "Régime" %>
            <%= f.text_field :telephone %>
            <%= f.number_field :effectif %>
            <%= f.text_field :code_agence %>

            <div class="hr-line-dashed"></div>

            <div class="form-group row">
              <div class="col-sm-4 col-sm-offset-2">
                <%= link_to 'Annuler', declarations_manquantes_admin_employeurs_path, class: 'btn btn-white' %>
                <%= f.button 'Ajouter', class: 'btn btn-primary' %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>


<style>
    .invalid-feedback {
        color: #a00e0e;
    }
</style>