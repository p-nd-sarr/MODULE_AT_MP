<%= content_for :titre_page do %>
  <h2>Les Déclarations de l'employeur -  <span>ninea : <%= @user.ninea %></span></h2>

<% end %>

<br/>

<div class="wrapper wrapper-content">


  <div class="row" id="declaration_id" >

    <div class="col-sm-12" style="padding-left: 0%">

      <div class="ibox">
        <div class="ibox-title" style="background: #1ab394; color: #fff">
          <h5>Historique des déclarations uniques IPRES-CSS</h5>
          <div class="ibox-tools">
            <a class="collapse-link ">
              <i class="fa fa-chevron-down"style="color: #fff"></i>
            </a>
          </div>
        </div>

        <div class="ibox-content" style="">

          <table class="table table-striped table-bordered table-hover dataTables-example dataTable">
            <tr>
              <td>Periode</td>
              <td>Effectif</td>
              <td>Montant total</td>
              <td>Montant PF</td>
              <td>Montant AT</td>
              <td>Montant RG</td>
              <td>Montant RCC</td>
              <td>Total</td>
              <td>Voir</td>

            </tr>

            <% @declarations.each do |declaration| %>
              <tr>
                <td><%= declaration.periode %></td>
                <td><%= declaration.effectif %></td>
                <td><%= declaration.montant_total %></td>
                <td><%= declaration.montant_pf %></td>
                <td><%= declaration.montant_at %></td>
                <td><%= declaration.montant_rg %></td>
                <td><%= declaration.montant_rcc %></td>
                <td><%= declaration.montant_total %></td>
                <td><%= link_to "Details", employer_declaration_path(declaration)%></td>
              </tr>
            <% end %>
          </table>

        </div>
      </div>
    </div>


    <div class="col-sm-12" style="padding-left: 0%">

      <div class="ibox">
        <div class="ibox-title" style="background: #1ab394; color: #fff">
          <div class="accordion-heading" class="ibox-title" >
            <h5>Historique des déclarations spécifiques IPRES(avant 2020)</h5>
            <div class="ibox-tools">
              <a class="collapse-link ">
                <i class="fa fa-chevron-down"style="color: #fff"></i>
              </a>
            </div>
          </div>
        </div>

        <div  class="ibox-content">
          <table class="table table-striped table-bordered table-hover dataTables-example dataTable">
            <tr>
              <td>Numéro Ipres</td>
              <td>Période</td>
              <td>Regime</td>
              <td>Etat</td>
              <td>Details</td>
            </tr>

            <% @historique_ipres_declarations.each do |declaration| %>
              <tr>
                <td><%= declaration.numero_ipres %></td>
                <td><%= declaration.exercice %></td>
                <td><%= declaration.regime == "1" ? "GENERAL" : "CADRE" %></td>
                <td><%= MissingDeclaration.human_enum_name(:etat, declaration.etat) %></td>
                <td>
                  <button class="btn btn-outline btn-primary btn-xs">Faire la déclaration</button>
                </td>
              </tr>
            <% end %>
          </table>

        </div>
      </div>
    </div>

    <div class="hr-line-dashed"></div>

    <div class="form-group row" style="padding-left: 0%">
      <div class="col-sm-4 col-sm-offset-2">

      </div>
    </div>

  </div>

</div>


