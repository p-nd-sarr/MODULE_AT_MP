<%= content_for :titre_page, 'Admin Type Etablissement Diplomatiques' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_type_etablissement_diplomatique_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
                <th scope="col">Code</th>
                <th scope="col">Description</th>
            <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_type_etablissement_diplomatiques.each do |admin_type_etablissement_diplomatique| %>
    <tr>
                <td><%= admin_type_etablissement_diplomatique.code %></td>
                <td><%= admin_type_etablissement_diplomatique.description %></td>
            <td style="width: 75px">
        <%= link_to 'détails', admin_type_etablissement_diplomatique, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_type_etablissement_diplomatique_path(admin_type_etablissement_diplomatique), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_type_etablissement_diplomatique, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>