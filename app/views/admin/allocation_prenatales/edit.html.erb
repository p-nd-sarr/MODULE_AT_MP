<style type="text/css">

.no-text{
  font-size:0px;
}
.invalid-feedback{
  font-size:0px;
  }
</style>

<%= content_for :titre_page, "Modification Allocation Prenatale #{AllocationPrenatale.human_enum_name(:volet, @allocation_prenatale.volet)}" %>

<%= bootstrap_form_for([:admin, @dossier_prestation, @allocation_prenatale]) do |f| %>

<div class="ibox" style="margin-top:20px;">
  <div class="ibox-content">
    <div class="row">
      <div class="col-lg-8 col-lg-offset-2" >
        <%= f.alert_message 'Erreurs: rappel de la saisie du document à joindre' %>

        <div class="col-sm-6">
          <%= f.date_field :date_visite, label: 'Date de l\'examen chez le médecin', required:true %>
        </div>

        <div class="col-sm-6">
          <%= f.date_field :date_depot, :value => Time.now.strftime('%Y-%m-%d') , label: 'Date de dépot', readonly: true, required:true %>        </div>

        <div class="col-sm-6">
          <%= f.select :volet, @allocation_prenatale.grossesse.volets_eligibles_update.keys.collect { |volet|
            [AllocationPrenatale.human_enum_name(:volet, volet), volet] },
                       label: 'N° Volet', help: "Seul les volets sur la liste sont éligibles pour cette grossesse" %>
        </div>

        <div class="col-lg-12">
            <h4 style="font-weight: bold;">Document *</h4>
            <div class="btn-file">
              <label class= "no-text" >
                <%= f.file_field :document, hide_label: true, label: '.',
                            required: true, id:'label-ext'%>
                <div class="btn btn-success" style="margin-top:-20px; margin-left: 1px;"><span class="fa fa-upload"></span> Choisir un fichier
                </div>
              </label>
              <small id="doc-name"></small>
            </div>

        </div>
        <div class="col-lg-12">
          <%= f.text_area :commentaire, label: 'Commentaire' %>
        </div>

        <div class="form-group col-lg-12">
          <div class="col-lg-3 col-lg-offset-9" style="text-align:right;">
            <%= link_to 'Annuler', admin_dossier_prestation_allocation_prenatales_path(@dossier_prestation), class: 'btn btn-white' %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<% end %>

<% content_for :javascript do %>
  <script type="text/javascript">
    $(document).ready(function(){

      var input=document.getElementById('label-ext');
      var infoArea=document.getElementById('doc-name');
      input.addEventListener('change', showFileName);
      function showFileName(event){
        var input=event.srcElement;
        var fileName=input.files[0].name;
        infoArea.textContent=fileName;
      }
    });
  </script>
<% end %>

