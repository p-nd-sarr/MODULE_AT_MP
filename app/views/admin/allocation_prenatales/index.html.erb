<script>

    $(document).ready(function () {

        $('input:checkbox').removeAttr('checked');

        $("#accept_valide").hide();
        var all_checkboxes = $('#liquiderModal input[type="checkbox"]');

        $(".modal-body").change(function () {

            if (all_checkboxes.length === all_checkboxes.filter(":checked").length) {
                $("#accept_valide").show();
            } else {
                $("#accept_valide").hide();

            }

        });

    });

</script>
