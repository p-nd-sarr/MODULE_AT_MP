                  <%= link_to ' Ajouter demande', new_admin_liquidation_retraite_path, class: 'btn btn-success btn-xs fa fa-plus', style: 'margin-top:15px;' %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="col-lg-4">
