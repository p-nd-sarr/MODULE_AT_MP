<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-8">
      <div class="col-lg-4">
        <%= link_to admin_dossier_prestations_path do %>
          <div class="ibox option_menu" style="box-shadow: 2px 2px 4px #1ab394;">
            <div class="ibox-title">
              <h5>Prestations familiales</h5>
            </div>
            <div class="ibox-content product-box">
              <h2 class="no-margins"><%= DossierPrestation.where(conjoint_id: nil).count %></h2>
              <div class="stat-percent text-success font-bold">
                <%= @total_demande.zero? ? 0 : DossierPrestation.where(conjoint_id: nil).count * 100 / @total_demande %>%
                <i class="fa fa-bolt"></i>
              </div>
              <small>Total demande</small>
              <% if current_user.gestionnaire_compte_allocataire? %>
                <div style="text-align:center">
                  <%= link_to ' Ajouter dossier', new_admin_dossier_prestation_path, class: 'btn btn-success btn-xs fa fa-plus', style: 'margin-top:15px;' %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
      <div class="col-lg-4">
        <%= link_to admin_liquidation_retraites_path do %>
          <div class="ibox option_menu" style="box-shadow: 2px 2px 4px #1ab394;">
