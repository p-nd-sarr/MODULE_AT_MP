    <div class="col-lg-4">
      <div class="ibox">
        <div class="ibox-title">
          <h5>Utilisateurs</h5>
          <span class="label label-success">Total <%= User.count %></span>
        </div>
        <div class="ibox-content">
          <div class="feed-activity-list" style="height:700px; overflow-x:scroll">

            <% for type_profil in User::TYPE_PROFIL.keys.collect %>
              <%= link_to admin_users_path(type_profil: type_profil) do %>
                <div class="feed-element feed_el_h" style="padding:5px;">
                  <small><%= User.human_enum_name(:type_profil, type_profil) %></small>
                  <div class="tooltip-demo">
                    <%= User.try(type_profil).count %>
                    <div class="stat-percent text-warning font-bold" style="margin-left: 10px" data-toggle="tooltip" data-placement="top" title data-original-title="Non activés">
                      <%= User.try(type_profil).count.zero? ? 0 : (User.try(type_profil).count - User.try(type_profil).actifs.count) * 100 / User.try(type_profil).count %>
                      %
                      <i class="fa fa-bolt"></i>
                    </div>
                    <div class="stat-percent text-navy font-bold" data-toggle="tooltip" data-placement="top" title data-original-title="Activés">
                      <%= User.try(type_profil).count.zero? ? 0 : User.try(type_profil).actifs.count * 100 / User.try(type_profil).count %>
                      %
                      <i class="fa fa-bolt"></i>
                    </div>
                  </div>
                </div>
