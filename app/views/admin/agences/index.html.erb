<%= content_for :titre_page, 'Admin Agences' %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_admin_agence_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Type</th>
        <th scope="col">Code</th>
        <th scope="col">Libelle EBS</th>
        <th scope="col">Libelle</th>
        <th scope="col">Code PSRM</th>
        <th colspan="3"></th>
      </tr>
      </thead>

      <tbody>
      <% @admin_agences.each do |admin_agence| %>
        <tr>
          <td><%= admin_agence.type_agence %></td>
          <td><%= admin_agence.code %></td>
          <td><%= admin_agence.description_ebs %></td>
          <td><%= admin_agence.description_prest %></td>
          <td><%= admin_agence.code_psrm %></td>
          <td style="width: 75px">
            <%= link_to 'détails', admin_agence, class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'modifier', edit_admin_agence_path(admin_agence), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'supprimer', admin_agence, method: :delete, data: {confirm: 'En êtes vous sûr?'}, class: 'btn btn-outline btn-danger btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>