<%= content_for :titre_page, 'Admin Type Employeurs' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_admin_type_employeur_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
      <th width="10px">ID</th>
                <th scope="col">Code</th>
                <th scope="col">Description</th>
            <th colspan="2"></th>
    </tr>
    </thead>

    <tbody>
    <% @admin_type_employeurs.each do |admin_type_employeur| %>
    <tr>
      <td><%= link_to "##{admin_type_employeur.id}", admin_type_employeur %></td>
                <td><%= admin_type_employeur.code %></td>
                <td><%= admin_type_employeur.description %></td>
            <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_type_employeur_path(admin_type_employeur), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_type_employeur, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>