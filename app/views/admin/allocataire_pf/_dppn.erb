<div class="row">
  <div class="col-lg-12">
    <div class="row">
      <div class="col-lg-12" style="margin-bottom: 25px">
        <%= link_to 'Ajouter un dossier de prestation', new_admin_dossier_prestation_path, class: 'btn btn-primary btn-sm' %>
      </div>
    </div>
  </div>
</div>

<div class="row" style="margin-top: -50px; min-height: 300px;">
  <div class="col-lg-12">
    <div class="ibox ">
      <div class="ibox-title">
        <h5>Liste des dossiers de prestation de l'allocataire </h5>
        <span> &nbsp;<%= params[:id] %> </span>
        <div class="ibox-tools">
          <a class="collapse-link">
            <i class="fa fa-chevron-up"></i>
          </a>
          <a class="dropdown-toggle" data-toggle="dropdown" href="#">
            <i class="fa fa-wrench"></i>
          </a>
          <ul class="dropdown-menu dropdown-user">
            <li><a href="#" class="dropdown-item">Config option 1</a>
            </li>
            <li><a href="#" class="dropdown-item">Config option 2</a>
            </li>
          </ul>
          <a class="close-link">
            <i class="fa fa-times"></i>
          </a>
        </div>
      </div>
      <div class="ibox-content">

        <div class="tab-content">
          <!--      START liste validé     -->
          <div class="table-responsive" style="margin-top: 20px">
            <table class="table table-striped">
              <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">N° Dossier</th>
                <th scope="col">Allocataire</th>
                <th scope="col">Conjoint(e)</th>
                <th scope="col">Etat</th>
                <th scope="col">Traité le</th>
                <th colspan="3"></th>
              </tr>
              </thead>
              <tbody>
              <% @dossier_prestation_allocataire.each do |dossier_prestation_allocataire| %>
                <tr>
                  <td></td>
                  <td><%= dossier_prestation_allocataire.num_dossier %></td>
                  <td><%= dossier_prestation_allocataire.prenom + ' ' + dossier_prestation_allocataire.nom%></td>
                  <td>
                    <%unless dossier_prestation_allocataire.conjoint.nil? %>
                      <%= dossier_prestation_allocataire.conjoint.prenom + ' ' + dossier_prestation_allocataire.conjoint.nom %>
                    <%end %>
                  </td>
                  <td>
                    <%= DossierPrestation.human_enum_name(:etat, dossier_prestation_allocataire.etat) %>
                  </td>
                  <td>
                    <%unless dossier_prestation_allocataire.date_validation.nil? %>
                      <%= dossier_prestation_allocataire.date_validation %>
                    <%end %>
                  </td>
                  <td style="width: 75px">
                    <%= link_to 'Détails', admin_dossier_prestation_path(dossier_prestation_allocataire), class: 'btn btn-outline btn-primary btn-xs' %>
                  </td>
                </tr>
              <%end %>
              </tbody>
            </table>
          </div>
          <!-- END -->
        </div>
      </div>
    </div>
  </div>
</div>