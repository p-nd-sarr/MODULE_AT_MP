
<div class="wrapper wrapper-content">
  <%= link_to 'Ajouter un conjoint', new_admin_conjoint_path, class: 'btn btn-primary btn-sm' %>
  <%= link_to 'Ajouter un enfant', new_admin_enfant_path, class: 'btn btn-primary btn-sm' %>
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox">
        <div class="ibox-title">
          <h5> Affichage de la liste des conjoints </h5>
          <div class="ibox-tools">
            <a class="collapse-link">
              <i class="fa fa-chevron-up"></i>
            </a>
          </div>
        </div>
        <div class="ibox-content">
          <div class="row">
            <div class="col-lg-12">
              <table class="footable table table-stripped table-hover" data-page-size="8" data-filter="#filter" style="margin-top: 20px;">
                <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Prénom conjoint</th>
                  <th scope="col">Nom conjoint</th>
                  <th scope="col">Date de naissance</th>
                  <th scope="col">Date du mariage</th>
                  <th scope="col">Est Salarié ?</th>
                </tr>
                </thead>

                <tbody>
                <% @conjoints.each do |conjoint| %>
                  <tr>
                    <td></td>
                    <td><%= conjoint.prenom %></td>
                    <td><%= conjoint.nom %></td>
                    <td><%= l conjoint.date_naissance %></td>
                    <td><%= l conjoint.date_mariage %></td>
                    <td><%= state_yes_no conjoint.est_salarie? %></td>
                    <td style="width: 75px">
                      <%= link_to 'Plus de détails', admin_conjoint_path(conjoint), class: 'btn btn-outline btn-primary btn-xs' %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox">
        <div class="ibox-title">
          <h5> Affichage de la liste des enfants </h5>
          <div class="ibox-tools">
            <a class="collapse-link">
              <i class="fa fa-chevron-up"></i>
            </a>
          </div>
        </div>
        <div class="ibox-content">
          <div class="row">
            <div class="col-lg-12">
              <table class="footable table table-stripped table-hover" data-page-size="8" data-filter="#filter" style="margin-top: 20px;">
                <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">Prénom de l'enfant</th>
                  <th scope="col">Nom de l'enfant</th>
                  <th scope="col">Date de naissance</th>
                  <th scope="col">Nom complet conjoint(e)</th>
                  <th colspan="3"></th>
                </tr>
                </thead>

                <tbody>
                <% @enfants.each do |enfant| %>
                  <tr>
                    <td></td>
                    <td><%= enfant.prenom %></td>
                    <td><%= enfant.nom %></td>
                    <td><%= l enfant.date_naissance %></td>
                    <%if enfant.conjoint_id? %>
                      <td><%= enfant.conjoint.full_name %></td>
                    <% end %>
                    <td style="width: 75px">
                      <%= link_to 'Plus de détails', admin_enfant_path(enfant), class: 'btn btn-outline btn-primary btn-xs' %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
