<%= content_for :titre_page do %>
  Détails échéance caisse : #<%= @echeance.id %> <br>
  Période : <%= l @echeance.periode_debut %> - <%= l @echeance.periode_fin %> <br>
  Employeur : <%= @employeur.matric %> <br>
<% end %>

<%= content_for :titre_page_autres_details do %>
  <% unless @employeur.motif_retour.nil? %>
    <strong class="text-info">Dossier retourné </strong>
    <br>
    <strong class="text-info">Motif de retour :</strong>
    <%= @employeur.motif_retour %>
    <br>
  <% end %>
  <br>
  <span>
    <%= link_to 'Liste des états de paiement', admin_echeance_caisse_payment_orders_path(@echeance, @employeur), 'data-turbolinks': false, class: 'btn btn-white btn-sm' %>
    <% if @employeur.bordereau_rempli.attached? %>
      &ensp;&ensp;&ensp;&ensp;
      <span> État de contrôle :
        <a href="<%= url_for(@employeur.bordereau_rempli) %>" class="btn btn-primary btn-sm" target="_blank">
          <i class="fa fa-eye"></i>
        </a>
      </span>
  <% end %>
  </span>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_echeance_caisse_path(@echeance), 'data-turbolinks': false, class: 'btn btn-white btn-xs' %>
  <%= link_to 'Saisie TPS', admin_echeance_caisse_edit_employeur_path(@echeance, @employeur), 'data-turbolinks': false, class: 'btn btn-primary btn-xs' if current_user.gestionnaire_compte_allocataire? %>
  <%= link_to "Visualiser", '#', "data-toggle" => "modal", 'data-target' => '#liquidations-preview', class: 'btn btn-primary btn-xs' if @employeur.can_visualize? %>
  <br>
  <% @employeur.current_state.events.values.each { |event| %>
    <% event = event.first %>
    <% if event.meta[:types_profils].include?(current_user.type_profil.to_sym) %>
      <br>
      <%= link_to event.meta[:label], admin_echeance_caisse_change_statut_employeur_path(@echeance, @employeur, event.name), 'data-turbolinks': false, class: 'btn btn-primary btn-xs' if event.meta[:retour] == false and @employeur.peut_etre_affiche?(@echeance) %>
      <br>
      <%= link_to event.meta[:label], '#', "data-toggle" => "modal", 'data-target' => '#retourner', class: 'btn btn-primary btn-xs' if event.meta[:retour] == true %>
      <%= render 'echeance_employer_back_modal', object: event.name if event.meta[:retour] == true %>
    <% end %>
  <% } %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <div class="row">
      <div class="progressbar-wrapper">
        <ul class="progressbar">
          <li class="<%= ("active") if @employeur.current_state >= :creation %>">Création</li>
          <li class="<%= ("active") if @employeur.current_state >= :liquide %>">Liquidation</li>
          <li class="<%= ("active") if @employeur.current_state >= :liquidation_valide %>">Validation chef d'agence</li>
          <li class="<%= ("active") if @employeur.current_state >= :paiement_valide %>">Validation comptable</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= search_form_for @q, url: request.path do |f| %>
      <div class="row">
        <div class="col-sm-3">
          <%= f.label :num_affiliation_cont, 'Numéro' %>
          <%= f.search_field :num_affiliation_cont, class: 'form-control' %>
        </div>
        <div class="col-sm-3">
          <%= f.label :nin_cont, 'NIN' %>
          <%= f.search_field :nin_cont, class: 'form-control' %>
        </div>
        <div class="col-sm-3">
          <%= f.label :prenom_cont, 'Prénom' %>
          <%= f.search_field :prenom_cont, class: 'form-control' %>
        </div>
        <div class="col-sm-3">
          <%= f.label :nom_cont, 'Nom' %>
          <%= f.search_field :nom_cont, class: 'form-control' %>
        </div>
      </div>

      <div class="hr-line-dashed"></div>

      <%= f.submit class: 'btn btn-primary' %>
    <% end %>

    <br>

    <%= paginate @dossiers %>

    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col" colspan="6"></th>
        <th scope="col" colspan="3" class="text-center">Temps de présence</th>
        <th scope="col" colspan="2"></th>
      </tr>
      <tr>
        <th scope="col">Numéro</th>
        <th scope="col">NIN</th>
        <th scope="col">Prénom</th>
        <th scope="col">Nom</th>
        <th scope="col">Nombre enfants</th>
        <th scope="col">Nombre enfants éligible</th>
        <th scope="col" class="text-center">Mois 1</th>
        <th scope="col" class="text-center">Mois 2</th>
        <th scope="col" class="text-center">Mois 3</th>
        <th scope="col" colspan="2"></th>
      </tr>
      </thead>

      <tbody>
      <% @dossiers.each do |dossier| %>
        <tr>
          <td><%= dossier.num_affiliation %></td>
          <td><%= dossier.nin %></td>
          <td><%= dossier.prenom %></td>
          <td><%= dossier.nom %></td>
          <td><%= dossier.nombre_enfants %></td>
          <td><%= [6, dossier.nombre_total_enfants_eligibles].min %></td>
          <td class="text-center <%= dossier.presence_mois1_valide? ? 'success' : 'warning' %>"><%= dossier.temps_presence_mois1 %></td>
          <td class="text-center <%= dossier.presence_mois2_valide? ? 'success' : 'warning' %>"><%= dossier.temps_presence_mois2 %></td>
          <td class="text-center <%= dossier.presence_mois3_valide? ? 'success' : 'warning' %>"><%= dossier.temps_presence_mois3 %></td>
          <td style="width: 75px">
            <%= link_to 'dossier', admin_dossier_prestation_path(dossier.dossier_prestation_id), target: :_blank, class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'détails', admin_echeance_caisse_dossier_path(@echeance, @employeur, dossier), 'data-turbolinks': false, class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>

    <%= paginate @dossiers %>
  </div>
</div>

<%= render 'admin/echeance_caisses/preview_liquidations_modal' %>

<style>
    .progressbar-wrapper {
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        padding-left: 12%;
    }

    .progressbar li {
        list-style-type: none;
        width: 20%;
        float: left;
        font-size: 10px;
        position: relative;
        text-align: center;
        text-transform: uppercase;
        color: #7d7d7d;
    }

    .progressbar li:before {
        width: 60px;
        height: 60px;
        content: "";
        line-height: 60px;
        border: 2px solid #7d7d7d;
        display: block;
        text-align: center;
        margin: 0 auto 3px auto;
        border-radius: 50%;
        position: relative;
        z-index: 2;
        background-color: #fff;
    }

    .progressbar li:after {
        width: 100%;
        height: 2px;
        content: '';
        position: absolute;
        background-color: #7d7d7d;
        top: 30px;
        left: -50%;
        z-index: 0;
    }

    .progressbar li:first-child:after {
        content: none;
    }

    .progressbar li.active {
        color: #000;
        font-weight: normal;
    }

    .progressbar li.active:before {
        border-color: #1ab394;
        background: #1ab394;
    }

    .progressbar li.active + li:after {
        background-color: #1ab394;
    }

    .progressbar li.active:before {
        background: #1ab394;
        background-size: 60%;
    }

    .progressbar li::before {
        background: #fff;
        background-size: 60%;
    }

    .progressbar {
        counter-reset: step;
    }

    .progressbar li:before {
        content: counter(step);
        counter-increment: step;
    }
</style>
