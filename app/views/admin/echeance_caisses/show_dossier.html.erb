<%= content_for :titre_page do %>
  Détails échéance caisse : #<%= @echeance.id %> <br>
  Période : <%= l @echeance.periode_debut %> - <%= l @echeance.periode_fin %> <br>
  Employeur : <%= @employeur.matric %> <br>
  Salarié : <%= @dossier.num_affiliation %> / <%= @dossier.prenom %> <%= @dossier.nom %> <br> <br>
  <%= link_to "Retirer de l'échéance", admin_echeance_caisse_exclude_from_echeance_path(@echeance, @employeur, @dossier), 'data-turbolinks': false, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-danger btn-xs' if @dossier.can_exclude? %>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_echeance_caisse_employeur_path(@echeance, @employeur), 'data-turbolinks': false, class: 'btn btn-white btn-xs' %>
  <%#= link_to 'Activer paiement individuel', admin_echeance_caisse_set_individual_payment_path(@echeance, @employeur, @dossier), 'data-turbolinks': false, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-primary btn-xs' if @dossier.can_set_individual_payment?(current_user) %>
  <%#= link_to 'Desactiver paiement individuel', admin_echeance_caisse_remove_individual_payment_path(@echeance, @employeur, @dossier), 'data-turbolinks': false, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-primary btn-xs' if @dossier.can_remove_individual_payment?(current_user) %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <div style="font-size: large">
      <b>Montant total : </b> <%= format_cfa @dossier.get_total_amount %> <br>
      <span class="text-danger"><b>Montant payable : </b> <%= format_cfa @dossier.get_validated_amount %></span>
      <br>
      <span class="text-danger"><b>À valider : </b> <%= format_cfa @dossier.get_unvalidated_amount %></span>
      <br>
    </div>
    <div style="float: right">
      <% if @dossier.dossier_prestation.has_beneficiaries? %>
        <span class="text-danger"><b> Paiement individuel hors échéance (bénéficiaires) : </b> <%= state_yes_no @dossier.dossier_prestation.has_beneficiaries? %></span>
      <% end %>
      <% if @dossier.is_individual_payment %>
        <span class="text-danger"><b> Paiement individuel (ordre de paiement individuel) : </b> <%= state_yes_no @dossier.is_individual_payment %></span>
      <% end %>
    </div>
    <br>
    <br>
    <% (1..3).each { |mois| %>
      <h3>Enfants mois <%= mois %>
        (<%= @dossier.time_of_presence_under_limit?(mois) ? 'Temps de présence insuffisant' : 'Temps de présence suffisant' %>
        <%= '/ Ce mois est en de-hors de la période active du salarié' if @dossier.is_retired_salary?(mois) %>
        <%= "/ Cette période correspond au dernier mois d'activité du salarié" if @dossier.is_retired_salary_for_month?(mois) %>
        )
      </h3>
      <table class="table table-bordered table-condensed table-hover">
        <thead>
        <tr>
          <th scope="col">Numéro ordre</th>
          <th scope="col">Prénom</th>
          <th scope="col">Nom</th>
          <th scope="col">Date de naissance</th>
          <th scope="col">Montant</th>
          <th scope="col">Document valide ?</th>
          <th scope="col">payable</th>
          <th scope="col">payé(e)</th>
          <th scope="col">Options</th>
        </tr>
        </thead>

        <tbody>
        <% @enfants.where(mois: mois).each do |enfant| %>
          <tr>
            <td><%= enfant.numero_ordre %></td>
            <td><%= enfant.enfant.prenom %></td>
            <td><%= enfant.enfant.nom %></td>
            <td><%= l enfant.enfant.date_naissance %></td>
            <td class="text-right"><%= format_cfa enfant.montant %></td>
            <td><%= state_yes_no enfant.document_valide? %></td>
            <td><%= state_yes_no (@dossier.check_if_child_can_be_paid(enfant.id, mois)) %></td>
            <td><%= state_yes_no @dossier.is_paid?(enfant.id) %></td>
            <td><%= link_to 'Renouveler pièce', admin_enfant_path(enfant.enfant_id), class: 'btn btn-outline btn-primary btn-xs', target: '_blank' unless enfant.document_valide? %></td>
          </tr>
        <% end %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>