      <div class="ibox float-e-margins">
        <div class="ibox-title">
          <h5>Formulaire de modification</h5>
        </div>
        <div class="ibox-content">
          <%= render 'form', arret_travail_ged: @arret_travail_ged %>
        </div>
      </div>
    </div>
  </div>
</div>