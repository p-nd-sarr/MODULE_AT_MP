<%= content_for :titre_page, 'liste des établissements' %>

<%= content_for :actions_page do %>
    <%= link_to 'Nouvel établissement', new_admin_etablissement_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
     <th>Code</th>
     <th>Nom Etablissement</th>
    <th colspan="2">Actions</th>
    </tr>
    </thead>

    <tbody>
    <% @admin_etablissements.each do |admin_etablissement| %>
    <tr>
      <td><%=admin_etablissement.code %></td>
      <td><%=admin_etablissement.name %></td>
  
      <!--<td style="width: 75px">
        <%= link_to 'détails', admin_etablissement, class: 'btn btn-outline btn-primary btn-xs' %>
      </td> -->
      <td style="width: 75px">
        <%= link_to 'modifier', edit_admin_etablissement_path(admin_etablissement), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', admin_etablissement, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>