<%= bootstrap_form_for(@admin_ville, layout: :horizontal) do |f| %>
  <%= f.collection_select :admin_departement_id, Admin::Departement.all, :id, :designation, label: 'Département', required: true %>
  <%= f.text_field :code %>
  <%= f.text_field :designation %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_villes_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
