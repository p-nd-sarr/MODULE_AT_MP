
  <div class="wrapper wrapper-content">
    <div class="row">
    
          <div class="col-lg-12">
            <div class="col-lg-10" style="text-align: right;">
              <% if @at_rechute.creation? and (current_user.technicien_at? || current_user.technicien_direction_at?) %>
                  <%= link_to ' Modifier', edit_admin_at_rechute_path(@at_rechute), class:"btn btn-outline btn-white fa fa-edit" %>
              <% end %>
            </div>
            <div class="col-lg-6">
  
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-folder"></span> N° Affiliation: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_rechute.arret_travail.try(:numero_affiliation) %>
                </div>
              </d1>

              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-user"></span> Prenom et Nom du salarié: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_rechute.arret_travail.try(:prenom_salarie) %><%= @at_rechute.arret_travail.try(:nom_salarie) %>
                </div>
              </d1>
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-folder"></span> NIN: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_rechute.arret_travail.try(:nin_salarie) %>
                </div>
              </d1>

               <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-folder"></span> Observation: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_rechute.observation %>
                </div>
              </d1>
              <% if @at_rechute.rechute_rejetee?%>
                <d1 class="row mb-0">
                  <div class="col-sm-6 text-sm-right" style="text-align: right;">
                    <dt><span class="fa fa-folder"></span> Motif de rejet: </dt>
                  </div>
                  <div class="col-sm-6 text-sm-left" style="text-align: left;">
                    <dd class="mb-1"><%= @at_rechute.motif %>
                  </div>
                </d1>
              <% end %>
            </div>

             <div class="col-lg-6">
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-folder"></span> N° Sinistre: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_rechute.arret_travail.try(:num_dossier) %>
                </div>
              </d1>
              
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-calendar"></span> Date accident: </dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_rechute.arret_travail.try(:date_accident).strftime("%d-%m-%Y")  %>
                </div>
              </d1>
              
              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-calendar"></span> Date guérison</dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @arret_travail.at_guerison.try(:date_validation).strftime("%d-%m-%Y")  %>
                </div>
              </d1>

              <d1 class="row mb-0">
                <div class="col-sm-6 text-sm-right" style="text-align: right;">
                  <dt><span class="fa fa-calendar"></span> Date de rechute</dt>
                </div>
                <div class="col-sm-6 text-sm-left" style="text-align: left;">
                  <dd class="mb-1"><%= @at_rechute.try(:date_rechute).strftime("%d-%m-%Y")  %>
                </div>
              </d1>
            </div>
          </div>
        </div>
  </div>








