
<div class="wrapper wrapper-content">
<table class="table table-bordered table-condensed table-hover">
  <thead>
  <tr>
    <th scope="col"></th>
    <th scope="col">Montant</th>
  </tr>
  </thead>

  <tbody>
    <tr>
      <td>Salaire annuel</td>
        <td><%= @at_rente_famille.salaire_annuel %></td>
    </tr>
    <tr>
      <td>Nombre de conjoits</td>
        <td><%= @at_rente_famille.nombre_conjoints %></td>
    </tr>
    <tr>
      <td>Nombre d'enfants</td>
      <td><%= @at_rente_famille.nombre_enfants %></td>
    </tr>
    <tr>
      <td>Nombre d'ascendants</td>
      <td>0</td>
    </tr>
    <tr>
      <td>âge à la conversion </td>
      <td><%=@at_rente_famille.age_conversion%> années</td>
    </tr>
    <tr>
      <td>Prix du franc de rente </td>
      <td><%=@at_rente_famille.prix_franc_rente%> </td>
    </tr>
    <tr>
      <td>Ensemble des taux </td>
      <td><%=@at_rente_famille.part_total%> % </td>
    </tr>
  </tbody>
</table>
<ul class="text-danger">
  <li>Cliquez sur detail pour voir le decompte des rentes pour chaque ayant droit</li>
</ul>

  <table class="table table-bordered table-condensed table-hover">
    <thead>
      <tr>
          <th scope="col">Prénom</th>
          <th scope="col">Nom</th>
          <th scope="col">Type</th>
          <th colspan="3">Actions </th>
      </tr>
    </thead>
    <tbody>
      <% @at_rente_famille.at_dossier_reversion_rentes.each do |ayant_droit| %>
        <tr>
          <td><%=ayant_droit.prenom%> </td>
          <td><%=ayant_droit.nom%> </td>
          <td><%=ayant_droit.type_ayant_droit %></td>
          <td style="width: 75px">
            <%= link_to 'détails', admin_at_dossier_reversion_rente_path(ayant_droit), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
