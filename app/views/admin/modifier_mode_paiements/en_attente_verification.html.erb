<%= content_for :titre_page, "Modification mode paiement pour en vérification" %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'admin/modifier_mode_paiements/search' %>
    <%= render "liste_modifier_mode_paiement" %>
  </div>
</div>

<% content_for :javascript do %>
  <script type="text/javascript">
      $(function () {
          $('#action_export').click(function () {
              $('#formulaire_recherche').attr('action', '<%= en_attente_verification_admin_modifier_mode_paiements_path(format: :xlsx) %>')
          })
          $('#action_search').click(function () {
              $('#formulaire_recherche').attr('action', '<%= en_attente_verification_admin_modifier_mode_paiements_path %>')
          })
          $('#formulaire_recherche').submit(function (e) {
              e.preventDefault(); // dont submit multiple times
              this.submit(); // use native js submit

              setTimeout(function () {
                  $('#action_export').prop("disabled", false);
                  $('#action_search').prop("disabled", false);
              }, 500);
          });
      });
  </script>
<% end %>