<%= content_for :titre_page, "Détails Demande modification mode paiement [#{@modifier_mode_paiement.workflow_state}]" %>
<%= content_for :titre_page_autres_details do %>
     <p> <strong>N° Dossier: </strong> <%= @modifier_mode_paiement.numero_dossier%> </p>
     <p><strong>Etat du dossier: </strong>  <span class="text-warning"><%=@modifier_mode_paiement.workflow_state%></span></p>
     <p><strong>Date ouverture: </strong>  <%= @modifier_mode_paiement.created_at.strftime("%d/%m/%Y")%> </p>
     <p><strong>Ouvert par: </strong> <%= @modifier_mode_paiement.ajoute_par.email%> (<%=@modifier_mode_paiement.ajoute_par.type_profil%>)</p>
     <% unless @modifier_mode_paiement.motif.nil? %> 
       <strong>Motif retour du dossier:  </strong> <span class="text-warning"><%= (" #{@modifier_mode_paiement.motif} ") unless @modifier_mode_paiement.motif.nil? %> </span>
      <% end %>
<% end %>

<%= content_for :actions_page do %>
<!-- 
  <%= link_to 'Liste demandes', admin_allocataire_modifier_mode_paiements_path(@allocataire), class: 'btn btn-white btn-sm' %>
 -->
  <!-- Soumission demande  -->
   <% if @modifier_mode_paiement.creation? and (@modifier_mode_paiement.ajoute_par == current_user || current_user.admin?) %>
    <%= link_to 'Modifier', edit_admin_modifier_mode_paiement_path(@modifier_mode_paiement), class: 'btn btn-white btn-sm' %>
    <% if @modifier_mode_paiement.pret_pour_soumission? and current_user.can_allocataire?  %>
      <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#SoumissionModal" id="soumettre_id">Soumettre</button>
    <% end %>
      <%= render 'soumission_form' %>
  <% end %>

    <!-- Changement soumis  -->
    <% if @modifier_mode_paiement.soumis? and current_user.can_instruction? %>
      <%= (link_to "Validation en agence", admin_allocataire_modifier_mode_paiement_soumettre_modification_path(@allocataire, @modifier_mode_paiement), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm')  %>
      <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif">
        RETOUR DOSSIER
      </button>
    <% end %>

      <!-- Validation changement Changement  -->
       <% if @modifier_mode_paiement.modif_soumis? and current_user.chef_service_allocation? %>
          <%= link_to 'Valider',admin_allocataire_modifier_mode_paiement_valider_path(@allocataire, @modifier_mode_paiement), class: 'btn  btn-primary btn-sm' %>
            <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#motif">
                RETOUR DOSSIER
              </button> 
       <% end %>
<% end %>

<div class="wrapper wrapper-content">

  <div class="progressbar-wrapper">
    <ul class="progressbar">
      <li class="<%= ("active") if @modifier_mode_paiement.current_state >= :creation %>">Création</li>
      <li class="<%= ("active") if @modifier_mode_paiement.current_state >= :soumis %>">Soumis au chef agence</li>
      <li class="<%= ("active") if @modifier_mode_paiement.current_state >= :modif_soumis %>">Validation chef agence</li>
      <li class="<%= ("active") if @modifier_mode_paiement.current_state >= :dossier_valide %>">Validation Dossier</li>
    </ul>
  </div>

  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <h4>
            N° affiliation: <%= @modifier_mode_paiement.numero_allocataire %>
          </h4>
          <%unless @modifier_mode_paiement.numero_dossier.nil?%>
          <h4>
            N° dossier: <%= @modifier_mode_paiement.numero_dossier %>
          </h4>
          <% end %>
          <div class="wrapper wrapper-content">
            <ul class="nav nav-tabs">
              <!--                <span class="pull-right small text-muted">1406 Elements</span>-->
              <li class="active"><a data-toggle="tab" href="#tab-1"><i class="fa fa-user"></i>Informations Allocataire
                  <%= '<span class="label label-warning">à valider</span>'.html_safe unless @modifier_mode_paiement.etat_civil_demandeur_valide? %>
                  <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @modifier_mode_paiement.etat_civil_demandeur_valide? %> 
              </a></li>
              <li class=""><a data-toggle="tab" href="#tab-2"><i class="fa fa-folder"></i>Documents
                  <%= '<span class="label label-warning">à valider</span>'.html_safe unless @modifier_mode_paiement.documents_valide? %>
                  <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @modifier_mode_paiement.documents_valide? %> 
              </a></li>
               <li class=""><a data-toggle="tab" href="#tab-3"><i class="fa fa-folder"></i>Modification mode paiement
              </a></li>
              <li class=""><a data-toggle="tab" href="#tab-4"><i class="fa fa-history"></i>Historiques
              </a></li>

            </ul>
            <div class="tab-content">
              <div id="tab-1" class="tab-pane active">
                <div class="full-height-scroll">
                    <br>
                    <% if !@modifier_mode_paiement.etat_civil_demandeur_valide? %>
                      <%= link_to "Je valide les informations sur l'état civil", admin_allocataire_modifier_mode_paiement_valider_etat_civil_demandeur_path(@allocataire, @modifier_mode_paiement), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
                      <hr>
                    <% end %>
                    <%= render 'show_etat_civil' %>
                  </div>
              </div>
              <div id="tab-2" class="tab-pane">
                <div class="full-height-scroll">
                 <br>
                  <% if !@modifier_mode_paiement.documents_valide? %>
                    <%= link_to "Je valide tous les documents", admin_allocataire_modifier_mode_paiement_valider_documents_path(@allocataire, @modifier_mode_paiement), 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm' %>
                    <hr>
                  <% end %>
                  <%= render 'show_documents' %>
                  <br>
                </div>
              </div>
              <div id="tab-3" class="tab-pane">
                <div class="full-height-scroll">
                  <%= render 'show_tableau_recapitulatif' %>
                  <br>
                </div>
              </div>
              <div id="tab-4" class="tab-pane">
                <div class="full-height-scroll">
                  <%= render 'show_historiques' %>
                  <br>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Retour du dossier de liquidation -->
  <div class="modal inmodal" id="motif" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog">
      <div class="modal-content animated bounceInRight">
        <div class="modal-header">
          <button type="button" class="close" data-dismiss="modal">
            <span aria-hidden="true">x</span>
            <span class="sr-only">Close</span>
          </button>
          <h4 class="modal-title">Motif du retour de la demande de remboursement</h4>
          </div>
            <%= bootstrap_form_for(@modifier_mode_paiement, url: admin_allocataire_modifier_mode_paiement_retourner_process_path(@allocataire,@modifier_mode_paiement)) do |f| %>
          <div class="modal-body">
            <%= f.text_area :motif, label: 'Motif' %>
          </div>
          <div class="modal-footer form-group">
            <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
            <%= f.button 'Retourner Dossier', class: 'btn btn-primary' %>
          </div>
          <%end%>
        </div>
    </div>
  </div>
  <!-- Fin retour dossier -->
 
</div>

<style>
  .progressbar-wrapper {
    width: 100%;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 12%;
  }

  .progressbar li {
    list-style-type: none;
    width: 20%;
    float: left;
    font-size: 10px;
    position: relative;
    text-align: center;
    text-transform: uppercase;
    color: #7d7d7d;
    margin-bottom: 20px;
  }

  .progressbar li:before {
    width: 60px;
    height: 60px;
    content: "";
    line-height: 60px;
    border: 2px solid #7d7d7d;
    display: block;
    text-align: center;
    margin: 0 auto 3px auto;
    border-radius: 50%;
    position: relative;
    z-index: 2;
    background-color: #fff;
  }

  .progressbar li:after {
    width: 100%;
    height: 2px;
    content: '';
    position: absolute;
    background-color: #7d7d7d;
    top: 30px;
    left: -50%;
    z-index: 0;
  }

  .progressbar li:first-child:after {
    content: none;
  }

  .progressbar li.active {
    color: #000;
    font-weight: normal;
  }

  .progressbar li.active:before {
    border-color: #1ab394;
    background: #1ab394;
  }

  .progressbar li.active + li:after {
    background-color: #1ab394;
  }

  .progressbar li.active:before {
    background: #1ab394;
    background-size: 60%;
  }

  .progressbar li::before {
    background: #fff;
    background-size: 60%;
  }

  .progressbar {
    counter-reset: step;
  }

  .progressbar li:before {
    content: counter(step);
    counter-increment: step;
  }
</style>