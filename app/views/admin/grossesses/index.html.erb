<%= content_for :titre_page, "Enfants" %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_salarie_enfant_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <% @enfants.each do |enfant| %>
      <div class="col-lg-3">
        <div class="contact-box center-version">

          <%= link_to [:salarie, enfant] do %>
            <h3 class="m-b-xs"><strong><%= enfant.full_name %></strong></h3>
            <br>
            <p>
              Né le <%= l enfant.date_naissance %> <br>
              Mère : <%= enfant.prenom_mere %> <%= enfant.nom_mere %> <br>
              Père : <%= enfant.prenom_pere %> <%= enfant.nom_pere %> <br> <br>
              <span class='label label-info'><%= Enfant.human_enum_name(:etat, enfant.etat) %></span> <br>
            </p>
          <% end %>
          <div class="contact-box-footer">
            <div class="m-t-xs btn-group">
              <% if enfant.can_be_edited? %>
                <%= link_to 'modifier', edit_salarie_enfant_path(enfant), class: 'btn btn-outline btn-primary btn-xs' %>
              <% end %>
              <% if enfant.can_be_edited? %>
                <%= link_to 'supprimer', [:salarie, enfant], method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
              <% end %>
            </div>
          </div>

        </div>
      </div>
    <% end %>
  </div>


