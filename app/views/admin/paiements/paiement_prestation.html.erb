<div class="container" style="float: initial">
  <div class="row" style="margin-top: 10px; padding: 5%; border: #1e0fbe;">
    <div class="col col-lg-6" style="float: left;">
      <p>Institution de Prévoyance Retraite du Sénégal</p>
      <p>I.P.R.E.S</p>
      <p>22, Avenue Léopold Sédar Senghor</p>
      <p><img style="width: 100px; height: 100px; border-radius: 100%"
              src="data:image/png;base64," alt="">
      </p>
    </div>
    <div class="col col-lg-6" style="float: right;">
      <p>Caisse de Sécurité Sociale</p>
      <p>C.S.S</p>
      <p>Place de l'OIT, Colobane</p>
      <p><img style="width: 100px; height: 100px; border-radius: 100%"
              src="data:image/jpeg;base64," alt="">
      </p>
    </div>
  </div>
  <h2 style="float: initial; text-align: center">ORDRE DE PAIEMENT</h2>
</div>

<div class="container" style="float: initial">
  <div class="row">
    <div class="col col-lg-6" style="float: left;">
      <h4>Référence Paiement : <%= @paiement.id %>/<%= @paiement.code %></h4>
      <h4>Emission le : <%= l @paiement.date_generation %></h4>
    </div>
    <div class="col col-lg-6" style="float: right;">
      <h4>Nom : <%= @paiement.allocataire.nom %></h4>
      <h4>Prenom : <%= @paiement.allocataire.prenom %></h4>
      <h4>Nom Conjoint : <%= @paiement.dossier_prestation.conjoint.nom %></h4>
      <h4>Prenom Conjoint : <%= @paiement.dossier_prestation.conjoint.prenom %></h4>
      <h4>Numéro allocataire : <%= @paiement.allocataire.numero_allocataire %></h4>
      <h4>Numéro dossier : <%= @paiement.dossier_prestation.num_dossier %></h4>
    </div>

  </div>

</div>

<div class="container" style="margin-top: 0px;">

  <div style="margin-top: 0px; margin-left: 2%">
    <table class="table no-borders no-top-border">
      <tr>
        <td style="font-size: 1.5em;">Montant Total à Payer</td>
        <td style="font-size: 1.5em"><%= @paiement.montant_brut.round(0) %></td>
      </tr>
    </table>
    <% unless @prestation_prenatales.empty? %>
      <h3>Prestations Prénatales</h3>
      <table class=" table" style="font-size: 12px">
        <thead>
        <tr>
          <th scope="col">Volet</th>
          <th scope="col">Date liquidation</th>
          <th scope="col">Date validation</th>
          <th scope="col">Montant</th>

        </tr>
        </thead>

        <tbody>

        <% @prestation_prenatales.each do |allocation| %>
          <tr>
            <td><%= AllocationPrenatale.human_enum_name(:volet, allocation.volet) %></td>
            <td>
              <% unless allocation.date_soumission.nil? %>
                <%= l allocation.date_soumission %>
              <% end %>
            </td>
            <td>
              <% unless allocation.date_validation.nil? %>
                <%= l allocation.date_validation %>
              <% end %>
            </td>
            <td><%= allocation.montant_paiement %></td>

          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>


    <% unless @prestation_postnatales.empty? %>
      <h3>Prestations Postnatales</h3>
      <table class=" table" style="font-size: 12px">
        <thead>
        <tr>
          <th scope="col">Volet</th>
          <th scope="col">Date liquidation</th>
          <th scope="col">Date validation</th>
          <th scope="col">Montant</th>

        </tr>
        </thead>

        <tbody>

        <% @prestation_postnatales.each do |allocation| %>
          <tr>
            <td><%= AllocationPostnatale.human_enum_name(:volet, allocation.volet) %></td>
            <td>
              <% unless allocation.date_soumission.nil? %>
                <%= l allocation.date_soumission %>
              <% end %>
            </td>
            <td>
              <% unless allocation.date_validation.nil? %>
                <%= l allocation.date_validation %>
              <% end %>
            </td>
            <td><%= allocation.montant_paiement %></td>

          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>

    <% unless @prestation_familiales.empty? %>
      <h3>Prestations Familiales</h3>
      <table class="table table-bordered table-condensed table-hover" style="font-size: 12px">
        <thead>
        <tr>
          <th scope="col">Volet</th>
          <th scope="col">Date liquidation</th>
          <th scope="col">Date validation</th>
          <th scope="col">Montant</th>

        </tr>
        </thead>

        <tbody>

        <% @prestation_familiales.each do |allocation| %>
          <tr>
            <td><%= AllocationFamiliale.human_enum_name(:volet, allocation.volet) %></td>
            <td>
              <% unless allocation.date_soumission.nil? %>
                <%= l allocation.date_soumission %>
              <% end %>
            </td>
            <td>
              <% unless allocation.date_validation.nil? %>
                <%= l allocation.date_validation %>
              <% end %>
            </td>
            <td><%= allocation.montant_paiement %></td>

          </tr>
        <% end %>
        </tbody>
      </table>
    <% end %>

  </div>

</div>