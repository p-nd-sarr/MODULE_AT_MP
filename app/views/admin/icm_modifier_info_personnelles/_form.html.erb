<%= bootstrap_form_for([:admin, @dossier_maternite, @icm_modifier_info_personnelle]) do |f| %>
<%= f.alert_message "Une erreur est survenue lors de l'enregistrement" %>
 <div class="row">
   

      <div class="col-lg-12" style="margin-top: 20px" id="subrogation_oui">
        <div class="content clearfix">
          <h3 class="text-navy" style="font-weight:bold">Informations Salarié</h3>
          <hr>
          <div class="row">
                <div class="col-lg-4">
                <%= f.text_field :prenom, label: "Prénom",  value: @dossier_maternite.prenom,  required: true %>
                </div>
               
                <div class="col-lg-4">
                <%= f.text_field :nom, label: "Nom", value: @dossier_maternite.nom, required: true %>
                </div>

                 <div class="col-lg-4">
                <%= f.text_field :sexe, label: "Sexe",value: @dossier_maternite.sexe_salarie, required: true %>
                </div>
                <div class="col-lg-4">
                <%= f.select :type_piece,
                                DossierMaternite::TYPE_PIECE.keys.collect { |type_piece| [DossierMaternite.human_enum_name(:type_piece, type_piece), type_piece] },
                                label: "Type de pièce", required: true %>
                </div>

                <div class="col-lg-4">
                <%= f.text_field :nin, label: 'N° Identification', value: @dossier_maternite.nin %>
                </div>
                <div class="col-lg-4">
                <%= f.date_field :date_naissance, label: "Date de naissance", value: @dossier_maternite.date_naissance%>
                </div>
                <div class="col-lg-4">
                <%= f.text_field :lieu_naissance, label: "Lieu de naissance", value: @dossier_maternite.lieu_naissance %>
                </div>

                <div class="col-lg-4">
                <%= f.email_field :email, label: 'Email', value: @dossier_maternite.email %>
                </div>
                <div class="col-lg-4">
                <%= f.phone_field :telephone, label: 'Téléphone',value: @dossier_maternite.telephone, help: "spécifiez l'indicatif du pays (ex: 221770000000)" %>
                </div>
                <div class="col-lg-4">
                <%= f.text_field :adresse_domicile, value: @dossier_maternite.adresse_domicile %>
                </div>
                <div class="col-lg-4">
                    <%= f.select :mode_paiement,
                        MODE_PAIEMENT_CAISSE_CSS.keys.collect { |mode_paiement| [DossierMaternite.human_enum_name(:mode_paiement, mode_paiement), mode_paiement] },
                        include_blank: true, label: 'Mode de paiement' %>
                </div>
                <div class="col-lg-4">
                    <%= f.date_field :debut_grossesse, label: "Date début grossesse (approximative)", value: @dossier_maternite.debut_grossesse %>
                </div>
            </div>
          </div>
        </div>

    <div class="form-group col-lg-12">
      <hr>
      <div class="col-lg-4 col-lg-offset-8" style="text-align:right">
        <%= link_to 'Annuler', (@dossier_maternite.persisted? ? [:admin, @dossier_maternite] : admin_dossier_maternites_path), class: 'btn btn-danger' %>
        <%= f.button 'Enregistrer', class: 'btn btn-primary', id: 'submit_button' %>
      </div>
    </div>
  </div>
<% end %>