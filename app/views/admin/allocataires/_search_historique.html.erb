<%= search_form_for @q, url: request.path do |f| %>

  <div class="row">
    <div class="col-sm-3">
      <%= f.label :allocataire_numero_allocataire_cont, 'Numéro allocataire' %>
      <%= f.search_field :allocataire_numero_allocataire_cont, class: 'form-control' %>
    </div>

    <div class="col-sm-3">
      <%= f.label :created_at_gteq, 'Ajouté le >=' %>
      <%= f.date_field :created_at_gteq, class: 'form-control' %>
    </div>

    <div class="col-sm-3">
      <%= f.label :created_at_lteq, 'Ajouté le <' %>
      <%= f.date_field :created_at_lteq, class: 'form-control' %>
    </div>

  </div>

  <div class="hr-line-dashed"></div>

  <%= f.submit class: 'btn btn-primary' %>
<% end %>