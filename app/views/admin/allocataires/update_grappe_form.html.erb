<%= content_for :titre_page, "Déclaration de  d'un conjoint " %>

<div class="wrapper wrapper-content">

 <%= bootstrap_form_for(@update_grappe_familiale, url: admin_allocataire_sousmettre_grappe_familiale_path(params[:allocataire_id])) do |f| %>
  <div class="ibox ">
    <div class="ibox-title">
      <h5 style="text-decoration: underline;"> Ajouter une demande de <%=@etat%> </h5>
      <div class="ibox-tools">
         
      </div>
    </div>
    <div class="ibox-content">
      <div class="row">
      <% if @etat=="divorce" %>
        <div class="col-sm-6 b-r">
  
          <%= f.hidden_field :conjoint_id %>
          <%= f.text_field :prenom %>
          <%= f.text_field :nom %>
          <%= f.date_select :date_deces, label: "Date de divorce",
                            start_year: (Date.today - 65.year).year, end_year: (Date.today - 18.year).year %>
          <%= f.text_field :lieu_deces, label: "Lieu de divorce" %>
           <%=hidden_field_tag 'etat', @etat %>
      
           <%= f.file_field :attachment, label: "Certificat de divorce", required: true %>
            

        </div>
        <% else %>
        

        
        <div class="col-sm-6 b-r">

          <% if @type=="conjoint" %>
             <%= f.hidden_field :conjoint_id %>
           <% end %>
          <% if @type=="enfant" %>
             <%= f.hidden_field :enfant_id %>
          <% end %>

          <%= f.text_field :prenom %>
          <%= f.text_field :nom %>
          <%= f.date_select :date_deces, label: "Date de décés",
                            start_year: (Date.today - 65.year).year, end_year: (Date.today - 18.year).year %>
          <%= f.text_field :lieu_deces, label: "Lieu de décés" %>
          <%=hidden_field_tag 'etat', @etat %>
           <%= f.file_field :attachment, label: "Certificat de décés", required: true %>
            

        </div>
        <% end %>
        <div class="col-sm-6"><h4>Vous avez besoin d'éclairessissements ?</h4>
          <p>Retour à la page d'informations</p>
          <p class="text-center">
            <a href=""><i class="fa fa-sign-in big-icon"></i></a>
          </p>
        </div>
      </div>
    </div>
  </div>


  <div class="row">
    <div class="col-sm-6">

    </div>
  </div>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler',  class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>

</div>