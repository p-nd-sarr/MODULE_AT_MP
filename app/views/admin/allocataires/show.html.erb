                    </div>
                  </ul>
                </div> <!-- dropdown -->
              </div> <!-- end col-lg-3 -->
            </div>
            <div class="row">
              <div class="col-lg-12">
                <ul class="nav nav-tabs">
                  <li class="active"><a data-toggle="tab" href="#tab-1"><i class="fa fa-user"></i>Etat Civil

