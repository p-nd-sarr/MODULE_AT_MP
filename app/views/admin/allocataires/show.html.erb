<%= content_for :titre_page, "Détails Allocataire" %>
<%= content_for :titre_page_autres_details do %>
  N° Allocataire : <%= @allocataire.numero_allocataire %> <br>
  Type Allocataire : <%= @allocataire.categorie %> <br>
  Arrondi en cours : <%= format_cfa @allocataire.arrondi_en_cours %> <br>
  <% if @allocataire.actif? %>
    <%= link_to "<i class='fa fa-file-pdf-o'></i> Carte allocataire".html_safe, admin_allocataire_imprimer_carte_allocataire_path(@allocataire, format: :pdf), class: 'btn btn-outline btn-default btn-xs', target: :_blank %>
  <% end %>

  <% if not @allocataire.motif_rejet.nil? and @allocataire.inactif? %>
    <h3 style="color: red"> <u>Motif rejet allocataire: </u></h3>
    <div class="rejet_allocataire">
      <p class="text-warning"><%= (" #{@allocataire.motif_rejet} ") unless @allocataire.motif_rejet.nil? %> </p>
    </div>
  <% end %>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Liste des allocataires', admin_allocataires_path, class: 'btn btn-white btn-sm' %>
  <% if @allocataire.retraite? %>
    <% if @allocataire.base_reversion.nil? %>
      <% if current_user.gestionnaire_compte_allocataire? %>
        <%= (link_to 'Créer base de réversion', new_admin_allocataire_base_reversion_path(@allocataire), class: 'btn btn-success btn-sm') if current_user.gestionnaire_compte_allocataire? %>
      <% end %>
    <% else %>
      <%= (link_to 'Base de reversion', admin_allocataire_base_reversions_path(@allocataire), class: 'btn btn-success btn-sm') %>
    <% end %>
  <% end %>

  <% if @allocataire.veuve? %>
    <% unless @allocataire.base_reversion.nil? %>
      <%= (link_to 'Base de reversion', admin_allocataire_base_reversions_path(@allocataire), class: 'btn btn-success btn-sm') %>
    <% end %>
  <% end %>

  <% unless @allocataire.liquidation_retraite.nil? %>
    <%= (link_to 'Dossier liquidation', admin_liquidation_retraite_path(@allocataire.liquidation_retraite), class: 'btn btn-success btn-sm') %>
  <% end %> <br><br>

  <% unless @allocataire.dossier_reversion_salary.nil? %>
    <%= (link_to 'Dossier Reversion', admin_dossier_reversion_salary_path(@allocataire.dossier_reversion_salary), class: 'btn btn-info btn-sm') %>
  <% end %>
  <% unless @allocataire.reversion_veuve.nil? %>
    <%= (link_to 'Dossier Reversion', admin_allocataire_reversion_veuve_path(@allocataire.reversion_veuve.allocataire.id, @allocataire.reversion_veuve.id), class: 'btn btn-info btn-sm') %>
  <% end %>

  <% if @allocataire.inactif? and current_user.directeur_prestation? %>
    <td style="width: 75px">
      <%= (link_to 'valider', admin_allocataire_valider_path(@allocataire), class: 'btn btn-success btn-sm') if current_user.directeur_prestation? %>
    </td>
    <td style="width: 75px">
      <% if current_user.directeur_prestation? %>
        <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#rejet_rejet_allocataire">Rejeter
        </button>

        <%#= link_to 'rejeter', admin_allocataire_rejeter_allocataire_path(@allocataire), method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      <% end %>
    </td>
  <% end %>

  <% if @allocataire.valider? and current_user.inspection? %>
    <td style="width: 75px">
      <%= (link_to 'valider', admin_allocataire_activer_path(@allocataire), class: 'btn btn-success btn-sm') %>
    </td>
    <td style="width: 75px">
        <button type="button" class="btn btn-danger btn-sm" data-toggle="modal" data-target="#rejet_rejet_allocataire">Rejeter
        </button>

        <%#= link_to 'rejeter', admin_allocataire_rejeter_allocataire_path(@allocataire), method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
    </td>
  <% end %>

<% end %>

<div class="wrapper wrapper-content">
