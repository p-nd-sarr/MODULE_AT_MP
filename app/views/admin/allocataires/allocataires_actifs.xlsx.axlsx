wb = xlsx_package.workbook
wb.add_worksheet(name: "Allocataires actifs") do |sheet|
  title = wb.styles.add_style(b: true, bg_color: "395870", fg_color: "FFFFFF",
                              alignment: {horizontal: :center})
  sheet.add_row [
    "Numéro allocataire",
    "Numéro dossier", 
    "Prénom", 
    "Nom", 
    "Sexe",
    "Téléphone",
    "Email",
    "Etat",
    "Association",
    "regime",
    "date_suspension",
    "motif_suspension",
    "date_eteint",
    "date_soumission",
    "Date de naissance",
    "Lieu de naissance",
    "type_piece_identification",
    "numero_identification_nationale",
    "situation_matrimoniale_code",
    "type_etat_civil",
    "nombre_epouses",
    "nombre_enfants",
    "nombre_enfant_veuve",
    "trimestre_sorti_enfant1",
    "trimestre_sorti_enfant2",
    "trimestre_sorti_enfant3",
    "Mode de paiement",
    "Agence",
    "Numéro compte bancaire",
    "Date de cessation",
    "age_revolu",
    "moyenne_rg",
    "mois_gratuis_rg",
    "points_rg",
    "points_base_rg",
    "pourcentage_minoration_rg",
    "point_minoration_rg",
    "pourcentage_majoration_rg",
    "point_majoration_rg",
    "points_complementaires_rg",
    "points_servis_rg",
    "montant_brut_rg",
    "montant_imposable_rg",
    "moyenne_rc",
    "mois_gratuis_rc",
    "points_rc",
    "points_base_rc",
    "pourcentage_minoration_rc",
    "point_minoration_rc",
    "pourcentage_majoration_rc",
    "point_majoration_rc",
    "points_complementaires_rc",
    "points_servis_rc",
    "montant_brut_rc",
    "montant_imposable_rc",
    "montant_net",
    "montant_minimum_fiscal",
    "montant_igr",
    "montant_rappel",
    "montant_premier_paiement",
    "versement_unique",
    "Date de jouissance",
    "moyenne",
    "mois_gratuis",
    "numero_employeur",
    "adress_employeur"
    
 ], style: title

  @allocataires.each do |allocataire|
    sheet.add_row [
      allocataire.numero_allocataire, 
      allocataire.numero_dossier, 
      allocataire.prenom, 
      allocataire.nom, 
      allocataire.sexe, 
      allocataire.telephone, 
      allocataire.email, 
      allocataire.etat_human, 
      allocataire.admin_association_allocataire.try(:name),
      allocataire.regime, 
      allocataire.date_suspension,
      allocataire.motif_suspension,
      allocataire.date_eteint,
      allocataire.date_soumission,
      allocataire.date_naissance, 
      allocataire.lieu_naissance,
      allocataire.type_piece_identification_id,
      allocataire.numero_identification_nationale,
      allocataire.situation_matrimoniale_code,
      allocataire.type_etat_civil_id,
      allocataire.nombre_epouses,
      allocataire.nombre_enfants,
      allocataire.nombre_enfant_veuve,
      allocataire.trimestre_sorti_enfant1,
      allocataire.trimestre_sorti_enfant2,
      allocataire.trimestre_sorti_enfant3,
      allocataire.mode_paiement_human, 
      allocataire.admin_agence.try(:description_prest),
      allocataire.compte_bancaire_numero_compte,
      allocataire.date_cessation,
      allocataire.age_revolu,
      allocataire.moyenne_rg,
      allocataire.mois_gratuis_rg,
      allocataire.points_rg,
      allocataire.points_base_rg,
      allocataire.pourcentage_minoration_rg,
      allocataire.point_minoration_rg,
      allocataire.pourcentage_majoration_rg,
      allocataire.point_majoration_rg,
      allocataire.points_complementaires_rg,
      allocataire.points_servis_rg,
      allocataire.montant_brut_rg,
      allocataire.montant_imposable_rg,
      allocataire.moyenne_rc,
      allocataire.mois_gratuis_rc,
      allocataire.points_rc,
      allocataire.points_base_rc,
      allocataire.pourcentage_minoration_rc,
      allocataire.point_minoration_rc,
      allocataire.pourcentage_majoration_rc,
      allocataire.point_majoration_rc,
      allocataire.points_complementaires_rc,
      allocataire.points_servis_rc,
      allocataire.montant_brut_rc,
      allocataire.montant_imposable_rc,
      allocataire.montant_net,
      allocataire.montant_minimum_fiscal,
      allocataire.montant_igr,
      allocataire.montant_rappel,
      allocataire.montant_premier_paiement,
      allocataire.versement_unique,
      allocataire.date_jouissance,
      allocataire.moyenne,
      allocataire.mois_gratuis,
      allocataire.numero_employeur,
      allocataire.adress_employeur,
 ]
  end
end