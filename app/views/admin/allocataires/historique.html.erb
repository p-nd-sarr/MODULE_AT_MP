<div class=" body-small pace-done">
  <div id="wrapper">
  <div class="row wrapper border-bottom white-bg page-heading">
    <div class="col-lg-10">
      <h2>
        Historique de l'allocataire <%= @allocataire.numero_allocataire %>
      </h2>
    </div>
  </div>
    <div class="col-lg-12">
      <div class="ibox ">
        <div class="ibox-title">
          <h5> Historique </h5>
        </div>
        <div class="ibox-content table-responsive">
          <table class="table table-hover no-margins">
            <thead>
            <tr>
              <th scope="col"> Evenement </th>
              <th scope="col"> Etat dossier </th>
              <th scope="col"> Date </th>
              <th scope="col"> Fait par </th>
            </tr>
            </thead>
            <tbody>
            <% @historique.each do |historique| %>
              <tr>
               <% if historique.evenement? %>
                  <td><small> <%= historique.evenement %> </small></td>
                <% end %>
                <% if historique.etat? %>
                  <td><small><%= Historique.human_enum_name(:etat, historique.etat) %></small></td>
                <% end %>
                <% if historique.date_soumission? %>
                  <td><i class="fa fa-clock-o"></i> <%= historique.date_soumission.strftime("%d/%m/%Y")  %> </td>
                <% elsif historique.date_suspension? %>
                  <td><i class="fa fa-clock-o"></i> <%= historique.date_suspension.strftime("%d/%m/%Y")  %> </td>
                <% elsif historique.date_lever_suspension? %>
                  <td><i class="fa fa-clock-o"></i> <%= historique.date_lever_suspension.strftime("%d/%m/%Y")  %> </td>
                <% end %>
                <% if historique.user_id? %>
                  <td> <%= historique.user.prenom  %> <%= historique.user.nom  %> </td>
                <% end %>
              </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
</div>
</div>