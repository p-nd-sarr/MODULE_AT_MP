

<!DOCTYPE html>
<html>
<head>
  <style>
    .contenu {
        padding: 20px;
        width: 100%;
        text-align: left;
        margin-left: 5%;
    }
    .num_cat{
        padding: 20px;
        width: 100%;
    }
    .paiement{
      margin-left: 5%;
      width: 100%;
      padding: 20px;    
    }

    .num_dossier{
    margin-left: 10%;
     margin-top: 30px;
      width: 100%;
      padding: 20px;
    }


    .title{
      width: 100%;
      font-weight: bold;
      
    }
    table, tr {border:hidden;}
    td, th {border:hidden;}
    tr{
      margin-bottom: 20px;
    }
  </style>
</head>
  <body>
    <div class="container" style="font-size:18px;padding-top: 50px;">
      <table class="table  table-condensed table-hover border">
        <tbody>
          <tr>
            <td>
              <div class="title"></div>
              <div class="num_cat" style="padding-left: 20%"> <%= @allocataire.numero_allocataire %> </div>
            </td>
            <td>
              <div class="title"></div>
              <div class="num_cat" style="margin-right: 50px;"> <%= @allocataire.regime=="general" ? "RETRAITE R.G.R" : "RETRAITE R.C.R" %> </div>
            </td>
          </tr>
          <tr>
            <td colspan="2">
            <div class="title"></div>
              <div class="contenu" style="margin-bottom: 10px;"> <%= @allocataire.prenom %> <%= @allocataire.nom %> </div>
            </td>
          </tr>
          <tr>
            <td colspan="2">
              <div class="title"></div>
              <div class="contenu" style="margin-bottom: 10px;">
                <p>
                    </strong> <%= @allocataire.adresse_ville %></strong>
                    </strong> <%= @allocataire.adresse_rue %></strong> 
                    </strong> <%= @allocataire.adresse_domicile %></strong>
                  </p>
              </div>
            </td>
          </tr>
          <tr>
             <td colspan="2">
              <div class="title"></div>
              <div class="paiement">
                <d1 class="row mb-0">
                  <p>
                    </strong> <%= @allocataire.try(:mode_paiement_human) %></strong>
                  </p>
                </d1>
                <d1 class="row mb-0">
                  <div class="col-sm-12" style="font-size: 11px; color: rgb(50, 50 50);">
                    <% if @allocataire.virement? %>
                      <div class="notes">
                        <p><strong style="font-style: italic;" class="text-info">Nom de la banque
                          :</strong> <%= @allocataire.try(:admin_banque_agence).try(:nom) %></p>
                        <p><strong style="font-style: italic;" class="text-info">Numéro compte bancaire
                          :</strong> <%= @allocataire.compte_bancaire_numero_compte %></p>
                        <p><strong style="font-style: italic;" class="text-info">Code SWIFT
                          :</strong> <%= @allocataire.admin_banque_agence.try(:admin_banque).try(:code_swift) %></p>
                        <p><strong style="font-style: italic;" class="text-info">RIB
                          :</strong> <%= @allocataire.compte_bancaire_cle_rib %></p>
                        <hr>
                        <p><strong style="font-style: italic;" class="text-info">REPRISE - Code Banque
                          :</strong> <%= @allocataire.old_code_banque %></p>
                        <p><strong style="font-style: italic;" class="text-info">REPRISE - Compte Banque
                          :</strong> <%= @allocataire.old_compte_banque %></p>
                      </div>
                    <% end %>

                  </div>
                </d1>
                <% if @allocataire.mandant_postal? %>
                <d1 class="row mb-0">
              
                    <p><strong style="font-style: italic;" class="text-info">ADRESSE DOMICILE
                      :</strong> <%= @allocataire.adresse_domicile %></strong>
                    </p>
                    <p><strong style="font-style: italic;" class="text-info">TELEPHONE
                      :</strong> <%= @allocataire.telephone %></strong>
                    </p>
                    <p><strong style="font-style: italic;" class="text-info">NIN
                      :</strong> <%= @allocataire.telephone %></strong>
                    </p>
                    <p><strong style="font-style: italic;" class="text-info">DATE DEBUT CHANGEMENT
                      :</strong> <%= @allocataire.try(:date_debut_changement).try(:strftime, "%d/%m/%Y") %></strong>
                    </p>
                </d1>
                <% end %>
                <d1 class="row mb-0">
                  <div class="col-sm-12" style="font-size: 11px; color: rgb(50, 50 50);">
                    <% if @allocataire.adresse_domicile? %>
                      <p><strong style="font-style: italic;" class="text-info">ADRESSE DOMICILE
                        :</strong> <%= @allocataire.adresse_domicile %></strong>
                      </p>
                      <p><strong style="font-style: italic;" class="text-info">TELEPHONE
                        :</strong> <%= @allocataire.telephone %></strong>
                      </p>
                    <%end %>
                  </div>
                </d1>
              </div>
              <div class="num_dossier"> 
                <d1 class="row mb-0">
                  <p><%= @allocataire.try(:numero_dossier) %></strong>
                  </p>
                </d1>
              </div>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </body>
</html>









