<div class="modal inmodal" id="modificationModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">&times;</span><span class="sr-only">Close</span></button>
        <i class="fa fa-laptop modal-icon"></i>
        <h5 class="modal-title">Modification etat en masse</h5>
      </div>
      <%= form_tag import_admin_allocataires_path, multipart: true do %>
        <div class="modal-body" style="height:150px">
          <div class="col-sm-12" style="text-align:left">
          </div>
          <div class="col-sm-4 col-lg-offset-4">
            <div class="btn-file">
              <label>
                <%= file_field_tag :file, hide_label:true, label: '.', class: '', id:'label_file' %>

                <div class="btn btn-success" style="margin-top: 0px; margin-left: 1px;"><span class="fa fa-upload"></span> Choisir un fichier
                </div>
              </label>
              <%= select_tag :etat, options_for_select(Allocataire.etats.to_a.map { |w| [Allocataire.human_enum_name(:etat, w[0]), w[0]] }) %>

            </div>
          </div>
          <div class="col-lg-12" style="text-align:center">
            <h4 id="file_name" class="text-success">Aucun fichier choisi</h4>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
          <%= submit_tag "Importer fichier allocataire",  class: 'btn btn-primary'  %>
        </div>
      <% end %>
      <div class="modal-footer">
        <button type="button" class="btn btn-white" data-dismiss="modal">Fermer</button>
        <button type="submit" class="btn btn-danger">rejeter</button>
      </div>
    </div>
  </div>
</div>

<script>
  const ctx = document.getElementById('evolutionAlloc');
    // ctx.height = 100;
     const color = Chart.helpers.color;
     const myChart = new Chart(ctx, {
         type: 'line',
         data: {
                labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jui', 'Juil', 'Aoû', 'Sep', 'Oct', 'Nov', 'Déc'],
                    datasets: [
                    {
                      label: 'Modif. adresse',
                      backgroundColor: 'rgba(255, 99, 132, 0.2)',
                               borderColor: 'rgb(255,99,132)',
                               borderWidth: 1,
                               data: [<%= (1..12).map{ |m| @modifier_adresses.where('extract(year from created_at) = ? AND extract(month from created_at) = ?', Date.today.year, m).count }.join(',') %>],
                           },
                           {
                               label: 'Reg. pension',
                               backgroundColor: '#36A2EB',
                               borderColor: 'rgba(54, 162, 235, 1)',
                               borderWidth: 1,
                               data: [<%= (1..12).map{ |m| @regularisation_pensions.where('extract(year from created_at) = ? AND extract(month from created_at) = ?', Date.today.year, m).count }.join(',') %>],
                           },
                           {
                               label: 'Mode paiement',
                               backgroundColor: '#D9865B',
                               borderColor: 'rgba(255, 206, 86, 1)',
                               borderWidth: 1,
                               data: [<%= (1..12).map{ |m| @modifier_mode_paiements.where('extract(year from created_at) = ? AND extract(month from created_at) = ?', Date.today.year, m).count  }.join(',') %>],
                           },
                           {
                               label: 'Grappe familiale',
                               backgroundColor: '#BC5CE6',
                               borderColor: 'rgba(75, 192, 192, 1)',
                               borderWidth: 1,
                               data: [<%= (1..12).map{ |m| @demande_grappe_familiales.where('extract(year from created_at) = ? AND extract(month from created_at) = ?', Date.today.year, m).count  }.join(',') %>],
                           },
                           {
                               label: 'Susp. allocataire',
                               backgroundColor: '#848BE2',
                               borderColor: 'rgba(153, 102, 255, 1)',
                               borderWidth: 1,
                               data: [<%= (1..12).map{ |m| @suspension_allocataires.where('extract(year from created_at) = ? AND extract(month from created_at) = ?', Date.today.year, m).count }.join(',') %>],
                           },
                       ]
                   },
                   options: {

                    legend:{
                      align:"start"
                    },

                    scales: {
                        yAxes: [{
                            ticks: {
                                beginAtZero: true,
                                stepSize: 5
                            }
                        }]
                    }
        }
    });



</script>
