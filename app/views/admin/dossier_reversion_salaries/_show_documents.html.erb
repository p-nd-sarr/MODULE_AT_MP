<style type="text/css">
  label[title="required"] {
    display: none;
  }

  .invalid-feedback {
    font-size: 0px;
  }
</style>


<ul class="text-danger">
  <% if @reversion_veuve_salarie.documents.where(type_document: [:cni, :attestation_travail, :certificat_mariage, :passeport, :carte_consulaire]).empty? %>
    <li>Veuillez ajouter une copie du CNI ou passeport ou carte consulaire</li>
  <% end %>
</ul>


  <div class="row" style="margin-top: 20px;">
    <div class="col-lg-4">
      <h2>Liste des documents</h2>
    </div>
    <%# unless @admin_reversion_veuve_salary.documents_valide! %>
      <div class="col-lg-8">
        <div class="alert alert-info alert-dismissable">
          <button ariahidden="true" data-dismiss="alert" class="close" type="button">
            <font style="vertical-align: inherit;">
              <font style="vertical-align: inherit;">x</font>
            </font>
          </button>
          <font style="vertical-align: inherit;">
            <font style="vertical-align: inherit;"><span class="fa fa-info-o"></span> Veuillez renseigner des documents
              au format PDF</font>
          </font>
        </div>
      </div>
    <%# end %>
  </div>



<% if @reversion_veuve_salarie.creation? %>
  <%= render 'documents/liste',
            object: @reversion_veuve_salarie,
            documents: @reversion_veuve_salarie.documents,
            include_add: @reversion_veuve_salarie.creation?,
            include_delete: @reversion_veuve_salarie.creation?,
            type_documents: ReversionVeuveSalary::TYPE_DOCUMENT_ORPHELIN,
            type_documents_obligatoires: ReversionVeuveSalary::TYPE_DOCUMENT_ORPHELIN_OBLIGATOIRE,
            back_url: admin_reversion_veuve_salary_path(@reversion_veuve_salarie)
  %>

    <%= render 'documents/modal_form',
              type_documents: ReversionVeuveSalary::TYPE_DOCUMENT_ORPHELIN,
              document: Document.new(documentable: @reversion_veuve_salarie),
              back_url:admin_reversion_veuve_salary_path(@reversion_veuve_salarie)
    %>
  <% else %>
  <%= render 'documents/liste',
            object: @reversion_veuve_salarie,
            documents: @reversion_veuve_salarie.documents,
            include_add: false, 
            include_delete: false, 
            type_documents: ReversionVeuveSalary::TYPE_DOCUMENT_ORPHELIN,
            type_documents_obligatoires: ReversionVeuveSalary::TYPE_DOCUMENT_ORPHELIN_OBLIGATOIRE,
            back_url: admin_reversion_veuve_salary_path(@reversion_veuve_salarie)
  %>
<%end%>