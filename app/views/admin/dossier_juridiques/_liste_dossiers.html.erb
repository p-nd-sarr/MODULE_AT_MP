<% if @dossier_juridiques.count.zero? %>
  <h2 style="text-align:center; margin-top:50px">
    <hr>
    La liste des dossiers juridiques est vide !!!
  </h2>
<% else %>

  <%= paginate @dossier_juridiques %>
  <div class="table-responsive" style="margin-top: 20px; padding-bottom:100px;">
    <table class="table table-striped">
      <thead class="thead-primary">
      <tr>
        <th scope="col">#</th>
        <th scope="col">N° Dossier</th>
        <th scope="col">Type Dossier</th>
        <th scope="col">Nom Dossier</th>
        <th scope="col">Objet Dossier</th>
        <th scope="col">Requérant</th>
        <th scope="col">Etat</th>
        <th scope="col">Créer le</th>
        <th colspan="3"></th>
      </tr>
      </thead>
      <tbody>
      <% @dossier_juridiques.each do |dossier_juridique| %>
        <tr>
          <td></td>
          <td><%= dossier_juridique.num_dossier %></td>
          <td><%= dossier_juridique.admin_type_dossier_juridique.title unless dossier_juridique.admin_type_dossier_juridique.nil? %></td>
          <td><%= dossier_juridique.nom_dossier %></td>
          <td><%= dossier_juridique.objet_dossier %></td>
          <td><%= dossier_juridique.requerent %></td>
          <td><%= dossier_juridique.current_state %></td>
          <td>
            <%= l dossier_juridique.created_at.to_date %>
          </td>
          <td style="width: 75px">
            <%= link_to 'Détails', admin_dossier_juridique_path(dossier_juridique), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px" class="dropdown">
            <button class="btn btn-success btn-xs dropdown-toggle" type="button" data-toggle="dropdown"> Options
              <span class="caret"></span>
            </button>
            <ul class="dropdown-menu pull-right" style="background-color:rgb(240,240,240)">
              <li>
                <%= link_to 'Modifier', edit_admin_dossier_juridique_path(dossier_juridique), id: "dd_hover" if dossier_juridique.creation? and current_user == dossier_juridique.ajoute_par %>
              </li>
              <li>
                <%= link_to 'Supprimer', admin_dossier_juridique_path(dossier_juridique), method: :delete, data: { confirm: 'En êtes vous sûr?' }, id: "dd_hover" if dossier_juridique.creation? and current_user == dossier_juridique.ajoute_par %>
              </li>
            </ul>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <%= paginate @dossier_juridiques %>
  </div>

<% end %>
