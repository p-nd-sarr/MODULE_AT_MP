<%= content_for :titre_page, "Détails Dossier Juridique [#{@dossier_juridique.current_state}]" %>

<%= content_for :titre_page_autres_details do %>
  <% unless @dossier_juridique.ajoute_par.nil? %>
    Créé par : <%= @dossier_juridique.ajoute_par.full_name unless @dossier_juridique.ajoute_par.nil? %>
    <br>
    <strong class="text-info">Date création :</strong>
    <%= "#{ @dossier_juridique.created_at.strftime('%d/%m/%Y') }" %>
  <% end %> <br>
  Etat du dossier : <%= "#{@dossier_juridique.current_state}" %> <br>
  <% if @dossier_juridique.soumission? %>
    Soumis par : <%= @dossier_juridique.soumis_par.full_name unless @dossier_juridique.soumis_par.nil? %> <br>
    <% unless @dossier_juridique.date_soumission.nil? %>
      <strong class="text-info">Date soumission :</strong>
      <%= "#{l @dossier_juridique.date_soumission}" %>
      <br>
    <% end %>
  <% end %>
  <% if @dossier_juridique.cloturation? %>
    Clôturé par : <%= @dossier_juridique.cloture_par.full_name unless @dossier_juridique.cloture_par.nil? %> <br>
    <% unless @dossier_juridique.date_cloture.nil? %>
      <strong class="text-info">Date clôture :</strong>
      <%= "#{l @dossier_juridique.date_cloture}" %>
      <br>
    <% end %>
  <% end %>
  <br>
  <% if current_user.directeur_juridique? or current_user.chef_service_direction_juridique? %>
    <span>
      <a data-toggle="modal" data-target="#affectation_agent" id="" class="btn btn-primary btn-sm"> Affectation dossier </a>
    </span>
  <% end %>
<% end %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour Accueil', admin_dossier_juridiques_path, class: 'btn btn-white btn-sm' %>

  <% if @dossier_juridique.creation? %>
    <%= (link_to 'Modifier', edit_admin_dossier_juridique_path(@dossier_juridique), class: 'btn btn-white btn-sm') if @dossier_juridique.creation? and current_user == @dossier_juridique.ajoute_par %>
    <%= (link_to 'Supprimer', [:admin, @dossier_juridique], method: :delete, data: { confirm: 'En êtes vous sûr?' },
                 class: 'btn btn-danger btn-sm') if @dossier_juridique.creation? and current_user == @dossier_juridique.ajoute_par %>
  <% end %>
  <% if @dossier_juridique.affectation? %>
    <%= (link_to 'Soumetre', admin_dossier_juridique_soumettre_path(@dossier_juridique), data: { confirm: 'En êtes vous sûr de vouloir soumettre le dossier?' }, class: 'btn btn-white btn-sm') if @dossier_juridique.is_set_manager(current_user.id) %>
  <% end %>
  <% if @dossier_juridique.soumission? %>
    <%= (link_to 'Clôturer', admin_dossier_juridique_cloturer_path(@dossier_juridique), data: { confirm: 'En êtes vous sûr de vouloir soumettre le dossier?' }, class: 'btn btn-white btn-sm') if current_user.directeur_juridique? or current_user.chef_service_direction_juridique? %>
  <% end %>
  <% if @dossier_juridique.soumission? and (current_user.directeur_juridique? or current_user.chef_service_direction_juridique?) %>
    <span>
      <a data-toggle="modal" data-target="#rejet_dossier" id="" class="btn btn-danger btn-sm"> Rejeter </a>
    </span>
  <% end %>

  <div style="margin-top: 5px">
    <% if @dossier_juridique.affectation? and !@dossier_juridique.rejete_par.nil? %>
      <p class="text-info">
        Le dossier à été rejeté par : <%= @dossier_juridique.rejete_par.full_name %> <br>
        Date de rejet : <%= l(@dossier_juridique.date_rejet) unless @dossier_juridique.date_rejet.nil? %>
      </p>
      <p class="text-info">
        <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#rejet_dossier" id="">Voir
          Le motif
        </button>
      </p>
    <% end %>
  </div>

<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="row">
            <div class="progressbar-wrapper">
              <ul class="progressbar">
                <li class="<%= ("active") if @dossier_juridique.current_state >= :creation %>">Création</li>
                <li class="<%= ("active") if @dossier_juridique.current_state >= :affectation %>">Affectation</li>
                <li class="<%= ("active") if @dossier_juridique.current_state >= :soumission %>">Soumission</li>
                <li class="<%= ("active") if @dossier_juridique.current_state >= :cloturation %>">cloturation</li>
              </ul>
            </div>
            <div class="col-lg-12" style="margin-top: 30px;">
              <%= link_to 'Historique', admin_dossier_juridique_historique_path(@dossier_juridique),
                          class: 'btn btn-outline btn-primary btn-sm' %>
            </div>
            <div class="col-lg-12" style="margin-top: 50px">
              <div>
                <ul class="nav nav-tabs" style="font-size:10px">
                  <li class="tab-link-top">
                    <a data-toggle="tab" href="#tab-1"><i class="fa fa-folder"></i>Informations
                      <%= '<span class="label label-warning">à valider</span>'.html_safe unless @dossier_juridique %>
                      <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @dossier_juridique %>
                    </a>
                  </li>
                  <li class="tab-link-top">
                    <a data-toggle="tab" href="#tab-2"><i class="fa fa-users"></i>Avocats / Huissiers
                      <%= '<span class="label label-warning">à valider</span>'.html_safe unless @dossier_juridique %>
                      <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @dossier_juridique %>
                    </a>
                  </li>
                  <li class="tab-link-top">
                    <a data-toggle="tab" href="#tab-3"><i class="fa fa-money"></i>Coûts
                      <%= '<span class="label label-warning">à valider</span>'.html_safe unless @dossier_juridique %>
                      <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @dossier_juridique %>
                    </a>
                  </li>
                  <li class="tab-link-top">
                    <a data-toggle="tab" href="#tab-4"><i class="fa fa-meetup"></i>Actes
                      <%= '<span class="label label-warning">à valider</span>'.html_safe unless @dossier_juridique %>
                      <%= '<span class="label label-primary">&#10003;</span>'.html_safe if @dossier_juridique %>
                    </a>
                  </li>
                </ul>
                <div class="tab-content">
                  <div id="tab-1" class="tab-pane tab-pane-section">
                    <div class="full-height-scroll">
                      <br>
                      <%= render 'show_info' %>
                    </div>
                  </div>
                  <div id="tab-2" class="tab-pane tab-pane-section">
                    <div class="full-height-scroll">
                      <br>
                      <%= render 'show_avocats_huissiers' %>
                    </div>
                  </div>
                  <div id="tab-3" class="tab-pane tab-pane-section">
                    <div class="full-height-scroll">
                      <br>
                      <%= render 'show_couts' %>
                    </div>
                  </div>
                  <div id="tab-4" class="tab-pane tab-pane-section">
                    <div class="full-height-scroll">
                      <br>
                      <%= render 'show_actes' %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%= render 'rejet_dossier' %>
<%= render 'affectation_agent' %>

<style>
    .progressbar-wrapper {
        width: 100%;
        padding-top: 5px;
        padding-bottom: 5px;
        padding-left: 12%;
    }

    .progressbar li {
        list-style-type: none;
        width: 20%;
        float: left;
        font-size: 10px;
        position: relative;
        text-align: center;
        text-transform: uppercase;
        color: #7d7d7d;
    }

    .progressbar li:before {
        width: 60px;
        height: 60px;
        content: "";
        line-height: 60px;
        border: 2px solid #7d7d7d;
        display: block;
        text-align: center;
        margin: 0 auto 3px auto;
        border-radius: 50%;
        position: relative;
        z-index: 2;
        background-color: #fff;
    }

    .progressbar li:after {
        width: 100%;
        height: 2px;
        content: '';
        position: absolute;
        background-color: #7d7d7d;
        top: 30px;
        left: -50%;
        z-index: 0;
    }

    .progressbar li:first-child:after {
        content: none;
    }

    .progressbar li.active {
        color: #000;
        font-weight: normal;
    }

    .progressbar li.active:before {
        border-color: #1ab394;
        background: #1ab394;
    }

    .progressbar li.active + li:after {
        background-color: #1ab394;
    }

    .progressbar li.active:before {
        background: #1ab394;
        background-size: 60%;
    }

    .progressbar li::before {
        background: #fff;
        background-size: 60%;
    }

    .progressbar {
        counter-reset: step;
    }

    .progressbar li:before {
        content: counter(step);
        counter-increment: step;
    }
</style>
