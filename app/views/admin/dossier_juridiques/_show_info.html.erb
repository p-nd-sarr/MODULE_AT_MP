<div class="row">
  <div class="col-lg-12" style="text-align: right;">
    <% if @dossier_juridique.creation? and current_user == @dossier_juridique.ajoute_par %>
      <%= link_to 'Modifier', edit_admin_dossier_juridique_path(@dossier_juridique), class: 'btn btn-outline btn-white fa fa-edit' %>
    <% end %>
  </div>
  <div class="col-lg-6">

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-arrow-right"></span> Numéro dossier:</dt>
      </div>
      <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.num_dossier unless @dossier_juridique.num_dossier.nil? %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-arrow-right"></span> Type dossier:</dt>
      </div>
      <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.admin_type_dossier_juridique.title unless @dossier_juridique.admin_type_dossier_juridique.nil? %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-answer"></span> Nom du dossier:</dt>
      </div>
      <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.nom_dossier %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-folder"></span> Objet du dossier:</dt>
      </div>
      <div class="col-sm-6 text-sm-left text-navy" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.objet_dossier %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-file"></span> Description du dossier:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.description_dossier %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-user"></span> Requérant:</dt>
      </div>
      <div class="col-sm-6 text-sm-left " style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.requerent %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa fa-user"></span> Défendeur:</dt>
      </div>
      <div class="col-sm-6 text-sm-left " style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.defendeur %></dd>
      </div>
    </d1>

  </div>
  <div class="col-lg-6">
    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt><span class="fa fa-folder"></span> Parties:</dt>
      </div>
      <div class="col-sm-6 " style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.parties %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6" style="text-align: right;">
        <dt><span class="fa"></span> Nature litige:</dt>
      </div>
      <div class="col-sm-6" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.nature_litige %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa"></span> État procédure:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.etat_procedure %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa"></span> Agence concernée:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.agence_concerne %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa"></span> Direction concernée:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.direction_concerne %></dd>
      </div>
    </d1>

    <d1 class="row mb-0">
      <div class="col-sm-6 text-sm-right" style="text-align: right;">
        <dt><span class="fa"></span> Montants réclamés:</dt>
      </div>
      <div class="col-sm-6 text-sm-left" style="text-align: left;">
        <dd class="mb-1"><%= @dossier_juridique.montant_reclame %></dd>
      </div>
    </d1>

    <% if @dossier_juridique.est_contrat? %>
      <d1 class="row mb-0">
        <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt><span class="fa"></span> Date début contrat:</dt>
        </div>
        <div class="col-sm-6 text-sm-left" style="text-align: left;">
          <dd class="mb-1"><%= l(@dossier_juridique.date_debut_contrat) unless @dossier_juridique.date_debut_contrat.nil? %></dd>
        </div>
      </d1>

      <d1 class="row mb-0">
        <div class="col-sm-6 text-sm-right" style="text-align: right;">
          <dt><span class="fa"></span> Date fin contrat:</dt>
        </div>
        <div class="col-sm-6 text-sm-left" style="text-align: left;">
          <dd class="mb-1"><%= l(@dossier_juridique.date_fin_contrat) unless @dossier_juridique.date_fin_contrat.nil? %></dd>
        </div>
      </d1>
    <% end %>

  </div>

</div>
