<%= content_for :titre_page, 'Admin Sites' %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_admin_site_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">Code</th>
        <th scope="col">Description</th>
        <th colspan="3"></th>
      </tr>
      </thead>

      <tbody>
      <% @admin_sites.each do |admin_site| %>
        <tr>
          <td><%= admin_site.code %></td>
          <td><%= admin_site.description %></td>
          <td style="width: 75px">
            <%= link_to 'détails', admin_site, class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'modifier', edit_admin_site_path(admin_site), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <td style="width: 75px">
            <%= link_to 'supprimer', admin_site, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
</div>