<%= content_for :titre_page, 'At Carnets' %>

<%= content_for :actions_page do %>
    <%= link_to 'Ajouter', new_at_carnet_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
                <th scope="col">Numero carnet</th>
                <th scope="col">Arret travail</th>
                <th scope="col">Numero employeur</th>
                <th scope="col">Date achat</th>
            <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <% @at_carnets.each do |at_carnet| %>
    <tr>
                <td><%= at_carnet.numero_carnet %></td>
                <td><%= at_carnet.arret_travail_id %></td>
                <td><%= at_carnet.numero_employeur %></td>
                <td><%= at_carnet.date_achat %></td>
            <td style="width: 75px">
        <%= link_to 'détails', at_carnet, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'modifier', edit_at_carnet_path(at_carnet), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%= link_to 'supprimer', at_carnet, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <% end %>
    </tbody>
    </table>
  </div>
</div>