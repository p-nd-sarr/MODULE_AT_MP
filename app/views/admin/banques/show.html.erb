<%= content_for :titre_page, "Détails Banque" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_banques_path, class: 'btn btn-white btn-sm' %>
  <%= link_to 'Modifier', edit_admin_banque_path(@admin_banque), class: 'btn btn-white btn-sm' %>
  <%= link_to 'Ajouter une banque', new_admin_banque_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
            <p>
              <strong>Nom:</strong>
              <%= @admin_banque.nom %>
            </p>

            <p>
              <strong>Code Banque:</strong>
              <%= @admin_banque.code %>
            </p>

            <p>
              <strong>Code SWIFT:</strong>
              <%= @admin_banque.code_swift %>
            </p>

            <p>
              <strong>BANK ID:</strong>
              <%= @admin_banque.bank_id %>
            </p>

            <p>
              <strong>Actif:</strong>
              <%= state_yes_no @admin_banque.actif %>
            </p>

            <hr>

            <h4>liste des Agences</h4>

            <table class="table table-bordered table-condensed table-hover">
              <thead>
              <tr>
                <th scope="col">Agence</th>
                <th scope="col">Code Agence</th>
                <th scope="col">Bank branch ID</th>
                <th colspan="3"></th>
              </tr>
              </thead>

              <tbody>
              <% @admin_banque.admin_banque_agences.each do |admin_banque_agence| %>
                <tr>
                  <td><%= admin_banque_agence.nom %></td>
                  <td><%= admin_banque_agence.code %></td>
                  <td><%= admin_banque_agence.bank_branch_id %></td>
                  <td style="width: 75px">
                    <%= link_to 'détails', admin_banque_agence, class: 'btn btn-outline btn-primary btn-xs' %>
                  </td>
                  <td style="width: 75px">
                    <%= link_to 'modifier', edit_admin_banque_agence_path(admin_banque_agence), class: 'btn btn-outline btn-primary btn-xs' %>
                  </td>
                  <td style="width: 75px">
                    <%= link_to 'supprimer', admin_banque_agence, method: :delete, data: {confirm: 'En êtes vous sûr?'}, class: 'btn btn-outline btn-danger btn-xs' %>
                  </td>
                </tr>
              <% end %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
