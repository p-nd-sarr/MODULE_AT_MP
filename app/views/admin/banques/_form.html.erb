<%= bootstrap_form_for(@admin_banque, layout: :horizontal) do |f| %>
  <%= f.text_field :nom, label: 'Nom de la banque' %>
  <%= f.text_field :code, label: 'Code Banque' %>
  <%= f.text_field :code_swift, label: 'Code SWIFT' %>
  <%= f.text_field :bank_id, label: 'BANK ID' %>
  <%= f.select :actif, [['Non', false], ['Oui', true]], label: "Est actif ?"%>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_banques_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
