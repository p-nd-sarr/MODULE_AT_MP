<%= bootstrap_form_for([:admin, @allocataire, @paiement], layout: :horizontal) do |f| %>

 <%= f.select :periode,
               PaiementAllocataire::PERIODE.keys.collect { |periode| [PaiementAllocataire.human_enum_name(:periode, periode), periode] },
               include_blank: true, label: 'Periode' %>
  <%= f.select :mode_paiement,
               MODE_PAIEMENT.keys.collect { |mode_paiement| [PaiementAllocataire.human_enum_name(:mode_paiement, mode_paiement), mode_paiement] },
               include_blank: true, label: 'Mode paiement' %>

  <%= f.select :annee, (Time.zone.now.year - 10)..(Time.zone.now.year + 1) %>

  
   
  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_allocataire_paiement_allocataires_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
