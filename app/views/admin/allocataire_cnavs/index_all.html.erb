<%= content_for :titre_page, "Allocataires #{DossierCnav.human_enum_name(:type_convention, @dossier_cnav.type_convention)} : toutes " %>

<%= content_for :actions_page do %>
  <% if is_active_action?('en_attente') %>
    <%= link_to 'Afficher tout', index_all_admin_allocataire_cnavs_path, class: 'btn btn-white btn-sm' %>
  <% else %>
    <%= link_to 'En attente de validation', en_attente_admin_allocataire_cnavs_path, class: 'btn btn-white btn-sm' %>
  <% end %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'liste' %>
  </div>
</div>