<%= bootstrap_form_for(@allocataire_cnav, layout: :horizontal) do |f| %>
    <%= f.text_field :dossier_cnav %>
    <%= f.text_field :date_import %>
    <%= f.text_field :numero %>
    <%= f.text_field :prenom %>
    <%= f.text_field :nom %>
    <%= f.text_field :admin_region_id %>
    <%= f.text_field :montant %>
    <%= f.text_field :origine %>
    <%= f.text_field :compte %>
    <%= f.text_field :caisse_bk %>
    <%= f.text_field :date_soumission %>
    <%= f.text_field :date_validation %>
    <%= f.text_field :valide_par_id %>
    <%= f.text_field :user %>
    <%= f.text_field :ajoute_par_id %>
    <%= f.text_field :traite_le %>
    <%= f.text_field :traite_par_id %>
    <%= f.text_field :motif_rejet %>
    <%= f.text_field :montant_paiement %>
    <%= f.text_field :paiement %>
    <%= f.text_field :etat %>
    <%= f.text_field :mode_paiement %>
    <%= f.text_field :numero_liquidation %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', allocataire_cnavs_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
