<h3>Critères de recherche</h3>
<br>
<%= search_form_for @q, url: request.path, html: { id: 'formulaire_recherche' } do |f| %>
  <div class="row">
    <div class="col-sm-4">
      <%= f.label :num_dossier_cont, 'Numéro' %>
      <%= f.search_field :numero_cont, class: 'form-control' %>
    </div>
    <div class="col-sm-4">
      <%= f.label :prenom_cont, 'Prénom' %>
      <%= f.search_field :prenom_cont, class: 'form-control' %>
    </div>
    <div class="col-sm-4">
      <%= f.label :nom_cont, 'Nom' %>
      <%= f.search_field :nom_cont, class: 'form-control' %>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-4">
      <%= f.label :compte_cont, 'Compte' %>
      <%= f.search_field :compte_cont, class: 'form-control' %>
    </div>
    <div class="col-sm-4">
      <%= f.label :mode_paiement_eq, 'Mode de paiement' %>
      <%= f.select :mode_paiement_eq, AllocataireCnav.mode_paiements.to_a.map { |w| [AllocataireCnav.human_enum_name(:mode_paiement, w[0]), w[1]] },
                   { :include_blank => true }, class: 'form-control' %>
    </div>
    <div class="col-sm-4">
      <%#= f.label :ajoute_par_id_eq, 'Ouvert par' %>
      <%#= f.collection_select :ajoute_par_id_eq, User.gestionnaire_compte_allocataire.order(:prenom), :id, :full_name, { :include_blank => true }, class: 'form-control' %>
      <%= f.label :admin_region_id_eq, 'Région' %>
      <%= f.collection_select :admin_region_id_eq, Admin::Region.order(:designation), :id, :designation,
                              { :include_blank => true }, class: 'form-control' %>
    </div>
  </div>
<!--  <div class="row">-->
<!--    <div class="col-sm-4">-->
      <%#= f.label :workflow_state_eq, 'Etat' %>
      <%#= f.select :workflow_state_eq, LiquidationRetraite.workflow_spec.states.keys.map { |k| [LiquidationRetraite.workflow_spec.states[k].meta[:label], k] }, { :include_blank => true }, class: 'form-control' %>
<!--    </div>-->
<!--  </div>-->

  <div class="hr-line-dashed"></div>

  <%= f.submit 'Rechercher', class: 'btn btn-primary', id: 'action_search' %>
  <%#= f.submit 'Exporter', class: 'btn', id: 'action_export' %>
<% end %>


<% content_for :javascript do %>
  <script type="text/javascript">
      $(function () {
<!--          $('#action_export').click(function () {-->
<!--              $('#formulaire_recherche').attr('action', '<%#= admin_liquidation_retraites_path(format: :xlsx) %>')-->
<!--          })-->
          $('#action_search').click(function () {
              $('#formulaire_recherche').attr('action', '<%= admin_dossier_cnav_allocataire_cnavs_path %>')
          })
          $('#formulaire_recherche').submit(function (e) {
              e.preventDefault(); // dont submit multiple times
              this.submit(); // use native js submit

              setTimeout(function () {
                  $('#action_export').prop("disabled", false);
                  $('#action_search').prop("disabled", false);
              }, 500);
          });
      });
  </script>
<% end %>