<%= content_for :titre_page, "Indemnités De Congés Maternité en attente de validation" %>

<%= content_for :actions_page do %>
  <% if is_active_action?('en_attente') %>
    <%= link_to 'Afficher tout', index_all_admin_indemnite_conges_maternites_path, class: 'btn btn-white btn-sm' %>
  <% else %>
    <%= link_to 'En attente de validation', en_attente_admin_indemnite_conges_maternites_path, class: 'btn btn-white btn-sm' %>
  <% end %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'liste' %>
  </div>
</div>