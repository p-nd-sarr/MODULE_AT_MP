<%= content_for :titre_page, "Css Transfert Employeurs" %>

<%= content_for :actions_page do %>
  <%= link_to 'Ajouter', new_admin_css_transfert_employeur_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <%= render 'admin/css_transfert_employeurs/search_employeur' %>
    <br> <br>
    <%= paginate @css_transfert_employeurs %>
    <table class="table table-bordered table-condensed table-hover">
      <thead>
      <tr>
        <th scope="col">N°</th>
        <th scope="col">Employeur</th>
        <th scope="col">Agence source</th>
        <th scope="col">Agence destination</th>
        <th scope="col">Date transfert</th>
        <th scope="col">Etat</th>
        <th scope="col">Créé le</th>
        <th colspan="3"></th>
      </tr>
      </thead>

      <tbody>
      <% @css_transfert_employeurs.each_with_index do |transfer, i| %>
        <tr>
          <td><%= i + 1 %></td>
          <td><%= Psrm::Employeur.find_by_fhnum(transfer.employeur_matric).fhrsoc %></td>
          <td><%= Admin::Agence.find(transfer.agence_source_id).description_prest %></td>
          <td><%= Admin::Agence.find(transfer.agence_destination_id).description_prest %></td>
          <td><%= l transfer.date_transfert unless transfer.date_transfert.nil? %></td>
          <td><%= CssTransfertEmployeur.human_enum_name(:workflow_state, transfer.workflow_state) %></td>
          <td><%= transfer.created_at.strftime('%d-%m-%Y') %></td>
          <td style="width: 75px">
            <%= link_to 'détails', admin_css_transfert_employeur_path(transfer), class: 'btn btn-outline btn-primary btn-xs' %>
          </td>
          <% if transfer.creation? and current_user.gestionnaire_compte_allocataire? %>
            <td style="width: 75px">
              <%= link_to 'modifier', edit_admin_css_transfert_employeur_path(transfer), class: 'btn btn-outline btn-primary btn-xs' %>
            </td>
            <td style="width: 75px">
              <%= link_to 'supprimer', admin_css_transfert_employeur_path(transfer), method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
            </td>
          <% end %>
        </tr>
      <% end %>
      </tbody>
    </table>
    <%= paginate @css_transfert_employeurs %>
  </div>
</div>