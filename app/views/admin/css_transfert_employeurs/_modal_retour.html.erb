<div class="modal inmodal" id="retourner" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
  <div class="modal-dialog">
    <div class="modal-content animated bounceInRight">
      <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal">
          <span aria-hidden="true">x</span>
          <span class="sr-only">Close</span>
        </button>
        <h4 class="modal-title">Motif </h4>
      </div>
      <%= bootstrap_form_for(@css_transfert_employeur, url: admin_css_transfert_employeur_change_transfert_statut_with_motif_path(@css_transfert_employeur, object)) do |f| %>
        <div class="modal-body">
          <%= f.text_area :motif_retour, label: 'Motif de retour', required: true, disabled: !@css_transfert_employeur.retourne_par.nil? %>
        </div>

        <div class="modal-footer form-group">
          <button class="btn btn-white" type="button" data-dismiss="modal">Fermer</button>
          <% if (!@css_transfert_employeur.creation? and @css_transfert_employeur.retourne_par.nil?) %>
            <%= f.button 'Valider', class: 'btn btn-primary' %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>