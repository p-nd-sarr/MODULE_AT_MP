<%= content_for :titre_page, "Détails css_transfert_employeur [#{ CssTransfertEmployeur.human_enum_name(:workflow_state, @css_transfert_employeur.workflow_state)}]" %>

<%= content_for :actions_page do %>

  <%= link_to 'Retour', admin_css_transfert_employeurs_path, 'data-turbolinks': false, class: 'btn btn-white btn-sm' %>
  <% if @css_transfert_employeur.creation? and current_user.gestionnaire_compte_allocataire? %>
    <%= link_to 'Editer', edit_admin_css_transfert_employeur_path(@css_transfert_employeur), 'data-turbolinks': false, class: 'btn btn-white btn-sm' %>
  <% end %>
  <br> <br>
  <% @css_transfert_employeur.current_state.events.values.each { |event| %>
    <% event = event.first %>
    <% if event.meta[:types_profils].include?(current_user.type_profil.to_sym) %>
      <%= link_to event.meta[:label], admin_css_transfert_employeur_change_transfert_statut_path(@css_transfert_employeur, event.name), 'data-turbolinks': false, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-primary btn-sm' if event.meta[:back] == false and @css_transfert_employeur.can_display(current_user) %>
      <br>
      <%= link_to "Retourner demande", '#', "data-toggle" => "modal", 'data-target' => '#retourner', class: 'btn btn-primary btn-sm' if event.meta[:back] == true and @css_transfert_employeur.can_display(current_user) %>
      <%= render 'admin/css_transfert_employeurs/modal_retour', object: event.name if event.meta[:back] == true %>
    <% end %>
  <% } %>

  <%# if @dossier_prestation_avis_tier.soumis? and current_user.chef_agence? %>
  <%#= (link_to 'Valider', admin_dossier_prestation_dossier_prestation_avis_tier_valider_path(@dossier_prestation, @dossier_prestation_avis_tier), 'data-turbolinks': false, 'data-confirm': 'Vous confirmez cette action ?', class: 'btn btn-primary btn-sm') %>
  <!--    <button type="button" class="btn btn-warning btn-sm" data-toggle="modal" data-target="#motif">Retourner Avis à-->
  <!--      tiers-->
  <!--    </button>-->
  <%#= render 'modal_retour' %>
  <%# end %>

<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-sm-4">
      <div class="col-sm-12">
        <div class="ibox">
          <div class="ibox-title">
            <h5>Historique</h5> &nbsp;
          </div>
          <div class="ibox-content">
            <% unless @css_transfert_employeur.ajoute_par.nil? %>
              <h5><strong class="text-navy">Crée Par</strong>
                : <%= (@css_transfert_employeur.ajoute_par.try(:full_name)) unless @css_transfert_employeur.ajoute_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date de création</strong>
                : <%= (@css_transfert_employeur.created_at.strftime("%d/%m/%Y")) unless @css_transfert_employeur.created_at.nil? %>
              </h5>
              <hr>
            <% end %>
            <% unless @css_transfert_employeur.soumis_par.nil? %>
              <h5><strong class="text-navy">Soumis Par</strong>
                : <%= (@css_transfert_employeur.soumis_par.try(:full_name)) unless @css_transfert_employeur.soumis_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date de soumission</strong>
                : <%= (@css_transfert_employeur.date_soumission.strftime("%d/%m/%Y")) unless @css_transfert_employeur.date_soumission.nil? %>
              </h5>
              <hr>
            <% end %>
            <% unless @css_transfert_employeur.valide_par.nil? %>
              <h5><strong class="text-navy">Validé Par</strong>
                : <%= (@css_transfert_employeur.valide_par.try(:full_name)) unless @css_transfert_employeur.valide_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date de validation</strong>
                : <%= (@css_transfert_employeur.date_validation.strftime("%d/%m/%Y")) unless @css_transfert_employeur.date_validation.nil? %>
              </h5>
              <hr>
            <% end %>
            <% unless @css_transfert_employeur.retourne_par.nil? %>
              <h5><strong class="text-navy">Retourné Par</strong>
                : <%= (@css_transfert_employeur.retourne_par.try(:full_name)) unless @css_transfert_employeur.retourne_par.nil? %>
              </h5>
              <h5><strong class="text-navy">Date retour</strong>
                : <%= (@css_transfert_employeur.date_retour.strftime("%d/%m/%Y")) unless @css_transfert_employeur.date_retour.nil? %>
              </h5>
              <h5><strong class="text-navy">Motif retour</strong>
                : <%= (@css_transfert_employeur.motif_retour) unless @css_transfert_employeur.motif_retour.nil? %>
              </h5>
            <% end %>
          </div>
        </div>
      </div>

    </div>

    <div class="col-sm-8">
      <div class="col-sm-12">
        <div class="ibox">
          <div class="ibox-title">
            <h5>Informations sur la demande</h5>
          </div>
          <div class="ibox-content">
            <p>
              <strong>Employeur :</strong>
              <%= Psrm::Employeur.find_by_fhnum(@css_transfert_employeur.employeur_matric).fhrsoc %>
            </p>
            <p>
              <strong>Numéro :</strong>
              <%= @css_transfert_employeur.employeur_matric %>
            </p>
            <p>
              <strong>État :</strong>
              <%= CssTransfertEmployeur.human_enum_name(:workflow_state, @css_transfert_employeur.workflow_state) unless @css_transfert_employeur.workflow_state.nil? %>
            </p>
            <p>
              <strong>Agence source :</strong>
              <%= Admin::Agence.find(@css_transfert_employeur.agence_source_id).description_prest %>
            </p>
            <p>
              <strong>Agence destination :</strong>
              <%= Admin::Agence.find(@css_transfert_employeur.agence_destination_id).description_prest %>
            </p>
            <p>
              <strong>Date transfert :</strong>
              <%= l @css_transfert_employeur.date_transfert unless @css_transfert_employeur.date_transfert.nil? %>
            </p>
            <p>
              <strong>Commentaire :</strong>
              <%= @css_transfert_employeur.commentaire %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>