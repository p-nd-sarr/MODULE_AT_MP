<%= bootstrap_form_for([:admin, @allocataire, @revision_pension], layout: :horizontal, label_col: "col-sm-4", control_col: "col-sm-8") do |f| %>
  <%#= f.alert_message "Please fix the errors below." %>
  <%= f.select :type_motif,
               RevisionPension::TYPE_MOTIF.keys.collect { |type_motif| [RevisionPension.human_enum_name(:type_motif, type_motif), type_motif] },
               include_blank: false, label: 'Type motif' %>


  <%= f.date_select :date_reception, label: "Date de réception",
                    end_month: Date.today.month,
                    start_year: (Date.today - 10.year).year, end_year: Date.today.year%>

  <%= f.text_area :commentaire, label: "Période à réviser: ", class:'form-control' %>

  <%= f.collection_select :soumis_par_id, User.gestionnaire_compte_allocataire, :id, :full_name, label: 'Choisir gestionnaire', required: true %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-4">
      <%= link_to 'Annuler', (@revision_pension.persisted? ? [:admin, @allocataire, @revision_pension] : admin_allocataire_revision_pensions_path(@allocataire)), class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
