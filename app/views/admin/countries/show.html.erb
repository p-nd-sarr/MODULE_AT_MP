<%= content_for :titre_page, "Détails admin_country" %>

<%= content_for :actions_page do %>
  <%= link_to 'Retour', admin_countries_path, class: 'btn btn-white btn-sm' %>
  <%= link_to 'Modifier', edit_admin_country_path(@admin_country), class: 'btn btn-white btn-sm' %>
  <%= link_to 'Ajouter admin_country', new_admin_country_path, class: 'btn btn-primary btn-sm' %>
<% end %>

<div class="wrapper wrapper-content">
  <div class="row">
    <div class="col-lg-12">
      <div class="ibox float-e-margins">
        <div class="ibox-content">
          <div class="wrapper wrapper-content">
            <p>
              <strong>Code:</strong>
              <%= @admin_country.code %>
            </p>

            <p>
              <strong>Description:</strong>
              <%= @admin_country.description %>
            </p>


            <p>
              <strong>Est un pays CAF:</strong>
              <% if @admin_country.est_pays_caf? %>
                Oui
              <% else %>
                Non
              <% end %>

            </p>

          </div>
        </div>
      </div>
    </div>
  </div>
</div>
