<%= bootstrap_form_for(@admin_country, layout: :horizontal) do |f| %>
    <%= f.text_field :code %>
    <%= f.text_field :description %>
    <%= f.select :est_pays_caf, [['Non', false], ['Oui', true]] %>

  <div class="hr-line-dashed"></div>

  <div class="form-group row">
    <div class="col-sm-4 col-sm-offset-2">
      <%= link_to 'Annuler', admin_countries_path, class: 'btn btn-white' %>
      <%= f.button 'Valider', class: 'btn btn-primary' %>
    </div>
  </div>
<% end %>
