<%%= content_for :titre_page, '<%= plural_table_name.titleize %>' %>

<%%= content_for :actions_page do %>
    <%%= link_to 'Ajouter', new_<%= singular_table_name %>_path, class: 'btn btn-primary btn-sm' %>
<%% end %>

<div class="wrapper wrapper-content">
  <div class="ibox-content">
    <table class="table table-bordered table-condensed table-hover">
    <thead>
    <tr>
      <% attributes.reject(&:password_digest?).each do |attribute| -%>
          <th scope="col"><%= attribute.human_name %></th>
      <% end -%>
      <th colspan="3"></th>
    </tr>
    </thead>

    <tbody>
    <%% @<%= plural_table_name %>.each do |<%= singular_table_name %>| %>
    <tr>
      <% attributes.reject(&:password_digest?).each do |attribute| -%>
          <td><%%= <%= singular_table_name %>.<%= attribute.name %> %></td>
      <% end -%>
      <td style="width: 75px">
        <%%= link_to 'détails', <%= singular_table_name %>, class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%%= link_to 'modifier', edit_<%= singular_table_name %>_path(<%= singular_table_name %>), class: 'btn btn-outline btn-primary btn-xs' %>
      </td>
      <td style="width: 75px">
        <%%= link_to 'supprimer', <%= singular_table_name %>, method: :delete, data: { confirm: 'En êtes vous sûr?' }, class: 'btn btn-outline btn-danger btn-xs' %>
      </td>
    </tr>
    <%% end %>
    </tbody>
    </table>
  </div>
</div>